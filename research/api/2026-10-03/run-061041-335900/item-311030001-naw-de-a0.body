{"id":311030001,"name":"Offenbarungsamulett","desc":"Ein Amulett, das nur jene erhalten können, die die Offenbarung wahrhaft verstanden haben.\nKann mit einer Rolle der Amulett-Verstärkung verbessert werden, die durch Monolith-Resonanz erhältlich ist.","grade":"Unique","gradeName":"Einzigartig","icon":"https://assets.playnccdn.com/static-aion2-gamedata/resources/Icon_Item_Craft_Conversion_Crystal_L_lv5_01.png","level":65,"levelValue":0,"enchantLevel":0,"storable":false,"tradable":false,"tradablePersonal":false,"enchantable":true,"decomposable":false,"maxEnchantLevel":10,"raceName":"Alle","categoryName":"Amulett","type":"Accessory","equipLevel":1,"subStatCount":0,"subSkillCountMax":0,"subStatRandom":false,"mainStats":[{"id":"DefensePierce","name":"Penetration","value":"700","extra":"0","exceed":false},{"id":"SealStoneAddDamage","name":"Zusatzschaden (Siegelstein)","value":"40","extra":"0","exceed":false},{"id":"AmplifyWeaponDamage","name":"Verstärkung (Waffenschaden)","value":"10%","extra":"0%","exceed":false},{"id":"Perfect","name":"Perfektion","value":"5%","extra":"0%","exceed":false}],"sources":["Konvertierung"],"favorite":false}