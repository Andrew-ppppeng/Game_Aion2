notice_en","boardUrlPattern":"https://aion2.plaync.com/en-us/board/notice/view?articleId={articleId}","boardSdkUrlPattern":null,"metaTags":["searchAllowed"],"language":"en-US","weight":0,"serviceReserved":{"reserved1":{},"reserved2":{},"reserved3":{},"reserved4":{},"serviceReserved":{}},"docMetaVersion":"0.0.3"},"recentCommentWriter":null,"idNumberHierarchy":{"root":"","parent":"","reactionParent":""},"docMetaVersion":"0.0.3"},"content":{"id":"6abd3200a279104f7d9d5eeb","meta":{"version":"0.0.3"},"zone":"ncs","boardRef":"6a2629f436bfe25a75cb4c82","content":"<div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f8337b-a9e655da-41ac-4dda-991b-40563c3c76d8&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f8337b-a9e655da-41ac-4dda-991b-40563c3c76d8\" alt=\"announcements_EN.jpg\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\">We would like to provide information regarding the PURPLE region settings required when accessing the AION2 Global Service.</div><div data-contents-type=\"text\">​</div><div data-contents-type=\"text\">When using PURPLE from the countries and regions listed below, AION2 may not appear in your game list depending on your PURPLE region settings.</div><div data-contents-type=\"text\">If you are playing AION2 from one of the applicable countries or regions, please change your PURPLE region setting to <strong>“Global”</strong> before launching the game.</div><div data-contents-type=\"text\">​</div><div data-contents-type=\"text\"><strong>Applicable Countries and Regions</strong></div><ul><li><div data-contents-type=\"text\">Indonesia</div></li><li><div data-contents-type=\"text\">Malaysia</div></li><li><div data-contents-type=\"text\">Philippines</div></li><li><div data-contents-type=\"text\">Singapore</div></li><li><div data-contents-type=\"text\">Thailand</div></li></ul><div data-contents-type=\"text\">​</div><div data-contents-type=\"text\"><strong>How to Change Your PURPLE Region Setting</strong></div><ol><li><div data-contents-type=\"text\">Launch PURPLE.</div></li><li><div data-contents-type=\"text\">Check your current PURPLE region setting.</div></li><li><div data-contents-type=\"text\">If your current country or region is selected, change the setting to <strong>“Global.”</strong></div></li><li><div data-contents-type=\"text\">After changing the setting, confirm that AION2 appears in your game list.</div></li></ol><div data-contents-type=\"text\">※ You may need to restart PURPLE after changing the region setting.</div><div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\">​</div><div data-contents-type=\"text\">We apologize for any inconvenience this may cause and kindly ask users in the applicable countries and regions to check their PURPLE region settings before accessing AION2.</div><div data-contents-type=\"text\">Thank you for your continued support of AION2.</div><div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f809cf-b2d578e1-9d04-4159-9e6e-4406d3ff26ea&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f809cf-b2d578e1-9d04-4159-9e6e-4406d3ff26ea\" alt=\"Bottom banner.jpg\" class=\"fe-image\"></div></div></div>","userAgent":null,"attachments":{"files":[{"attachmentId":0,"fileId":"1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d","fileName":"1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d","fileUrl":"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d","mimeType":"image/png","fileSize":837578,"thumbnailUrl":"https://fizz-download.playnccdn.com/lg/file/AION/download_thumbnail/1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d","fileAttachmentType":"EMBEDDED","binary":null}],"thumbnailUrl":"https://fizz-download.playnccdn.com/lg/file/AION/download_thumbnail/1a0f316e022-80dc42f4-03b5-4e12-a3bb-45b5dc68c32d"},"tags":[],"userPlatform":null,"serviceReserved":{"reserved1":{},"reserved2":{},"reserved3":{},"reserved4":{},"serviceReserved":{}},"deleteReasonCode":0,"deleteReasonComment":null,"ip":"0.0.0.0","contentSize":3514,"docMetaVersion":"0.0.3"}},"voteContents":null,"tags":null,"recommendUpArticle":false,"recommendDownArticle":false,"isScrapArticle":false}