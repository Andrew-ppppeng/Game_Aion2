2629f436bfe25a75cb4c82","meta":{"version":"0.0.3"},"boardType":"Notice","boardState":"published","hierarchy":{"root":null,"parent":null,"friend":null,"subTree":{"treeId":null,"treeRoot":null}},"boardConfigRef":"6a2629f30045de2ac001dd44","snow":{"rootBoardId":0,"parentBoardId":0,"boardId":514},"boardName":"Announcements","boardNameI18N":{},"boardAlias":"notice_en","boardUrlPattern":"https://aion2.plaync.com/en-us/board/notice/view?articleId={articleId}","boardSdkUrlPattern":null,"metaTags":["searchAllowed"],"language":"en-US","weight":0,"serviceReserved":{"reserved1":{},"reserved2":{},"reserved3":{},"reserved4":{},"serviceReserved":{}},"docMetaVersion":"0.0.3"},"recentCommentWriter":null,"idNumberHierarchy":{"root":"","parent":"","reactionParent":""},"docMetaVersion":"0.0.3"},"content":{"id":"6abd2d50a279104f7d9d5ee2","meta":{"version":"0.0.3"},"zone":"ncs","boardRef":"6a2629f436bfe25a75cb4c82","content":"<div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f8337b-a9e655da-41ac-4dda-991b-40563c3c76d8&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f8337b-a9e655da-41ac-4dda-991b-40563c3c76d8\" alt=\"announcements_EN.jpg\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\">Daevas,<br><br>For those of you waiting in a queue for an existing server, or those of you who are joining just now, please consider creating your character on a recommended server. Server transfers will be available in the future starting on <strong>October 14th</strong> and you'll have a chance to move between servers within the same faction at that time. As a reminder, all instanced content including dungeons are available cross-server.</div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\">Note:&nbsp;When we introduce the server transfer feature, we will add restrictions to ensure Early Access players may only transfer between Early Access Servers, and not commercial launch servers.</div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\">Additionally, <strong>Server Transfers will initially be free during this period!</strong></div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div><div data-contents-type=\"text\"><div class=\"fr-image\" contenteditable=\"false\" data-contents-json=\"{&quot;src&quot;:&quot;https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f809cf-b2d578e1-9d04-4159-9e6e-4406d3ff26ea&quot;,&quot;width&quot;:null,&quot;height&quot;:null}\" data-contents-type=\"image\"><div class=\"fe-image-inner\"><img src=\"https://fizz-download.playnccdn.com/lg/file/AION/download/1a0f2f809cf-b2d578e1-9d04-4159-9e6e-4406d3ff26ea\" alt=\"Bottom banner.jpg\" class=\"fe-image\"></div></div></div><div data-contents-type=\"text\"><br class=\"ProseMirror-trailingBreak\"></div>","userAgent":null,"attachments":{"files":[],"thumbnailUrl":""},"tags":[],"userPlatform":null,"serviceReserved":{"reserved1":{},"reserved2":{},"reserved3":{},"reserved4":{},"serviceReserved":{}},"deleteReasonCode":0,"deleteReasonComment":null,"ip":"0.0.0.0","contentSize":2246,"docMetaVersion":"0.0.3"}},"voteContents":null,"tags":null,"recommendUpArticle":false,"recommendDownArticle":false,"isScrapArticle":false}