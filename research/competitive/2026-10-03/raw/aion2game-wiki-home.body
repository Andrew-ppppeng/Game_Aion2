            window.__awLoadGlobalScripts?.();
            await window.__awGeoReady;
            if (window.__awGaAllowedNow()) window.__awLoadGa?.();
          },
          { once: true },
        );
      })();</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"AION 2 Wiki","url":"https://aion2game.wiki","logo":"https://aion2game.wiki/android-chrome-512x512.png","image":"https://aion2game.wiki/images/og.jpg","description":"Unofficial AION 2 wiki with sourced guides to classes, dungeons, PvP, the Founder's Packs, system requirements and the October 5 global launch."}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"AION 2 Wiki","url":"https://aion2game.wiki","description":"Unofficial AION 2 wiki with sourced guides to classes, dungeons, PvP, the Founder's Packs, system requirements and the October 5 global launch.","inLanguage":"en"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"VideoGame","name":"AION 2","description":"Unofficial AION 2 wiki with sourced guides to classes, dungeons, PvP, the Founder's Packs, system requirements and the October 5 global launch.","url":"https://aion2game.wiki","genre":"Open-world MMORPG","gamePlatform":"PC (Steam / PURPLE)","publisher":{"@type":"Organization","name":"NC (NCSOFT)"},"datePublished":"2026-10-05"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"When does AION 2 launch?","acceptedAnswer":{"@type":"Answer","text":"October 5, 2026 worldwide, on PC only - Steam and PURPLE. A Founder's Pack gets you in five days earlier, from September 30."}},{"@type":"Question","name":"Can I play it on PS5 or mobile?","acceptedAnswer":{"@type":"Answer","text":"Launch is PC only. NC's development PD confirmed a PS5 version is in development but gave no date. Mobile exists only in Korea and Taiwan; the global version officially has none."}},{"@type":"Question","name":"How many classes are there?","acceptedAnswer":{"@type":"Answer","text":"The official Korean class guide says eight. Global launch is expected to be those eight. The ninth, Brawler, shipped only in Korea and Taiwan."}},{"@type":"Question","name":"Will Brawler be in the global launch?","acceptedAnswer":{"@type":"Answer","text":"NC has published no global roster as of September 18, 2026. Creators who play the Korea/Taiwan service believe global launches with eight and no Brawler - but that is a creator report, not an official announcement."}},{"@type":"Question","name":"Can my PC run it?","acceptedAnswer":{"@type":"Answer","text":"Minimum is Ryzen 5 2600 / i5-10500, 8 GB RAM and GTX 1050 Ti (4GB). Recommended is Ryzen 7 3700X / i7-11700, 16 GB and RTX 2070 (8GB). Both tiers need 100 GB and both recommend an SSD."}},{"@type":"Question","name":"Is AION 2 pay to win?","acceptedAnswer":{"@type":"Answer","text":"It is free to play with an optional USD 15/month membership. The membership unlocks the Market and the Kina-to-Quna exchange. The shop is cosmetics and consumables, which NC says do not affect power. Whether buying Kina with real money crosses your line is your call."}},{"@type":"Question","name":"Are the Founder's Packs worth it?","acceptedAnswer":{"@type":"Answer","text":"All three include five days of early access, a supply chest, a unique title and 30 days of membership. The extra tiers are entirely cosmetics - no power. Worth it only if you want those looks or the day-one head start."}},{"@type":"Question","name":"Is there another beta I can join?","acceptedAnswer":{"@type":"Answer","text":"No. The only test was the Launch Scale Test on September 17-18, six hours a day, no keys, progress wiped. The only way to play earlier now is Founder's Pack early access."}}]}</script><script>(function(){const defaultTheme = "dark";

      (() => {
        const stored = localStorage.getItem('theme');
        const useDarkTheme = stored === 'dark'
          || (!stored && defaultTheme === 'dark')
          || (!stored && defaultTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (useDarkTheme) {
          document.documentElement.classList.add('dark');
        }
      })();
    })();</script><link rel="stylesheet" href="/_astro/_slug_.Bv1ny9Zm.css">
