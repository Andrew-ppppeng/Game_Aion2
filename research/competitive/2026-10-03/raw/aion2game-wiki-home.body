6 10-9.4 17.3-18 11.6c2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4c-.9-4.2 4-6.6 7-3.8c1.1 0 3-1.2 3-1.2"/></symbol><use href="#ai:lucide:twitter"></use>  </svg> Official X </a> </li><li> <a href="https://www.reddit.com/r/Aion2/" rel="noopener noreferrer" target="_blank" class="inline-flex items-center gap-2 text-sm text-foreground/80 transition hover:text-nav"> <svg width="1em" height="1em" viewBox="0 0 24 24" class="h-4 w-4" data-icon="lucide:globe">   <use href="#ai:lucide:globe"></use>  </svg> Reddit community </a> </li> </ul> </div>  <div> <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground"> Legal &amp; contact </h2> <ul class="mt-3 space-y-2"> <li> <a href="/about/" class="text-sm text-foreground/80 transition hover:text-nav"> About </a> </li><li> <a href="/privacy-policy/" class="text-sm text-foreground/80 transition hover:text-nav"> Privacy Policy </a> </li><li> <a href="/terms-of-service/" class="text-sm text-foreground/80 transition hover:text-nav"> Terms of Service </a> </li><li> <a href="/copyright/" class="text-sm text-foreground/80 transition hover:text-nav"> Copyright </a> </li><li> <a href="/contact/" class="text-sm text-foreground/80 transition hover:text-nav"> Contact </a> </li> </ul> <button type="button" data-consent-open class="mt-3 text-sm text-foreground/80 transition hover:text-nav"> Cookie settings </button> </div> </div> <div class="mt-8 border-t border-border pt-6"> <p class="text-xs text-muted-foreground">(c) 2026 AION 2 Wiki. Unofficial community resource.</p> </div> </div> </footer>   <div id="cookie-consent" hidden class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-card p-4 shadow-lg" role="dialog" aria-live="polite" aria-label="Cookies"> <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 sm:flex-row"> <p class="text-sm text-muted-foreground"> <span class="font-semibold text-foreground">Cookies: </span>We use cookies for analytics to keep this site free. </p> <div class="flex shrink-0 items-center gap-2 sm:ml-auto"> <button type="button" data-consent-decline class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition hover:text-foreground"> Decline </button> <button type="button" data-consent-accept class="btn-primary px-3 py-1.5"> Accept </button> </div> </div> </div> <script type="module">(async()=>{const n="aw-cookie-consent",e=document.getElementById("cookie-consent");if(!e)return;const r=()=>{try{return localStorage.getItem(n)}catch{return null}},c=t=>{try{localStorage.setItem(n,t)}catch{}},a=()=>{e.hidden=!1},o=()=>{e.hidden=!0};document.addEventListener("click",t=>{const d=t.target;d instanceof Element&&d.closest("[data-consent-open]")&&(t.preventDefault(),a())});const i=()=>{c("accepted"),o(),window.__awLoadGa?.()},s=()=>{c("declined"),o(),window.__awGaId&&(window["ga-disable-"+window.__awGaId]=!0)};e.querySelector("[data-consent-accept]")?.addEventListener("click",i),e.querySelector("[data-consent-decline]")?.addEventListener("click",s),!r()&&(await window.__awGeoReady,!window.__awGaAllowedNow?.()&&a())})();</script> </body></html>