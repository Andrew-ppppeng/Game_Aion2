l="Play video: AION 2 trailer"><span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 shadow-lg transition group-hover:scale-110 group-hover:bg-red-500"><svg width="1em" height="1em" class="ml-1 h-7 w-7 text-white" data-icon="lucide:play">   <symbol id="ai:lucide:play" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></symbol><use href="#ai:lucide:play"></use>  </svg></span></button><img src="https://i.ytimg.com/vi/IZ_zw2GksRY/hqdefault.jpg" alt="AION 2 trailer" class="h-full w-full object-cover opacity-85 transition duration-300 group-hover:opacity-100" loading="eager" fetchpriority="high" decoding="async" width="480" height="360"></div></div></section><script>
