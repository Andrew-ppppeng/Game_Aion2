          for (const entry of window.__awGlobalScripts) {
            if (window.__awGlobalScriptsLoaded.has(entry.scriptUrl)) continue;
            window.__awGlobalScriptsLoaded.add(entry.scriptUrl);
            const script = document.createElement('script');
            script.async = true;
