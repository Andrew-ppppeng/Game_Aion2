          return !window.__awNeedsConsent();
        };
        window.__awAdsterraSlots = window.__awAdsterraSlots || [];
        window.__awAdsterraLoaded = window.__awAdsterraLoaded || new Set();
        window.__awNativeBanners = window.__awNativeBanners || [];
        window.__awNativeBannersLoaded = window.__awNativeBannersLoaded || new Set();
        window.__awGlobalScripts = window.__awGlobalScripts || activeGlobalScripts;
        window.__awGlobalScriptsLoaded = window.__awGlobalScriptsLoaded || new Set();
        window.__awLoadAdsterraSlots = () => {
          if (!adsConfigured) return;
          for (const slot of window.__awAdsterraSlots) {
            if (window.__awAdsterraLoaded.has(slot.containerId)) continue;
            const container = document.getElementById(slot.containerId);
            if (!container) continue;
            const options = JSON.stringify({
