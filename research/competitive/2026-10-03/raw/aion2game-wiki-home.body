        window.__awGeo = '';
        window.__awGeoReady =
          consentMode === 'geo'
            ? Promise.race([
                fetch('/cdn-cgi/trace', { cache: 'no-store' })
                  .then((response) => (response.ok ? response.text() : ''))
                  .then((trace) => {
                    const match = /^loc=([A-Z]{2})$/m.exec(trace || '');
