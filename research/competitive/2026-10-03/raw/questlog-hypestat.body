				<section>
    <h2>questlog.gg<span> Traffic Flow</span><div class="a2a_kit a2a_default_style" style="float:right;">
    <a class="a2a_dd" href="https://www.addtoany.com/share">
        <span class="share-b"></span>
    </a>
</div></h2>
<span>
    The largest share of traffic to questlog.gg comes from Direct visits (76.99%). 
    After leaving the site, the most common destination is discord.com
            and google.com
    .
</span>

    <div id="tio-container">
        <div id="tio"></div>
    </div>

<script>

    const traffic_stats_json = '{\"in\":[{\"host\":\"Direct\",\"visits\":399630,\"share\":\"76.99%\",\"trend\":\"-24.66%\"},{\"host\":\"Google organic\",\"visits\":49563,\"share\":\"9.74%\",\"trend\":\"-17.19%\"},{\"host\":\"youtube.com\",\"visits\":32708,\"share\":\"6.34%\",\"trend\":\"-39.60%\"},{\"host\":\"discord.com\",\"visits\":8148,\"share\":\"1.61%\",\"trend\":\"-1.81%\"},{\"host\":\"bing.com\",\"visits\":6828,\"share\":\"1.32%\",\"trend\":\"+300.90%\"}],\"out\":[{\"host\":\"discord.com\",\"visits\":4676,\"share\":\"24.21%\",\"trend\":\"-41.50%\"},{\"host\":\"google.com\",\"visits\":3148,\"share\":\"16.61%\",\"trend\":\"-32.17%\"},{\"host\":\"youtube.com\",\"visits\":3064,\"share\":\"15.96%\",\"trend\":\"-32.59%\"},{\"host\":\"twitch.tv\",\"visits\":1721,\"share\":\"9.12%\",\"trend\":\"-41.32%\"},{\"host\":\"reddit.com\",\"visits\":660,\"share\":\"3.42%\",\"trend\":\"+66.34%\"}]}';
    const trafficData = JSON.parse(traffic_stats_json);
    const formattedData = {
        in: trafficData.in.map(item => ({
            name: item.host,
            p: parseFloat(item.share.replace('%', '')),
            trend: item.trend
        })),
        out: trafficData.out.map(item => ({
            name: item.host,
            p: parseFloat(item.share.replace('%', '')),
            trend: item.trend
        }))
    };

createTrafficFlow(formattedData, 'tio', 'questlog.gg');




function createTrafficFlow(data, containerId, domainName) {
let site_url = "https://hypestat.com";
    const vW = 600, vH = 330;
    const midW = 100, midH = 30;
    const midX = (vW / 2) - (midW / 2);
    const midY = (vH / 2) - (midH / 2);


    function calculateHeight(value, items, totalAvailableH) {
        const sumP = items.reduce((acc, item) => acc + item.p, 0);
        const minH = 6;
        return Math.max(minH, (value / (sumP || 1)) * totalAvailableH);
    }

    function getPath(x1, y1, h1, x2, y2, h2) {
        const cp = (x2 - x1) * 0.45;
        return `M ${x1} ${y1} C ${x1+cp} ${y1}, ${x2-cp} ${y2}, ${x2} ${y2} L ${x2} ${y2+h2} C ${x2-cp} ${y2+h2}, ${x1+cp} ${y1+h1}, ${x1} ${y1+h1} Z`;
    }

    let svgStr = `<svg class="flow-tio-svg" viewBox="0 0 ${vW} ${vH}" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">`;

    function generateSide(items, isLeft) {
        const gap = vH * 0.12;
        const minFlowH = 1.2;
        const totalAvailableH = vH * 0.4;

        const heights = items.map(item => calculateHeight(item.p, items, totalAvailableH));
        const totalContentH = heights.reduce((a, b) => a + b, 0) + (items.length - 1) * gap;

        let currentY = (vH / 2) - (totalContentH / 2);
        let stackY = midY + (midH / 2) - ((items.length * (minFlowH + 1.5)) / 2);

        const xPos = isLeft ? vW * 0.22 : vW * 0.78;
        const targetX = isLeft ? midX : midX + midW;

        items.forEach((item, i) => {
            let edgeH = heights[i];
            const p1 = isLeft ? xPos : targetX;
            const p2 = isLeft ? targetX : xPos;
            const yCoord1 = isLeft ? currentY : stackY;
            const yCoord2 = isLeft ? stackY : currentY;
            const hCoord1 = isLeft ? edgeH : minFlowH;
            const hCoord2 = isLeft ? minFlowH : edgeH;

            svgStr += `<path d="${getPath(p1, yCoord1, hCoord1, p2, yCoord2, hCoord2)}" fill="#80caff" fill-opacity="0.2" />`;

            const markerX = isLeft ? xPos - 4 : xPos;
            svgStr += `<rect x="${markerX}" y="${currentY}" width="4" height="${edgeH}" rx="1" class="edge-marker" />`;

            const textX = isLeft ? xPos - 15 : xPos + 15;
            const isDomain = item.name.includes('.') && !item.name.includes(' '); 
            const anchor = isLeft ? "end" : "start";
            const url = isDomain ? site_url + `/info/${item.name}` : null;

            let hostContent = `<tspan class="tio_host" x="${textX}">${item.name}</tspan>`;
            if (isDomain) {
                hostContent = `
                <a xlink:href="${url}" target="_self" class="svg-link">
                    ${hostContent}
                </a>`;
            }

           svgStr += `
            <text x="${textX}" y="${currentY + (edgeH/2) - 6}" text-anchor="${anchor}">
                ${hostContent}
                <tspan class="tio_stats" x="${textX}" dy="16">${item.p}% 
                    <tspan class="${item.trend.includes('+') ? 'trend-up' : 'trend-down'}">${item.trend}</tspan>
                </tspan>
            </text>`;

            currentY += edgeH + gap;
            stackY += minFlowH + 1.5;
        });
    }

    generateSide(data.in, true);
    generateSide(data.out, false);

    svgStr += `<path d="M ${midX - 18} ${midY + midH/2 - 5} L ${midX - 10} ${midY + midH/2} L ${midX - 18} ${midY + midH/2 + 5} Z" class="arrow-icon" />`;
    svgStr += `<path d="M ${midX + midW + 10} ${midY + midH/2 - 5} L ${midX + midW + 18} ${midY + midH/2} L ${midX + midW + 10} ${midY + midH/2 + 5} Z" class="arrow-icon" />`;

    svgStr += `
    <defs>
      <clipPath id="boxClip">
        <rect x="${midX + 5}" y="${midY}" width="${midW - 10}" height="${midH}" />
      </clipPath>
    </defs>
    <rect x="${midX}" y="${midY}" width="${midW}" height="${midH}" rx="8" class="main-node-rect" />
    <text x="${vW / 2}" y="${midY + midH / 2 + 4}" class="main-node-text" clip-path="url(#boxClip)">
        ${domainName}
    </text></svg>`;

    document.getElementById(containerId).innerHTML = svgStr;
}

</script>


