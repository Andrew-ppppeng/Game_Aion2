    <h2>questlog.gg<span> Visitors from AI Platforms</span><div class="a2a_kit a2a_default_style" style="float:right;">
    <a class="a2a_dd" href="https://www.addtoany.com/share">
        <span class="share-b"></span>
    </a>
</div></h2>
    <span>See which AI tools are talking about questlog.gg Check how questlog.gg ranks across today’s most popular AI platforms.</span>

    <div class="traffic_ai_wrapper">
        <div class="chart-side" id="ai_pie"></div>
        <div class="stats-side" id="ai_list"></div>
    </div>


<script>
    const ai_stats_json = '[{\"name\":\"ChatGPT\",\"visits\":96,\"share\":\"0.013%\",\"trend\":\"-84.15%\"},{\"name\":\"copilot.microsoft.com\",\"visits\":67,\"share\":\"0.009%\",\"trend\":\"-1.10%\"}]';
    const ai_trafficData = JSON.parse(ai_stats_json);
    const colorPalette = ["#3b82f6", "#10b981", "#8b5cf6", "#f59e0b", "#94a3b8"];
    const formatedAIdata = ai_trafficData.map((item, index) => ({
        n: item.name,
        v: item.visits,
        s: item.share,
        t: item.trend,
        c: colorPalette[index] || colorPalette[colorPalette.length - 1]
    }));

renderAITraffic(formatedAIdata);


 function renderAITraffic(data) {
    const nF = n => n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'K' : n;

    let offset = 0;
    let svg = `<svg class="traffic_ai_svg" viewBox="0 0 42 42">`;
    
    // Izračunavanje ukupnog broja poseta
    const total = data.reduce((s, i) => s + i.v, 0);

    // Selektori za elemente
    const listElement = document.getElementById('ai_list');
    const pieElement = document.getElementById('ai_pie');

    // Čišćenje prethodnog sadržaja pre novog iscrtavanja
    if (listElement) listElement.innerHTML = '';

    data.forEach(i => {
        const p = (i.v / total) * 100;
        
        // Generisanje SVG krugova
        svg += `<circle cx="21" cy="21" r="15.9" fill="transparent" stroke="${i.c}" stroke-width="8" stroke-dasharray="${p} ${100-p}" stroke-dashoffset="${-offset}"></circle>`;
        offset += p;

        // Popunjavanje liste podataka
        if (listElement) {
            listElement.innerHTML += `
                <div class="ai_row">
                    <div class="ai_head">
                        <div class="ai_dot" style="background:${i.c}"></div>
                        ${i.n} <span class="ai_vis">${nF(i.v)}</span>
                    </div>
                    <div class="ai_info">
                        <div class="ai_sub">
                            ${i.s} <span class="${i.t.includes('+') ? 'ai_up' : 'ai_down'}">${i.t}</span>
                        </div>
                    </div>
                </div>`;
        }
    });

    // Ubacivanje gotovog SVG-a u kontejner
    if (pieElement) {
        pieElement.innerHTML = svg + `</svg>`;
    }
}
    
</script>
