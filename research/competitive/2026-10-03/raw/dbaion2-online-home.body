19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></a></div></div></footer></div><script>
  (() => {
    const box = document.querySelector('.nebula-home .news-grid'); if (!box) return;
    const cards = [...box.querySelectorAll('.news-card')];
    document.querySelectorAll('.nebula-home [data-nf]').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.nf;
      document.querySelectorAll('.nebula-home [data-nf]').forEach((x) => { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      let shown = 0;
      for (const c of cards) {
        const ok = !v || c.dataset.src === v || c.dataset.tags.split('|').includes(v);
        c.hidden = !(ok && shown < 3); if (ok && shown < 3) shown++;
      }
    }));
  })();
</script><script>
  // firefly route = the lower arc of the design's ellipse (.hero:before: 690x515, top -242px, rotate -16deg),
  // cut where it meets the top edge of the hero, so it starts and ends exactly at the header on both sides
  (() => {
    const hero = document.querySelector('.nebula-home .hero'), ff = hero?.querySelector('.ff');
    if (!hero || !ff) return;
    const build = () => {
      // the ellipse is read from the arc itself (.hero::before), so the route follows it at every screen size
      const arc = getComputedStyle(hero, '::before');
      const a = (parseFloat(arc.width) || 690) / 2, b = (parseFloat(arc.height) || 515) / 2, top = parseFloat(arc.top) || -242;
      const W = hero.clientWidth, cx = W / 2, cy = top + b, th = (-16 * Math.PI) / 180;
      const pt = (t) => [cx + a * Math.cos(t) * Math.cos(th) - b * Math.sin(t) * Math.sin(th), cy + a * Math.cos(t) * Math.sin(th) + b * Math.sin(t) * Math.cos(th)];
      // walk the ellipse and keep the one run of points below the top edge, in order along the curve
      const N = 720, all = Array.from({ length: N }, (_, i) => pt((i / N) * 2 * Math.PI));
      const start = all.findIndex((p, i) => p[1] >= 0 && all[(i - 1 + N) % N][1] < 0);
      if (start < 0) return;
      const pts = [];
      for (let k = 0; k < N; k++) { const p = all[(start + k) % N]; if (p[1] < 0) break; pts.push(p); }
      if (pts[0][0] > pts[pts.length - 1][0]) pts.reverse();
      if (pts.length < 2) return;
      ff.style.offsetPath = "path('M " + pts.map((p) => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' L ') + "')";
    };
    build();
    addEventListener('resize', build);
  })();
</script><details class="seotext"><summary><span data-edit="seo-h">База данных AION 2</span></summary><div class="seobody"><p data-edit="seo-p1">DBAion2 — база данных AION 2 Global (Aion 2, Айон 2, Аион 2, aion2, Глобал): предметы, NPC и монстры, задания, навыки и стигмы, крафт, подземелья, титулы, питомцы и интерактивная карта мира. Всё собрано из клиента игры и обновляется вместе с патчем.</p><p data-edit="seo-p2">Здесь есть калькулятор навыков и стигм, калькулятор экипировки и характеристик, дерево Даэваниона и калькулятор крафта: соберите билд, посчитайте расход материалов и поделитесь ссылкой на сборку с легионом.</p><p data-edit="seo-p3">База знаний работает на русском и английском языках — переключатель RU / EN в правом верхнем углу. Ищите предмет, монстра, квест или навык через поиск по всей базе: он подсказывает совпадения прямо во время набора.</p><p class="seolinks"><a href="/items/">Предметы</a> · <a href="/npcs/">NPC и монстры</a> · <a href="/quests/">Задания</a> · <a href="/skills/">Навыки и стигмы</a> · <a href="/equip/">Экипировка</a> · <a href="/craft/">Крафт</a> · <a href="/dungeons/">Подземелья</a> · <a href="/map/">Карта</a> · <a href="/guides/">Гайды</a></p></div></details></main><div class="vctl"><div class="dd style-dd"><a class="icon-btn styleorb" href="#" aria-haspopup="true" aria-label="Стиль оформления" title="Стиль оформления"><span class="orb" aria-hidden="true"><i></i><i></i></span></a><ul class="pop"><li><a href="#" data-style="nebula"><span><span class="stsw" style="background:linear-gradient(135deg,#1a2350,#93baff)"></span>Nebula</span></a></li><li><a href="#" data-style="nebula-light"><span><span class="stsw" style="background:linear-gradient(135deg,#dfe8ff,#a8c6ff)"></span>Nebula Light</span></a></li></ul></div></div><footer class="legal"><div class="finner"><a class="fbrand brand-link" href="/" aria-label="Aion 2 — База данных"><span class="brand-symbol"><span class="brand-star"></span></span><span class="brand-wordmark"><strong>Aion 2</strong><em>БАЗА ДАННЫХ</em></span></a><nav class="flinks" aria-label="Дополнительно"><a href="/about/">О проекте</a><a href="/rules/">Правила</a><a href="/privacy/">Политика конфиденциальности</a><a href="/ads/" hidden>Реклама</a><a href="/contacts/">Контакты</a><a href="/support/">Поддержать проект</a><a href="/tooltips/">Подсказки для сайтов</a></nav><div class="fsocial"><span class="soc off" role="img" title="Discord — появится позже" aria-label="Discord"><svg class="icon discord-icon" aria-hidden="true" width="26" height="20" viewBox="0 0 64 48" fill="none" xmlns="http://www.w3.org/2000/svg">
