currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/equip/">Экипировка и характеристики</a></li><li><a href="/daevanion/">Даэванион</a></li><li><a href="/skills/">Навыки и стигмы</a></li><li><a href="/craft/">Крафт: расход материалов</a></li></ul></div><div class="navdd"><a href="/titles/" class="navitem"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg><span>Ещё</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/titles/">Титулы</a></li><li><a href="/tracker/">Трекер фарма и DPS-метр</a></li><li><a href="/timeline/">Расписание ивентов</a></li><li><a href="/promo/">Промокоды</a></li><li><a href="/checklist/">Чек-лист</a></li><li><a href="/guilds/">Гильдии</a></li><li><a href="/servers/">Серверы и техработы</a></li><li><a href="/site-news/">Новости сайта</a></li><li><a href="/contacts/">Контакты</a></li><li><a href="/support/">Поддержать проект</a></li></ul></div><a class="navlang" href="/en/" hreflang="en" title="English version">EN</a><div class="navlive" id="navlive" hidden data-on="в эфире" data-more="Стримерам: партнёрская программа →" data-more-href="/streamers/"><button type="button" class="navlive-btn" aria-haspopup="true"><img class="navlive-ava" alt="" width="22" height="22" referrerpolicy="no-referrer"><span class="navlive-name"></span><span class="navlive-on">Live</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div class="navlive-pop" role="menu"></div></div></nav></header><script>
// Live streamers (like questlog.gg): /api/live is our own cached list from the Twitch API (tools/live-server.mjs).
// Hidden when nobody is live; streams in the page language come first; refresh every 5 min while the tab is visible.
(() => {
  const box = document.getElementById('navlive');
  if (!box) return;
  const en = document.documentElement.lang === 'en';
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const sample = new URLSearchParams(location.search).has('livetest') ? { streams: [
    { login: 'maresco', name: 'Maresco', title: 'AION 2 Global — stream', lang: 'ru', viewers: 100, avatar: 'https://static-cdn.jtvnw.net/jtv_user_pictures/d1a14a9c-6255-4d83-869f-87464f156483-profile_image-300x300.png' } ] } : null;
  async function load() {
    if (document.hidden) return;
    let data = sample;
    if (!data) try { const r = await fetch('/api/live'); data = r.ok ? await r.json() : null; } catch { data = null; }
    const all = data?.streams ?? [];
    if (!all.length) { box.hidden = true; return; }
    const lang = en ? 'en' : 'ru';
    const list = [...all.filter((s) => s.lang === lang), ...all.filter((s) => s.lang !== lang)].slice(0, 12);
    const top = list[0];
    box.querySelector('.navlive-ava').src = top.avatar || '/favicon.svg';
    box.querySelector('.navlive-name').textContent = top.name;
    box.querySelector('.navlive-pop').innerHTML = list.map((s) => `<a class="navlive-item" role="menuitem" href="https://www.twitch.tv/${encodeURIComponent(s.login)}" target="_blank" rel="noopener nofollow" title="${esc(s.title)}">
      <img src="${esc(s.avatar || '/favicon.svg')}" alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer">
      <span><b>${esc(s.name)} ${esc(box.dataset.on)}<i></i></b><em>${esc(s.title)}</em><small>Aion 2 · ${esc(String(s.lang || '').toUpperCase())}</small></span></a>`).join('') + `<a class="navlive-more" href="${esc(box.dataset.moreHref)}">${esc(box.dataset.more)}</a>`;
    box.hidden = false;
  }
  load();
  setInterval(load, 300000);
  // a page opened in a background tab loads the list when it is first shown, not 5 min later
  document.addEventListener('visibilitychange', () => { if (!document.hidden && box.hidden) load(); });
})();
</script></div><section class="hero shell-native hero-min" style="--hero:url(/media/art/a11.webp);--heropos:center 30%"><div class="hero-in"><p class="eyebrow" data-edit="eyebrow">AION 2 · база данных</p><h1 data-edit="h1">AION 2</h1><p class="hsub" data-edit="hsub">База данных</p><p class="hlead" data-edit="lead">База данных AION 2 Global (Айон 2, aion2, DBAion2): предметы, NPC и монстры, навыки и стигмы, задания, крафт, подземелья, карта, калькуляторы экипировки и билдов. Данные из клиента игры, обновляются с патчем.</p><form class="hero-search" action="/search/" role="search"><svg class="mi" aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="q" id="hq3" placeholder="Название предмета, NPC, задания или навыка…" aria-label="Поиск по базе" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hsug3" aria-autocomplete="list"><button type="submit">Найти</button><ul class="hsug" id="hsug3" role="listbox" hidden></ul></form></div></section><main class="wrap page-body"><div class="nebula-home"><header class="topbar"><nav class="topnav" aria-label="Основная навигация"><div class="navdd"><a href="/items/" class="navitem"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg><span>Предметы</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/items/?g=weapon">Оружие</a><ul class="navpop2"><li><a href="/items/?g=weapon&amp;cat=GREATSWORD">Двуручный меч</a></li><li><a href="/items/?g=weapon&amp;cat=SWORD">Длинный меч</a></li><l