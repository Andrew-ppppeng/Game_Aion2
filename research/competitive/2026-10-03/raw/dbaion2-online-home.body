on(){const METRIKA = "112930113";

    // Yandex Metrika (only on the live domain, so local previews don't pollute stats)
    // counted on the main site and on the mirror (dbaion2.online, www too), each in its own counter; never on localhost
    const YM = location.hostname.endsWith('dbaion2.online') ? 112975960 : +METRIKA;
    if (/^(www\.)?dbaion2\.(ru|online)$/.test(location.hostname)) {
      window.ym = window.ym || function(){ (window.ym.a = window.ym.a || []).push(arguments); };
      let started = false;
      const startMetrika = () => {
        if (started) return;
        started = true;
        const s = document.createElement('script'); s.async = true;
        s.src = 'https://mc.yandex.ru/metrika/tag.js?id=' + METRIKA;
        document.head.append(s);
      };
      addEventListener('load', () => {
        if ('requestIdleCallback' in window) requestIdleCallback(startMetrika, { timeout: 3000 });
        else setTimeout(startMetrika, 2500);
      }, { once: true });
      for (const event of ['pointerdown', 'keydown']) addEventListener(event, startMetrika, { once: true, passive: true });
      // the mirror sends most visitors on to dbaion2.ru within ~1.5 s: load at once there, or its counter never sees them
      if (YM === 112975960) startMetrika();
      ym(YM, 'init', { ssr: true, webvisor: true, clickmap: true, referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
    }
    window.track = (goal, params) => { try { window.ym?.(YM, 'reachGoal', goal, params); } catch {} };
  })();</script><link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml"><link rel="icon" href="/favicon-96.png?v=3" sizes="96x96" type="image/png"><link rel="icon" href="/favicon-48.png?v=3" sizes="48x48" type="image/png"><link rel="icon" href="/favicon-192.png?v=3" sizes="192x192" type="image/png"><link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest"><!-- style choice key: siteStyle2 (23.09.2026 reset: everyone starts on Nebula once; the old siteStyle key is ignored) --><script>try { const s = localStorage.getItem('siteStyle2'); if (s && s !== 'native') document.documentElement.dataset.style = s; } catch {}</script><!-- ?embed=1: the page runs inside the character builder (an iframe) — only the page body is shown --><script>if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.classList.add('embed');</script><script>
    // dbaion2.ru registers /sw.js (opens the mirror when the main site is unreachable for a returning visitor);
    // the mirror dbaion2.online sends the visitor back to dbaion2.ru when it is reachable from here (faster in Russia), once per session
    (() => {
      const h = location.hostname;
      if (h === 'dbaion2.ru' && 'serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      if (!h.endsWith('dbaion2.online') || /[?&]stay/.test(location.search)) return;
      try { if (sessionStorage.getItem('mirrorChecked')) return; sessionStorage.setItem('mirrorChecked', '1'); } catch {}
      const img = new Image(), t = setTimeout(() => { img.onload = null; img.src = ''; }, 2500);
      // the mirror's own Metrika counter gets the visit (goal mirror_redirect) before the visitor leaves; 1.5 s at most
      img.onload = () => {
        clearTimeout(t);
        let gone = false;
        const go = () => { if (!gone) { gone = true; location.replace('https://dbaion2.ru' + location.pathname + location.search + location.hash); } };
        setTimeout(go, 1500);
        try { window.ym(112975960, 'reachGoal', 'mirror_redirect', {}, go); } catch { go(); }
      };
      img.src = 'https://dbaion2.ru/favicon-32.png?p=' + Date.now();
    })();
