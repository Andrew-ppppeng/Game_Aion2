"0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg><span>Карта</span></summary><a class="mitem" href="/map/">Все: карта</a><details class="msub"><summary class="mitem">Элийцы</summary><a class="mitem mitem2" href="/map/#verteron">Бертрон</a><a class="mitem mitem2" href="/map/#poeta">Фоэта</a><a class="mitem mitem2" href="/map/#eltnen">Элтенен</a></details><details class="msub"><summary class="mitem">Асмодиане</summary><a class="mitem mitem2" href="/map/#altgard">Альтгард</a><a class="mitem mitem2" href="/map/#ishalgen">Исхальген</a><a class="mitem mitem2" href="/map/#morheim">Морхейм</a></details><details class="msub"><summary class="mitem">Бездна</summary><a class="mitem mitem2" href="/map/#reshanta">Нижний уровень Арэшурата хаоса</a><a class="mitem mitem2" href="/map/#reshanta-mid">Средний уровень Арэшурата хаоса</a><a class="mitem mitem2" href="/map/#reshanta-top">Хаотичный верхний уровень Арэшурата</a></details></details><details class="mgroup"><summary><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/></svg><span>Калькулятор навыков</span></summary><a class="mitem" href="/skills/">Все: калькулятор навыков</a><a class="mitem" href="/skills/">Калькулятор навыков и стигм</a><a class="mitem" href="/classes/assassin/">Убийца</a><a class="mitem" href="/classes/chanter/">Чародей</a><a class="mitem" href="/classes/cleric/">Целитель</a><a class="mitem" href="/classes/elementalist/">Заклинатель</a><a class="mitem" href="/classes/fighter/">Мастер кулака</a><a class="mitem" href="/classes/gladiator/">Гладиатор</a><a class="mitem" href="/classes/ranger/">Стрелок</a><a class="mitem" href="/classes/sorcerer/">Волшебник</a><a class="mitem" href="/classes/templar/">Страж</a></details><a class="mgroup mgroup-link" href="/guides/"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg><span>Гайды</span></a><details class="mgroup"><summary><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg><span>Рейтинг игроков</span></summary><a class="mitem" href="/players/">Все: рейтинг игроков</a><a class="mitem" href="/armory/">Персонажи: экипировка и статы</a><a class="mitem" href="/ranking/">Рейтинг игроков</a><a class="mitem" href="/tierlist/">Тир-лист классов</a></details><details class="mgroup"><summary><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.4 1.4 0 0 0 0 2l1 1a1.4 1.4 0 0 0 2 0l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.3-.6-.6-2.3z"/></svg><span>Конструктор</span></summary><a class="mitem" href="/builder/">Все: конструктор</a><a class="mitem" href="/builder/">Сборки игроков</a><a class="mitem" href="/builder/b/?new=1">Создать сборку</a></details><details class="mgroup"><summary><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg><span>Калькуляторы</span></summary><a class="mitem" href="/equip/">Все: калькуляторы</a><a class="mitem" href="/equip/">Экипировка и характеристики</a><a class="mitem" href="/daevanion/">Даэванион</a><a class="mitem" href="/skills/">Навыки и стигмы</a><a class="mitem" href="/craft/">Крафт: расход материалов</a></details><details class="mgroup"><summary><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg><span>Ещё</span></summary><a class="mitem" href="/titles/">Все: ещё</a><a class="mitem" href="/titles/">Титулы</a><a class="mitem" href="/tracker/">Трекер фарма и DPS-метр</a><a class="mitem" href="/timeline/">Расписание ивентов</a><a class="mitem" href="/promo/">Промокоды</a><a class="mitem" href="/checklist/">Чек-лист</a><a class="mitem" href="/guilds/">Гильдии</a><a class="mitem" href="/servers/">Серверы и техработы</a><a class="mitem" href="/site-news/">Новости сайта</a><a class="mitem" href="/contacts/">Контакты</a><a class="mitem" href="/support/">Поддержать проект</a></details></aside></div><div class="mpop mpop-sheet" id="mSheet" hidden><div class="mpop__back" data-mclose></div><div class="msheet" role="dialog" aria-modal="true" aria-labelledby="mSheetTitle"><header><b id="mSheetTitle"></b><button type="button" data-mclose aria-label="Закрыть">×</button></header><div class="msheet__body" id="mSheetBody"></div></div></div><template id="mSheetCalc"><a class="mrow" href="/equip/">Экипировка и характеристики</a><a class="mrow" href="/daevanion/">Даэванион</a><a class="mrow" href="/skills/">Навыки и стигмы</a><a class="mrow" href="/craft/">Крафт: расход материалов</a></template><template id="mSheetStyle"><button type="button" class="mrow" data-mstyle="nebula"><i class="mradio"></i>Nebula</button><button type="button" class="mrow" data-mstyle="nebula-light"><i class="mradio"></i>Nebula Light</button></template><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>(function(){const TITLES = {"calc":"Калькуляторы","style":"Стиль оформления"};
const T = {"back":"Назад","filters":"Фильтры","filter":"Фильтр","sort":"Сортировка","reset":"Сбросить","show":"Применить"};

  (() => {
    const open = (el) => { el.hidden = false; requestAnimationFrame(() => el.classList.add('on')); document.documentElement.classList.add('mlock'); };
    const close = (el) => { el.classList.remove('on'); document.documentElement.classList.remove('mlock'); setTimeout(() => { if (!el.classList.contains('on')) el.hidden = true; }, 250); };
    const drawer = document.getElementById('mDrawer'), sheet = document.getElementById('mSheet');
    // shared bottom sheet: window.mSheet(title, nodeOrHtml) — pages reuse it for sorting and pickers
    window.mSheet = (title, content) => {
      document.getElementById('mSheetTitle').textContent = title;
      const body = document.getElementById('mSheetBody'); body.innerHTML = '';
      typeof content === 'string' ? (body.innerHTML = content) : body.append(content);
      if (!drawer.hidden) close(drawer);
      open(sheet);
    };
    window.mSheetClose = () => close(sheet);
    const markStyle = () => document.querySelectorAll('#mSheetBody [data-mstyle]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.mstyle === document.documentElement.dataset.style));
    document.addEventListener('click', (e) => {
      const s = e.target.closest('[data-msheet]');
      if (s) { e.preventDefault(); window.mSheet(TITLES[s.dataset.msheet], document.getElementById('mSheet' + s.dataset.msheet[0].toUpperCase() + s.dataset.msheet.slice(1)).content.cloneNode(true)); markStyle(); return; }
      if (e.target.closest('[data-mdrawer]')) { open(drawer); return; }
      if (e.target.closest('[data-mclose]')) { close(e.target.closest('.mpop')); return; }
      const st = e.target.closest('[data-mstyle]');
      if (st) { document.documentElement.dataset.style = st.dataset.mstyle; try { localStorage.setItem('siteStyle2', st.dataset.mstyle); } catch {} markStyle(); setTimeout(() => close(sheet), 150); }
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll('.mpop.on').forEach(close); });

    // catalog pages (.gmain with a filter panel and a toolbar): on phones the panel becomes a full-screen layer and the
    // toolbar gets «Сортировка» (bottom sheet from the page's own <select>) and «Фильтр». Pages that already have
    // these buttons (#mFilter, the items catalog) are left alone.
    const gm = document.querySelector('.gmain'), fp = gm?.querySelector('.fpanel'), tb = gm?.querySelector('.toolbar');
    // phones: a card in a catalog opens its own page (the side card of the desktop layout is hidden there)
    gm?.addEventListener('click', (e) => {
      const c = e.target.closest('.icard[data-id]');
      if (!c || !matchMedia('(max-width: 768px)').matches || c.tagName === 'A') return;
      e.stopImmediatePropagation();
      location.href = location.pathname.replace(/(list\/\d+\/)?$/, '') + c.dataset.id + '/';
    }, true);
    if (!gm || !fp || !tb || document.getElementById('mFilter')) return;
    const sel = tb.querySelector('select') ?? fp.querySelector('select#sort'), reset = fp.querySelector('#reset, [data-reset]');
    const ic = (d) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="${d}"/></svg>`;
    fp.insertAdjacentHTML('afterbegin', `<div class="mf-head"><button type="button" data-mfclose aria-label="${T.back}">←</button><b>${T.filters}</b></div>`);
    fp.insertAdjacentHTML('beforeend', `<div class="mf-foot">${reset ? `<button type="button" class="mf-reset" id="mfReset">${T.reset}</button>` : ''}<button type="button" class="mf-apply" data-mfclose>${T.show}</button></div>`);
    tb.insertAdjacentHTML('afterbegin', (sel ? `<button type="button" class="mtool" id="mSort">${ic('M4 6h10M4 12h7M4 18h4M17 5v14M14 16l3 3 3-3')}${T.sort}</button>` : '')
      + `<button type="button" class="mtool" id="mFilter">${ic('M4 6h16M7 12h10M10 18h4')}${T.filter}</button>`);
    const mFilter = (on) => { fp.classList.toggle('mopen', on); document.documentElement.classList.toggle('mlock', on); };
    document.getElementById('mFilter').addEventListener('click', () => mFilter(true));
    fp.addEventListener('click', (e) => { if (e.target.closest('[data-mfclose]')) mFilter(false); });
    document.getElementById('mfReset')?.addEventListener('click', () => reset.click());
    document.getElementById('mSort')?.addEventListener('click', () => {
      const box = document.createElement('div');
      box.innerHTML = [...sel.options].map((o) => `<button type="button" class="mrow" data-v="${o.value}" aria-pressed="${o.value === sel.value}"><i class="mradio"></i>${o.text.replace(/</g, '&lt;')}</button>`).join('');
      box.onclick = (e) => { const b = e.target.closest('[data-v]'); if (!b) return; sel.value = b.dataset.v; sel.dispatchEvent(new Event('change', { bubbles: true })); window.mSheetClose(); };
      window.mSheet(T.sort, box);
    });
  })();
})();</script><script>(function(){const TIP_LV = "ур. предмета";
const TIP_REQ = "треб. ур.";
const TIP_DIR = "/data";
const EDIT_HINT = "Режим правки: кликните текст, измените, щёлкните мимо";
const EDIT_SAVED = "Сохранено";
const EDIT_FAIL = "Не сохранено: ";

  // item hover card: any link to an item page (or [data-tip="<id>"]) shows its stats on hover.
  // One small file per item (tools/build-tips.mjs), fetched once and kept in memory.
  (() => {
    const cache = new Map();
    let box = null, over = null, timer = 0;
    const idOf = (el) => el.dataset?.tip ?? (el.getAttribute('href') || '').match(/\/items\/(\d+)\//)?.[1];
    const esc = (t) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const num = (v) => v.toLocaleString(document.documentElement.lang === 'en' ? 'en-US' : 'ru-RU');
    const load = async (id) => {
      if (!cache.has(id)) cache.set(id, fetch(TIP_DIR + '/tip/' + id + '.json').then((r) => (r.ok ? r.json() : null)).catch(() => null));
      return cache.get(id);
    };
    const html = (t) => `<b class="g-${esc(t.g)}">${esc(t.n)}</b>
      <i>${esc(t.cat)}${t.lv ? ' · ' + TIP_LV + ' ' + t.lv : ''}${t.req ? ' · ' + TIP_REQ + ' ' + t.req : ''}</i>
      ${t.main.length ? '<dl>' + t.main.map(([n, v]) => `<dt>${esc(n)}</dt><dd>${num(v)}</dd>`).join('') + '</dl>' : ''}
      ${t.sub.length ? '<dl class="sub">' + t.sub.map(([n, a, b]) => `<dt>${esc(n)}</dt><dd>${a === b ? num(a) : num(a) + '–' + num(b)}</dd>`).join('') + '</dl>' : ''}
      ${t.d ? '<p>' + esc(t.d) + '</p>' : ''}`;
    const place = (el) => {
      const r = el.getBoundingClientRect(), w = box.offsetWidth, h = box.offsetHeight;
      let x = r.right + 12, y = r.top;
      if (x + w > innerWidth - 8) x = Math.max(8, r.left - w - 12);
      if (y + h > innerHeight - 8) y = Math.max(8, innerHeight - h - 8);
      box.style.left = x + 'px'; box.style.top = y + 'px';
    };
    const show = async (el, id) => {
      const t = await load(id);
      if (!t || over !== el) return;
      box ??= Object.assign(document.createElement('div'), { className: 'itip' });
      box.innerHTML = html(t);
      if (!box.isConnected) document.body.append(box);
      box.hidden = false; place(el);
    };
    const hide = () => { over = null; clearTimeout(timer); if (box) box.hidden = true; };
    document.addEventListener('mouseover', (e) => {
      const el = e.target.closest('a[href*="/items/"], [data-tip]');
      // pages with their own item tooltip (armory: the character's actual item) opt out with data-notip
      if (!el || el === over || el.closest('[data-notip]')) return;
      const id = idOf(el); if (!id) return;
      over = el; clearTimeout(timer);
      timer = setTimeout(() => show(el, id), 180);
    });
    document.addEventListener('mouseout', (e) => { if (over && !over.contains(e.relatedTarget)) hide(); });
    addEventListener('scroll', hide, { passive: true });
  })();
  // touch: first tap on a menu item with a dropdown opens it (second tap navigates); opening one closes every other open menu
  document.querySelectorAll('.nav .dd > a, .nav .dd2 > a').forEach((a) => a.addEventListener('click', (e) => {
    if (!matchMedia('(hover: none)').matches) return;
    const li = a.parentElement; if (li.classList.contains('open')) return;
    e.preventDefault();
    document.querySelectorAll('.nav .open').forEach((x) => { if (!x.contains(li)) x.classList.remove('open'); });
    li.classList.add('open');
  }));
  // style switcher: apply + remember
  const markStyle = () => document.querySelectorAll('[data-style]').forEach((a) => a.tagName === 'A' && a.setAttribute('aria-current', a.dataset.style === document.documentElement.dataset.style));
  markStyle();
  document.querySelectorAll('.style-dd .pop a').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); document.documentElement.dataset.style = a.dataset.style;
    try { localStorage.setItem('siteStyle2', a.dataset.style); } catch {}
    markStyle(); a.closest('.dd').classList.remove('open'); a.blur();
  }));
  document.addEventListener('click', (e) => { if (!e.target.closest('.nav')) document.querySelectorAll('.nav .open').forEach((x) => x.classList.remove('open')); });
  document.querySelector('.vctl .style-dd > a')?.addEventListener('click', (e) => { e.preventDefault(); e.currentTarget.parentElement.classList.toggle('open'); });
  document.addEventListener('click', (e) => { if (!e.target.closest('.vctl')) document.querySelector('.vctl .style-dd')?.classList.remove('open'); });
  // editable texts: every [data-edit] can be overridden without a rebuild (tools/content-server.mjs).
  // Editing is switched on at /admin/ — the code is typed there and never travels in a URL or lives in this code.
  (async () => {
    const slots = [...document.querySelectorAll('[data-edit]')];
    let token = ''; try { token = localStorage.getItem('aion2admin') ?? ''; } catch {}
    if (!slots.length) return;
    const key = (el) => location.pathname + '|' + el.dataset.edit;
    for (const el of slots) el.dataset.orig = el.textContent.trim();
    let data = {};
    try { data = await (await fetch('/api/content')).json(); } catch {}
    for (const el of slots) { const v = data[key(el)]; if (v && v !== el.textContent.trim()) el.textContent = v; }
    if (!token) return;
    document.body.classList.add('editmode');
    const note = document.createElement('div'); note.className = 'editnote'; note.textContent = EDIT_HINT;
    document.body.append(note);
    for (const el of slots) {
      el.contentEditable = 'true'; el.spellcheck = false;
      el.addEventListener('keydown', (e) => { if (e.key === 'Escape') { el.textContent = data[key(el)] ?? el.dataset.orig; el.blur(); } });
      el.addEventListener('blur', async () => {
        const text = el.textContent.trim();
        if (text === (data[key(el)] ?? el.dataset.orig)) return;
        // empty text means "back to the built-in wording"
        const body = { key: key(el), text: text === el.dataset.orig ? '' : text };
        try {
          const r = await fetch('/api/content', { method: 'PUT', headers: { 'content-type': 'application/json', 'x-admin-token': token }, body: JSON.stringify(body) });
          if (!r.ok) throw new Error(r.status);
          if (body.text) data[body.key] = body.text; else { delete data[body.key]; el.textContent = el.dataset.orig; }
          note.textContent = EDIT_SAVED; setTimeout(() => { note.textContent = EDIT_HINT; }, 1500);
        } catch (e) {
          note.textContent = EDIT_FAIL + e.message;
          el.textContent = data[key(el)] ?? el.dataset.orig;
        }
      });
    }
  })();
  // header search: item suggestions while typing (data/lookup.json, loaded on first focus); Enter without a pick = full search
  (() => {
    // this layout is shared by RU and /en/ pages: take names and links from the page's language
    const LP = location.pathname.startsWith('/en/') ? '/en' : '';
    for (const [qid, bid] of [['hq', 'hsug'], ['hq3', 'hsug3']]) bind(qid, bid);
    function bind(qid, bid) {
    const qi = document.getElementById(qid), box = document.getElementById(bid); if (!qi) return;
    let items = null;
    let hits = [], act = -1;
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const load = () => items ??= fetch(LP ? '/data-en/lookup.json' : '/data/lookup.json').then((r) => r.json()).then((l) => {
      const seen = new Set(), out = [];
      for (const [id, [n, ic, g]] of Object.entries(l.items)) if (n && !seen.has(n + g)) { seen.add(n + g); out.push([id, n, n.toLowerCase(), ic, g]); }
      return out;
    }).catch(() => []);
    const close = () => { box.hidden = true; qi.setAttribute('aria-expanded', 'false'); act = -1; };
    qi.addEventListener('focus', load, { once: true });
    qi.addEventListener('input', async () => {
      const q = qi.value.trim().toLowerCase(), all = await load();
      if (q !== qi.value.trim().toLowerCase()) return;
      hits = q.length < 2 ? [] : all.filter((x) => x[2].includes(q)).sort((a, b) => a[2].indexOf(q) - b[2].indexOf(q) || a[1].length - b[1].length).slice(0, 10);
      act = -1;
      box.innerHTML = hits.map(([id, n, , ic, g], k) => `<li role="option" id="${qid}s${k}"><a class="g-${g}" href="${LP}/items/${id}/">${ic ? `<img src="${'/icons/' + ic + '.webp'}" alt="" width="28" height="28">` : ''}<span>${esc(n)}</span></a></li>`).join('');
      box.hidden = !hits.length; qi.setAttribute('aria-expanded', String(!!hits.length));
    });
    qi.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); act = (act + (e.key === 'ArrowDown' ? 1 : -1) + hits.length) % hits.length; }
      else if (e.key === 'Enter' && act >= 0) { e.preventDefault(); window.track?.('search_pick', { q: qi.value }); location.href = LP + '/items/' + hits[act][0] + '/'; return; }
      else if (e.key === 'Escape') return close();
      else return;
      box.querySelectorAll('li').forEach((li, k) => li.classList.toggle('act', k === act)); qi.setAttribute('aria-activedescendant', act >= 0 ? qid + 's' + act : '');
    });
    qi.addEventListener('blur', () => setTimeout(close, 150));
    box.addEventListener('mousedown', () => window.track?.('search_pick', { q: qi.value }));
    qi.form.addEventListener('submit', () => window.track?.('search', { q: qi.value }));
    }
  })();
})();</script></body></html>