<!-- ====================================================
     메인 팝업 광고 (베나투스 캠페인 릴레이) - 시간대 기반 자동 전환
     - CAMPAIGNS 배열 순서대로 KST 시각을 검사하여 매칭되는 첫 캠페인 노출
     ==================================================== -->
<style>
  /* 1400~2559px 구간에서 html { zoom: 0.75 } 가 적용되어 팝업이 0.75배로 축소되는 문제 보정
     (base.html 의 fullscreen-loading-overlay / site-header / stat-info-modal 과 동일한 패턴) */
  @media (min-width: 1400px) and (max-width: 2559px) {
    #ad-popup-overlay,
    #ad-popup-wrap {
      zoom: 1.3333 !important; /* 1 / 0.75 = 1.3333 → 원래 크기로 복원 */
    }
  }
</style>
<div id="ad-popup-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:99998;"></div>
<div id="ad-popup-wrap" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:99999; border-radius:8px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,0.6);">
  <a id="ad-popup-link" href="#" target="_blank" rel="noopener noreferrer" style="display:block;">
    <img id="ad-popup-img" src="" alt="팝업 광고" style="display:block; width:100%; height:auto;" />
  </a>
  <div style="display:flex; background:#fff; border-top:1px solid #ddd;">
    <button id="ad-popup-no-today" style="flex:1; padding:14px 0; border:none; border-right:1px solid #ddd; background:#fff; color:#555; font-size:0.92rem; cursor:pointer;">오늘 다시 보지 않기</button>
    <button id="ad-popup-close" style="flex:1; padding:14px 0; border:none; background:#fff; color:#222; font-size:0.92rem; font-weight:600; cursor:pointer;">닫기</button>
  </div>
</div>

<script>
(function () {
  /* ============================================================
   *  [팝업 광고 캠페인 설정] - 한국 시간(KST, UTC+9) 기준
   *  - 형식: 'YYYY-MM-DDTHH:mm:ss'  (24시간제, KST 기준)
   *  - end 는 '미만(<)' 비교 → 종료 시각 직전까지 노출
   *  - 새 캠페인 추가 시: 아래 CAMPAIGNS 배열에 객체를 push 하면 됨
   * ============================================================ */
  var CAMPAIGNS = [
    /* 디아블로 IV 사전구매 (4/25 00:00 ~ 4/28 07:59:59 KST) */
    {
      eventId:    'diablo4_lord_of_hatred',
      startKst:   '2026-04-25T00:00:00',
      endKst:     '2026-04-28T08:00:00',
