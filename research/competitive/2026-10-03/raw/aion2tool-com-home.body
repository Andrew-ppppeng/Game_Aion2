                <!-- 데바니온 아리엘 보드 시뮬레이션 섹션 -->
                <div class="simulation-daevanion-section" style="margin-bottom: 1.5rem;">
                  <div class="skill-category-card">
                    <div class="skill-category-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem;">
                      <div style="flex: 1; min-width: 150px;">
                        <span>데바니온 - 아리엘 보드</span>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                          공격력: <span id="sim-ariel-attack" style="color: #4ade80;">+0</span>,
                          피해 증폭: <span id="sim-ariel-damage-amp" style="color: #60a5fa;">+0%</span>,
                          PVE 명중: <span id="sim-ariel-pve-accuracy" style="color: #fbbf24;">+0</span><span id="sim-ariel-extra-stats"></span>
                        </div>
                      </div>
                      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.8rem;">
                        <span style="color: var(--text-muted);">결정: <span id="sim-ariel-total-invested" style="color: #a78bfa; font-weight: 600;">0</span></span>
                        <button onclick="resetArielBoardAll()" style="padding: 0.25rem 0.5rem; background: rgba(248, 113, 113, 0.2); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 4px; color: #f87171; font-size: 0.7rem; cursor: pointer;">초기화</button>
                        <button onclick="resetArielBoardToOriginal()" style="padding: 0.25rem 0.5rem; background: rgba(96, 165, 250, 0.2); border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 4px; color: #60a5fa; font-size: 0.7rem; cursor: pointer;">리셋</button>
                      </div>
                    </div>
                    <div id="sim-ariel-crystal-cost" style="display: none; margin-top: 0.5rem; padding: 0.4rem 0.6rem; background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 6px; font-size: 0.8rem;">
                      <span id="sim-ariel-crystal-label" style="color: #facc15;">💎 결정 변화:</span>
                      <span id="sim-ariel-crystal-count" style="color: #facc15; font-weight: 700;">0</span>
                      <span style="color: var(--text-muted); margin-left: 0.3rem; font-size: 0.75rem;">
                        (<span id="sim-ariel-crystal-breakdown" style="color: var(--text-muted);"></span>)
                      </span>
                    </div>
                    <div id="sim-ariel-board-container" style="margin-top: 0.75rem; overflow-x: auto;"></div>
                    <div style="text-align: center; margin-top: 0.75rem; padding: 0.5rem; background: rgba(255, 193, 7, 0.08); border-radius: 6px; font-size: 0.8rem; color: #fbbf24;">
                      💡 노드를 클릭하여 활성화/비활성화할 수 있습니다
                    </div>
                  </div>
                </div>
                
                <!-- 데바니온 마르쿠탄 보드 시뮬레이션 섹션 -->
                <div class="simulation-daevanion-section" style="margin-bottom: 1.5rem;">
                  <div class="skill-category-card">
                    <div class="skill-category-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem;">
                      <div style="flex: 1; min-width: 150px;">
                        <span>데바니온 - 마르쿠탄 보드</span>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                          추가 공격력: <span id="sim-markutan-attack" style="color: #4ade80;">+0</span>,
                          무기 피해 증폭: <span id="sim-markutan-weapon-amp" style="color: #60a5fa;">+0%</span>,
                          치명타: <span id="sim-markutan-critical" style="color: #f87171;">+0</span>,
                          추가 명중: <span id="sim-markutan-accuracy" style="color: #fbbf24;">+0</span><span id="sim-markutan-extra-stats"></span>
                        </div>
                      </div>
                      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.8rem;">
                        <span style="color: var(--text-muted);">결정: <span id="sim-markutan-total-invested" style="color: #a78bfa; font-weight: 600;">0</span></span>
                        <button onclick="resetMarkutanBoardAll()" style="padding: 0.25rem 0.5rem; background: rgba(248, 113, 113, 0.2); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 4px; color: #f87171; font-size: 0.7rem; cursor: pointer;">초기화</button>
                        <button onclick="resetMarkutanBoardToOriginal()" style="padding: 0.25rem 0.5rem; background: rgba(96, 165, 250, 0.2); border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 4px; color: #60a5fa; font-size: 0.7rem; cursor: pointer;">리셋</button>
                      </div>
                    </div>
                    <div id="sim-markutan-crystal-cost" style="display: none; margin-top: 0.5rem; padding: 0.4rem 0.6rem; background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 6px; font-size: 0.8rem;">
                      <span id="sim-markutan-crystal-label" style="color: #facc15;">💎 결정 변화:</span>
                      <span id="sim-markutan-crystal-count" style="color: #facc15; font-weight: 700;">0</span>
                      <span style="color: var(--text-muted); margin-left: 0.3rem; font-size: 0.75rem;">
                        (<span id="sim-markutan-crystal-breakdown" style="color: var(--text-muted);"></span>)
                      </span>
                    </div>
                    <div id="sim-markutan-board-container" style="margin-top: 0.75rem; overflow-x: auto;"></div>
                    <div style="text-align: center; margin-top: 0.75rem; padding: 0.5rem; background: rgba(255, 193, 7, 0.08); border-radius: 6px; font-size: 0.8rem; color: #fbbf24;">
                      💡 노드를 클릭하여 활성화/비활성화할 수 있습니다
                    </div>
                  </div>
                </div>
                
                <!-- 안내 문구 -->
                <div style="text-align: center; padding: 1rem; background: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.25); border-radius: 10px; font-size: 0.85rem; color: #fbbf24;">
                  ⚠️ 시뮬레이션은 클라이언트에서만 계산되며, 실제 데이터는 변경되지 않습니다.
                </div>
              </div>
            </div>
            
            <!-- 스펙업 추천 탭 패널 -->
            <div class="character-tab-card character-tab-panel" id="panel-spec-up" style="display: none;">
              <div id="specup-content" style="min-height: 400px; width: 100%; max-width: 100%; overflow-x: hidden;">
                <!-- 주의사항 -->
                <div style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px;">
                  <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
                    <span style="color: #10b981; font-size: 1rem;">💡</span>
                    <div style="font-size: 0.8rem; color: #10b981; line-height: 1.5;">
                      <strong>스펙업 추천:</strong> 각 스탯이 기여하는 전투력을 계산하여 스펙업 우선순위를 제안합니다. <strong style="font-weight: bold;">전투력 공식을 역산한 추정치이며, 계산에 포함되지 않는 스탯들도 있으니,</strong> 참고용으로 활용하세요.
                    </div>
                  </div>
                </div>
                <!-- 섹션 전환 버튼 -->
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;">
                  <button id="specup-btn-magic-stone" onclick="switchSpecupSection('magic-stone')"
                    style="padding:0.4rem 1rem;border-radius:6px;border:1px solid rgba(167,139,250,0.5);background:rgba(167,139,250,0.2);color:#a78bfa;font-size:0.85rem;font-weight:700;cursor:pointer;transition:all 0.2s;">마석 각인</button>
                  <button id="specup-btn-breakthrough" onclick="switchSpecupSection('breakthrough')"
                    style="padding:0.4rem 1rem;border-radius:6px;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.04);color:var(--text-muted);font-size:0.85rem;font-weight:700;cursor:pointer;transition:all 0.2s;">돌파</button>
