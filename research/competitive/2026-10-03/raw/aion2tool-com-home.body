8fc", "platform": "chzzk", "profile_image_url": null, "race": "\ub9c8\uc871", "server": "\uc774\uc2a4\ub77c\ud3a0", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "a7e175625fdea5a7d98428302b7aa57f", "character_guild": "", "character_job": "\uc815\ub839\uc131", "character_level": 45, "character_nickname": "\ud0ec\ud0ec\ubc84\ub9b0 (\ud0ec\ud0ec\ubcbc\ub9b0)", "combat_power": 0, "display_name": "\ud0ec\ud0ec\ubc84\ub9b0 (\ud0ec\ud0ec\ubcbc\ub9b0)", "id": 14, "is_active": true, "is_live": false, "name": "\ud0ec\ud0ec\ubc84\ub9b0", "platform": "chzzk", "profile_image_url": null, "race": "\ub9c8\uc871", "server": "\uc774\uc2a4\ub77c\ud3a0", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "moonwol0614", "character_guild": "", "character_job": "\uac80\uc131", "character_level": 45, "character_nickname": "\ubb38\uc6d4 (\ubb38\uac80\uc6d4\uc131)", "combat_power": 0, "display_name": "\ubb38\uc6d4 (\ubb38\uac80\uc6d4\uc131)", "id": 15, "is_active": true, "is_live": false, "name": "\ubb38\uc6d4", "platform": "soop", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\uc2dc\uc5d8", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "ioioiobb", "character_guild": "\uc232", "character_job": "\uad81\uc131", "character_level": 45, "character_nickname": "\uc815\uc724\uc885 (\ub300\ud45c)", "combat_power": 0, "display_name": "\uc815\uc724\uc885 (\ub300\ud45c)", "id": 16, "is_active": true, "is_live": false, "name": "\uc815\uc724\uc885", "platform": "soop", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\uc2dc\uc5d8", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "zkwks4413", "character_guild": "\uc6a9", "character_job": "\uac80\uc131", "character_level": 45, "character_nickname": "\uafc0\ud0f1\ud0f1 (\uc0ad)", "combat_power": 0, "display_name": "\uafc0\ud0f1\ud0f1 (\uc0ad)", "id": 17, "is_active": true, "is_live": false, "name": "\uafc0\ud0f1\ud0f1", "platform": "soop", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\uc2dc\uc5d8", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "da8a48c948f8fa1048eda60e568b3178", "character_guild": "\ubb34\ub8cc\uae09\uc2dd\uc18c", "character_job": "\uc218\ud638\uc131", "character_level": 45, "character_nickname": "\uae40\ubc30\ub9c8 (\uae40\ubc30\ub9c8)", "combat_power": 0, "display_name": "\uae40\ubc30\ub9c8 (\uae40\ubc30\ub9c8)", "id": 18, "is_active": true, "is_live": false, "name": "\uae40\ubc30\ub9c8", "platform": "chzzk", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\ub124\uc790\uce78", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "aa6232", "character_guild": "\uc6a9", "character_job": "\uce58\uc720\uc131", "character_level": 45, "character_nickname": "\uc950\ub3cc\uc774\uc950\ub3cc\uc774 (\uc950)", "combat_power": 0, "display_name": "\uc950\ub3cc\uc774\uc950\ub3cc\uc774 (\uc950)", "id": 19, "is_active": true, "is_live": false, "name": "\uc950\ub3cc\uc774\uc950\ub3cc\uc774", "platform": "soop", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\uc2dc\uc5d8", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}, {"channel_id": "larothy", "character_guild": "\uc232", "character_job": "\uce58\uc720\uc131", "character_level": 45, "character_nickname": "\ub77c\ub85c\uc2dc (\ub85c\uc2dc)", "combat_power": 0, "display_name": "\ub77c\ub85c\uc2dc (\ub85c\uc2dc)", "id": 20, "is_active": true, "is_live": false, "name": "\ub77c\ub85c\uc2dc", "platform": "soop", "profile_image_url": null, "race": "\ucc9c\uc871", "server": "\uc2dc\uc5d8", "stream_title": null, "thumbnail_url": null, "updated_at": "2026-10-02T17:22:11", "viewer_count": 0}], "last_updated": "2026-10-03T02:34:10.224782+09:00", "success": true}};
  
  // 서버 사이드 데이터가 있으면 즉시 렌더링, 없는 항목은 API 폴백
  // 우측 배너는 '아티팩트 현황' 위젯으로 바뀌었다. 홈 캐시(server_stats)는 이 위젯의
  // 데이터 소스가 아니므로, 캐시 유무와 무관하게 항상 위젯을 로드한다.
  initHomeReportModal();
  setTimeout(() => { loadServerStats(); loadHomeBoard(); loadHomePop(); }, 100);
  // 스트리머 섹션은 종합 서버 순위 보드로 대체됐다 (렌더 대상 DOM 없음)
  if (serverSideCacheData.aion2_updates) {
    renderAion2Updates(serverSideCacheData.aion2_updates);
  } else {
    setTimeout(() => { loadAion2Updates(); }, 100);
  }
  if (serverSideCacheData.power_top5) {
    loadIngamePowerTop5();
  } else {
    loadPowerTop5WithSavedMode();
  }
  if (serverSideCacheData.daily_search_ranking) {
    renderDailySearchRanking(serverSideCacheData.daily_search_ranking);
  } else {
    setTimeout(() => { loadDailySearchRanking(); }, 100);
  }
  

  
  setTimeout(() => { loadHomePopulationWidget(); }, 100);
  
  
  // 페이지 로드 시 URL 파라미터가 있으면 즉시 로딩 표시
  (function() {
    const path = window.location.pathname;
    const charMatch = path.match(/^(?:\/zh-tw|\/global)?\/char\/serverid=(\d+)\/(.+)$/);
    const urlParams = new URLSearchParams(window.location.search);
    const hasNicknameParam = urlParams.get('nickname');
    
    if (charMatch || hasNicknameParam) {
      // DOM이 로드되기 전이므로 즉시 표시
      lockLoadingOverlay();
      const characterLoading = document.getElementById('character-loading');
      if (characterLoading) {
        characterLoading.style.display = 'block';
      }
    }
  })();
  
  // URL 파라미터에서 캐릭터 정보 읽기
  loadCharacterFromUrlParams();
  startEventCountdowns();
  
  // 공지사항 NEW 뱃지: 공지 날짜 기준 2일까지만 유지한다.
  // (예전엔 항목마다 data-new-badge-expires-at 을 손으로 적었는데 7일씩 적혀 있어 오래 남았다.
  //  이제는 .announcement-date 에서 자동 계산하므로 새 공지에 속성을 안 적어도 된다.
  //  속성이 있고 그게 더 이르면 그쪽을 쓴다 = 뱃지는 절대 2일을 넘지 않는다.)
  const NEW_BADGE_DAYS = 2;
  (function pruneExpiredNewBadges() {
    const nowTs = Date.now();
    document.querySelectorAll('.announcement-item').forEach(item => {
      let expiresTs = NaN;

      // 1) 공지 날짜(YYYY-MM-DD, KST) + 2일 00:00 → 공지 당일과 다음 날까지만 표시
      const dateStr = (item.querySelector('.announcement-date')?.textContent || '').trim();
      const m = dateStr.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (m) {
        // KST(+09:00) 자정 기준으로 고정 — 보는 사람 타임존에 따라 하루씩 밀리지 않게
        const startTs = Date.parse(`${m[1]}-${m[2]}-${m[3]}T00:00:00+09:00`);
        if (!isNaN(startTs)) expiresTs = startTs + NEW_BADGE_DAYS * 86400000;
      }

      // 2) 명시적 만료 시각이 더 이르면 그걸 따른다 (일부러 짧게 잡아 둔 공지)
      const attrTs = Date.parse(item.getAttribute('data-new-badge-expires-at') || '');
      if (!isNaN(attrTs) && (isNaN(expiresTs) || attrTs < expiresTs)) expiresTs = attrTs;

      if (!isNaN(expiresTs) && nowTs >= expiresTs) {
        item.querySelectorAll('[data-role="new-badge"]').forEach(badge => badge.remove());
      }
    });
  })();

  // 공지사항 아코디언 기능
  const announcementItems = document.querySelectorAll('.announcement-item');
  
  announcementItems.forEach(item => {
    const header = item.querySelector('.announcement-header');
    header.addEventListener('click', function() {
      const isActive = item.classList.contains('active');
      
      // 다른 항목들 닫기
      announcementItems.forEach(otherItem => {
        if (otherItem !== item) {
          otherItem.classList.remove('active');
        }
      });
      
      // 현재 항목 토글
      if (isActive) {
        item.classList.remove('active');
      } else {
        item.classList.add('active');
      }
    });
  });
  
  // 탭 변경 이벤트 리스너
  const tabCharacter = document.getElementById('tab-character');
  const tabRanking = document.getElementById('tab-ranking');
  const tabStatistics = document.getElementById('tab-statistics');
  const tabRegion = document.getElementById('tab-region');
  
  // 탭 변경 시 맨 위로 스크롤하는 함수
  function scrollToTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  
  // 캐릭터 검색 결과 숨기는 공통 함수
  function hideCharacterResult() {
    const characterResult = document.getElementById('character-result');
    if (characterResult) {
      characterResult.style.display = 'none';
    }
    const mainLayout = document.querySelector('.main-layout');
    if (mainLayout) {
      mainLayout.classList.remove('show-character-result');
    }
    // 검색결과가 숨겨졌으면 그 안의 광고(비디오 slot-5 포함)를 즉시 remove.
    // 호출부마다 updateSidebarVisibility()를 붙이는 데 의존하면 한 곳만 빠져도 비디오가 안 보이는 채로 계속 재생된다.
    if (typeof __lazySlotSync === 'function') {
      __lazySlotSync('slot-3'); __lazySlotSync('slot-5'); __lazySlotSync('slot-17');
    }
  }
  
  if (tabCharacter) {
    tabCharacter.addEventListener('change', function() {
      if (tabCharacter.checked) {
        // URL 업데이트
        updateURL('character', false);
      }
      updateSidebarVisibility();
      scrollToTop();
    });
  }
  if (tabRanking) {
    tabRanking.addEventListener('change', function() {
      if (tabRanking.checked) {
        // 캐릭터 검색 결과 숨김
        hideCharacterResult();
        // URL 업데이트 (캐릭터 검색 URL 제거, pathname도 정리)
        updateURL('ranking', false, true);
      }
      updateSidebarVisibility();
      scrollToTop();
      // 랭킹 탭이 선택되면 필터 초기화 및 랭킹 로드
      if (tabRanking.checked) {
        initializeRankingFilters(); // 내부에서 loadRanking과 setupRankingInfiniteScroll 호출
        setupRankingSubTabs();
      }
    });
  }
  if (tabStatistics) {
    tabStatistics.addEventListener('change', function() {
      if (tabStatistics.checked) {
        // 캐릭터 검색 결과 숨김
        hideCharacterResult();
        // URL 업데이트 (캐릭터 검색 URL 제거, pathname도 정리, 기본적으로 인구수 통계로 설정)
        updateURL('statistics/population', false, true);
      }
      updateSidebarVisibility();
      scrollToTop();
      // setupStatisticsSubTabs만 호출 (데이터 로드는 DOMContentLoaded에서 처리)
      setupStatisticsSubTabs();
    });
  }
  if (tabRegion) {
    tabRegion.addEventListener('change', function() {
      if (tabRegion.checked) {
        hideCharacterResult();
        updateURL('region', false, true);
      }
      updateSidebarVisibility();
      scrollToTop();
      // 레기온 탭이 선택되면 필터 초기화 및 랭킹 로드 (상세 뷰가 아닐 때만)
      if (tabRegion.checked) {
        if (typeof initializeRegionRankingFilters === 'function') {
          initializeRegionRankingFilters();
        }
        if (!(window.regionDetailServer && window.regionDetailGuild)) {
          if (typeof loadRegionRankings === 'function') {
            loadRegionRankings(1);
          }
        }
      }
    });
  }
  
  // 페이지 로드 시 이미 체크된 탭 처리 (URL 직접 접속 시)
  // 랭킹 관련 서브탭이면 메인 탭도 체크되어 있어야 함
  const path = pathWithoutSitePrefix(window.location.pathname);
  if (path.startsWith('/ranking')) {
    if (tabRanking && !tabRanking.checked) {
      tabRanking.checked = true;
      tabRanking.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  // 레기온 탭 (메인 탭) 초기 로드 처리
  if (tabRegion && tabRegion.checked) {
    if (typeof initializeRegionRankingFilters === 'function') {
      initializeRegionRankingFilters();
    }
    setTimeout(() => {
      // 레기온 상세 페이지 직접 접근 시 자동 로드
      if (window.regionDetailServer && window.regionDetailGuild) {
        if (typeof loadRegionDetail === 'function') {
          loadRegionDetail(window.regionDetailServer, window.regionDetailGuild);
        }
      } else if (typeof loadRegionRankings === 'function') {
        loadRegionRankings(1);
      }
    }, 100);
  }
  
  // 통계 탭 초기화 (랭킹 탭 초기화 전에 처리)
  if (path.startsWith('/statistics')) {
    if (tabStatistics && !tabStatistics.checked) {
      tabStatistics.checked = true;
      // change 이벤트를 발생시키지 않음 (중복 호출 방지)
      // 초기화는 아래 블록에서 처리
    }
  }
  
  if (tabStatistics && tabStatistics.checked) {
    // 통계 탭이 이미 체크되어 있으면 초기화 수행
    setupStatisticsSubTabs();
    
    // 서브탭에 따라 적절한 데이터 로드
    const activeSubTab = document.querySelector('#panel-statistics .statistics-sub-tab-btn.active');
    const subTabTarget = activeSubTab ? activeSubTab.dataset.target : 'population-statistics';
    
    if (subTabTarget === 'skill-statistics') {
      // 스킬 통계 초기화 및 로드 (중복 호출 방지)
      if (typeof setupSkillStatsClassSelector === 'function' && !window.skillStatsInitialized) {
        setupSkillStatsClassSelector();
        window.skillStatsInitialized = true;
      }
      setTimeout(() => {
        if (typeof loadSkillStatistics === 'function' && !window.skillStatsLoading) {
          window.skillStatsLoading = true;
          const activeJobBtn = document.querySelector('.skill-stats-class-btn.active');
          const job = activeJobBtn ? activeJobBtn.dataset.job : '검성';
          loadSkillStatistics(job);
          setTimeout(() => {
            window.skillStatsLoading = false;
          }, 1000);
        }
      }, 100);
    } else if (subTabTarget === 'arcana-statistics') {
      // 아르카나 통계 초기화 및 로드 (중복 호출 방지)
      if (typeof setupArcanaStatsClassSelector === 'function' && !window.arcanaStatsInitialized) {
        setupArcanaStatsClassSelector();
        window.arcanaStatsInitialized = true;
      }
      setTimeout(() => {
        if (typeof loadArcanaStatistics === 'function' && !window.arcanaStatsLoading) {
          window.arcanaStatsLoading = true;
          const activeJobBtn = document.querySelector('.arcana-stats-class-btn.active');
          const job = activeJobBtn ? activeJobBtn.dataset.job : '검성';
          loadArcanaStatistics(job);
          setTimeout(() => {
            window.arcanaStatsLoading = false;
          }, 1000);
        }
      }, 100);
    } else if (subTabTarget === 'server-statistics') {
      // 서버 통계 초기화 및 로드 (중복 호출 방지)
      setTimeout(() => {
        if (typeof loadServerStatistics === 'function' && !window.serverStatsLoading) {
          window.serverStatsLoading = true;
          loadServerStatistics();
          setTimeout(() => {
            window.serverStatsLoading = false;
          }, 1000);
        }
      }, 100);
    } else if (subTabTarget === 'combat-power-statistics') {
      // 전투력 통계 초기화 및 로드 (중복 호출 방지)
      if (typeof setupCombatPowerStatsClassSelector === 'function' && !window.cpStatsInitialized) {
        setupCombatPowerStatsClassSelector();
        window.cpStatsInitialized = true;
      }
      setTimeout(() => {
        if (typeof loadCombatPowerStatistics === 'function' && !window.cpStatsLoading) {
          window.cpStatsLoading = true;
          loadCombatPowerStatistics();
          setTimeout(() => {
            window.cpStatsLoading = false;
          }, 1000);
        }
      }, 100);
    } else if (subTabTarget === 'population-statistics') {
      // 인구수 통계 초기화 및 로드 (중복 호출 방지)
      setTimeout(() => {
        if (typeof loadPopulationStatistics === 'function' && !window.popStatsLoading) {
          window.popStatsLoading = true;
          loadPopulationStatistics();
          setTimeout(() => {
            window.popStatsLoading = false;
          }, 1000);
        }
      }, 100);
    }
    // 일시 중지: 아이템 통계 (부하 감소)
    // else if (subTabTarget === 'item-statistics') {
    //   if (typeof initializeItemStatisticsControls === 'function' && !window.itemStatsControlsInitialized) {
    //     initializeItemStatisticsControls();
    //     window.itemStatsControlsInitialized = true;
    //   }
    //   setTimeout(() => {
    //     if (typeof loadItemStatistics === 'function' && !window.itemStatsLoading) {
    //       window.itemStatsLoading = true;
    //       loadItemStatistics();
    //       setTimeout(() => {
    //         window.itemStatsLoading = false;
    //       }, 1000);
    //     }
    //   }, 100);
    // }
    else {
      // 직업 통계 로드
      if (typeof loadStatistics === 'function') {
        loadStatistics();
      }
    }
  }
  
  if (tabRanking && tabRanking.checked) {
    // 랭킹 탭이 이미 체크되어 있으면 초기화 수행
    initializeRankingFilters();
    setupRankingSubTabs();
    
    // 서브탭에 따라 적절한 데이터 로드
    const activeSubTab = document.querySelector('#panel-ranking .statistics-sub-tab-btn.active');
    const subTabTarget = activeSubTab ? activeSubTab.dataset.target : 'combat-power-ranking';
    
    if (subTabTarget === 'region-ranking') {
      // 레기온 랭킹 초기화 및 로드
      if (typeof initializeRegionRankingFilters === 'function') {
        initializeRegionRankingFilters();
      }
      setTimeout(() => {
        // 레기온 상세 페이지 직접 접근 시 자동 로드
        if (window.regionDetailServer && window.regionDetailGuild) {
          if (typeof loadRegionDetail === 'function') {
            loadRegionDetail(window.regionDetailServer, window.regionDetailGuild);
          }
        } else if (typeof loadRegionRankings === 'function') {
          loadRegionRankings(1);
        }
      }, 100);
    } else if (subTabTarget === 'farming-ranking') {
      // 내실 랭킹 초기화 및 로드 (중복 호출 방지)
      // active_farming_type에 따라 타입 설정
      
      if (typeof initializeInternalRankingFilters === 'function' && !window.internalRankingInitialized) {
        initializeInternalRankingFilters();
        window.internalRankingInitialized = true;
      }
      if (typeof setupInternalRankingEventListeners === 'function' && !window.internalRankingListenersSetup) {
        setupInternalRankingEventListeners();
        window.internalRankingListenersSetup = true;
      }
      setTimeout(() => {
        if (typeof loadInternalRanking === 'function' && !window.internalRankingLoading) {
          window.internalRankingLoading = true;
          loadInternalRanking(1);
          setTimeout(() => {
            window.internalRankingLoading = false;
          }, 1000);
        }
      }, 100);
    } else if (subTabTarget === 'combat-score-ranking') {
      // 아툴 전투 점수 랭킹 초기화 및 로드
      if (typeof setupCombatScoreRankingEventListeners === 'function') {
        setupCombatScoreRankingEventListeners();
      }
      setTimeout(() => {
        if (typeof loadCombatScoreRanking === 'function') {
          loadCombatScoreRanking(1);
        }
      }, 100);
    } else if (subTabTarget === 'contents-ranking') {
      // 컨텐츠 랭킹 초기화 및 로드 (중복 호출 방지)
      // active_contents_type에 따라 타입 설정
      
      if (typeof initializeContentsRankingFilters === 'function' && !window.contentsRankingInitialized) {
        initializeContentsRankingFilters();
        window.contentsRankingInitialized = true;
      }
      if (typeof setupContentsRankingEventListeners === 'function' && !window.contentsRankingListenersSetup) {
        setupContentsRankingEventListeners();
        window.contentsRankingListenersSetup = true;
      }
      setTimeout(() => {
        if (typeof loadContentsRanking === 'function' && !window.contentsRankingLoading) {
          window.contentsRankingLoading = true;
          loadContentsRanking(1);
          setTimeout(() => {
            window.contentsRankingLoading = false;
          }, 1000);
        }
      }, 100);
    }
    // 전투력 랭킹은 initializeRankingFilters()에서 이미 로드됨
  }
  
  // 통계 탭 초기화는 위의 path.startsWith('/statistics') 블록에서 이미 처리됨
  // 중복 호출 방지를 위해 이 블록은 제거됨
  
  // URL 해시로 탭 선택 처리
  function handleHashChange() {
    const hash = window.location.hash.replace('#', '');
    
    // char/serverid=xxx/닉네임 형식 처리
    if (hash.startsWith('char/serverid=')) {
      const charMatch = hash.match(/^char\/serverid=(\d+)\/(.+)$/);
      if (charMatch) {
        const serverId = charMatch[1];
        const nickname = decodeURIComponent(charMatch[2]);
        
        // 서버 정보 찾기
        const serverDataEl = document.getElementById('server-data');
        let servers = { elyos: [], asmodian: [] };
        if (serverDataEl && serverDataEl.textContent) {
          try {
            servers = JSON.parse(serverDataEl.textContent);
          } catch (e) {
          }
        }
        
        let race = null;
        let server = null;
        for (const serverList of [servers.elyos || [], servers.asmodian || []]) {
          for (const s of serverList) {
            if (s.id == serverId) {
              server = s.id;
              race = servers.elyos && servers.elyos.some(es => es.id == serverId) ? '1' : '2';
              break;
            }
          }
          if (race) break;
        }
        
        if (nickname && race && server && tabCharacter) {
          // 캐릭터 검색 탭으로 이동
          tabCharacter.checked = true;
          tabCharacter.dispatchEvent(new Event('change'));
          updateSidebarVisibility();
          
          // 검색 폼에 값 설정
          const serverSelect = document.getElementById('server-select');
          const keywordInput = document.getElementById('character-keyword');
          
          // 종족 버튼 업데이트 (캐릭터 링크 클릭이므로 localStorage에 저장하지 않음)
          if (race) {
            updateRaceSelection(race, true);
          }
          
          setTimeout(() => {
            if (serverSelect) {
              serverSelect.value = server;
              if (keywordInput) keywordInput.value = nickname;
              
              // 로딩 표시 유지
              document.getElementById('character-loading').style.display = 'block';
              lockLoadingOverlay();
              
              // 검색 실행
              performSearch();
            }
          }, 300);
          scrollToTop();
          return;
        }
      }
    }
    
    if (hash === 'character' && tabCharacter) {
      tabCharacter.checked = true;
      tabCharacter.dispatchEvent(new Event('change'));
      scrollToTop();
    } else if (hash === 'ranking' && tabRanking) {
      tabRanking.checked = true;
      tabRanking.dispatchEvent(new Event('change'));
      scrollToTop();
    } else if ((hash === 'region' || hash.startsWith('ranking/region')) && tabRegion) {
      tabRegion.checked = true;
      tabRegion.dispatchEvent(new Event('change'));
      scrollToTop();
      setTimeout(() => {
        if (typeof initializeRegionRankingFilters === 'function') {
          initializeRegionRankingFilters();
        }
        if (typeof loadRegionRankings === 'function') {
          loadRegionRankings(1);
        }
      }, 100);
    } else if (hash.startsWith('region/') && tabRegion) {
      tabRegion.checked = true;
      tabRegion.dispatchEvent(new Event('change'));
      scrollToTop();
      const parts = hash.split('/');
      if (parts.length >= 3) {
        const server = decodeURIComponent(parts[1]);
        const guild = decodeURIComponent(parts.slice(2).join('/'));
        setTimeout(() => {
          loadRegionDetail(server, guild);
        }, 100);
      }
    } else if (hash === 'statistics' && tabStatistics) {
      tabStatistics.checked = true;
      // change 이벤트를 발생시키지 않음 (중복 호출 방지)
      // 초기화는 DOMContentLoaded 블록에서 처리됨
      hideCharacterResult();
      updateURL('statistics/population', false, true);
      updateSidebarVisibility();
      scrollToTop();
      setupStatisticsSubTabs();
    }
  }
  
  // 초기 해시 처리
  handleHashChange();
  
  // 해시 변경 이벤트 리스너
  window.addEventListener('hashchange', function() {
    handleHashChange();
    scrollToTop();
    // URL에서 상태 복원
    restoreStateFromURL();
  });
  
  // 브라우저 뒤로가기/앞으로가기 처리
  window.addEventListener('popstate', function(event) {
    const path = window.location.pathname;
    
    // 캐릭터 검색 결과 URL인 경우
    const charMatch = path.match(/^(?:\/zh-tw|\/global)?\/char\/serverid=(\d+)\/(.+)$/);
    if (charMatch) {
      loadCharacterFromUrlParams();
      return;
    }
    
    // 홈 경로 또는 기본 경로인 경우
    const _homePfx = SITE_URL_PREFIX || '';
    if (path === '/' || path === '' || path === _homePfx || path === _homePfx + '/') {
      hideCharacterResult();
      // 캐릭터 검색 탭 활성화
      const tabCharacter = document.getElementById('tab-character');
      if (tabCharacter) {
        tabCharacter.checked = true;
      }
      scrollToTop();
      return;
    }
    
    // 다른 경로인 경우 (랭킹, 통계 등)
    hideCharacterResult();
    activateTabByPath();
    scrollToTop();
  });
  
  // 초기 상태 설정
  updateSidebarVisibility();
  
  // URL에서 상태 복원 (초기 로드 시)
  restoreStateFromURL();
  
  // 통계 탭이 처음부터 선택되어 있으면 통계 로드
  if (tabStatistics && tabStatistics.checked) {
    loadStatistics();
    setupStatisticsSubTabs();
  } else {
    setupStatisticsSubTabs(); // 초기화 (탭 이동 시 자동 동작)
  }
  
  // 내실 랭킹 서브탭 이벤트 리스너는 setupInternalRankingEventListeners에서 등록
});

// 레기온 랭킹 관련 변수 (전역 스코프)
// 중복 선언 방지
if (typeof currentRegionRaceFilter === 'undefined') {
  var currentRegionRaceFilter = 'all';
}
if (typeof currentRegionServerFilter === 'undefined') {
  var currentRegionServerFilter = 'all';
}
if (typeof currentRegionPage === 'undefined') {
  var currentRegionPage = 1;
}
if (typeof regionSearchQuery === 'undefined') {
  var regionSearchQuery = '';
}

// 랭킹 서브 탭 설정
function setupRankingSubTabs() {
  const btns = document.querySelectorAll('#panel-ranking .statistics-sub-tab-btn');
  const contents = {
    'combat-power-ranking': document.getElementById('combat-power-ranking-content'),
    'farming-ranking': document.getElementById('internal-ranking-content'),
    'combat-score-ranking': document.getElementById('combat-score-ranking-content'),
    'contents-ranking': document.getElementById('contents-ranking-content')
  };
  
  if (btns.length === 0) return; // 요소가 없으면 리턴
  
  // a 태그인 경우 클릭 이벤트 등록하지 않음 (페이지 이동으로 처리)
  // 초기 상태만 갱신
  const activeBtn = document.querySelector('#panel-ranking .statistics-sub-tab-btn.active') || btns[0];
  if (activeBtn) {
    const target = activeBtn.dataset.target;
    Object.keys(contents).forEach(key => {
      if (contents[key]) {
        contents[key].style.display = key === target ? 'block' : 'none';
      }
    });
    
    // 메인 탭의 border-bottom 유지
    const mainTabsContainer = document.querySelector('#panel-ranking .statistics-sub-tabs');
    if (mainTabsContainer) {
      mainTabsContainer.classList.remove('no-border-bottom');
    }
    
    if (target === 'farming-ranking') {
      // 내실 랭킹은 setupRankingSubTabs에서 처리하지 않음 (중복 방지)
      // DOMContentLoaded에서만 처리
    } else if (target === 'contents-ranking') {
      // 컨텐츠 랭킹은 setupRankingSubTabs에서 처리하지 않음 (중복 방지)
      // DOMContentLoaded에서만 처리
    }
  }
}

// 통계 서브 탭 설정
function setupStatisticsSubTabs() {
  const btns = document.querySelectorAll('#panel-statistics .statistics-sub-tab-btn');
  const contents = {
    'job-statistics': document.getElementById('job-statistics-content'),
    'skill-statistics': document.getElementById('skill-statistics-content'),
    'arcana-statistics': document.getElementById('arcana-statistics-content'),
    'server-statistics': document.getElementById('server-statistics-content'),
    'combat-power-statistics': document.getElementById('combat-power-statistics-content'),
    'population-statistics': document.getElementById('population-statistics-content'),
    'item-statistics': document.getElementById('item-statistics-content')
  };
  
  if (btns.length === 0) return; // 요소가 없으면 리턴
  
  // a 태그인 경우 클릭 이벤트 등록하지 않음 (페이지 이동으로 처리)
  // 초기 상태만 갱신
  const activeBtn = document.querySelector('#panel-statistics .statistics-sub-tab-btn.active') || btns[0];
  if (activeBtn) {
    const target = activeBtn.dataset.target;
    // 컨텐츠 표시/숨김 처리
    Object.keys(contents).forEach(key => {
      if (contents[key]) {
        contents[key].style.display = key === target ? 'block' : 'none';
      }
    });
    // 설명 표시/숨김 처리
    Object.keys(STAT_SUBTAB_DESCRIPTIONS).forEach(key => {
      if (STAT_SUBTAB_DESCRIPTIONS[key]) {
        STAT_SUBTAB_DESCRIPTIONS[key].style.display = key === target ? 'block' : 'none';
      }
    });
  }
}

// 아이템 통계 상태 (전체 직업 고정, 전투력 구간만 필터)
const itemStatisticsState = {
  combatPowerMin: 0,
  combatPowerMax: 5000,
  initialized: false
};

// 아이템 통계용 전투력 구간 컨트롤 (동적으로 가져옴)
function getItemStatisticsControls() {
  return {
    minInput: document.getElementById('item-stat-min-input'),
    maxInput: document.getElementById('item-stat-max-input'),
    minRange: document.getElementById('item-stat-range-min'),
    maxRange: document.getElementById('item-stat-range-max'),
    track: document.getElementById('item-stat-range-track'),
    summary: document.getElementById('item-stat-range-summary'),
    applyButton: document.getElementById('item-stat-apply-button')
  };
}

// 아이템 통계 슬라이더 초기화
function initializeItemStatisticsControls() {
  const controls = getItemStatisticsControls();
  if (!controls.minInput || !controls.maxInput || !controls.minRange || !controls.maxRange || !controls.track || !controls.applyButton) {
    return;
  }

  let minValue = itemStatisticsState.combatPowerMin || 0;
  let maxValue = itemStatisticsState.combatPowerMax || 5000;

  // 이미 초기화되었으면 값만 업데이트하고 이벤트 리스너는 추가하지 않음
  if (itemStatisticsState.initialized) {
    controls.minInput.value = minValue;
    controls.maxInput.value = maxValue;
    controls.minRange.value = minValue;
    controls.maxRange.value = maxValue;
    updateItemRangeTrack(controls, minValue, maxValue);
    if (controls.summary) {
      controls.summary.textContent = `${Number(minValue).toLocaleString()} ~ ${Number(maxValue).toLocaleString()} 전투력 기준`;
    }
    return;
  }

  function clampItemRange() {
    // 오른쪽은 왼쪽보다 큰 snap 구간이어야 함
    const nextSnapPoint = POWER_SNAP_POINTS.find(point => point > minValue);
    if (nextSnapPoint && maxValue <= minValue) {
      maxValue = nextSnapPoint;
    }
    if (maxValue < minValue) {
      maxValue = minValue;
    }
    if (maxValue - minValue < STAT_MIN_GAP) {
      maxValue = minValue + STAT_MIN_GAP;
    }
  }

  function updateItemRangeTrack(ctrl, minVal, maxVal) {
    const bounds = { min: 0, max: 5000 };
    const span = bounds.max - bounds.min || 1;
    const startPercent = ((minVal - bounds.min) / span) * 100;
    const endPercent = ((maxVal - bounds.min) / span) * 100;
    const gradientValue = `linear-gradient(90deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.15) ${startPercent}%, rgba(157, 140, 255, 0.9) ${startPercent}%, rgba(236, 72, 153, 0.9) ${endPercent}%, rgba(255,255,255,0.15) ${endPercent}%, rgba(255,255,255,0.15) 100%)`;
    ctrl.track.style.setProperty('background', gradientValue, 'important');
    ctrl.track.style.setProperty('background-image', gradientValue, 'important');
  }

  function syncItemRangeUI() {
    clampItemRange();
    controls.minInput.value = minValue;
    controls.maxInput.value = maxValue;
    controls.minRange.value = minValue;
    controls.maxRange.value = maxValue;

    updateItemRangeTrack(controls, minValue, maxValue);

    const minLabel = Number(minValue).toLocaleString();
    const maxLabel = Number(maxValue).toLocaleString();
    if (controls.summary) {
      controls.summary.textContent = `${minLabel} ~ ${maxLabel} 전투력 기준`;
    }
  }

  controls.minInput.addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    if (!Number.isNaN(v)) {
      minValue = snapToPowerPoint(v);
      // 왼쪽 슬라이더는 최대 3000까지만
      if (minValue > 3000) {
        minValue = 3000;
      }
      syncItemRangeUI();
    }
  });

  controls.maxInput.addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    if (!Number.isNaN(v)) {
      maxValue = snapToPowerPoint(v);
      // 오른쪽 슬라이더는 왼쪽보다 큰 snap 구간이어야 함
      const nextSnapPoint = POWER_SNAP_POINTS.find(point => point > minValue);
      if (nextSnapPoint && maxValue <= minValue) {
        maxValue = nextSnapPoint;
      }
      syncItemRangeUI();
    }
  });

  controls.minRange.addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    if (!Number.isNaN(v)) {
      minValue = snapToPowerPoint(v);
      // 왼쪽 슬라이더는 최대 3000까지만
      if (minValue > 3000) {
        minValue = 3000;
      }
      syncItemRangeUI();
    }
  });

  controls.maxRange.addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    if (!Number.isNaN(v)) {
      maxValue = snapToPowerPoint(v);
      // 오른쪽 슬라이더는 왼쪽보다 큰 snap 구간이어야 함
      const nextSnapPoint = POWER_SNAP_POINTS.find(point => point > minValue);
      if (nextSnapPoint && maxValue <= minValue) {
        maxValue = nextSnapPoint;
      }
      syncItemRangeUI();
    }
  });

  controls.applyButton.addEventListener('click', () => {
    clampItemRange();
    itemStatisticsState.combatPowerMin = minValue;
    itemStatisticsState.combatPowerMax = maxValue;
    loadItemStatistics();
  });

  syncItemRangeUI();
  itemStatisticsState.initialized = true;
}

// 아이템 통계 데이터 로드
function loadItemStatistics() {
  const container = document.getElementById('item-statistics-container');
  const updateInfoEl = document.getElementById('item-statistics-update-info');
  
  if (!container) {
    return;
  }
  
  container.innerHTML = '<p style="text-align: center; color: #ffffff;">로딩 중...</p>';
  if (updateInfoEl) {
    updateInfoEl.textContent = '';
  }
  
  // 필터 파라미터 생성 (전투력 구간만)
  const params = new URLSearchParams();
  params.append('combat_power_min', itemStatisticsState.combatPowerMin);
  params.append('combat_power_max', itemStatisticsState.combatPowerMax);
  
  fetch(`/api/stats/items?${params.toString()}`)
    .then(res => {
      if (!res.ok) {
        throw new Error(`HTTP ${res.status}: ${res.statusText}`);
      }
      return res.json();
    })
    .then(data => {
      if (!data.success) {
        container.innerHTML = `<p style="text-align: center; color: #ef4444;">${data.error || '데이터 로드 실패'}</p>`;
        return;
      }
      
      // 업데이트 시간 표시
      if (updateInfoEl && data.data.last_updated) {
        updateInfoEl.textContent = `${_t('최근 업데이트', '最近更新')}: ${data.data.last_updated}`;
      } else if (updateInfoEl) {
        updateInfoEl.textContent = '';
      }
      
      renderItemStatistics(data.data);
    })
    .catch(err => {
      container.innerHTML = '<p style="text-align: center; color: #ef4444;">데이터를 불러오는 중 오류가 발생했습니다: ' + err.message + '</p>';
    });
}

// 아이템 통계 렌더링 (5개의 pie chart)
function renderItemStatistics(data) {
  const container = document.getElementById('item-statistics-container');
  
  if (!container) {
    return;
  }
  
  const hasData = Object.keys(data.arcana || {}).length > 0 || 
                  Object.keys(data.main_weapon || {}).length > 0 || 
                  Object.keys(data.gauntlet || {}).length > 0 ||
                  Object.keys(data.armor || {}).length > 0 || 
                  Object.keys(data.accessory || {}).length > 0;
  
  if (!hasData) {
    container.innerHTML = '<p style="text-align: center; color: #ffffff;">데이터가 없습니다.</p>';
    return;
  }
  
  container.innerHTML = '';
  
  // Chart.js 로드 대기
  if (typeof Chart === 'undefined') {
    // Chart.js 로드 대기 (최대 10초)
    let checkCount = 0;
    const maxChecks = 100; // 100ms * 100 = 10초
    const checkChart = setInterval(() => {
      checkCount++;
      if (typeof Chart !== 'undefined') {
        clearInterval(checkChart);
        // Chart.js가 로드되면 다시 렌더링
        renderItemStatistics(data);
      } else if (checkCount >= maxChecks) {
        clearInterval(checkChart);
        container.innerHTML = '<p style="text-align: center; color: #ef4444;">Chart.js가 로드되지 않았습니다.</p>';
      }
    }, 100);
    return;
  }
  
  // 총 통계 대상 수
  const totalCount = data.total_count || 0;
  
  // 그리드 컨테이너 생성 (반응형)
  const gridContainer = document.createElement('div');
  gridContainer.style.cssText = 'display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1rem;';
  gridContainer.id = 'item-statistics-grid';
  
  // 모바일 반응형 스타일 추가
  const mobileStyle = document.createElement('style');
  mobileStyle.id = 'item-statistics-styles';
  mobileStyle.textContent = `
    #item-statistics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    #item-statistics-grid .chart-wrapper {
      position: relative;
      height: 350px;
      width: 100%;
    }
    #item-statistics-grid * {
      color: #ffffff !important;
    }
    #item-statistics-grid canvas + div,
    #item-statistics-grid canvas ~ div,
    #item-statistics-grid canvas ~ ul,
    #item-statistics-grid canvas ~ li {
      color: #ffffff !important;
    }
    #item-statistics-grid ul,
    #item-statistics-grid li,
    #item-statistics-grid span,
    #item-statistics-grid div,
    #item-statistics-grid label,
    #item-statistics-grid p {
      color: #ffffff !important;
    }
    #item-statistics-grid .chartjs-legend,
    #item-statistics-grid .chartjs-legend * {
      color: #ffffff !important;
      font-size: 22px !important;
    }
    #item-statistics-grid canvas + ul,
    #item-statistics-grid canvas ~ ul,
    #item-statistics-grid canvas + ul li,
    #item-statistics-grid canvas ~ ul li,
    #item-statistics-grid canvas + ul span,
    #item-statistics-grid canvas ~ ul span {
      font-size: 22px !important;
    }
    #item-statistics-grid ul,
    #item-statistics-grid ul li,
    #item-statistics-grid ul li span {
      font-size: 22px !important;
    }
    @media (max-width: 768px) {
      #item-statistics-grid {
        grid-template-columns: 1fr !important;
        gap: 1rem;
      }
      #item-statistics-grid > div {
        padding: 1.5rem !important;
      }
      #item-statistics-grid .chart-wrapper {
        height: 300px !important;
      }
      #item-statistics-grid canvas {
        max-width: 100% !important;
        height: 100% !important;
      }
    }
    @media (max-width: 480px) {
      #item-statistics-grid > div {
        padding: 1rem !important;
      }
      #item-statistics-grid .chart-wrapper {
        height: 250px !important;
      }
    }
  `;
  // 기존 스타일이 있으면 제거
  const existingStyle = document.getElementById('item-statistics-styles');
  if (existingStyle) {
    existingStyle.remove();
  }
  document.head.appendChild(mobileStyle);
  
  // 차트 컨테이너 스타일
  const chartContainerStyle = 'background: linear-gradient(135deg, rgba(9, 16, 37, 0.95), rgba(15, 23, 42, 0.95)); border: 1px solid rgba(157, 140, 255, 0.2); border-radius: 16px; padding: 2rem; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); transition: transform 0.2s ease, box-shadow 0.2s ease;';
  const chartTitleStyle = 'font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; color: #ffffff !important; text-align: center; text-shadow: 0 2px 8px rgba(157, 140, 255, 0.3);';
  const chartSubtitleStyle = 'font-size: 0.9rem; font-weight: 400; margin-bottom: 1.5rem; color: rgba(255, 255, 255, 0.7) !important; text-align: center;';
  const chartWrapperStyle = 'position: relative; height: 350px; width: 100%;';
  const chartContainerHoverStyle = 'transform: translateY(-4px); box-shadow: 0 12px 40px rgba(157, 140, 255, 0.2);';
  
  // 공통 차트 옵션 생성 함수
  function createChartOptions(total, itemName, containerElement) {
    return {
      responsive: true,
      maintainAspectRatio: false,
      interaction: {
        mode: 'nearest',
        intersect: true,
        axis: 'x'
      },
      animation: {
        onComplete: function() {
          // legend 텍스트 색상 및 폰트 크기 강제 적용
          if (containerElement) {
            const legendContainer = containerElement.querySelector('.chartjs-legend');
            if (legendContainer) {
              const textElements = legendContainer.querySelectorAll('*');
              textElements.forEach(el => {
                el.style.color = '#ffffff';
                el.style.setProperty('color', '#ffffff', 'important');
                el.style.fontSize = '22px';
                el.style.setProperty('font-size', '22px', 'important');
              });
            }
            // Chart.js가 생성하는 모든 텍스트 요소
            const allText = containerElement.querySelectorAll('li, span, div, label');
            allText.forEach(el => {
              if (el.textContent && el.textContent.trim() && !el.querySelector('canvas')) {
                el.style.color = '#ffffff';
                el.style.setProperty('color', '#ffffff', 'important');
                el.style.fontSize = '22px';
                el.style.setProperty('font-size', '22px', 'important');
              }
            });
            // canvas 다음에 오는 ul (legend)
            const canvas = containerElement.querySelector('canvas');
            if (canvas && canvas.nextElementSibling) {
              const nextSibling = canvas.nextElementSibling;
              if (nextSibling.tagName === 'UL' || nextSibling.querySelector('ul')) {
                const ul = nextSibling.tagName === 'UL' ? nextSibling : nextSibling.querySelector('ul');
                if (ul) {
                  const items = ul.querySelectorAll('li, span');
                  items.forEach(item => {
                    item.style.fontSize = '22px';
                    item.style.setProperty('font-size', '22px', 'important');
                  });
                }
              }
            }
          }
        }
      },
      plugins: {
        legend: {
          position: 'bottom',
          onClick: () => {}, // legend 클릭 비활성화
          labels: {
            color: '#ffffff',
            padding: 12,
            font: { 
              size: 15, 
              weight: '500',
              family: 'inherit'
            },
            usePointStyle: true,
            pointStyle: 'circle',
            generateLabels: function(chart) {
              const data = chart.data;
              if (data.labels.length && data.datasets.length) {
                const dataset = data.datasets[0];
                return data.labels.map((label, i) => {
                  return {
                    text: label,
                    fillStyle: dataset.backgroundColor[i],
                    strokeStyle: dataset.backgroundColor[i],
                    fontColor: '#ffffff',
                    fontStyle: 'normal',
                    fontFamily: 'inherit',
                    fontSize: 15,
                    fontWeight: '500',
                    hidden: false,
                    index: i
                  };
                });
              }
              return [];
            }
          },
          onHover: function(e, legendItem) {
            if (e.native && e.native.target) {
              e.native.target.style.cursor = 'default';
            }
          }
        },
        tooltip: {
          enabled: true,
          intersect: true,
          mode: 'point',
          backgroundColor: 'rgba(0, 0, 0, 0.9)',
          titleColor: '#ffffff',
          bodyColor: '#ffffff',
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 1,
          padding: 12,
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed || 0;
              const percentage = ((value / total) * 100).toFixed(1);
              return `${label}: ${value}${itemName} (${percentage}%)`;
            }
          }
        },
        datalabels: {
          color: '#ffffff',
          font: { size: 14, weight: 'bold' },
          textStrokeColor: '#000000',
          textStrokeWidth: 2,
          formatter: function(value, context) {
            const percentage = ((value / total) * 100).toFixed(1);
            // 3% 이상인 경우만 표시
            if (percentage >= 3) {
              return percentage + '%';
            }
            return '';
          }
        }
      }
    };
  }
  
  // legend 폰트 크기 적용 함수
  function applyLegendFontSize(container, chartInstance) {
    if (!container || !chartInstance) return;
    
    // 여러 번 시도 (Chart.js가 legend를 나중에 렌더링할 수 있음)
    const tryApply = (attempt = 0) => {
      if (attempt > 5) return; // 최대 5번 시도
      
      // Chart.js가 생성한 legend 요소 찾기 - canvas의 부모에서 찾기
      const chartWrapper = container.querySelector('.chart-wrapper');
      if (chartWrapper) {
        // canvas 다음에 오는 모든 형제 요소 (legend)
        let nextSibling = chartWrapper.nextElementSibling;
        while (nextSibling) {
          if (nextSibling.tagName === 'UL' || nextSibling.querySelector('ul')) {
            const ul = nextSibling.tagName === 'UL' ? nextSibling : nextSibling.querySelector('ul');
            if (ul) {
              const items = ul.querySelectorAll('li');
              items.forEach(item => {
                const spans = item.querySelectorAll('span');
                spans.forEach(span => {
                  span.style.fontSize = '22px';
                  span.style.setProperty('font-size', '22px', 'important');
                });
                item.style.fontSize = '22px';
                item.style.setProperty('font-size', '22px', 'important');
              });
            }
          }
          nextSibling = nextSibling.nextElementSibling;
        }
      }
      
      // container 내부의 모든 ul, li, span 요소
      const allLegendElements = container.querySelectorAll('ul li, ul li span, ul span');
      allLegendElements.forEach(el => {
        if (el.textContent && el.textContent.trim()) {
          el.style.fontSize = '22px';
          el.style.setProperty('font-size', '22px', 'important');
        }
      });
      
      // Chart.js의 legend 플러그인에서 직접 접근
      if (chartInstance.legend && chartInstance.legend.legendBox) {
        const legendBox = chartInstance.legend.legendBox;
        if (legendBox) {
          const legendTexts = legendBox.querySelectorAll('*');
          legendTexts.forEach(el => {
            if (el.textContent && el.textContent.trim()) {
              el.style.fontSize = '22px';
              el.style.setProperty('font-size', '22px', 'important');
            }
          });
        }
      }
      
      // legend가 아직 렌더링되지 않았으면 다시 시도
      const hasLegend = container.querySelector('ul') || (chartInstance.legend && chartInstance.legend.legendBox);
      if (!hasLegend && attempt < 5) {
        setTimeout(() => tryApply(attempt + 1), 200);
      }
    };
    
    tryApply();
  }
  
  // 1. 아르카나 세트 옵션
  if (Object.keys(data.arcana || {}).length > 0) {
    const arcanaContainer = document.createElement('div');
    arcanaContainer.style.cssText = chartContainerStyle;
    arcanaContainer.onmouseenter = function() { this.style.cssText = chartContainerStyle + chartContainerHoverStyle; };
    arcanaContainer.onmouseleave = function() { this.style.cssText = chartContainerStyle; };
    
    const arcanaEntries = Object.entries(data.arcana).sort((a, b) => b[1] - a[1]);
    const arcanaLabels = arcanaEntries.map(([label]) => label);
    const arcanaValues = arcanaEntries.map(([, value]) => value);
    const arcanaTotal = arcanaValues.reduce((a, b) => a + b, 0);
    const arcanaCount = arcanaTotal;
    
    arcanaContainer.innerHTML = `
      <h3 style="${chartTitleStyle}">✨ 아르카나 세트 옵션</h3>
      <p style="${chartSubtitleStyle}">총 ${arcanaCount.toLocaleString()}명</p>
      <div style="${chartWrapperStyle}" class="chart-wrapper">
        <canvas id="arcana-chart"></canvas>
      </div>
    `;
    gridContainer.appendChild(arcanaContainer);
    
    const arcanaCanvas = arcanaContainer.querySelector('#arcana-chart');
    if (!arcanaCanvas) return;
    
    const arcanaCtx = arcanaCanvas.getContext('2d');
    
    const arcanaChart = new Chart(arcanaCtx, {
      type: 'pie',
      data: {
        labels: arcanaLabels,
        datasets: [{
          data: arcanaValues,
          backgroundColor: [
            'rgba(157, 140, 255, 0.9)',
            'rgba(236, 72, 153, 0.9)',
            'rgba(59, 130, 246, 0.9)',
            'rgba(34, 197, 94, 0.9)',
            'rgba(251, 146, 60, 0.9)'
          ],
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 2
        }]
      },
      options: createChartOptions(arcanaTotal, '명', arcanaContainer),
      plugins: [typeof ChartDataLabels !== 'undefined' ? ChartDataLabels : {}]
    });
    
    // legend 폰트 크기 강제 적용
    setTimeout(() => {
      applyLegendFontSize(arcanaContainer, arcanaChart);
    }, 300);
  }
  
  // 2. 메인 무기
  if (Object.keys(data.main_weapon || {}).length > 0) {
    const mainWeaponContainer = document.createElement('div');
    mainWeaponContainer.style.cssText = chartContainerStyle;
    mainWeaponContainer.onmouseenter = function() { this.style.cssText = chartContainerStyle + chartContainerHoverStyle; };
    mainWeaponContainer.onmouseleave = function() { this.style.cssText = chartContainerStyle; };
    
    const mainWeaponEntries = Object.entries(data.main_weapon).sort((a, b) => b[1] - a[1]).slice(0, 10);
    const mainWeaponLabels = mainWeaponEntries.map(([label]) => label);
    const mainWeaponValues = mainWeaponEntries.map(([, value]) => value);
    const mainWeaponTotal = mainWeaponValues.reduce((a, b) => a + b, 0);
    const mainWeaponCount = mainWeaponTotal;
    
    mainWeaponContainer.innerHTML = `
      <h3 style="${chartTitleStyle}">⚔️ 메인 무기</h3>
      <p style="${chartSubtitleStyle}">총 ${mainWeaponCount.toLocaleString()}명</p>
      <div style="${chartWrapperStyle}" class="chart-wrapper">
        <canvas id="main-weapon-chart"></canvas>
      </div>
    `;
    gridContainer.appendChild(mainWeaponContainer);
    
    const mainWeaponCanvas = mainWeaponContainer.querySelector('#main-weapon-chart');
    if (!mainWeaponCanvas) return;
    
    const mainWeaponCtx = mainWeaponCanvas.getContext('2d');
    
    const mainWeaponChart = new Chart(mainWeaponCtx, {
      type: 'pie',
      data: {
        labels: mainWeaponLabels,
        datasets: [{
          data: mainWeaponValues,
          backgroundColor: [
            'rgba(157, 140, 255, 0.9)', 'rgba(236, 72, 153, 0.9)', 'rgba(59, 130, 246, 0.9)',
            'rgba(34, 197, 94, 0.9)', 'rgba(251, 146, 60, 0.9)', 'rgba(168, 85, 247, 0.9)',
            'rgba(14, 165, 233, 0.9)', 'rgba(20, 184, 166, 0.9)', 'rgba(245, 158, 11, 0.9)',
            'rgba(239, 68, 68, 0.9)'
          ],
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 2
        }]
      },
      options: createChartOptions(mainWeaponTotal, '명', mainWeaponContainer),
      plugins: [typeof ChartDataLabels !== 'undefined' ? ChartDataLabels : {}]
    });
    
    setTimeout(() => {
      applyLegendFontSize(mainWeaponContainer, mainWeaponChart);
    }, 300);
  }
  
  // 3. 가더
  if (Object.keys(data.gauntlet || {}).length > 0) {
    const gauntletContainer = document.createElement('div');
    gauntletContainer.style.cssText = chartContainerStyle;
    gauntletContainer.onmouseenter = function() { this.style.cssText = chartContainerStyle + chartContainerHoverStyle; };
    gauntletContainer.onmouseleave = function() { this.style.cssText = chartContainerStyle; };
    
    const gauntletEntries = Object.entries(data.gauntlet).sort((a, b) => b[1] - a[1]).slice(0, 10);
    const gauntletLabels = gauntletEntries.map(([label]) => label);
    const gauntletValues = gauntletEntries.map(([, value]) => value);
    const gauntletTotal = gauntletValues.reduce((a, b) => a + b, 0);
    const gauntletCount = gauntletTotal;
    
    gauntletContainer.innerHTML = `
      <h3 style="${chartTitleStyle}">⚔️ 가더</h3>
      <p style="${chartSubtitleStyle}">총 ${gauntletCount.toLocaleString()}명</p>
      <div style="${chartWrapperStyle}" class="chart-wrapper">
        <canvas id="gauntlet-chart"></canvas>
      </div>
    `;
    gridContainer.appendChild(gauntletContainer);
    
    const gauntletCanvas = gauntletContainer.querySelector('#gauntlet-chart');
    if (!gauntletCanvas) return;
    
    const gauntletCtx = gauntletCanvas.getContext('2d');
    
    const gauntletChart = new Chart(gauntletCtx, {
      type: 'pie',
      data: {
        labels: gauntletLabels,
        datasets: [{
          data: gauntletValues,
          backgroundColor: [
            'rgba(157, 140, 255, 0.9)', 'rgba(236, 72, 153, 0.9)', 'rgba(59, 130, 246, 0.9)',
            'rgba(34, 197, 94, 0.9)', 'rgba(251, 146, 60, 0.9)', 'rgba(168, 85, 247, 0.9)',
            'rgba(14, 165, 233, 0.9)', 'rgba(20, 184, 166, 0.9)', 'rgba(245, 158, 11, 0.9)',
            'rgba(239, 68, 68, 0.9)'
          ],
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 2
        }]
      },
      options: createChartOptions(gauntletTotal, '명', gauntletContainer),
      plugins: [typeof ChartDataLabels !== 'undefined' ? ChartDataLabels : {}]
    });
    
    setTimeout(() => {
      applyLegendFontSize(gauntletContainer, gauntletChart);
    }, 300);
  }
  
  // 4. 방어구
  if (Object.keys(data.armor || {}).length > 0) {
    const armorContainer = document.createElement('div');
    armorContainer.style.cssText = chartContainerStyle;
    armorContainer.onmouseenter = function() { this.style.cssText = chartContainerStyle + chartContainerHoverStyle; };
    armorContainer.onmouseleave = function() { this.style.cssText = chartContainerStyle; };
    
    const armorEntries = Object.entries(data.armor).sort((a, b) => b[1] - a[1]).slice(0, 10);
    const armorLabels = armorEntries.map(([label]) => label);
    const armorValues = armorEntries.map(([, value]) => value);
    const armorTotal = armorValues.reduce((a, b) => a + b, 0);
    const armorCount = armorTotal;
    
    armorContainer.innerHTML = `
      <h3 style="${chartTitleStyle}">🛡️ 방어구</h3>
      <p style="${chartSubtitleStyle}">총 ${armorCount.toLocaleString()}개</p>
      <div style="${chartWrapperStyle}" class="chart-wrapper">
        <canvas id="armor-chart"></canvas>
      </div>
    `;
    gridContainer.appendChild(armorContainer);
    
    const armorCanvas = armorContainer.querySelector('#armor-chart');
    if (!armorCanvas) return;
    
    const armorCtx = armorCanvas.getContext('2d');
    
    const armorChart = new Chart(armorCtx, {
      type: 'pie',
      data: {
        labels: armorLabels,
        datasets: [{
          data: armorValues,
          backgroundColor: [
            'rgba(157, 140, 255, 0.9)', 'rgba(236, 72, 153, 0.9)', 'rgba(59, 130, 246, 0.9)',
            'rgba(34, 197, 94, 0.9)', 'rgba(251, 146, 60, 0.9)', 'rgba(168, 85, 247, 0.9)',
            'rgba(14, 165, 233, 0.9)', 'rgba(20, 184, 166, 0.9)', 'rgba(245, 158, 11, 0.9)',
            'rgba(239, 68, 68, 0.9)'
          ],
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 2
        }]
      },
      options: createChartOptions(armorTotal, '개', armorContainer),
      plugins: [typeof ChartDataLabels !== 'undefined' ? ChartDataLabels : {}]
    });
    
    setTimeout(() => {
      applyLegendFontSize(armorContainer, armorChart);
    }, 300);
  }
  
  // 5. 장신구
  if (Object.keys(data.accessory || {}).length > 0) {
    const accessoryContainer = document.createElement('div');
    accessoryContainer.style.cssText = chartContainerStyle;
    accessoryContainer.onmouseenter = function() { this.style.cssText = chartContainerStyle + chartContainerHoverStyle; };
    accessoryContainer.onmouseleave = function() { this.style.cssText = chartContainerStyle; };
    
    const accessoryEntries = Object.entries(data.accessory).sort((a, b) => b[1] - a[1]).slice(0, 10);
    const accessoryLabels = accessoryEntries.map(([label]) => label);
    const accessoryValues = accessoryEntries.map(([, value]) => value);
    const accessoryTotal = accessoryValues.reduce((a, b) => a + b, 0);
    const accessoryCount = accessoryTotal;
    
    accessoryContainer.innerHTML = `
      <h3 style="${chartTitleStyle}">💍 장신구</h3>
      <p style="${chartSubtitleStyle}">총 ${accessoryCount.toLocaleString()}개</p>
      <div style="${chartWrapperStyle}" class="chart-wrapper">
        <canvas id="accessory-chart"></canvas>
      </div>
    `;
    gridContainer.appendChild(accessoryContainer);
    
    const accessoryCanvas = accessoryContainer.querySelector('#accessory-chart');
    if (!accessoryCanvas) return;
    
    const accessoryCtx = accessoryCanvas.getContext('2d');
    
    const accessoryChart = new Chart(accessoryCtx, {
      type: 'pie',
      data: {
        labels: accessoryLabels,
        datasets: [{
          data: accessoryValues,
          backgroundColor: [
            'rgba(157, 140, 255, 0.9)', 'rgba(236, 72, 153, 0.9)', 'rgba(59, 130, 246, 0.9)',
            'rgba(34, 197, 94, 0.9)', 'rgba(251, 146, 60, 0.9)', 'rgba(168, 85, 247, 0.9)',
            'rgba(14, 165, 233, 0.9)', 'rgba(20, 184, 166, 0.9)', 'rgba(245, 158, 11, 0.9)',
            'rgba(239, 68, 68, 0.9)'
          ],
          borderColor: 'rgba(255, 255, 255, 0.2)',
          borderWidth: 2
        }]
      },
      options: createChartOptions(accessoryTotal, '개', accessoryContainer),
      plugins: [typeof ChartDataLabels !== 'undefined' ? ChartDataLabels : {}]
    });
    
    setTimeout(() => {
      applyLegendFontSize(accessoryContainer, accessoryChart);
    }, 300);
  }
  
  container.appendChild(gridContainer);
  
  // 모든 legend 텍스트 색상 강제 적용 (추가 보장)
  setTimeout(() => {
    const allContainers = gridContainer.querySelectorAll('div[style*="background"]');
    allContainers.forEach(container => {
      const allText = container.querySelectorAll('li, span, div, label, p');
      allText.forEach(el => {
        if (el.textContent && el.textContent.trim() && !el.querySelector('canvas')) {
          el.style.color = '#ffffff';
          el.style.setProperty('color', '#ffffff', 'important');
        }
      });
    });
  }, 500);
}

// 스킬 통계 직업 선택 버튼 설정
function setupSkillStatsClassSelector() {
  const btns = document.querySelectorAll('.skill-stats-class-btn');
  btns.forEach(btn => {
    if (btn.dataset.listenerAttached === 'true') {
      return;
    }
    btn.addEventListener('click', function() {
      btns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      loadSkillStatistics(this.dataset.job);
    });
    btn.dataset.listenerAttached = 'true';
  });
}

// 스킬 통계 데이터 로드
function loadSkillStatistics(job) {
  const container = document.getElementById('skill-stats-container');
  const lastUpdateEl = document.getElementById('skill-stats-last-update');
  if (!container) {
    return;
  }
  
  container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">${TA('statistics.skill.loading', '데이터를 불러오는 중...')}</div>`;
  if (lastUpdateEl) {
    lastUpdateEl.textContent = TA('statistics.skill.last_update_loading', '마지막 업데이트: 로딩 중...');
  }
  
  // skill_priorities와 skill_stats를 병렬로 로드
  Promise.all([
    fetch(`${SITE_URL_PREFIX}/api/stats/skills?job=${encodeURIComponent(job)}`).then(res => res.json()),
    fetch(`${SITE_URL_PREFIX}/api/skill-priorities?job=${encodeURIComponent(job)}`).then(res => res.json()).catch(() => null)
  ])
    .then(([statsData, prioritiesData]) => {
      if (!statsData.success) {
        container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #ef4444;">${statsData.error || TA('statistics.skill.load_failed', '데이터 로드 실패')}</div>`;
        if (lastUpdateEl) {
          lastUpdateEl.textContent = '';
        }
        return;
      }
      
      // 마지막 업데이트 날짜 표시
      if (lastUpdateEl && statsData.last_update) {
        lastUpdateEl.textContent = `${TA('statistics.skill.last_update_prefix', '마지막 업데이트')}: ${statsData.last_update}`;
      } else if (lastUpdateEl) {
        lastUpdateEl.textContent = '';
      }
      
      // priority 정보 전달
      const priorities = prioritiesData && prioritiesData.success ? prioritiesData.data : null;
      renderSkillStatistics(statsData.data, job, priorities);
    })
    .catch(err => {
      container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #ef4444;">${TA('statistics.skill.error_generic', '오류가 발생했습니다.')}</div>`;
      if (lastUpdateEl) {
        lastUpdateEl.textContent = '';
      }
    });
}

// 스킬 통계 렌더링
function renderSkillStatistics(stats, job, priorities = null) {
  const container = document.getElementById('skill-stats-container');
  if (!container) return;
  
  container.innerHTML = '';
  
  const categories = [
    { key: 'active', label: TA('statistics.skill.cat_active', '액티브 스킬') },
    { key: 'passive', label: TA('statistics.skill.cat_passive', '패시브 스킬') },
    { key: 'stigma', label: TA('statistics.skill.cat_stigma', '스티그마') }
  ];
  
  categories.forEach(cat => {
    const skills = stats[cat.key] || [];
    if (skills.length === 0) return; // 데이터 없으면 스킵
    
    // 고+중+저 합이 최소 기준 미만인 스킬 필터링 (TW는 랭커 수가 적으므로 기준 완화)
    const minSkillCount = IS_TW ? 1 : 10;
    let filteredSkills = skills.filter(skill => {
      const totalCount = skill.high_tier_count + skill.mid_tier_count + skill.low_tier_count;
      return totalCount >= minSkillCount;
    });
    
    // priority 순으로 정렬
    if (priorities && priorities[cat.key] && priorities[cat.key].length > 0) {
      const priorityMap = {};
      priorities[cat.key].forEach((p, idx) => {
        priorityMap[p.skill_name] = idx;
      });
      filteredSkills.sort((a, b) => {
        const priorityA = priorityMap[a.name] !== undefined ? priorityMap[a.name] : 9999;
        const priorityB = priorityMap[b.name] !== undefined ? priorityMap[b.name] : 9999;
        return priorityA - priorityB;
      });
    }
    
    if (filteredSkills.length === 0) return; // 필터링 후 데이터 없으면 스킵
    
    const col = document.createElement('div');
    col.className = 'skill-stats-column';
    
    col.innerHTML = `
      <div class="skill-stats-col-header">
        <span>${cat.label}</span>
        <span style="font-size: 0.8rem; color: var(--text-muted);">${TA('statistics.skill.count_suffix', '{n}개').replace(/\{n\}/g, String(filteredSkills.length))}</span>
      </div>
      <div class="skill-stats-list">
        ${filteredSkills.map((skill, index) => {
          // 게이지: 막대 100% = 100명 기준 (스택 합은 최대 100%)
          const GAUGE_DENOM = 100;
          const h = skill.high_tier_count;
          const m = skill.mid_tier_count;
          const l = skill.low_tier_count;
          const tierSum = h + m + l;
          const filledPct = Math.min(100, (tierSum / GAUGE_DENOM) * 100);
          let highPct = 0;
          let midPct = 0;
          let lowPct = 0;
          if (tierSum > 0) {
            highPct = (h / tierSum) * filledPct;
            midPct = (m / tierSum) * filledPct;
            lowPct = (l / tierSum) * filledPct;
          }
          const displayRate = Math.min(100, (h / GAUGE_DENOM) * 100);
          
          const iconUrl = (skill.icon_url && skill.icon_url.trim()) ? skill.icon_url : SKILL_ICON_PLACEHOLDER;
          const itemId = `skill-stats-item-${cat.key}-${index}`;
          
          // NEW META 뱃지: 스티그마이고, 4순위 밖이고, usage_rates[2] > 10%이고, 제외 리스트에 없으면
          let isNewMeta = false;
          if (cat.key === 'stigma' && priorities && priorities.stigma) {
            const priorityInfo = priorities.stigma.find(p => p.skill_name === skill.name);
            const usageRates = priorityInfo?.usage_rates || [0, 0, 0, 0];
            const usageRate15 = usageRates[2] || 0;  // 15렙 이상 채용률
            isNewMeta = isNewMetaSkill(skill.name, index, usageRate15);
          }

          const displaySkillName = skill.name_zh_tw || skill.name;
          return `
          <div class="skill-stats-item" id="${itemId}" data-skill-name="${skill.name}" data-skill-type="${cat.key}" ${isNewMeta ? 'data-new-meta="true"' : ''}>
            <div class="skill-stats-meta">
              <div class="skill-stats-icon-wrapper">
                <img src="${iconUrl}" alt="${displaySkillName}" class="skill-stats-icon" onerror="this.onerror=null;this.src='${SKILL_ICON_PLACEHOLDER}';">
                ${isNewMeta ? '<span class="new-meta-badge-icon" style="background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%) !important; background-color: #f97316 !important;">NEW META</span>' : ''}
              </div>
              <div class="skill-stats-header">
                <span class="skill-stats-name">${displaySkillName}</span>
                <span class="skill-stats-rate">${TA('statistics.skill.invest_rate', ' 고투자율: ')}${displayRate.toFixed(1)}%</span>
              </div>
            </div>
            <div class="skill-stats-bars">
              <div class="skill-stats-bar-segment skill-stats-bar-high" style="width: ${highPct}%"></div>
              <div class="skill-stats-bar-segment skill-stats-bar-mid" style="width: ${midPct}%"></div>
              <div class="skill-stats-bar-segment skill-stats-bar-low" style="width: ${lowPct}%"></div>
            </div>
            <div class="skill-stats-details">
              <span>${TA('statistics.skill.tier_high', '고')} ${skill.high_tier_count}${TA('statistics.skill.people_suffix', '명')}</span>
              <span>${TA('statistics.skill.tier_mid', '중')} ${skill.mid_tier_count}${TA('statistics.skill.people_suffix', '명')}</span>
              <span>${TA('statistics.skill.tier_low', '저')} ${skill.low_tier_count}${TA('statistics.skill.people_suffix', '명')}</span>
            </div>
          </div>
          `;
        }).join('')}
      </div>
    `;
    container.appendChild(col);
    
    // 각 스킬 아이템에 툴팁 추가
    if (job) {
      filteredSkills.forEach((skill, index) => {
        const itemId = `skill-stats-item-${cat.key}-${index}`;
        const skillItem = document.getElementById(itemId);
        if (skillItem) {
          skillItem.style.position = 'relative';
          const skillType = cat.key === 'active' ? 'active' : (cat.key === 'passive' ? 'passive' : 'stigma');
          // name이 한글(ko), name_zh_tw가 번체인 경우 → displayName=번체, lookupName=한글
          const displaySkillNameTooltip = skill.name_zh_tw || skill.name;
          const tooltip = createSkillTooltip(displaySkillNameTooltip, job, skillType, null, skill.name);
          if (tooltip) {
            skillItem.appendChild(tooltip);
          }
        }
      });
    }
  });
}

// 아르카나 통계 직업 선택 버튼 설정
function setupArcanaStatsClassSelector() {
  const btns = document.querySelectorAll('.arcana-stats-class-btn');
  btns.forEach(btn => {
    if (btn.dataset.listenerAttached === 'true') {
      return;
    }
    btn.addEventListener('click', function() {
      btns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      loadArcanaStatistics(this.dataset.job);
    });
    btn.dataset.listenerAttached = 'true';
  });
}

// 아르카나 통계 데이터 로드
function loadArcanaStatistics(job) {
  const container = document.getElementById('arcana-stats-container');
  const lastUpdateEl = document.getElementById('arcana-stats-last-update');
  if (!container) return;
  
  container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">${TA('statistics.arcana.loading', '데이터를 불러오는 중...')}</div>`;
  if (lastUpdateEl) lastUpdateEl.textContent = TA('statistics.skill.last_update_loading', '마지막 업데이트: 로딩 중...');
  
  fetch(`${SITE_URL_PREFIX}/api/stats/arcana-skills?job=${encodeURIComponent(job)}`)
    .then(res => res.json())
    .then(data => {
      if (!data.success) {
        container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #ef4444;">${data.error || TA('statistics.arcana.load_failed', '데이터 로드 실패')}</div>`;
        if (lastUpdateEl) lastUpdateEl.textContent = '';
        return;
      }
      // 마지막 업데이트 시간 표시
      if (lastUpdateEl && data.last_update) {
        lastUpdateEl.textContent = TA('statistics.arcana.last_update_fmt', '마지막 업데이트: {t} (KST)').replace(/\{t\}/g, data.last_update);
      } else if (lastUpdateEl) {
        lastUpdateEl.textContent = '';
      }
      renderArcanaStatistics(data.data, data.total_rankers, job);
    })
    .catch(err => {
      container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #ef4444;">${TA('statistics.arcana.error_generic', '오류가 발생했습니다.')}</div>`;
      if (lastUpdateEl) lastUpdateEl.textContent = '';
    });
}

// 아르카나 통계 렌더링
function renderArcanaStatistics(data, totalRankers, job) {
  const container = document.getElementById('arcana-stats-container');
  if (!container) return;
  
  container.innerHTML = '';
  
  // 아르카나 장비 아이콘 매핑
  const arcanaIcons = {
    '성배': '🏆',
    '양피지': '📜',
    '나침반': '🧭',
    '종': '🔔',
    '거울': '🪞',
    '천칭': '⚖️'
  };

  const arcanaNameMap = {
    '성배': TA('arcana.item.chalice', '성배'),
    '양피지': TA('arcana.item.scroll', '양피지'),
    '나침반': TA('arcana.item.compass', '나침반'),
    '종': TA('arcana.item.bell', '종'),
    '거울': TA('arcana.item.mirror', '거울'),
    '천칭': TA('arcana.item.scale', '천칭')
  };
  
  // 순위 메달
  const rankMedals = ['🥇', '🥈', '🥉'];
  
  const arcanaTypes = ['성배', '양피지', '나침반', '종', '거울', '천칭'];
  
  if (!data || Object.keys(data).length === 0) {
    container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">${TA('statistics.arcana.no_skill_data', '아르카나 스킬 데이터가 없습니다.')}</div>`;
    return;
  }
  
  // 총 랭커 수 표시
  const totalInfo = document.createElement('div');
  totalInfo.className = 'arcana-stats-total-info';
  totalInfo.style.gridColumn = '1 / -1';
  totalInfo.textContent = TA('statistics.arcana.total_info', '아툴 전투 점수 상위 {n}명 기준').replace('{n}', String(totalRankers));
  container.appendChild(totalInfo);
  
  arcanaTypes.forEach(arcanaType => {
    const arcanaData = data[arcanaType];
    if (!arcanaData || !arcanaData.skills || arcanaData.skills.length === 0) return;
    
    // 채용률 10% 미만 스킬 제외
    arcanaData.skills = arcanaData.skills.filter(s => s.pick_rate >= 10);
    
    const col = document.createElement('div');
    col.className = 'arcana-stats-column';
    
    const validCount = arcanaData.valid_count || 0;
    const skills = arcanaData.skills;
    
    let skillsHtml = skills.map((skill, index) => {
      const rankClass = index === 0 ? 'arcana-stats-rank-1' : 
                        index === 1 ? 'arcana-stats-rank-2' : 
                        index === 2 ? 'arcana-stats-rank-3' : 'arcana-stats-rank-default';
      
      // 1~3위는 메달 이모지, 4위부터는 숫자
      const rankDisplay = index < 3 ? rankMedals[index] : (index + 1);
      
      // 채용률 색상: 80% 이상 = 초록, 50~79% = 노랑, 그 이하 = 기본 보라
      const rateColor = skill.pick_rate >= 80 ? '#4ade80' : 
                        skill.pick_rate >= 50 ? '#fbbf24' : 'var(--accent)';
      // 바 색상도 동일하게
      const barColor = skill.pick_rate >= 80 ? '#4ade80' : 
                       skill.pick_rate >= 50 ? '#fbbf24' : 'var(--accent)';
      
      // 스킬 아이콘
      const iconUrl = (skill.icon_url && skill.icon_url.trim()) ? skill.icon_url : SKILL_ICON_PLACEHOLDER;
      const itemId = `arcana-stats-item-${arcanaType}-${index}`;
      const displayArcanaSkillName = skill.name_zh_tw || skill.name;
      
      return `
        <div class="arcana-stats-item" id="${itemId}" data-skill-name="${skill.name}">
          <div class="arcana-stats-item-header">
            <div style="display: flex; align-items: center;">
              <span class="arcana-stats-rank ${rankClass}">${rankDisplay}</span>
              <img src="${iconUrl}" alt="${displayArcanaSkillName}" class="arcana-stats-skill-icon" onerror="this.onerror=null;this.src='${SKILL_ICON_PLACEHOLDER}';">
              <span class="arcana-stats-name">${displayArcanaSkillName}</span>
            </div>
            <span class="arcana-stats-rate" style="color: ${rateColor};">${skill.pick_rate}%</span>
          </div>
          <div class="arcana-stats-bar-wrap">
            <div class="arcana-stats-bar" style="width: ${Math.max(skill.pick_rate, 1)}%; background-color: ${barColor} !important;"></div>
          </div>
          <div class="arcana-stats-count">${TA('statistics.arcana.count_of_valid', '{c}명 / {t}명').replace(/\{c\}/g, String(skill.count)).replace(/\{t\}/g, String(validCount))}</div>
        </div>
      `;
    }).join('');
    
    col.innerHTML = `
      <div class="arcana-stats-col-header">
        <span><span class="arcana-equip-icon">${arcanaIcons[arcanaType] || '✨'}</span>${arcanaNameMap[arcanaType] || arcanaType}</span>
        <span style="font-size: 0.8rem; color: var(--text-muted);">${TA('statistics.arcana.skills_per_slot', '{n}개 스킬').replace(/\{n\}/g, String(skills.length))}</span>
      </div>
      <div class="arcana-stats-list">
        ${skillsHtml}
      </div>
    `;
    
    container.appendChild(col);
    
    // 각 스킬 아이템에 툴팁 추가 (active, passive, stigma 순서로 시도)
    if (job && typeof createSkillTooltip === 'function') {
      skills.forEach((skill, index) => {
        const itemId = `arcana-stats-item-${arcanaType}-${index}`;
        const skillItem = document.getElementById(itemId);
        if (skillItem) {
          skillItem.style.position = 'relative';
          // active → passive → stigma 순서로 시도하여 첫 번째 매치 사용
          // name_zh_tw가 있으면 displayName=번체, lookupName=한글
          const arcanaDisplayName = skill.name_zh_tw || skill.name;
          let tooltip = createSkillTooltip(arcanaDisplayName, job, 'active', null, skill.name);
          if (!tooltip) tooltip = createSkillTooltip(arcanaDisplayName, job, 'passive', null, skill.name);
          if (!tooltip) tooltip = createSkillTooltip(arcanaDisplayName, job, 'stigma', null, skill.name);
          if (tooltip) {
            skillItem.appendChild(tooltip);
          }
        }
      });
    }
  });
}

// 통계 로드 함수
// ============================================================
// 직업 통계 (전투력 구간별 직업 점유율 + 남툴효율)
// ============================================================
const JOBSTAT_JOB_CODE = {
  '검성': 'gladiator', '수호성': 'templar', '살성': 'assassin', '궁성': 'ranger',
  '마도성': 'sorcerer', '정령성': 'elementalist', '치유성': 'cleric', '호법성': 'chanter',
  '권성': 'fighter'
};
function jobstatIconUrl(ko) {
  const c = JOBSTAT_JOB_CODE[ko];
  return c ? `https://assets.playnccdn.com/static-aion2/characters/img/class/class_icon_${c}.png` : '';
}
function classIntroImageUrl(ko) {
  if (!ko) return '';
  const prefix = (typeof SITE_URL_PREFIX !== 'undefined') ? SITE_URL_PREFIX : '';
  return `${prefix}/static/${encodeURIComponent(ko + '_소개.png')}`;
}

const JOBSTAT_MIN_CP = (typeof IS_GLOBAL !== 'undefined' && IS_GLOBAL) ? 20000 : 400000;   // 글로벌: 전투력 규모가 작아 1만 단위
const JOBSTAT_STEP = (typeof IS_GLOBAL !== 'undefined' && IS_GLOBAL) ? 10000 : 100000;
const JOBSTAT_LOW_CP = 10000;          // 최하 옵션 "10k+" (거의 전체 모집단)
const JOBSTAT_DEFAULT_CP = JOBSTAT_LOW_CP;  // 디폴트 = 10k+
let jobstatCpByClass = null;      // combat-power-by-class 캐시 (남툴효율 계산용)
let jobstatThreshold = JOBSTAT_DEFAULT_CP;
let jobstatDropdownBuilt = false;
const jobstatStatsCache = {};     // threshold -> /api/statistics data (세션 메모리 캐시)
// 정렬 상태 + 마지막 렌더 데이터 (재정렬 시 재요청 없음)
let jobstatSort = { key: 'count', dir: 'desc' };
let jobstatLastRows = null, jobstatLastTotal = 0, jobstatLastEff = null;

// combat-power-by-class 데이터 확보: 이미 로드돼 있으면 재사용(추가 호출 0), 없으면 1회 fetch
async function jobstatEnsureCpByClass() {
  if (jobstatCpByClass) return jobstatCpByClass;
  if (typeof cpStatsData !== 'undefined' && cpStatsData && cpStatsData.class_data) {
    jobstatCpByClass = cpStatsData;
    return jobstatCpByClass;
  }
  if (typeof IS_TW !== 'undefined' && IS_TW) return null; // KO 전용 엔드포인트
  try {
    const res = await fetch(`${SITE_URL_PREFIX}/api/statistics/combat-power-by-class`);
    const json = await res.json();
    if (json && json.success && json.data && json.data.class_data) {
      jobstatCpByClass = json.data;
    }
  } catch (e) { /* 무시 - 남툴효율만 비표시 */ }
  return jobstatCpByClass;
}

// 남툴효율 지수(100 기준): 동일 아이템레벨 버킷 대비 전투력 비율의 표본가중 평균.
// 선택한 전투력 임계값(threshold) 이상의 중앙값을 가진 버킷만 반영(threshold-scoped).
function jobstatComputeEfficiency(cpByClass, threshold) {
  const result = {};
  if (!cpByClass || !cpByClass.class_data) return result;
  const classData = cpByClass.class_data;
  const jobs = Object.keys(classData);

  // 버킷(아이템레벨)별 전 직업 중앙값 평균 = baseline
  const bucketSum = {}, bucketCnt = {};
  jobs.forEach(job => {
    (classData[job].buckets || []).forEach(b => {
      if (typeof b.median !== 'number') return;
      bucketSum[b.bucket_lo] = (bucketSum[b.bucket_lo] || 0) + b.median;
      bucketCnt[b.bucket_lo] = (bucketCnt[b.bucket_lo] || 0) + 1;
    });
  });
  const baseline = {};
  Object.keys(bucketSum).forEach(k => { baseline[k] = bucketSum[k] / bucketCnt[k]; });

  jobs.forEach(job => {
    let wsum = 0, w = 0;
    (classData[job].buckets || []).forEach(b => {
      if (typeof b.median !== 'number' || b.median < threshold) return;
      const base = baseline[b.bucket_lo];
      if (!base || base <= 0) return;
      const weight = b.count || 1;
      wsum += (b.median / base) * weight;
      w += weight;
    });
    result[job] = w > 0 ? (wsum / w) * 100 : null;
  });
  return result;
}

function jobstatBuildDropdown(maxCp2) {
  const select = document.getElementById('jobstat-cp-select');
  if (!select || jobstatDropdownBuilt) return;
  let topStep = JOBSTAT_MIN_CP;
  if (typeof maxCp2 === 'number' && maxCp2 > JOBSTAT_MIN_CP) {
    topStep = Math.floor(maxCp2 / JOBSTAT_STEP) * JOBSTAT_STEP;
  }
  let html = `<option value="${JOBSTAT_LOW_CP}">${Math.round(JOBSTAT_LOW_CP / 1000)}k+</option>`;
  for (let v = JOBSTAT_MIN_CP; v <= topStep; v += JOBSTAT_STEP) {
    html += `<option value="${v}">${Math.round(v / 1000)}k+</option>`;
  }
  select.innerHTML = html;
  select.value = String(jobstatThreshold);
  jobstatDropdownBuilt = true;
}

const JOBSTAT_CHART_ORDER = ['검성', '수호성', '살성', '궁성', '마도성', '정령성', '치유성', '호법성', '권성'];
const JOBSTAT_CHART_COLORS = {
  '검성': '#f97316', '수호성': '#eab308', '살성': '#a855f7', '궁성': '#22c55e',
  '마도성': '#3b82f6', '정령성': '#06b6d4', '치유성': '#ec4899', '호법성': '#fb7185',
  '권성': '#dc2626',
};
const jobstatTimeseriesCache = {};
let jobstatChart = null;
let jobstatChartResizeHandler = null;
let jobstatChartHidden = {};
let jobstatChartPayload = null;
let jobstatChartPayloadFull = null;
let jobstatChartViewMode = 'change';
let jobstatChartAvailableDates = [];
let jobstatChartStartDate = null;

function jobstatFilterPayloadByStartDate(payload, startDate) {
  const dates = payload.dates || [];
  if (!dates.length) return payload;
  let idx = dates.indexOf(startDate);
  if (idx < 0) idx = 0;
  const filteredDates = dates.slice(idx);
  const jobs = payload.jobs || Object.keys(payload.chart_series || {});
  const chartSeries = {};
  jobs.forEach(job => {
    chartSeries[job] = (payload.chart_series[job] || []).slice(idx);
  });
  return Object.assign({}, payload, { dates: filteredDates, chart_series: chartSeries });
}

function _snapJobstatDateInput(input) {
  const dates = jobstatChartAvailableDates || [];
  if (!input.value || dates.length === 0) return;
  if (dates.indexOf(input.value) !== -1) return;
  const picked = new Date(input.value).getTime();
  let nearest = dates[0];
  let best = Infinity;
  for (const d of dates) {
    const diff = Math.abs(new Date(d).getTime() - picked);
    if (diff < best) { best = diff; nearest = d; }
  }
  input.value = nearest;
}

function setupJobstatDateControls(dates) {
  const controls = document.getElementById('jobstat-date-controls');
  const startInput = document.getElementById('jobstat-date-start');
  if (!controls || !startInput) return;

  jobstatChartAvailableDates = dates || [];
  if (!dates.length) {
    controls.style.display = 'none';
    return;
  }
  controls.style.display = 'flex';

  const minDate = dates[0];
  const maxDate = dates[dates.length - 1];
  startInput.min = minDate;
  startInput.max = maxDate;

  if (!jobstatChartStartDate || dates.indexOf(jobstatChartStartDate) === -1) {
    jobstatChartStartDate = minDate;
  }
  startInput.value = jobstatChartStartDate;

  if (!startInput.dataset.bound) {
    startInput.dataset.bound = '1';
    startInput.addEventListener('change', () => {
      _snapJobstatDateInput(startInput);
      jobstatChartStartDate = startInput.value;
      jobstatApplyStartDateFilter();
    });
    const field = startInput.closest('.jobstat-date-field');
    if (field && !field.dataset.pickerBound) {
      field.dataset.pickerBound = '1';
      field.addEventListener('click', (e) => {
        e.preventDefault();
        try { startInput.showPicker(); } catch (err) { startInput.focus(); }
      });
    }
  }
}

function jobstatApplyStartDateFilter() {
  if (!jobstatChartPayloadFull) return;
  jobstatChartPayload = jobstatFilterPayloadByStartDate(jobstatChartPayloadFull, jobstatChartStartDate);
  renderJobstatChart(jobstatChartPayload);
}

function jobstatFormatSignedPct(v, digits) {
  const d = digits != null ? digits : (Math.abs(v) >= 10 ? 1 : 2);
  if (v > 0) return `+${v.toFixed(d)}%`;
  if (v < 0) return `${v.toFixed(d)}%`;
  return '0%';
}

function jobstatTransformJobSeries(raw, mode) {
  if (mode === 'absolute') return raw.slice();
  const base = raw[0] || 0;
  if (base <= 0) return raw.map(() => 0);
  return raw.map(v => ((v / base) - 1) * 100);
}

function jobstatFormatYTick(mode, v) {
  if (mode === 'absolute') {
    return v >= 10000 ? (v / 10000) + '만' : v.toLocaleString();
  }
  return jobstatFormatSignedPct(v);
}

function jobstatFormatTooltipLabel(mode, y, rawCount) {
  const unit = TA('statistics.population.unit', '명');
  if (mode === 'absolute') return `${y.toLocaleString()}${unit}`;
  return `${jobstatFormatSignedPct(y, 2)} (${rawCount.toLocaleString()}${unit})`;
}

function jobstatBuildChartSeries(payload, mode) {
  const dates = payload.dates || [];
  const chartSeries = payload.chart_series || {};
  const jobs = payload.jobs || Object.keys(chartSeries);
  const orderedJobs = JOBSTAT_CHART_ORDER.filter(j => jobs.indexOf(j) !== -1)
    .concat(jobs.filter(j => JOBSTAT_CHART_ORDER.indexOf(j) === -1 && j !== '-'));
  return orderedJobs.map(job => {
    const raw = chartSeries[job] || dates.map(() => 0);
    return { job, raw, data: jobstatTransformJobSeries(raw, mode) };
  });
}

function jobstatUpdateModeHint() {
  const el = document.getElementById('jobstat-chart-mode-hint');
  if (!el) return;
  if (jobstatChartViewMode === 'change') {
    el.textContent = TA('statistics.job.chart_mode_change_hint', '시작일 대비 증감률(%) · 기준일=0%');
    el.style.display = '';
  } else {
    el.style.display = 'none';
  }
}

function jobstatSyncViewModeButtons() {
  document.querySelectorAll('.jobstat-view-mode-btn').forEach(btn => {
    const active = btn.getAttribute('data-mode') === jobstatChartViewMode;
    btn.classList.toggle('active', active);
    btn.setAttribute('aria-selected', active ? 'true' : 'false');
  });
}

function setupJobstatViewModeToggle() {
  const wrap = document.getElementById('jobstat-view-mode-wrap');
  if (!wrap || wrap.dataset.bound === '1') return;
  wrap.dataset.bound = '1';
  wrap.querySelectorAll('.jobstat-view-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      if (!mode || mode === jobstatChartViewMode) return;
      jobstatChartViewMode = mode;
      jobstatSyncViewModeButtons();
      jobstatUpdateModeHint();
      if (jobstatChartPayload) jobstatRefreshChartDisplay();
    });
  });
}

function jobstatRefreshChartDisplay() {
  if (!jobstatChart || !jobstatChartPayload) return;
  const built = jobstatBuildChartSeries(jobstatChartPayload, jobstatChartViewMode);
  built.forEach(({ job, raw, data }) => {
    const ds = jobstatChart.data.datasets.find(d => d._jobKey === job);
    if (!ds) return;
    ds.data = data;
    ds._rawData = raw;
  });
  updateJobstatChartYScale();
  jobstatChart.options.scales.y.ticks.callback = (v) => jobstatFormatYTick(jobstatChartViewMode, v);
  jobstatChart.update();
}

function computeDynamicChartYBounds(values, paddingRatio) {
  const pad = paddingRatio != null ? paddingRatio : 0.12;
  const nums = [];
  (values || []).forEach(v => {
    if (Array.isArray(v)) v.forEach(x => { if (typeof x === 'number' && isFinite(x)) nums.push(x); });
    else if (typeof v === 'number' && isFinite(v)) nums.push(v);
  });
  if (!nums.length) return { min: undefined, max: undefined };
  let min = Math.min(...nums);
  let max = Math.max(...nums);
  if (min === max) {
    const bump = Math.max(1, Math.abs(min) * 0.05);
    min -= bump;
    max += bump;
  }
  const span = max - min;
  const margin = span * pad;
  return { min: Math.floor(min - margin), max: Math.ceil(max + margin) };
}

function applyDynamicYScale(chart, getValues) {
  if (!chart || !chart.options || !chart.options.scales || !chart.options.scales.y) return;
  const bounds = computeDynamicChartYBounds(getValues());
  chart.options.scales.y.min = bounds.min;
  chart.options.scales.y.max = bounds.max;
  chart.options.scales.y.beginAtZero = false;
}

function updateJobstatChartYScale() {
  if (!jobstatChart) return;
  applyDynamicYScale(jobstatChart, () => {
    const vals = [];
    jobstatChart.data.datasets.forEach(ds => {
      if (ds.hidden) return;
      (ds.data || []).forEach(v => vals.push(v));
    });
    return vals;
  });
  if (jobstatChartViewMode === 'change') {
    const yScale = jobstatChart.options.scales.y;
    if (yScale.min != null && yScale.max != null) {
      yScale.min = Math.min(yScale.min, 0);
      yScale.max = Math.max(yScale.max, 0);
    }
  }
}

function jobstatCpLabel(threshold) {
  return `${Math.round(threshold / 1000)}k+`;
}

function jobstatUpdateChartCpLabel() {
  const el = document.getElementById('jobstat-chart-cp-label');
  if (el) el.textContent = jobstatCpLabel(jobstatThreshold);
}

async function loadJobstatTimeseries() {
  const chartWrap = document.getElementById('jobstat-chart-wrap');
  const chartSection = document.getElementById('jobstat-chart-section');
  if (!chartWrap || !chartSection) return;
  if (typeof IS_TW !== 'undefined' && IS_TW) {
    chartSection.style.display = 'none';
    return;
  }
  chartSection.style.display = '';
  jobstatUpdateChartCpLabel();

  let payload = jobstatTimeseriesCache[jobstatThreshold];
  if (!payload) {
    chartWrap.innerHTML = `<div class="jobstat-chart-loading">${TA('statistics.job.chart_loading', '차트를 불러오는 중...')}</div>`;
    try {
      const res = await fetch(`${SITE_URL_PREFIX}/api/statistics/job/timeseries?min_cp2=${jobstatThreshold}`, {
        cache: 'default', headers: { 'Cache-Control': 'max-age=3600' }
      });
      const json = await res.json();
      if (!json.success) {
        chartWrap.innerHTML = `<div class="jobstat-chart-error">${TA('statistics.job.chart_load_error', '차트 데이터를 불러올 수 없습니다.')}</div>`;
        return;
      }
      payload = json;
      jobstatTimeseriesCache[jobstatThreshold] = payload;
    } catch (e) {
      chartWrap.innerHTML = `<div class="jobstat-chart-error">${TA('statistics.job.chart_load_error', '차트 데이터를 불러올 수 없습니다.')}</div>`;
      return;
    }
  }
  jobstatChartPayloadFull = payload;
  jobstatChartStartDate = null;
  setupJobstatDateControls(payload.dates || []);
  jobstatChartPayload = jobstatFilterPayloadByStartDate(payload, jobstatChartStartDate);
  renderJobstatChart(jobstatChartPayload);
}

function renderJobstatLegend(jobs) {
  const legendEl = document.getElementById('jobstat-chart-legend');
  if (!legendEl) return;
  const ordered = JOBSTAT_CHART_ORDER.filter(j => jobs.indexOf(j) !== -1)
    .concat(jobs.filter(j => JOBSTAT_CHART_ORDER.indexOf(j) === -1 && j !== '-'));
  legendEl.innerHTML = ordered.map(job => {
    const color = JOBSTAT_CHART_COLORS[job] || '#9d8cff';
    const icon = jobstatIconUrl(job);
    const off = jobstatChartHidden[job] ? ' off' : '';
    const iconHtml = icon
      ? `<img class="jobstat-legend-icon" src="${icon}" alt="${job}" loading="lazy" onerror="this.style.visibility='hidden'">`
      : `<span class="jobstat-legend-swatch" style="background:${color}"></span>`;
    return `<button type="button" class="jobstat-legend-item${off}" data-job="${job}" aria-pressed="${jobstatChartHidden[job] ? 'false' : 'true'}">
      ${iconHtml}<span class="jobstat-legend-swatch" style="background:${color}"></span><span>${job}</span>
    </button>`;
  }).join('');

  legendEl.querySelectorAll('.jobstat-legend-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const job = btn.getAttribute('data-job');
      jobstatChartHidden[job] = !jobstatChartHidden[job];
      if (jobstatChart) {
        const ds = jobstatChart.data.datasets.find(d => d._jobKey === job);
        if (ds) {
          ds.hidden = !!jobstatChartHidden[job];
          updateJobstatChartYScale();
          jobstatChart.update();
        }
      }
      btn.classList.toggle('off', !!jobstatChartHidden[job]);
      btn.setAttribute('aria-pressed', jobstatChartHidden[job] ? 'false' : 'true');
    });
  });
}

function renderJobstatChart(payload) {
  const chartWrap = document.getElementById('jobstat-chart-wrap');
  if (!chartWrap || !payload) return;

  jobstatChartPayload = payload;
  setupJobstatViewModeToggle();
  jobstatSyncViewModeButtons();
  jobstatUpdateModeHint();

  if (jobstatChart) {
    if (jobstatChartResizeHandler) {
      window.removeEventListener('resize', jobstatChartResizeHandler);
      jobstatChartResizeHandler = null;
    }
    try { jobstatChart.destroy(); } catch (e) {}
    jobstatChart = null;
  }

  const dates = payload.dates || [];
  const chartSeries = payload.chart_series || {};
  const jobs = payload.jobs || Object.keys(chartSeries);
  if (!dates.length || !jobs.length) {
    chartWrap.innerHTML = `<div class="jobstat-chart-loading">${TA('statistics.job.empty_range', '선택된 구간의 데이터가 없습니다.')}</div>`;
    const legendEl = document.getElementById('jobstat-chart-legend');
    if (legendEl) legendEl.innerHTML = '';
    return;
  }

  chartWrap.innerHTML = '<div style="position:relative;width:100%;height:100%;"><canvas id="jobstat-pop-chart"></canvas></div>';
  const canvas = document.getElementById('jobstat-pop-chart');
  renderJobstatLegend(jobs);

  const buildChart = () => {
    const ctx = canvas.getContext('2d');
    const isMobile = window.innerWidth <= 768;
    const mode = jobstatChartViewMode;
    const built = jobstatBuildChartSeries(payload, mode);

    const datasets = built.map(({ job, raw, data }) => {
      const color = JOBSTAT_CHART_COLORS[job] || '#9d8cff';
      return {
        _jobKey: job,
        _rawData: raw,
        label: job,
        data: data,
        borderColor: color,
        backgroundColor: color + '22',
        borderWidth: 2.2,
        fill: false,
        tension: 0.35,
        pointRadius: dates.length <= 14 ? 3 : 0,
        pointHoverRadius: 6,
        pointBackgroundColor: color,
        pointBorderColor: '#fff',
        pointBorderWidth: 1.5,
        hidden: !!jobstatChartHidden[job],
      };
    });

    const visibleValues = [];
    datasets.forEach(ds => {
      if (ds.hidden) return;
      (ds.data || []).forEach(v => visibleValues.push(v));
    });
    const yBounds = computeDynamicChartYBounds(visibleValues);
    if (mode === 'change' && yBounds.min != null && yBounds.max != null) {
      yBounds.min = Math.min(yBounds.min, 0);
      yBounds.max = Math.max(yBounds.max, 0);
    }

    jobstatChart = new Chart(ctx, {
      type: 'line',
      data: { labels: dates, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(9, 16, 37, 0.98)',
            titleColor: '#f5f7ff',
            bodyColor: '#cbd5e1',
            borderColor: 'rgba(157, 140, 255, 0.45)',
            borderWidth: 1.5,
            padding: 12,
            boxPadding: 4,
            usePointStyle: true,
            titleFont: { family: 'Pretendard', size: 12, weight: '600' },
            bodyFont: { family: 'Pretendard', size: 12, weight: '600' },
            itemSort: (a, b) => (b.parsed.y || 0) - (a.parsed.y || 0),
            callbacks: {
              title: (items) => items.length ? items[0].label : '',
              label: (ctx2) => {
                const rawCount = (ctx2.dataset._rawData && ctx2.dataset._rawData[ctx2.dataIndex]) || 0;
                const val = jobstatFormatTooltipLabel(jobstatChartViewMode, ctx2.parsed.y, rawCount);
                return ` ${ctx2.dataset.label}: ${val}`;
              },
              labelColor: (ctx2) => ({
                borderColor: JOBSTAT_CHART_COLORS[ctx2.dataset.label] || '#9d8cff',
                backgroundColor: JOBSTAT_CHART_COLORS[ctx2.dataset.label] || '#9d8cff',
              }),
            },
          },
        },
        scales: {
          x: {
            ticks: {
              color: '#8b95b5',
              font: { family: 'Pretendard', size: isMobile ? 10 : 11 },
              maxRotation: 0, autoSkip: true, maxTicksLimit: isMobile ? 5 : 10,
            },
            grid: { color: 'rgba(255,255,255,0.05)' },
          },
          y: {
            min: yBounds.min,
            max: yBounds.max,
            ticks: {
              color: '#8b95b5',
              font: { family: 'Pretendard', size: isMobile ? 10 : 11 },
              callback: (v) => jobstatFormatYTick(mode, v),
            },
            grid: { color: 'rgba(255,255,255,0.06)' },
            beginAtZero: false,
          },
        },
      },
    });

    let rt;
    const handler = () => {
      clearTimeout(rt);
      rt = setTimeout(() => { try { jobstatChart && jobstatChart.resize(); } catch (e) {} }, 100);
    };
    jobstatChartResizeHandler = handler;
    window.addEventListener('resize', handler);
  };

  if (typeof Chart === 'undefined') {
    let n = 0;
    const iv = setInterval(() => {
      n++;
      if (typeof Chart !== 'undefined') { clearInterval(iv); buildChart(); }
      else if (n >= 100) { clearInterval(iv); }
    }, 100);
    return;
  }
  buildChart();
}

async function loadStatistics() {
  const jobContainer = document.getElementById('job-statistics-container');
  if (!jobContainer) return;

  const select = document.getElementById('jobstat-cp-select');
  if (select && select.value) jobstatThreshold = parseInt(select.value, 10) || JOBSTAT_MIN_CP;

  // 남툴효율 데이터 미리 확보(이미 로드된 경우 즉시 재사용)
  jobstatEnsureCpByClass();
  loadJobstatTimeseries();

  let data = jobstatStatsCache[jobstatThreshold];
  if (!data) {
    jobContainer.innerHTML = `<p style="text-align: center; color: var(--text-secondary);">${TA('statistics.job.loading', '로딩 중...')}</p>`;
    try {
      const params = new URLSearchParams();
      params.append('min_power', 0);      // 아이템 레벨 전체 (서버 기본값이 0~4999로 제한되므로 명시)
      params.append('max_power', 10000);
      params.append('min_cp2', jobstatThreshold);
      const res = await fetch(`${SITE_URL_PREFIX}/api/statistics?${params.toString()}`, {
        cache: 'default', headers: { 'Cache-Control': 'max-age=3600' }
      });
      const json = await res.json();
      if (!json.success || !json.data) {
        jobContainer.innerHTML = `<p style="text-align: center; color: var(--text-secondary);">${TA('statistics.job.load_failed', '통계 데이터를 불러올 수 없습니다.')}</p>`;
        return;
      }
      data = json.data;
      jobstatStatsCache[jobstatThreshold] = data;
    } catch (e) {
      jobContainer.innerHTML = `<p style="text-align: center; color: var(--text-secondary);">${TA('statistics.job.load_error', '통계 데이터를 불러오는 중 오류가 발생했습니다.')}</p>`;
      return;
    }
  }

  // 드롭다운 옵션 구성(최초 1회, 전투력 최대값 기준 50k 단위)
  jobstatBuildDropdown(data.bounds_cp2 && typeof data.bounds_cp2.max === 'number' ? data.bounds_cp2.max : JOBSTAT_MIN_CP);
  if (select) select.value = String(jobstatThreshold);

  const updateInfoEl = document.getElementById('job-statistics-update-info');
  if (updateInfoEl) {
    updateInfoEl.textContent = data.last_updated
      ? `${TA('statistics.job.recent_update', _t('최근 업데이트', '最近更新'))}: ${data.last_updated}`
      : '';
  }

  const renderNow = () => {
    const eff = jobstatComputeEfficiency(jobstatCpByClass, jobstatThreshold);
    jobstatRenderTable(data.job_stats, data.filtered_count, eff, jobContainer);
  };
  renderNow();
  if (!jobstatCpByClass) {
    // 효율 데이터가 늦게 도착하면 도착 후 재렌더
    jobstatEnsureCpByClass().then(d => { if (d) renderNow(); });
  }
}

// 신규 직업통계 UI에서는 미사용(구 슬라이더 메타 처리 함수 자리)
function applyStatisticsMeta() {}

function jobstatSortArrow(key) {
  const active = jobstatSort.key === key;
  const up = active && jobstatSort.dir === 'asc' ? ' on' : '';
  const down = active && jobstatSort.dir === 'desc' ? ' on' : '';
  return `<span class="jobstat-sort-ic"><span class="jobstat-arr${up}">▲</span><span class="jobstat-arr${down}">▼</span></span>`;
}

function jobstatSortBy(key) {
  if (jobstatSort.key === key) {
    jobstatSort.dir = jobstatSort.dir === 'desc' ? 'asc' : 'desc';
  } else {
    jobstatSort.key = key;
    jobstatSort.dir = (key === 'job') ? 'asc' : 'desc';
  }
  const container = document.getElementById('job-statistics-container');
  if (container && jobstatLastRows) {
    jobstatRenderTable(jobstatLastRows, jobstatLastTotal, jobstatLastEff, container);
  }
}
window.jobstatSortBy = jobstatSortBy;

function jobstatPositionHelpTip(helpEl) {
  const tip = helpEl && helpEl.querySelector('.jobstat-tip');
  if (!tip || window.innerWidth > 768) return;
  const rect = helpEl.getBoundingClientRect();
  const gap = 6;
  const pad = 16;
  tip.style.left = pad + 'px';
  tip.style.right = pad + 'px';
  tip.style.width = 'auto';
  tip.style.transform = 'none';
  tip.style.top = (rect.bottom + gap) + 'px';
  const tipH = tip.offsetHeight || 120;
  let top = rect.bottom + gap;
  if (top + tipH > window.innerHeight - 12) {
    top = Math.max(12, rect.top - tipH - gap);
  }
  tip.style.top = top + 'px';
}

function jobstatResetHelpTip(helpEl) {
  const tip = helpEl && helpEl.querySelector('.jobstat-tip');
  if (!tip) return;
  tip.style.top = '';
  tip.style.left = '';
  tip.style.right = '';
  tip.style.transform = '';
}

function jobstatBindHelpTips(container) {
  if (!container) return;
  container.querySelectorAll('.jobstat-help').forEach(help => {
    help.addEventListener('mouseenter', () => jobstatPositionHelpTip(help));
    help.addEventListener('mouseleave', () => jobstatResetHelpTip(help));
  });
}

function jobstatRenderTable(jobStats, totalCount, effMap, container) {
  if (!jobStats || jobStats.length === 0 || !totalCount) {
    container.innerHTML = `<p style="text-align: center; color: var(--text-secondary);">${TA('statistics.job.empty_range', '선택된 전투력 구간의 데이터가 없습니다.')}</p>`;
    return;
  }
  // 재정렬을 위해 원본 보관
  jobstatLastRows = jobStats;
  jobstatLastTotal = totalCount;
  jobstatLastEff = effMap;

  const rows = jobStats.filter(s => s.job && s.job !== '-' && s.job !== '');
  if (rows.length === 0) {
    container.innerHTML = `<p style="text-align: center; color: var(--text-secondary);">${TA('statistics.job.empty_range', '선택된 전투력 구간의 데이터가 없습니다.')}</p>`;
    return;
  }
  const hasEff = effMap && Object.keys(effMap).length > 0;
  const nameOf = (job) => (typeof displayJobLabel === 'function' ? displayJobLabel(job) : job);
  const effOf = (job) => (hasEff ? effMap[job] : null);

  // # 는 현재 정렬 기준 컬럼의 내림차순 순위 (값 높을수록 1위, 값 없는 항목은 마지막)
  const rankValue = (s) => {
    if (jobstatSort.key === 'share') return s.percentage || 0;
    if (jobstatSort.key === 'eff') { const e = effOf(s.job); return typeof e === 'number' ? e : -Infinity; }
    return s.count || 0;
  };
  const rankMap = {};
  [...rows].sort((a, b) => rankValue(b) - rankValue(a)).forEach((s, i) => { rankMap[s.job] = i + 1; });

  // 정렬
  const dir = jobstatSort.dir === 'asc' ? 1 : -1;
  const sorted = [...rows].sort((a, b) => {
    const key = jobstatSort.key;
    if (key === 'job') return nameOf(a.job).localeCompare(nameOf(b.job)) * dir;
    if (key === 'eff') {
      const av = effOf(a.job), bv = effOf(b.job);
      const an = typeof av === 'number', bn = typeof bv === 'number';
      if (!an && !bn) return 0;
      if (!an) return 1;   // 값 없는 항목은 항상 아래로
      if (!bn) return -1;
      return (av - bv) * dir;
    }
    const av = key === 'share' ? (a.percentage || 0) : (a.count || 0);
    const bv = key === 'share' ? (b.percentage || 0) : (b.count || 0);
    return (av - bv) * dir;
  });

  const thJob = TA('statistics.job.col_job', '직업');
  const thShare = TA('statistics.job.col_share', '점유율');
  const thPop = TA('statistics.job.col_population', '인구');
  const thEff = TA('statistics.job.col_efficiency', '남툴효율');
  const effTip = TA('statistics.job.eff_tooltip', '동일 아이템 레벨 대비 전투력(남툴) 효율입니다. 같은 아이템 레벨 구간에서 전 직업 평균 전투력을 100으로 봤을 때의 상대 지수이며, 100보다 높을수록 같은 장비로 더 높은 전투력을 냅니다. 선택한 전투력 구간 이상에서 계산됩니다.');

  let html = '<div class="jobstat-table-wrap"><table class="jobstat-table"><thead><tr>';
  html += `<th class="jobstat-col-rank">#</th>`;
  html += `<th class="jobstat-col-job">${thJob}</th>`;
  html += `<th class="jobstat-th-sort jobstat-col-share" onclick="jobstatSortBy('share')">${thShare}${jobstatSortArrow('share')}</th>`;
  html += `<th class="jobstat-th-sort jobstat-col-pop" onclick="jobstatSortBy('count')">${thPop}${jobstatSortArrow('count')}</th>`;
  if (hasEff) {
    html += `<th class="jobstat-th-sort" onclick="jobstatSortBy('eff')">${thEff}<span class="jobstat-help" onclick="event.stopPropagation()">?<span class="jobstat-tip">${effTip}</span></span>${jobstatSortArrow('eff')}</th>`;
  }
  html += '</tr></thead><tbody>';

  sorted.forEach((s, i) => {
    const pct = s.percentage || 0;
    const name = nameOf(s.job);
    const icon = jobstatIconUrl(s.job);
    const iconHtml = icon
      ? `<img class="jobstat-job-icon" src="${icon}" alt="${name}" loading="lazy" onerror="this.style.visibility='hidden'">`
      : `<span class="jobstat-job-icon"></span>`;
    let effCell = '';
    if (hasEff) {
      const e = effOf(s.job);
      if (typeof e === 'number') {
        const cls = e >= 102 ? 'jobstat-eff-high' : (e <= 98 ? 'jobstat-eff-low' : '');
        effCell = `<td><span class="jobstat-eff-val ${cls}">${e.toFixed(1)}</span></td>`;
      } else {
        effCell = `<td><span class="jobstat-eff-na">-</span></td>`;
      }
    }
    const code = JOBSTAT_JOB_CODE[s.job] || '';
    const rowHref = code ? `${SITE_URL_PREFIX}/statistics/jobstats/${code}` : '';
    const clickAttr = code ? ` class="jobstat-row-link" data-cd-code="${code}" data-cd-href="${rowHref}"` : '';
    const chevron = code ? '<span class="jobstat-row-chevron">›</span>' : '';
    html += `<tr${clickAttr}>
      <td class="jobstat-col-rank">${rankMap[s.job]}</td>
      <td><div class="jobstat-job-cell">${iconHtml}<span class="jobstat-job-name">${name}</span>${s.job === '권성' ? '<sup class="new-class-badge">NEW</sup>' : ''}${chevron}</div></td>
      <td class="jobstat-col-share">${pct}%</td>
      <td class="jobstat-col-pop">${s.count.toLocaleString()}</td>
      ${effCell}
    </tr>`;
  });

  html += '</tbody><tfoot><tr>';
  html += `<td></td><td class="jobstat-foot-label">${TA('statistics.job.total', '총합')}</td>`;
  html += `<td class="jobstat-col-share">100%</td>`;
  html += `<td class="jobstat-col-pop">${totalCount.toLocaleString()}</td>`;
  if (hasEff) html += `<td></td>`;
  html += '</tr></tfoot></table></div>';
  container.innerHTML = html;
  jobstatBindHelpTips(container);
  jobstatBindRowLinks(container);
}

// 직업 통계 테이블 행: 좌클릭=SPA 전환, 휠(가운데)클릭·Ctrl/Cmd+클릭=새 탭으로 열기
function jobstatBindRowLinks(container) {
  if (!container) return;
  container.querySelectorAll('.jobstat-row-link').forEach(tr => {
    const code = tr.getAttribute('data-cd-code');
    const href = tr.getAttribute('data-cd-href');
    if (!code) return;
    tr.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey) {
        if (href) window.open(href, '_blank', 'noopener');
        return;
      }
      openClassDetail(code);
    });
    tr.addEventListener('auxclick', (e) => {
      if (e.button === 1 && href) { e.preventDefault(); window.open(href, '_blank', 'noopener'); }
    });
    // 가운데 버튼 기본 동작(오토스크롤) 방지
    tr.addEventListener('mousedown', (e) => { if (e.button === 1) e.preventDefault(); });
  });
}

