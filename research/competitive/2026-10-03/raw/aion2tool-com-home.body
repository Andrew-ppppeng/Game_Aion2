                      </tr>
                    </tbody>
                  </table>
                  <div id="contents-ranking-pagination" class="pagination-container" style="display: none; margin-top: 1.5rem; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap;"></div>
