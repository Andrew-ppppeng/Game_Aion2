  /* ============================================================ */

  /* 노출 페이지 조건: 홈(/) 경로에서만 표시 */
  var pathname = window.location.pathname;
  if (pathname !== '/') return;

  /* dev 환경 / ?test=venatus / ?page=venatus 에서는 시간 체크 건너뛰고
   * 항상 "가장 최신(배열 마지막) 캠페인" 노출 - 라이브 송출 전 미리보기/QA 용
   * ?test=venatus&campaign=<eventId> 로 특정 캠페인 강제 미리보기도 가능 */
  var hostname = window.location.hostname;
  var params = new URLSearchParams(window.location.search);
  var isDevPreview = (hostname === 'dev.aion2tool.com'
                  || params.get('test') === 'venatus'
                  || params.get('page') === 'venatus');

  /* 노출할 캠페인 결정 */
  var activeAd = null;
  if (isDevPreview) {
    var forcedId = params.get('campaign');
    if (forcedId) {
      for (var i = 0; i < CAMPAIGNS.length; i++) {
        if (CAMPAIGNS[i].eventId === forcedId) { activeAd = CAMPAIGNS[i]; break; }
      }
    }
    if (!activeAd) activeAd = CAMPAIGNS[CAMPAIGNS.length - 1]; /* 기본: 최신 캠페인 */
  } else {
    /* 한국 시간(KST) 기준 시간대 매칭
     * - Date.now() : 현재 UTC ms
     * - +9h 더하면 "현재 KST를 UTC인 것처럼" 표현한 ms
     * - 시작/종료 문자열 뒤에 'Z'를 붙여 UTC로 파싱 → 같은 기준으로 비교 */
    var nowKstMs = Date.now() + (9 * 3600 * 1000);
    var inRange = function (ad) {
      var s = Date.parse(ad.startKst + 'Z');
      var e = Date.parse(ad.endKst   + 'Z');
      if (isNaN(s) || isNaN(e)) return false;
      return (nowKstMs >= s && nowKstMs < e);
    };
    for (var j = 0; j < CAMPAIGNS.length; j++) {
      if (inRange(CAMPAIGNS[j])) { activeAd = CAMPAIGNS[j]; break; }
    }
    if (!activeAd) return; /* 노출 기간 외 */
  }

  var EVENT_ID = activeAd.eventId;
  var STORAGE_KEY = 'adPopupHideUntil_' + EVENT_ID;

  /* 숨김 조건 체크: "오늘 다시 보지 않기"는 캠페인(eventId) 별로 별도 관리 */
  try {
    var hideUntil = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
    if (hideUntil > Date.now()) return;
  } catch (e) {}

  /* 이미지 결정 (PC: 768px 이상, 모바일: 미만) */
  var isMobile = window.innerWidth < 768;
  var device = isMobile ? 'mobile' : 'pc';
  var imgSrc = isMobile ? activeAd.moImg : activeAd.pcImg;
  var imgSize = isMobile ? '340px' : '500px';

  /* 팝업 표시 */
  var overlay = document.getElementById('ad-popup-overlay');
  var wrap    = document.getElementById('ad-popup-wrap');
  var img     = document.getElementById('ad-popup-img');
  var link    = document.getElementById('ad-popup-link');

  link.href        = activeAd.landingUrl;
  img.src          = imgSrc;
  img.alt          = activeAd.altText || '팝업 광고';
  img.style.width  = imgSize;
  img.style.height = imgSize;
  overlay.style.display = 'block';
  wrap.style.display    = 'block';

  /* 노출 기록 */
  fetch('/api/ad_popup/impression', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ event_id: EVENT_ID, device: device }),
    keepalive: true
  }).catch(function () {});

  /* 링크 클릭 기록 */
  link.addEventListener('click', function () {
    fetch('/api/ad_popup/click', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ event_id: EVENT_ID, device: device }),
      keepalive: true
    }).catch(function () {});
  });

  /* 오늘 다시 보지 않기 */
  document.getElementById('ad-popup-no-today').addEventListener('click', function () {
    var now = Date.now();
    /* 다음 KST 자정(UTC+9 기준 00:00)까지의 타임스탬프 계산 */
    var kstOffset = 9 * 3600 * 1000;
    var kstNow = new Date(now + kstOffset);
    var nextKstMidnightUtc = Date.UTC(
      kstNow.getUTCFullYear(), kstNow.getUTCMonth(), kstNow.getUTCDate() + 1,
      0, 0, 0
    ) - kstOffset;
    try { localStorage.setItem(STORAGE_KEY, String(nextKstMidnightUtc)); } catch (e) {}
    _closePopup();
  });

  /* 닫기: 현재 페이지 뷰에서만 닫힘 (새로고침/재접속 시 다시 노출) */
  document.getElementById('ad-popup-close').addEventListener('click', function () {
    _closePopup();
  });

  /* 오버레이 클릭 차단 (팝업 외부 클릭 무시) */
  overlay.addEventListener('click', function (e) { e.stopPropagation(); });

  function _closePopup() {
    overlay.style.display = 'none';
    wrap.style.display    = 'none';
  }
})();
</script>



    <script>
    /*
     * 언어 자동 감지 정책 (시크릿 탭 오리디렉트 방지 강화판)
     * - 사용자가 드롭다운에서 명시적으로 언어를 선택한 적 있으면(localStorage)
     *   더 이상 자동 리디렉트하지 않는다.
     * - 자동 리디렉트는 "루트(/) → /zh-tw" 한 방향으로만 한다.
     *   사용자가 이미 /zh-tw 페이지에 있다면 의도적으로 들어온 것이므로
     *   강제로 ko로 되돌리지 않는다.
     * - [중요] 클라이언트 안전망: 브라우저 언어 목록에 한국어가 들어있고
     *   중국어가 들어있지 않다면 절대로 /zh-tw로 보내지 않는다.
     *   (Cloudflare CF-IPCountry가 일시적으로 잘못 잡히거나, CDN 캐시 오염,
     *    VPN/회사망/ISP 라우팅 등 외부 요인으로 인한 오탐을 차단)
     */
    (function() {
      var LOC_KEY = 'a2tool_locale_v2';
      var CHOSEN_KEY = 'a2tool_locale_chosen';

      try {
        if (localStorage.getItem(CHOSEN_KEY)) return;
      } catch (e) {}

      if (sessionStorage.getItem(LOC_KEY)) return;
      sessionStorage.setItem(LOC_KEY, '1');

      var path = window.location.pathname;
      var onRoot = (path === '/' || path === '');
      if (!onRoot) return;

      // 브라우저 언어 신호 수집
      var langList = [];
      try {
        if (navigator.languages && navigator.languages.length) {
          for (var i = 0; i < navigator.languages.length; i++) {
            langList.push(String(navigator.languages[i] || '').toLowerCase());
          }
        } else if (navigator.language) {
          langList.push(String(navigator.language).toLowerCase());
        }
      } catch (e) {}

      var hasKoLang = langList.some(function(l){ return l.indexOf('ko') === 0; });
      var hasZhLang = langList.some(function(l){ return l.indexOf('zh') === 0; });

      // 가드 1: 한국어 브라우저 + 중국어 없음 → 서버 응답 무시하고 KR 유지
      if (hasKoLang && !hasZhLang) return;

      fetch('/api/detect-locale',{cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
        if (d && d.locale === 'zh-tw') {
          // 가드 2: 서버가 zh-tw라고 해도 브라우저 언어 목록에 zh가 전혀 없으면 무시
          if (!hasZhLang) return;
          window.location.href = '/zh-tw';
        }
      }).catch(function(){});
    })();
    </script>
