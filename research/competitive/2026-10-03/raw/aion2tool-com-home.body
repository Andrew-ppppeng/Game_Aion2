    <script>
      // 메인 탭(랭킹/통계/서버비교) 호버 시 서브탭 드롭다운을 탭 바로 아래에 fixed로 배치
      // ⚠️ 1400~2559px 구간은 html에 zoom:0.75가 걸려 있어(상단 미디어쿼리) style.left/top의 px 값과
      //    getBoundingClientRect()의 뷰포트 px 좌표계가 서로 다르다. 그래서 상수 보정 대신
      //    "0px에 놓고 실제로 어디에 그려지는지" 2점 실측(p0/p1)해서 오프셋·스케일을 구해 역산한다.
      //    (zoom이 없는 QHD 이상에서는 offset 0 / scale 1이 되어 기존 동작과 동일)
      (function () {
        var items = document.querySelectorAll('.main-site-nav .has-subnav');
        items.forEach(function (li) {
          var dd = li.querySelector('.subnav-dd');
          if (!dd) return;
          function place() {
            // 측정하려면 보이는 상태여야 함 (CSS :hover보다 이벤트가 먼저 올 수 있어 강제 노출 후 원복)
            var prevDisplay = dd.style.display;
            dd.style.display = 'flex';
            dd.style.left = '0px';
            dd.style.top = '0px';
            var p0 = dd.getBoundingClientRect();
            dd.style.left = '100px';
            var p1 = dd.getBoundingClientRect();
            var scale = (p1.left - p0.left) / 100;
            if (!scale || !isFinite(scale)) scale = 1;

            var r = li.getBoundingClientRect();
            var ddW = p0.width || 170;
            var left = r.left;
            if (left + ddW > window.innerWidth - 8) left = window.innerWidth - ddW - 8;
            left = Math.max(8, left);

            dd.style.left = ((left - p0.left) / scale) + 'px';
            dd.style.top = ((r.bottom - p0.top) / scale) + 'px';
            dd.style.display = prevDisplay;
          }
          li.addEventListener('mouseenter', place);
          window.addEventListener('scroll', function () { if (li.matches(':hover')) place(); }, { passive: true });
          window.addEventListener('resize', function () { if (li.matches(':hover')) place(); });
        });
      })();
    </script>

    
