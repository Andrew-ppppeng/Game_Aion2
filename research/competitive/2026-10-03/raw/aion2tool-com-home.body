                </div>
              </div>
            </div>
            
            <!-- 시뮬레이션 탭 패널 -->
            <div class="character-tab-card character-tab-panel" id="panel-simulation" style="display: none; overflow: hidden;">
              <div id="simulation-content" style="min-height: 400px; width: 100%; max-width: 100%; overflow-x: hidden;">
                <!-- 주의사항 -->
                <div style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px;">
                  <div style="display: flex; align-items: flex-start; gap: 0.5rem;">
                    <span style="color: #fbbf24; font-size: 1rem;">⚠️</span>
                    <div style="font-size: 0.8rem; color: #fbbf24; line-height: 1.5;">
                      <strong>주의:</strong> 스탯별 효율 공식을 역산하여 계산되지만, 실제 게임 내 전투력과 오차가 있을 수 있으니 참고용으로 활용하세요.
                    </div>
                  </div>
                </div>
                <!-- 전투 점수 표시 및 재계산 버튼 -->
                <div id="sim-score-container" class="simulation-combat-score-section" style="margin-bottom: 2rem; padding: 1rem 1.5rem; background: linear-gradient(135deg, rgba(20, 20, 35, 0.98) 0%, rgba(30, 30, 50, 0.98) 100%); border: 1px solid rgba(157, 140, 255, 0.25); border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);">
