// 주신 스탯 값 변경 (버튼)
function changeSimDivineStat(statType, delta) {
  const currentValue = window.simulationData.divineStats[statType] || 0;
  const newValue = Math.max(0, Math.min(999, currentValue + delta));
  setSimDivineStat(statType, newValue);
}

// 주신 스탯 값 직접 설정 (입력 필드)
function setSimDivineStat(statType, newValue) {
  newValue = Math.max(0, Math.min(999, newValue));
  window.simulationData.divineStats[statType] = newValue;
  
  // 값 표시 업데이트
  const valueInput = document.getElementById(`sim-divine-value-${statType}`);
  if (valueInput) {
    valueInput.value = newValue;
    // 원래 값과 비교해서 색상 변경
    const originalValue = window.simulationData.originalDivineStats?.[statType] || 0;
    valueInput.style.color = newValue !== originalValue ? '#fbbf24' : '#a78bfa';
  }
  
  // 효과 텍스트 업데이트
  updateSimDivineStatEffects(statType, newValue);
  
  // 총합 업데이트
  updateSimDivineStatsTotal();
}

// 일반 스탯 값 변경 (버튼)
function changeSimNormalStat(statType, delta) {
  const currentValue = window.simulationData.normalStats[statType] || 0;
  const newValue = Math.max(0, Math.min(999, currentValue + delta));
  setSimNormalStat(statType, newValue);
}

// 일반 스탯 값 직접 설정 (입력 필드)
function setSimNormalStat(statType, newValue) {
  newValue = Math.max(0, Math.min(999, newValue));
  window.simulationData.normalStats[statType] = newValue;
  
  // 값 표시 업데이트
  const valueInput = document.getElementById(`sim-normal-value-${statType}`);
  if (valueInput) {
    valueInput.value = newValue;
    // 원래 값과 비교해서 색상 변경
    const originalValue = window.simulationData.originalNormalStats?.[statType] || 0;
    valueInput.style.color = newValue !== originalValue ? '#fbbf24' : '#a78bfa';
  }
  
  // 효과 텍스트 업데이트
  updateSimNormalStatEffects(statType, newValue);
}

// 주신 스탯 효과 텍스트 업데이트 (시뮬레이션 값만 업데이트)
function updateSimDivineStatEffects(statType, value) {
  const statDef = DIVINE_STAT_EFFECTS[statType];
  if (!statDef) return;
  
  const originalValue = window.simulationData.originalDivineStats?.[statType] || 0;
  
  statDef.effects.forEach((effect, idx) => {
    const effectValueEl = document.getElementById(`sim-divine-effect-value-${statType}-${idx}`);
    if (effectValueEl) {
      const newEffectValue = (value * effect.multiplier).toFixed(1).replace(/\.0$/, '');
      const originalEffectValue = (originalValue * effect.multiplier).toFixed(1).replace(/\.0$/, '');
      const prefix = effect.multiplier < 0 ? '' : '+';
      
      effectValueEl.textContent = `${prefix}${newEffectValue}${effect.suffix}`;
      
      // 값이 변했으면 노란색, 아니면 보라색
      if (newEffectValue !== originalEffectValue) {
        effectValueEl.style.color = '#fbbf24';
      } else {
        effectValueEl.style.color = '#a78bfa';
      }
    }
  });
}

// 일반 스탯 효과 텍스트 업데이트 (시뮬레이션 값만 업데이트)
function updateSimNormalStatEffects(statType, value) {
  const statDef = NORMAL_STAT_EFFECTS[statType];
  if (!statDef) return;
  
  const originalValue = window.simulationData.originalNormalStats?.[statType] || 0;
  
  statDef.effects.forEach((effect, idx) => {
    const effectValueEl = document.getElementById(`sim-normal-effect-value-${statType}-${idx}`);
    if (effectValueEl) {
      const newEffectValue = (value * effect.multiplier).toFixed(1).replace(/\.0$/, '');
      const originalEffectValue = (originalValue * effect.multiplier).toFixed(1).replace(/\.0$/, '');
      const prefix = effect.multiplier < 0 ? '' : '+';
      
      effectValueEl.textContent = `${prefix}${newEffectValue}${effect.suffix}`;
      
      // 값이 변했으면 노란색, 아니면 보라색
      if (newEffectValue !== originalEffectValue) {
        effectValueEl.style.color = '#fbbf24';
      } else {
        effectValueEl.style.color = '#a78bfa';
      }
    }
  });
}

// 주신 스탯 총합 업데이트
function updateSimDivineStatsTotal() {
  const total = Object.values(window.simulationData.divineStats).reduce((sum, val) => sum + val, 0);
  const statsHeader = document.getElementById('sim-stats-header');
  if (statsHeader) {
    statsHeader.innerHTML = `주신 스탯 <span style="font-size: 0.85rem; color: var(--text-muted); margin-left: 0.5rem;">(총합: <span id="sim-divine-stats-total">${total}</span>)</span>`;
  }
}

// ====================================================================
// 범용 스탯 추출 시스템: 어떤 소스든 스탯 이름만으로 자동 CP 매핑
// ====================================================================

function statNameToCPKey(rawName) {
  const n = (rawName || '').replace(/\s+/g, '');
  const rules = [
    // ── 한국어 패턴 ──
    [/^PVE피해증폭/, 'PVE피해증폭%'],
    [/^PVE공격력/, 'PVE공격력'],
    [/^PVE명중/, 'PVE명중'],
    [/^보스피해증폭/, '보스피해증폭%'],
    [/^보스피해내성/, '보스피해내성%'],
    [/^보스공격력/, '보스공격력'],
    [/^치명타피해증폭/, '치명타피해증폭%'],
    [/^치명타피해내성/, '치명타피해내성%'],
    [/^무기피해증폭/, '무기피해증폭%'],
    [/^무기피해내성/, '무기피해내성%'],
    [/^후방피해증폭/, '후방피해증폭%'],
    [/^다단히트적중/, '다단히트적중%'],
    [/^다단히트저항/, '다단히트저항%'],
    [/^추가공격력/, '추가공격력'],
    [/^추가명중/, '추가명중'],
    [/^추가방어력/, '추가방어력'],
    [/^방어력증가/, '방어력%'],
    [/^방어력\(/, '방어력%'],
    [/^공격력증가/, '공격력%'],
    [/^피해증폭/, '피해증폭%'],
    [/^피해내성/, '피해내성%'],
    [/^전투속도/, '전투속도%'],
    [/^이동속도/, '이동속도%'],
    [/^재시전시간감소/, '재시전시간감소%'],
    [/^재사용대기시간/, '재사용대기시간%'],
    [/^강타/, '강타%'],
    [/^완벽/, '완벽%'],
    [/^철벽/, '철벽%'],
    [/^공격력/, '공격력'],
    [/^방어력/, '방어력'],
    [/^명중/, '명중'],
    [/^정확/, '정확'],
    [/^위력/, '위력'],
    [/^치명타저항/, null],
    [/^치명타/, '치명타'],
    [/^생명력/, '생명력'],
    [/^정신력/, '정신력'],
    [/^PVP/, null],
    [/^막기/, null],
    [/^회피/, null],
    [/^추가회피/, null],
    [/^추가희피/, null],
    // ── 繁體中文 패턴 ──
    [/^PVE傷害增幅/, 'PVE피해증폭%'],
    [/^PVE攻擊力/, 'PVE공격력'],
    [/^PVE命中/, 'PVE명중'],
    [/^BOSS傷害增幅/, '보스피해증폭%'],
    [/^BOSS傷害防禦/, '보스피해내성%'],
    [/^BOSS攻擊力/, '보스공격력'],
    [/^首領傷害增幅/, '보스피해증폭%'],
    [/^首領傷害抗性/, '보스피해내성%'],
    [/^首領攻擊力/, '보스공격력'],
    [/^暴擊傷害增幅/, '치명타피해증폭%'],
    [/^暴擊傷害防禦/, '치명타피해내성%'],
    [/^暴擊傷害抗性/, '치명타피해내성%'],
    [/^武器傷害增幅/, '무기피해증폭%'],
    [/^武器傷害防禦/, '무기피해내성%'],
    [/^武器傷害抗性/, '무기피해내성%'],
    [/^後方傷害增幅/, '후방피해증폭%'],
    [/^背後傷害增幅/, '후방피해증폭%'],
    [/^多段打擊擊中/, '다단히트적중%'],
    [/^多段命中/, '다단히트적중%'],
    [/^多段打擊抵抗/, '다단히트저항%'],
    [/^多段抗性/, '다단히트저항%'],
    [/^額外攻擊力/, '추가공격력'],
    [/^額外命中/, '추가명중'],
    [/^額外防禦力/, '추가방어력'],
    [/^防禦力增加/, '방어력%'],
    [/^攻擊力增加/, '공격력%'],
    [/^傷害增幅/, '피해증폭%'],
    [/^傷害防禦/, '피해내성%'],
    [/^戰鬥速度/, '전투속도%'],
    [/^移動速度/, '이동속도%'],
    [/^再施放時間減少/, '재시전시간감소%'],
    [/^技能冷卻時間/, '재사용대기시간%'],
    [/^強襲/, '강타%'],
    [/^完美/, '완벽%'],
    [/^鐵壁/, '철벽%'],
    [/^攻擊力/, '공격력'],
    [/^防禦力/, '방어력'],
    [/^命中/, '명중'],
    [/^命中力/, '명중'],
    [/^精準/, '정확'],
    [/^威力/, '위력'],
    [/^暴擊抵抗/, null],
    [/^暴擊/, '치명타'],
    [/^生命力/, '생명력'],
    [/^精神力/, '정신력'],
    [/^PVP/, null],
    [/^格擋/, null],
    [/^迴避/, null],
    [/^額外迴避/, null],
  ];
  for (const [re, cpKey] of rules) {
    if (re.test(n)) return cpKey;
  }
  return null;
}

function extractAllEngravingDiffs() {
  const diffs = {};
  const pv = (val) => { const num = parseFloat(String(val || '').replace('%', '').replace('+', '')); return isNaN(num) ? 0 : num; };
  const addD = (cpKey, amount) => { if (!cpKey || Math.abs(amount) < 0.0001) return; diffs[cpKey] = (diffs[cpKey] || 0) + amount; };

  const processItem = (item) => {
    if (!item) return;
    const origSoul = item.originalSoulEngravings || [];
    const simSoul = item.soulEngravings || [];
    const origRune = item.originalRunestones || [];
    const simRune = item.runestones || [];

    const soulNames = new Set();
    origSoul.forEach(e => soulNames.add(e?.name || e?.id || ''));
    simSoul.forEach(e => soulNames.add(e?.name || e?.id || ''));
    soulNames.forEach(name => {
      if (!name) return;
      let o = 0, s = 0;
      origSoul.forEach(e => { if ((e?.name || e?.id || '') === name) o += pv(e.value); });
      simSoul.forEach(e => { if ((e?.name || e?.id || '') === name) s += pv(e.value); });
      const diff = s - o;
      if (Math.abs(diff) < 0.0001) return;
      addD(statNameToCPKey(name), diff);
    });

    const runeNames = new Set();
    origRune.forEach(e => runeNames.add(e?.name || e?.id || ''));
    simRune.forEach(e => runeNames.add(e?.name || e?.id || ''));
    runeNames.forEach(name => {
      if (!name) return;
      let o = 0, s = 0;
      origRune.forEach(e => { if ((e?.name || e?.id || '') === name) o += pv(e.value); });
      simRune.forEach(e => { if ((e?.name || e?.id || '') === name) s += pv(e.value); });
      let diff = s - o;
      if (Math.abs(diff) < 0.0001) return;
      const cpKey = statNameToCPKey(name);
      if (!cpKey) return;
      if (cpKey.endsWith('%')) diff /= 100;
      addD(cpKey, diff);
    });
  };

  ['mainWeapon', 'subWeapon'].forEach(k => processItem(window.simulationData?.weapons?.[k]));
  Object.values(window.simulationData?.equipment || {}).forEach(processItem);
  Object.values(window.simulationData?.accessories || {}).forEach(processItem);
  return diffs;
}

function parseBoardEffectText(effectText) {
  if (!effectText) return {};
  const patterns = [
    // ── 한국어 패턴 ──
    [/PVE\s*피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, 'PVE피해증폭%'],
    [/보스\s*피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, '보스피해증폭%'],
    [/보스\s*피해\s*내성\s*\+?(\d+\.?\d*)%?/i, '보스피해내성%'],
    [/치명타\s*피해\s*내성\s*\+?(\d+\.?\d*)%?/i, '치명타피해내성%'],
    [/치명타\s*피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, '치명타피해증폭%'],
    [/무기\s*피해\s*내성\s*\+?(\d+\.?\d*)%?/i, '무기피해내성%'],
    [/무기\s*피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, '무기피해증폭%'],
    [/후방\s*피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, '후방피해증폭%'],
    [/피해\s*증폭\s*\+?(\d+\.?\d*)%?/i, '피해증폭%'],
    [/피해\s*내성\s*\+?(\d+\.?\d*)%?/i, '피해내성%'],
    [/PVE\s*공격력\s*\+?(\d+)/i, 'PVE공격력'],
    [/보스\s*공격력\s*\+?(\d+)/i, '보스공격력'],
    [/추가\s*공격력\s*\+?(\d+)/i, '추가공격력'],
    [/추가\s*명중\s*\+?(\d+)/i, '추가명중'],
    [/추가\s*방어력\s*\+?(\d+)/i, '추가방어력'],
    [/PVE\s*명중\s*\+?(\d+)/i, 'PVE명중'],
    [/전투\s*속도\s*\+?(\d+\.?\d*)%?/i, '전투속도%'],
    [/이동\s*속도\s*\+?(\d+\.?\d*)%?/i, '이동속도%'],
    [/다단\s*히트\s*적중\s*\+?(\d+\.?\d*)%?/i, '다단히트적중%'],
    [/다단\s*히트\s*저항\s*\+?(\d+\.?\d*)%?/i, '다단히트저항%'],
    [/재시전\s*시간\s*감소\s*\+?(\d+\.?\d*)%?/i, '재시전시간감소%'],
    [/강타\s*\+?\s*(\d+\.?\d*)%?/i, '강타%'],
    [/완벽\s*\+?\s*(\d+\.?\d*)%?/i, '완벽%'],
    [/철벽\s*\+?\s*(\d+\.?\d*)%?/i, '철벽%'],
    [/치명타\s*\+?(\d+)/i, '치명타'],
    [/공격력\s*\+?(\d+)/i, '공격력'],
    [/방어력\s*\+?(\d+)/i, '방어력'],
    [/명중\s*\+?(\d+)/i, '명중'],
    [/생명력\s*\+?(\d+)/i, '생명력'],
    [/정신력\s*\+?(\d+)/i, '정신력'],
    [/정확\s*\+?(\d+\.?\d*)/i, '정확'],
    [/위력\s*\+?(\d+\.?\d*)/i, '위력'],
    // ── 繁體中文 패턴 ──
    [/PVE\s*傷害增幅\s*\+?(\d+\.?\d*)%?/, 'PVE피해증폭%'],
    [/首領\s*傷害增幅\s*\+?(\d+\.?\d*)%?/, '보스피해증폭%'],
    [/首領\s*傷害抗性\s*\+?(\d+\.?\d*)%?/, '보스피해내성%'],
    [/暴擊\s*傷害抗性\s*\+?(\d+\.?\d*)%?/, '치명타피해내성%'],
    [/暴擊\s*傷害增幅\s*\+?(\d+\.?\d*)%?/, '치명타피해증폭%'],
    [/武器\s*傷害抗性\s*\+?(\d+\.?\d*)%?/, '무기피해내성%'],
    [/武器\s*傷害增幅\s*\+?(\d+\.?\d*)%?/, '무기피해증폭%'],
    [/背後\s*傷害增幅\s*\+?(\d+\.?\d*)%?/, '후방피해증폭%'],
    [/傷害增幅\s*\+?(\d+\.?\d*)%?/, '피해증폭%'],
    [/傷害抗性\s*\+?(\d+\.?\d*)%?/, '피해내성%'],
    [/PVE\s*攻擊力\s*\+?(\d+)/, 'PVE공격력'],
    [/首領\s*攻擊力\s*\+?(\d+)/, '보스공격력'],
    [/額外\s*攻擊力\s*\+?(\d+)/, '추가공격력'],
    [/額外\s*命中\s*\+?(\d+)/, '추가명중'],
    [/額外\s*防禦力\s*\+?(\d+)/, '추가방어력'],
    [/PVE\s*命中\s*\+?(\d+)/, 'PVE명중'],
    [/戰鬥速度\s*\+?(\d+\.?\d*)%?/, '전투속도%'],
    [/移動速度\s*\+?(\d+\.?\d*)%?/, '이동속도%'],
    [/多段命中\s*\+?(\d+\.?\d*)%?/, '다단히트적중%'],
    [/多段抗性\s*\+?(\d+\.?\d*)%?/, '다단히트저항%'],
    [/再施法時間減少\s*\+?(\d+\.?\d*)%?/, '재시전시간감소%'],
    [/強襲\s*\+?\s*(\d+\.?\d*)%?/, '강타%'],
    [/完美\s*\+?\s*(\d+\.?\d*)%?/, '완벽%'],
    [/鐵壁\s*\+?\s*(\d+\.?\d*)%?/, '철벽%'],
    [/暴擊\s*\+?(\d+)/, '치명타'],
    [/攻擊力\s*\+?(\d+)/, '공격력'],
    [/防禦力\s*\+?(\d+)/, '방어력'],
    [/命中\s*\+?(\d+)/, '명중'],
    [/生命力\s*\+?(\d+)/, '생명력'],
    [/精神力\s*\+?(\d+)/, '정신력'],
    [/精確\s*\+?(\d+\.?\d*)/, '정확'],
    [/威力\s*\+?(\d+\.?\d*)/, '위력'],
  ];
  const stats = {};
  for (const [re, cpKey] of patterns) {
    const m = effectText.match(re);
    if (m) { stats[cpKey] = parseFloat(m[1]) || 0; break; }
  }
  return stats;
}

function extractBoardDiffs(boardKey, boardId) {
  const diffs = {};
  const dd = window.daevanionData;
  if (!dd?.[boardId] || !window.simulationData?.[boardKey]) return diffs;
  const nodeList = dd[boardId].nodeList || [];
  const origS = window.simulationData[boardKey].original || {};
  const simS = window.simulationData[boardKey].simulated || {};
  const origT = {}, simT = {};
  nodeList.forEach(node => {
    if ((node.grade || 'None') === 'None') return;
    let etxts = [];
    (node.effectList || []).forEach(e => { if (e?.desc) etxts.push(e.desc); });
    if (!etxts.length && node.name) etxts.push(node.name);
    const ns = parseBoardEffectText(etxts.join(' '));
    const isO = origS[node.nodeId] || false;
    const isS = simS[node.nodeId] || false;
    for (const [k, v] of Object.entries(ns)) {
      if (isO) origT[k] = (origT[k] || 0) + v;
      if (isS) simT[k] = (simT[k] || 0) + v;
    }
  });
  const allK = new Set([...Object.keys(origT), ...Object.keys(simT)]);
  allK.forEach(k => {
    const d = (simT[k] || 0) - (origT[k] || 0);
    if (Math.abs(d) > 0.001) diffs[k] = d;
  });
  return diffs;
}

// ====================================================================
// 시뮬레이션 전투력(CP) 재계산 — 범용 구조
// ====================================================================
function recalculateSimulationCombatScore() {
  const currentCP = window.currentNcCombatPower || window.currentCombatPower2 || 0;
  if (currentCP <= 0) return 0;

  const statChanges = {};
  const addChange = (cpKey, amount, source) => {
    if (!cpKey || Math.abs(amount) < 0.0001) return;
    if (!statChanges[cpKey]) statChanges[cpKey] = { total: 0, sources: [] };
    statChanges[cpKey].total += amount;
    if (source) statChanges[cpKey].sources.push({ name: source, amount });
  };

  const simData = window.simulationData;
  if (!simData) return 0;

  // === 1. 구조적 무기 효과 (초월/돌파/커스텀 무기 기본 스탯) ===
  ['mainWeapon', 'subWeapon'].forEach(wKey => {
    const w = simData.weapons?.[wKey];
    if (!w) return;
    const label = wKey === 'mainWeapon' ? '무기' : '가더';
    const isCustom = w.useCustomWeapon;
    const origTrans = w.originalTranscendence || 0;

    if (isCustom && origTrans > 0) {
      addChange('공격력', -(origTrans * 30), `${label} 초월리셋`);
      addChange('공격력%', -origTrans, `${label} 초월%리셋`);
    }

    const effectiveOrig = isCustom ? 0 : origTrans;
    const simTrans = w.transcendence ?? origTrans;
    const transDiff = simTrans - effectiveOrig;
    if (transDiff !== 0) {
      addChange('공격력', transDiff * 30, `${label} 초월`);
      addChange('공격력%', transDiff, `${label} 초월%`);
    }

    const rudraBonus = w.rudraEnhanceBonus || 0;
    if (rudraBonus > 0) addChange('공격력', rudraBonus, `${label} 돌파보너스`);

    if (isCustom && w.customWeaponStats) {
      const origStats = w.originalItem?.main_stats || [];
      let origA = 0, origC = 0, origP = 0;
      origStats.forEach(s => {
        const nm = s?.name || '';
        const v = parseFloat(String(s?.value || 0)) || 0;
        const mv = parseFloat(String(s?.min_value || 0)) || 0;
        const ex = parseFloat(String(s?.extra || 0)) || 0;
        if (nm.includes('공격력') || nm.includes('攻擊力')) origA = (mv + v) / 2 + ex;
        if (nm.includes('치명타') || nm.includes('暴擊')) origC = v;
        if ((nm.includes('PVE') && (nm.includes('피해 증폭') || nm.includes('傷害增幅')))) origP = v;
      });
      const cs = w.customWeaponStats;
      const cA = ((cs.minAttack || 0) + (cs.maxAttack || 0)) / 2 + (cs.attackBonus || 0);
      if (Math.abs(cA - origA) > 0.01) addChange('공격력', cA - origA, `${label} 기본`);
      const _origC2 = origC;
      if ((cs.critical || 0) - _origC2 !== 0) addChange('치명타', (cs.critical || 0) - _origC2, `${label} 기본`);
      if (Math.abs((cs.pveDamageAmp || 0) - origP) > 0.01) addChange('PVE피해증폭%', (cs.pveDamageAmp || 0) - origP, `${label} 기본`);
    }
  });

  // === 2. 방어구 돌파 효과 ===
  Object.values(simData.equipment || {}).forEach(item => {
    if (!item) return;
    const d = (item.transcendence ?? item.originalTranscendence ?? 0) - (item.originalTranscendence || 0);
    if (d !== 0) {
      addChange('방어력', d * 40, '방어구돌파');
      addChange('생명력', d * 40, '방어구돌파');
      addChange('방어력%', d, '방어구돌파%');
    }
  });

  // === 3. 구조적 장신구 효과 (초월/커스텀/돌파보너스) ===
  Object.values(simData.accessories || {}).forEach(item => {
    if (!item) return;
    const d = (item.transcendence ?? item.originalTranscendence ?? 0) - (item.originalTranscendence || 0);
    if (d !== 0) { addChange('공격력', d * 20, '장신구초월'); addChange('방어력', d * 20, '장신구초월'); addChange('공격력%', d, '장신구초월%'); }

    const eb = item.endBraceletEnhanceBonus;
    if (eb) { if (eb.attack) addChange('공격력', eb.attack, '팔찌돌파'); if (eb.defense) addChange('방어력', eb.defense, '팔찌돌파'); }

    if (item.useCustomBracelet || item.useCustomNecklace || item.useCustomEarring || item.useCustomRing) {
      const sumMS = (sl) => {
        const t = { attack: 0, defense: 0, damageAmp: 0 };
        (sl || []).forEach(s => {
          const nm = s?.name || s?.id || '';
          const bv = parseFloat(String(s?.value || '0').replace(/[^0-9.-]/g, '')) || 0;
          const ev = parseFloat(String(s?.extra || '0').replace(/[^0-9.-]/g, '')) || 0;
          if (nm.includes('공격력') || nm.includes('攻擊力')) t.attack += (bv + ev);
          if (nm.includes('방어력') || nm.includes('防禦力')) t.defense += (bv + ev);
          if ((nm.includes('피해 증폭') || nm.includes('傷害增幅')) && !nm.includes('PVP')) t.damageAmp += (bv + ev);
        });
        return t;
      };
      const cs = item.useCustomBracelet ? item.customBraceletStats
        : (item.useCustomNecklace ? item.customNecklaceStats
          : (item.useCustomEarring ? item.customEarringStats : item.customRingStats));
      const oT = sumMS(item.originalItem?.main_stats || []);
      const sT = sumMS(cs?.main_stats || []);
      if (Math.abs(sT.attack - oT.attack) > 0.01) addChange('공격력', sT.attack - oT.attack, '커스텀장신구');
      if (Math.abs(sT.defense - oT.defense) > 0.01) addChange('방어력', sT.defense - oT.defense, '커스텀장신구');
      if (Math.abs(sT.damageAmp - oT.damageAmp) > 0.01) addChange('피해증폭%', sT.damageAmp - oT.damageAmp, '커스텀장신구');
    }
  });

  // === 4. 범용: 모든 영혼/마석 각인 자동 추출 ===
  const engDiffs = extractAllEngravingDiffs();
  for (const [cpKey, amount] of Object.entries(engDiffs)) {
    addChange(cpKey, amount, '각인');
  }

  // === 5. 범용: 데바니온 보드 자동 추출 ===
  const arielDiffs = extractBoardDiffs('arielBoard', 45);
  for (const [cpKey, amount] of Object.entries(arielDiffs)) {
    addChange(cpKey, amount, '아리엘');
  }
  const markutanDiffs = extractBoardDiffs('markutanBoard', 47);
  for (const [cpKey, amount] of Object.entries(markutanDiffs)) {
    addChange(cpKey, amount, '마르쿠탄');
  }

  // === 6. CP 변화량 계산 ===
  let totalCPDelta = 0;
  const cpBreakdown = [];

  for (const [statKey, data] of Object.entries(statChanges)) {
    if (Math.abs(data.total) < 0.0001) continue;
    const cpDelta = calculateCPChange(currentCP, statKey, data.total);
    if (Math.abs(cpDelta) < 0.01) continue;
    totalCPDelta += cpDelta;
    cpBreakdown.push({ stat: statKey, change: data.total, cpDelta, sources: data.sources });
  }

  const simCP = Math.round(currentCP + totalCPDelta);

  // === UI 업데이트 ===
  const newScoreEl = document.getElementById('sim-new-combat-score');
  const originalScoreEl = document.getElementById('sim-original-combat-score');
  const diffEl = document.getElementById('sim-score-diff');
  const calcLogEl = document.getElementById('sim-calc-log');

  const originalScore = currentCP;

  if (newScoreEl) {
    newScoreEl.textContent = simCP.toLocaleString();
    newScoreEl.style.textShadow = simCP > originalScore
      ? '0 0 20px rgba(74, 222, 128, 0.5)'
      : (simCP < originalScore ? '0 0 20px rgba(248, 113, 113, 0.5)' : '0 0 20px rgba(157, 140, 255, 0.3)');

    if (simCP > originalScore) {
      newScoreEl.style.color = '#4ade80';
    } else if (simCP < originalScore) {
      newScoreEl.style.color = '#f87171';
    } else {
      newScoreEl.style.color = 'var(--accent)';
    }
  }

  if (diffEl) {
    const diff = simCP - originalScore;
    const diffPercent = originalScore > 0 ? ((diff / originalScore) * 100).toFixed(2) : 0;

    if (diff > 0) {
      diffEl.innerHTML = `<span style="color: #4ade80; font-weight: 600;">▲ +${diff.toLocaleString()} (+${diffPercent}%)</span>`;
    } else if (diff < 0) {
      diffEl.innerHTML = `<span style="color: #f87171; font-weight: 600;">▼ ${diff.toLocaleString()} (${diffPercent}%)</span>`;
    } else {
      diffEl.innerHTML = `<span style="color: var(--text-muted);">${TA('sim.no_change_hint', '변화 없음. 돌파, 각인, 스탯, 아리엘 등을 조정하고 눌러보세요')}</span>`;
    }
  }

  // 변경 사항 요약 표시
  const summaryEl = document.getElementById('sim-changes-summary');
  const changes = generateSimulationChangesSummary();

  if (summaryEl) {
    if (changes.length > 0 || cpBreakdown.length > 0) {
      const diff = simCP - originalScore;
      const diffPercent = originalScore > 0 ? ((diff / originalScore) * 100).toFixed(2) : 0;
      let diffText = '';
      if (diff > 0) {
        diffText = `<span style="color: #4ade80; font-weight: 700;">▲ +${diff.toLocaleString()} (+${diffPercent}%)</span>`;
      } else if (diff < 0) {
        diffText = `<span style="color: #f87171; font-weight: 700;">▼ ${diff.toLocaleString()} (${diffPercent}%)</span>`;
      } else {
        diffText = `<span style="color: var(--text-muted);">${TA('sim.no_change_short', '변화 없음')}</span>`;
      }

      let breakdownHtml = '';
      if (cpBreakdown.length > 0) {
        const sortedBreakdown = cpBreakdown.sort((a, b) => Math.abs(b.cpDelta) - Math.abs(a.cpDelta));
        breakdownHtml = `
          <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05);">
            <div style="font-size: 0.8rem; font-weight: 600; color: #60a5fa; margin-bottom: 0.4rem;">${TA('sim.cp_change_detail', '전투력 변화 상세')}</div>
            ${sortedBreakdown.map(b => {
              const sign = b.cpDelta > 0 ? '+' : '';
              const color = b.cpDelta > 0 ? '#4ade80' : '#f87171';
              const isP = b.stat.endsWith('%');
              const chgStr = isP ? `${b.change > 0 ? '+' : ''}${b.change.toFixed(1)}%` : `${b.change > 0 ? '+' : ''}${Math.round(b.change)}`;
              return `<div style="font-size: 0.75rem; display: flex; justify-content: space-between; padding: 0.15rem 0;">
                <span style="color: var(--text-muted);">${getStatKeyDisplayName(b.stat)} ${chgStr}</span>
                <span style="color: ${color}; font-weight: 600;">${sign}${Math.round(b.cpDelta).toLocaleString()}</span>
              </div>`;
            }).join('')}
          </div>
        `;
      }

      summaryEl.style.display = 'block';
      summaryEl.innerHTML = `
        <div style="font-size: 0.9rem; font-weight: 600; color: #facc15; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
          📋 ${TA('sim.changes_summary_title', '변경 사항 요약')} <span style="font-size: 0.75rem; color: var(--text-muted);">(${changes.length}${TA('sim.changes_count_suffix', '개 변경됨')})</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; line-height: 1.5;">
          ${changes.map(c => `<div>• ${c}</div>`).join('')}
        </div>
        ${breakdownHtml}
        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.85rem;">
          <span style="color: var(--text-muted);">${TA('sim.combat_power_label', '전투력')}:</span> ${originalScore.toLocaleString()} → <span style="font-weight: 700; color: ${diff >= 0 ? '#4ade80' : '#f87171'};">${simCP.toLocaleString()}</span> ${diffText}
        </div>
      `;
    } else {
      summaryEl.style.display = 'none';
    }
  }

  // 계산 로그 항상 숨김
  if (calcLogEl) {
    calcLogEl.style.display = 'none';
  }

  // 플로팅 바 점수 동기화
  if (typeof window.updateSimFloatingBar === 'function') {
    window.updateSimFloatingBar();
  }

  return simCP;
}

// ============================================================
// 스펙업 추천 탭 - 마석 각인 전투력 기여치 분석 및 우선순위 정렬
// ============================================================
// 스펙업 추천 서브탭 버튼 스타일
function setSpecupBtnStyle(btn, active, accent) {
  if (!btn) return;
  if (active) {
    btn.style.background = accent.bg;
    btn.style.borderColor = accent.border;
    btn.style.color = accent.color;
  } else {
    btn.style.background = 'rgba(255,255,255,0.04)';
    btn.style.borderColor = 'rgba(255,255,255,0.15)';
    btn.style.color = 'var(--text-muted)';
  }
}

// 스펙업 추천 섹션 전환 (마석 각인 / 돌파)
function switchSpecupSection(section) {
  const msBtn = document.getElementById('specup-btn-magic-stone');
  const btBtn = document.getElementById('specup-btn-breakthrough');
  const msSection = document.getElementById('specup-magic-stone-section');
  const btSection = document.getElementById('specup-breakthrough-section');
  if (!msSection || !btSection) return;

  msSection.style.display = 'none';
  btSection.style.display = 'none';
  setSpecupBtnStyle(msBtn, false);
  setSpecupBtnStyle(btBtn, false);

  if (section === 'magic-stone') {
    msSection.style.display = '';
    setSpecupBtnStyle(msBtn, true, { bg: 'rgba(167,139,250,0.2)', border: 'rgba(167,139,250,0.5)', color: '#a78bfa' });
    renderSpecUpPanel();
  } else {
    btSection.style.display = '';
    setSpecupBtnStyle(btBtn, true, { bg: 'rgba(96,165,250,0.2)', border: 'rgba(96,165,250,0.5)', color: '#60a5fa' });
    renderBreakthroughPanel();
  }
}

// 아이템 → breakthrough API category 매핑
function getBtApiCategory(item, isAccessory) {
  if (!item || !item.name) return null;
  const name = (item.name || '').replace(/^\+\d+\s*/, '');
  const cat  = item.category_name || '';
  if (isAccessory) {
    if (isBraceletItem(item)) return '팔찌';
    if (isNecklaceItem(item)) return '목걸이';
    if (isEarringItem(item)) return '귀걸이';
    if (isRingItem(item)) return '반지';
    return null;
  }
  if (isGuarderItem(item)) return '가더';
  // 방어구 → DB 카테고리 매핑 (한국어 + 繁體中文)
  const armorMap = {
    '흉갑': '상의', '胸甲': '상의',
    '각반': '하의', '脛甲': '하의', '護腿': '하의',
    '장화': '신발', '靴': '신발', '靴子': '신발',
    '투구': '투구', '頭盔': '투구', '頭甲': '투구',
    '견갑': '견갑', '肩甲': '견갑',
    '장갑': '장갑', '手套': '장갑',
    '망토': '망토', '披風': '망토', '斗篷': '망토',
  };
  for (const [ending, dbCat] of Object.entries(armorMap)) {
    if (name.endsWith(ending)) return dbCat;
  }
  // 무기 타입 감지 (한국어 + 繁體中文)
  const weaponTypes = ['대검', '단검', '장검', '활', '전곤', '법봉', '법서', '보주',
                       '巨劍', '短刀', '長劍', '弓', '戰棍', '法杖', '法書', '寶珠'];
  const weaponMap = {
    '巨劍': '대검', '短刀': '단검', '長劍': '장검', '弓': '활',
    '戰棍': '전곤', '法杖': '법봉', '法書': '법서', '寶珠': '보주',
  };
  for (const wt of weaponTypes) {
    if (cat.includes(wt) || name.includes(wt)) {
      return weaponMap[wt] || wt;
    }
  }
  return null;
}

// 아이템 → breakthrough API grade 매핑
function getBtApiGrade(item) {
  const g = (item.grade || '').toLowerCase().trim();
  if (g === 'epic' || g === '영웅') return '영웅';
  return '유일'; // 기본 유일 등급
}

// 기댓값 API 호출 (캐시 적용)
async function fetchBreakthroughKina(btCategory, btGrade, exceedLevel) {
  if (!btCategory || !btGrade) return null;
  if (!window._btKinaCache) window._btKinaCache = {};
  const key = `${btCategory}_${btGrade}_${exceedLevel}`;
  if (key in window._btKinaCache) return window._btKinaCache[key];
  try {
    const res = await fetch('/api/breakthrough/calculate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: btCategory, grade: btGrade, start_level: exceedLevel, target_level: exceedLevel + 1 })
    });
    if (!res.ok) {
      // 영웅 등급 없으면 유일로 재시도
      if (btGrade === '영웅') return fetchBreakthroughKina(btCategory, '유일', exceedLevel);
      window._btKinaCache[key] = null; return null;
    }
    const data = await res.json();
    if (!data.success) {
      if (btGrade === '영웅') return fetchBreakthroughKina(btCategory, '유일', exceedLevel);
      window._btKinaCache[key] = null; return null;
    }
    const kina = data.summary?.total_expected_kinah || null;
    window._btKinaCache[key] = kina;
    return kina;
  } catch (e) {
    window._btKinaCache[key] = null;
    return null;
  }
}

// 키나 표시 형식 (만 단위)
function formatKinaBt(kina) {
  if (kina === null || kina === undefined) return '—';
  if (kina >= 100000000) return (kina / 100000000).toFixed(1) + '억';
  if (kina >= 10000) return (kina / 10000).toFixed(1) + '만';
  return kina.toLocaleString();
}

async function renderBreakthroughPanel() {
  const sectionEl = document.getElementById('specup-breakthrough-section');
  if (!sectionEl) return;

  const currentCP = window.currentNcCombatPower || window.currentCombatPower2 || 0;
  if (currentCP <= 0) {
    sectionEl.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:3rem;font-size:0.9rem;">${TA('specup.no_char', '캐릭터를 먼저 검색하세요.')}</div>`;
    return;
  }

  // 로딩 표시
  sectionEl.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:2.5rem;font-size:0.9rem;">${TA('specup.bt_loading', '💫 돌파 기댓값 계산 중...')}</div>`;

  const equipment  = window.currentEquipment  || [];
  const accessories = window.currentAccessories || [];

  const getBtCpGain = (category) => {
    if (category === 'weapon') {
      const cpFlat = calculateCPChange(currentCP, '공격력', 30);
      const cpPct  = calculateCPChange(currentCP, '공격력%', 1);
      return { total: cpFlat + cpPct, stats: [{ name: '공격력', change: '+30', cp: Math.round(cpFlat) }, { name: '공격력 %', change: '+1%', cp: Math.round(cpPct) }] };
    } else if (category === 'accessory') {
      const cpAtk = calculateCPChange(currentCP, '공격력', 20);
      const cpDef = calculateCPChange(currentCP, '방어력', 20);
      const cpPct = calculateCPChange(currentCP, '공격력%', 1);
      return { total: cpAtk + cpDef + cpPct, stats: [{ name: '공격력', change: '+20', cp: Math.round(cpAtk) }, { name: '방어력', change: '+20', cp: Math.round(cpDef) }, { name: '공격력 %', change: '+1%', cp: Math.round(cpPct) }] };
    } else if (category === 'brooch') {
      // 브로치: 공격력 % 대신 피해 증폭 % 가 오름 (돌파 1당 공격력 +20, 방어력 +40, 피해 증폭 +1%)
      const cpAtk = calculateCPChange(currentCP, '공격력', 20);
      const cpDef = calculateCPChange(currentCP, '방어력', 40);
      const cpPct = calculateCPChange(currentCP, '피해증폭%', 1);
      return { total: cpAtk + cpDef + cpPct, stats: [{ name: '공격력', change: '+20', cp: Math.round(cpAtk) }, { name: '방어력', change: '+40', cp: Math.round(cpDef) }, { name: '피해 증폭 %', change: '+1%', cp: Math.round(cpPct) }] };
    } else {
      const cpDef = calculateCPChange(currentCP, '방어력', 40);
      const cpHp  = calculateCPChange(currentCP, '생명력', 40);
      const cpPct = calculateCPChange(currentCP, '방어력%', 1);
      return { total: cpDef + cpHp + cpPct, stats: [{ name: '방어력', change: '+40', cp: Math.round(cpDef) }, { name: '생명력', change: '+40', cp: Math.round(cpHp) }, { name: '방어력 %', change: '+1%', cp: Math.round(cpPct) }] };
    }
  };

  const getItemCpCategory = (item, isAccessory) => {
    if (isAccessory) return 'accessory';
    if (isGuarderItem(item)) return 'weapon';
    const name = (item.name || '').replace(/^\+\d+\s*/, '');
    const armorEndings = ['흉갑', '각반', '투구', '견갑', '장갑', '장화', '망토',
                          '胸甲', '脛甲', '護腿', '頭盔', '頭甲', '肩甲', '手套', '披風', '斗篷', '靴'];
    if (armorEndings.some(e => name.endsWith(e))) return 'armor';
    return 'weapon';
  };

  const isBreakthroughExcluded = (item) => {
    if (!item || !item.name) return true;
    if (isArcanaItem && isArcanaItem(item)) return true;
    // 한국어 제외 목록
    if (item.name.includes('룬') || item.name.includes('아뮬렛') || item.name.includes('허리띠')) return true;
    // 繁體中文 제외 목록 (룬, 아뮬렛, 허리띠)
    if (item.name.includes('符文') || item.name.includes('護身符') || item.name.includes('古文石') || item.name.includes('腰帶')) return true;
    return false;
  };

  const itemEntries = [];
  equipment.forEach(item => {
    if (isBreakthroughExcluded(item)) return;
    const exceedLevel = item.exceed_level || 0;
    if (exceedLevel >= 5) return;
    const cpCat = getItemCpCategory(item, false);
    const bt = getBtCpGain(cpCat);
    itemEntries.push({ itemName: item.name, iconUrl: item.icon_url || '', exceedLevel, nextLevel: exceedLevel + 1, cpGain: bt.total, stats: bt.stats, cpCategory: cpCat, btCategory: getBtApiCategory(item, false), btGrade: getBtApiGrade(item) });
  });
  accessories.forEach(item => {
    if (isBreakthroughExcluded(item)) return;
    const exceedLevel = item.exceed_level || 0;
    if (exceedLevel >= 5) return;
    const cpCat = isBroochItem(item) ? 'brooch' : 'accessory';
    const bt = getBtCpGain(cpCat);
    itemEntries.push({ itemName: item.name, iconUrl: item.icon_url || '', exceedLevel, nextLevel: exceedLevel + 1, cpGain: bt.total, stats: bt.stats, cpCategory: cpCat, btCategory: getBtApiCategory(item, true), btGrade: getBtApiGrade(item) });
  });

  if (itemEntries.length === 0) {
    sectionEl.innerHTML = '<div style="text-align:center;color:var(--text-muted);padding:3rem;font-size:0.9rem;">' + TA('specup.all_bt5_done', '모든 장비가 이미 5돌파 완료 상태입니다.') + '</div>';
    return;
  }

  // 돌파 기댓값 병렬 조회
  const kinaResults = await Promise.all(itemEntries.map(e => fetchBreakthroughKina(e.btCategory, e.btGrade, e.exceedLevel)));
  itemEntries.forEach((e, i) => {
    e.expectedKina = kinaResults[i];
    e.cpPerMil = (e.expectedKina > 0) ? (e.cpGain * 1000000 / e.expectedKina) : null;
  });

  // 100만 키나당 CP 내림차순 정렬 (null은 후순위), 동일 시 낮은 돌파 먼저
  itemEntries.sort((a, b) => {
    if (a.cpPerMil === null && b.cpPerMil === null) { return a.exceedLevel - b.exceedLevel; }
    if (a.cpPerMil === null) return 1;
    if (b.cpPerMil === null) return -1;
    const diff = b.cpPerMil - a.cpPerMil;
    if (Math.abs(diff) > 0.001) return diff;
    return a.exceedLevel - b.exceedLevel;
  });

  window.specupBtItemEntries = itemEntries;

  const maxEff = itemEntries[0].cpPerMil || 1;
  const minEff = itemEntries.find(e => e.cpPerMil !== null)?.cpPerMil ?? 0;
  const minEffAll = itemEntries[itemEntries.length - 1].cpPerMil ?? 0;
  const effRange = maxEff - minEffAll || 1;

  let btTooltip = document.getElementById('specup-bt-tooltip');
  if (!btTooltip) {
    btTooltip = document.createElement('div');
    btTooltip.id = 'specup-bt-tooltip';
    document.body.appendChild(btTooltip);
  }
  btTooltip.style.cssText = 'position:fixed;display:none;z-index:2147483647;pointer-events:none;max-width:290px;padding:0.7rem 0.9rem;background:rgba(12,12,22,0.98);border:1px solid rgba(96,165,250,0.4);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.7);font-size:0.78rem;color:#e2e8f0;line-height:1.4;';

  const cardsHtml = itemEntries.map((entry, idx) => {
    const rank = idx + 1;
    const cpStr  = `+${Math.round(entry.cpGain).toLocaleString()}`;
    const kinaStr = formatKinaBt(entry.expectedKina);
    const effStr  = entry.cpPerMil !== null ? `${entry.cpPerMil.toFixed(1)}` : '—';
    const barWidth = (entry.cpPerMil !== null) ? Math.round(5 + ((entry.cpPerMil - minEffAll) / effRange) * 95) : 5;
    const rawName  = entry.itemName.replace(/^\+\d+\s*/, '');
    const shortName = rawName.length > 13 ? rawName.slice(0, 11) + '…' : rawName;
    const iconHtml = entry.iconUrl
      ? `<img src="${entry.iconUrl}" alt="" style="width:28px;height:28px;border-radius:5px;object-fit:cover;flex-shrink:0;" onerror="this.style.display='none'">`
      : `<div style="width:28px;height:28px;border-radius:5px;background:rgba(255,255,255,0.08);flex-shrink:0;"></div>`;
    return `
      <div style="padding:0.65rem 0.75rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.09);border-radius:8px;cursor:default;box-sizing:border-box;"
           onmouseover="showSpecupBtTooltip(event,${idx});this.style.background='rgba(96,165,250,0.1)';this.style.borderColor='rgba(96,165,250,0.35)';"
           onmouseout="hideSpecupBtTooltip();this.style.background='rgba(255,255,255,0.04)';this.style.borderColor='rgba(255,255,255,0.09)';"
           onmousemove="updateSpecupBtTooltipPos(event);">
        <!-- 1행: 순위 + 100만키나당 전투력 (효율 지표) -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.3rem;">
          <span style="font-size:0.85rem;font-weight:900;color:rgba(96,165,250,0.8);letter-spacing:-0.3px;">${TA('specup.rank_n', '{n}순위').replace('{n}', String(rank))}</span>
          <span style="font-size:0.7rem;font-weight:700;color:#fbbf24;" title="${TA('specup.tooltip_cp_per_mil', '100만 키나당 전투력')}"><span style="font-size:0.6rem;color:rgba(251,191,36,0.65);font-weight:500;">${TA('specup.cp_per_mil_title', '100만 키나당 ')}</span>${TA('specup.cp_rise_short', '전투력 +')}${effStr}</span>
        </div>
        <!-- 2행: 아이콘 + 장비명 -->
        <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.4rem;">
          ${iconHtml}
          <div style="min-width:0;overflow:hidden;">
            <div style="font-size:0.72rem;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;line-height:1.3;" title="${entry.itemName}">${shortName}</div>
            <div style="font-size:0.6rem;color:rgba(255,255,255,0.32);">${TA('specup.bt_arrow', '현재 {a}돌 → {b}돌').replace('{a}', String(entry.exceedLevel)).replace('{b}', String(entry.nextLevel))}</div>
          </div>
        </div>
        <!-- 3행: 전투력 + 기댓값 키나 -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;padding:0.25rem 0.4rem;background:rgba(0,0,0,0.2);border-radius:5px;">
          <div style="font-size:0.68rem;color:rgba(255,255,255,0.45);">${TA('specup.cp_label', '전투력')} <span style="color:#60a5fa;font-weight:700;">${cpStr}</span></div>
          <div style="font-size:0.68rem;color:rgba(255,255,255,0.45);">${TA('specup.expected_kinah', '기댓값')} <span style="color:#f97316;font-weight:700;">${kinaStr} ${TA('specup.kinah_currency', '키나')}</span></div>
        </div>
        <!-- 게이지 바 (효율 기준) -->
        <div style="height:3px;border-radius:2px;background:linear-gradient(to right, rgba(251,191,36,0.65) ${barWidth}%, rgba(255,255,255,0.07) ${barWidth}%);"></div>
      </div>`;
  }).join('');

  const validEntries = itemEntries.filter(e => e.cpPerMil !== null);
  const topEff = validEntries.length > 0 ? validEntries[0].cpPerMil.toFixed(1) : '—';
  const summaryHtml = `
    <div style="margin-bottom:1rem;padding:0.85rem 1.1rem;background:linear-gradient(135deg,rgba(20,20,35,0.98) 0%,rgba(30,30,50,0.98) 100%);border:1px solid rgba(96,165,250,0.22);border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.3);">
      <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:0.55rem;text-transform:uppercase;letter-spacing:0.5px;">${TA('specup.summary_title', '돌파 비용 효율 요약')}</div>
      <div style="display:flex;flex-wrap:wrap;gap:1.2rem;align-items:center;">
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.incomplete_items', '미완료 장비')}</div><div style="font-size:1.4rem;font-weight:700;color:#60a5fa;">${TA('specup.count_suffix', '{n}개').replace('{n}', String(itemEntries.length))}</div></div>
        <div style="height:30px;width:1px;background:rgba(255,255,255,0.1);"></div>
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.best_efficiency', '최고 효율')}</div><div style="font-size:1rem;font-weight:700;color:#fbbf24;">+${topEff} <span style="font-size:0.62rem;color:rgba(251,191,36,0.65);">${TA('specup.cp_per_mil_unit', '전투력/100만키나')}</span></div></div>
        <div style="height:30px;width:1px;background:rgba(255,255,255,0.1);"></div>
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.current_cp', '현재 전투력')}</div><div style="font-size:1rem;font-weight:600;color:#60a5fa;">${Math.round(currentCP).toLocaleString()}</div></div>
      </div>
    </div>`;

  const guideHtml = `
    <div style="margin-bottom:0.75rem;padding:0.5rem 0.8rem;background:rgba(96,165,250,0.06);border:1px solid rgba(96,165,250,0.18);border-radius:7px;font-size:0.75rem;color:var(--text-muted);line-height:1.5;">
      ${TA('specup.guide_line', '💰 <strong style="color:var(--text-primary);">100만 키나당 전투력</strong> 높은 순 정렬 · 마우스 오버 시 상세 확인 · 5돌파 장비 제외')}
    </div>`;

  sectionEl.innerHTML = `
    <div class="skill-category-card" style="margin-bottom:1.5rem;">
      <div class="skill-category-header" style="display:flex;align-items:center;gap:0.5rem;">
        <span>${TA('specup.priority_title', '돌파 스펙업 우선순위')}</span>
        <span style="font-size:0.75rem;color:var(--text-muted);font-weight:normal;">${TA('specup.subtitle_cp_per_mil', '100만 키나당 전투력 높은 순')}</span>
      </div>
      <div style="margin-top:0.75rem;">
        ${summaryHtml}
        ${guideHtml}
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.5rem;">
          ${cardsHtml}
        </div>
      </div>
    </div>`;
}

function showSpecupBtTooltip(event, idx) {
  const entry = (window.specupBtItemEntries || [])[idx];
  if (!entry) return;
  let tooltip = document.getElementById('specup-bt-tooltip');
  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.id = 'specup-bt-tooltip';
    tooltip.style.cssText = 'position:fixed;z-index:2147483647;pointer-events:none;max-width:290px;padding:0.7rem 0.9rem;background:rgba(12,12,22,0.98);border:1px solid rgba(96,165,250,0.4);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.7);font-size:0.78rem;color:#e2e8f0;line-height:1.4;';
    document.body.appendChild(tooltip);
  }
  const statsHtml = entry.stats.map(s =>
    `<div style="display:flex;justify-content:space-between;align-items:center;padding:0.2rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:rgba(255,255,255,0.55);">${typeof displayBreakthroughStatLabel === 'function' ? displayBreakthroughStatLabel(s.name) : s.name}</span>
      <span style="color:#e2e8f0;font-weight:600;margin:0 0.6rem;">${s.change}</span>
      <span style="color:#60a5fa;font-weight:700;min-width:38px;text-align:right;">+${s.cp}</span>
    </div>`
  ).join('');
  const kinaStr = formatKinaBt(entry.expectedKina);
  const effStr  = entry.cpPerMil !== null ? entry.cpPerMil.toFixed(1) : '—';
  tooltip.innerHTML = `
    <div style="font-size:0.82rem;font-weight:700;color:#e2e8f0;margin-bottom:0.25rem;word-break:keep-all;">${entry.itemName}</div>
    <div style="font-size:0.7rem;color:rgba(255,255,255,0.4);margin-bottom:0.45rem;">${TA('specup.tooltip_bt_change', '현재 {a}돌 → {b}돌 시 스탯 변화').replace('{a}', String(entry.exceedLevel)).replace('{b}', String(entry.nextLevel))}</div>
    <div>${statsHtml}</div>
    <div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid rgba(255,255,255,0.12);display:flex;flex-direction:column;gap:0.25rem;">
      <div style="display:flex;justify-content:space-between;gap:0.75rem;font-size:0.82rem;">
        <span style="color:rgba(255,255,255,0.45);white-space:nowrap;">${TA('specup.tooltip_cp_gain', '전투력 상승')}</span>
        <span style="color:#60a5fa;font-weight:800;">+${Math.round(entry.cpGain).toLocaleString()}</span>
      </div>
      <div style="display:flex;justify-content:space-between;gap:0.75rem;font-size:0.82rem;">
        <span style="color:rgba(255,255,255,0.45);white-space:nowrap;">${TA('specup.tooltip_expected_kinah', '예상 키나 (기댓값)')}</span>
        <span style="color:#f97316;font-weight:800;">${kinaStr}</span>
      </div>
      <div style="display:flex;justify-content:space-between;gap:0.75rem;font-size:0.82rem;">
        <span style="color:rgba(255,255,255,0.45);white-space:nowrap;">${TA('specup.tooltip_cp_per_mil', '100만 키나당 전투력')}</span>
        <span style="color:#fbbf24;font-weight:800;">+${effStr}</span>
      </div>
    </div>`;
  tooltip.style.display = 'block';
  _positionSpecupBtTooltip(tooltip, event.clientX, event.clientY);
}

function updateSpecupBtTooltipPos(event) {
  const tooltip = document.getElementById('specup-bt-tooltip');
  if (tooltip && tooltip.style.display !== 'none') _positionSpecupBtTooltip(tooltip, event.clientX, event.clientY);
}

function _positionSpecupBtTooltip(tooltip, cx, cy) {
  const tw = tooltip.offsetWidth || 260;
  const th = tooltip.offsetHeight || 160;
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  const x = cx + 16;
  const y = cy + 16;
  tooltip.style.left = (x + tw > vw - 6 ? Math.max(6, cx - tw - 6) : x) + 'px';
  tooltip.style.top  = (y + th > vh - 6 ? Math.max(6, cy - th - 6) : y) + 'px';
}

function hideSpecupBtTooltip() {
  const tooltip = document.getElementById('specup-bt-tooltip');
  if (tooltip) tooltip.style.display = 'none';
}

function renderSpecUpPanel() {
  const sectionEl = document.getElementById('specup-magic-stone-section');
  if (!sectionEl) return;

  const currentCP = window.currentNcCombatPower || window.currentCombatPower2 || 0;
  if (currentCP <= 0) {
    sectionEl.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:3rem;font-size:0.9rem;">${TA('specup.no_char', '캐릭터를 먼저 검색하세요.')}</div>`;
    return;
  }

  const equipment = window.currentEquipment || [];
  const accessories = window.currentAccessories || [];

  const parseVal = (val) => {
    const num = parseFloat(String(val || '').replace('%', '').replace('+', '').trim());
    return isNaN(num) ? 0 : num;
  };

  // 장비별 마석 각인 합산 데이터 수집
  const itemEntries = [];

  const processItem = (item) => {
    if (!item || !item.name) return;
    const rawStats = item.magic_stone_stat;
    if (!rawStats) return;
    const stats = extractStats(rawStats);
    if (!stats || stats.length === 0) return;

    let totalCpContrib = 0;
    const statDetails = [];

    stats.forEach(stat => {
      const name = stat.label || stat.name || '';
      const value = stat.value || '';
      if (!name) return;
      const cpKey = statNameToCPKey(name);
      // cpKey가 null이어도 포함 (PVP 등 기여 0인 스탯도 표시)
      let cpContrib = 0;
      if (cpKey) {
        let parsedVal = parseVal(value);
        if (cpKey.endsWith('%')) parsedVal /= 100;
        cpContrib = calculateCPChange(currentCP, cpKey, parsedVal);
      }
      totalCpContrib += cpContrib;
      statDetails.push({ name, value, cpContrib });
    });

    if (statDetails.length === 0) return;

    itemEntries.push({
      itemName: item.name,
      iconUrl: item.icon_url || '',
      totalCpContrib,
      statDetails
    });
  };

  equipment.forEach(item => processItem(item));
  accessories.forEach(item => processItem(item));

  if (itemEntries.length === 0) {
    sectionEl.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:3rem;font-size:0.9rem;">${TA('specup.ms_no_data', '마석 각인 정보가 없습니다.')}</div>`;
    return;
  }

  // 합산 전투력 오름차순 정렬
  itemEntries.sort((a, b) => a.totalCpContrib - b.totalCpContrib);

  // 전역 저장 (tooltip 참조용)
  window.specupItemEntries = itemEntries;

  const totalContrib = itemEntries.reduce((sum, e) => sum + e.totalCpContrib, 0);
  const count = itemEntries.length;
  const maxItemCP = itemEntries[count - 1].totalCpContrib || 1;

  // 요약 카드
  const summaryHtml = `
    <div style="margin-bottom:1rem;padding:0.85rem 1.1rem;background:linear-gradient(135deg,rgba(20,20,35,0.98) 0%,rgba(30,30,50,0.98) 100%);border:1px solid rgba(157,140,255,0.22);border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.3);">
      <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:0.55rem;text-transform:uppercase;letter-spacing:0.5px;">${TA('specup.ms_summary_title', '마석 각인 전투력 요약')}</div>
      <div style="display:flex;flex-wrap:wrap;gap:1.2rem;align-items:center;">
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.ms_total_contrib', '총 마석 각인 기여')}</div><div style="font-size:1.4rem;font-weight:700;color:var(--accent);">+${Math.round(totalContrib).toLocaleString()}</div></div>
        <div style="height:30px;width:1px;background:rgba(255,255,255,0.1);"></div>
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.ms_equip_count', '마석 보유 장비')}</div><div style="font-size:1.2rem;font-weight:700;color:#a78bfa;">${TA('specup.count_suffix', '{n}개').replace('{n}', String(count))}</div></div>
        <div style="height:30px;width:1px;background:rgba(255,255,255,0.1);"></div>
        <div><div style="font-size:0.65rem;color:var(--text-muted);margin-bottom:0.15rem;">${TA('specup.ms_current_cp', '현재 전투력')}</div><div style="font-size:1rem;font-weight:600;color:#60a5fa;">${Math.round(currentCP).toLocaleString()}</div></div>
      </div>
    </div>`;

  // 안내 문구
  const guideHtml = `
    <div style="margin-bottom:0.75rem;padding:0.5rem 0.8rem;background:rgba(167,139,250,0.06);border:1px solid rgba(167,139,250,0.18);border-radius:7px;font-size:0.75rem;color:var(--text-muted);line-height:1.5;">
      ${TA('specup.ms_hover_hint', '🎲 각 카드에 마우스 오버 시 스탯 상세 확인')}
    </div>`;

  // 컴팩트 카드 (4열 그리드)
  const isMobile = window.innerWidth <= 768;
  const cols = isMobile ? 2 : 4;

  // tooltip을 body에 등록 (position:fixed가 부모 overflow에 막히지 않도록)
  let tooltip = document.getElementById('specup-stat-tooltip');
  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.id = 'specup-stat-tooltip';
    document.body.appendChild(tooltip);
  }
  tooltip.style.cssText = 'position:fixed;display:none;z-index:2147483647;pointer-events:none;max-width:290px;padding:0.7rem 0.9rem;background:rgba(12,12,22,0.98);border:1px solid rgba(157,140,255,0.4);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.7);font-size:0.78rem;color:#e2e8f0;line-height:1.4;';

  // 게이지: 최솟값을 기준으로 상대 폭 계산 (첫 번째 아이템을 0 기준으로)
  const minItemCP = itemEntries[0].totalCpContrib;
  const cpRange = maxItemCP - minItemCP || 1;

  const cardsHtml = itemEntries.map((entry, idx) => {
    const totalCpStr = `+${Math.round(entry.totalCpContrib).toLocaleString()}`;
    // 최솟값~최댓값 사이에서 상대 비율 (5%~100% 범위)
    const barWidth = Math.round(5 + ((entry.totalCpContrib - minItemCP) / cpRange) * 95);
    const rank = idx + 1;

    const iconHtml = entry.iconUrl
      ? `<img src="${entry.iconUrl}" alt="" style="width:30px;height:30px;border-radius:5px;object-fit:cover;flex-shrink:0;" onerror="this.style.display='none'">`
      : `<div style="width:30px;height:30px;border-radius:5px;background:rgba(255,255,255,0.08);flex-shrink:0;"></div>`;

    const shortName = entry.itemName.length > 11 ? entry.itemName.slice(0, 9) + '…' : entry.itemName;

    return `
      <div style="padding:0.55rem 0.6rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.09);border-radius:8px;cursor:default;box-sizing:border-box;"
           onmouseover="showSpecupTooltip(event,${idx});this.style.background='rgba(157,140,255,0.1)';this.style.borderColor='rgba(157,140,255,0.35)';"
           onmouseout="hideSpecupTooltip();this.style.background='rgba(255,255,255,0.04)';this.style.borderColor='rgba(255,255,255,0.09)';"
           onmousemove="updateSpecupTooltipPos(event);">
        <!-- 1행: 순위 + 전투력 (한 줄에) -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.3rem;">
          <span style="font-size:0.85rem;font-weight:900;color:rgba(167,139,250,0.75);letter-spacing:-0.3px;">${TA('specup.ms_rank_n', '{n}순위').replace('{n}', String(rank))}</span>
          <span style="font-size:0.88rem;font-weight:800;color:#a78bfa;">${totalCpStr}</span>
        </div>
        <!-- 2행: 아이콘 + 장비명 -->
        <div style="display:flex;align-items:center;gap:0.35rem;margin-bottom:0.38rem;">
          ${iconHtml}
          <div style="min-width:0;overflow:hidden;">
            <div style="font-size:0.7rem;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;line-height:1.3;" title="${entry.itemName}">${shortName}</div>
            <div style="font-size:0.58rem;color:rgba(255,255,255,0.32);">${TA('specup.ms_engrave_count', '각인 {n}개').replace('{n}', String(entry.statDetails.length))}</div>
          </div>
        </div>
        <!-- 게이지 바 (gradient 방식 - overflow 문제 없음) -->
        <div style="height:4px;border-radius:2px;background:linear-gradient(to right, rgba(167,139,250,0.6) ${barWidth}%, rgba(255,255,255,0.08) ${barWidth}%);"></div>
      </div>`;
  }).join('');

  sectionEl.innerHTML = `
    <div class="skill-category-card" style="margin-bottom:1.5rem;">
      <div class="skill-category-header" style="display:flex;align-items:center;gap:0.5rem;">
        <span>${TA('specup.ms_section_title', '마석 각인 스펙업 우선순위')}</span>
        <span style="font-size:0.75rem;color:var(--text-muted);font-weight:normal;">${TA('specup.ms_section_subtitle', '장비별 합산 기여 낮은 순')}</span>
      </div>
      <div style="margin-top:0.75rem;">
        ${summaryHtml}
        ${guideHtml}
        <div style="display:grid;grid-template-columns:repeat(${cols},1fr);gap:0.45rem;">
          ${cardsHtml}
        </div>
      </div>
    </div>`;
}

function showSpecupTooltip(event, idx) {
  const entry = (window.specupItemEntries || [])[idx];
  if (!entry) return;

  // body에 없으면 생성
  let tooltip = document.getElementById('specup-stat-tooltip');
  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.id = 'specup-stat-tooltip';
    tooltip.style.cssText = 'position:fixed;z-index:2147483647;pointer-events:none;max-width:290px;padding:0.7rem 0.9rem;background:rgba(12,12,22,0.98);border:1px solid rgba(157,140,255,0.4);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,0.7);font-size:0.78rem;color:#e2e8f0;line-height:1.4;';
    document.body.appendChild(tooltip);
  }

  const statsHtml = entry.statDetails.map(s => {
    const valStr = String(s.value || '').startsWith('+') ? s.value : `+${s.value}`;
    const cpRound = Math.round(s.cpContrib);
    const cpColor = cpRound > 0 ? '#a78bfa' : 'rgba(255,255,255,0.3)';
    return `<div style="display:flex;justify-content:space-between;align-items:center;padding:0.2rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
      <span style="color:rgba(255,255,255,0.55);">${s.name}</span>
      <span style="color:#e2e8f0;font-weight:600;margin:0 0.6rem;">${valStr}</span>
      <span style="color:${cpColor};font-weight:700;min-width:38px;text-align:right;">+${cpRound}</span>
    </div>`;
  }).join('');

  const totalCp = Math.round(entry.totalCpContrib);
  tooltip.innerHTML = `
    <div style="font-size:0.82rem;font-weight:700;color:#e2e8f0;margin-bottom:0.5rem;word-break:keep-all;">${entry.itemName}</div>
    <div>${statsHtml}</div>
    <div style="display:flex;justify-content:space-between;padding-top:0.4rem;margin-top:0.2rem;border-top:1px solid rgba(255,255,255,0.12);font-size:0.82rem;">
      <span style="color:rgba(255,255,255,0.45);">${TA('specup.ms_total_cp', '합산 전투력 기여')}</span>
      <span style="color:#a78bfa;font-weight:800;">+${totalCp.toLocaleString()}</span>
    </div>`;

  tooltip.style.display = 'block';
  _positionSpecupTooltip(tooltip, event.clientX, event.clientY);
}

function updateSpecupTooltipPos(event) {
  const tooltip = document.getElementById('specup-stat-tooltip');
  if (tooltip && tooltip.style.display !== 'none') {
    _positionSpecupTooltip(tooltip, event.clientX, event.clientY);
  }
}

function _positionSpecupTooltip(tooltip, cx, cy) {
  const tw = tooltip.offsetWidth || 290;
  const th = tooltip.offsetHeight || 160;
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  const x = cx + 16;
  const y = cy + 16;
  tooltip.style.left = (x + tw > vw - 6 ? Math.max(6, cx - tw - 6) : x) + 'px';
  tooltip.style.top  = (y + th > vh - 6 ? Math.max(6, cy - th - 6) : y) + 'px';
}

function hideSpecupTooltip() {
  const tooltip = document.getElementById('specup-stat-tooltip');
  if (tooltip) tooltip.style.display = 'none';
}
</script>


      </main>
      
      
      
      <!-- Venatus: Billboard (데스크탑 최하단, 970x250) -->
      <div id="slot-2" class="venatus-ad-slot venatus-desktop-only" style="display: flex; justify-content: center; align-items: center; min-height: 250px; margin: 1.5rem 0;"></div>
      <!-- Venatus: Double MPU (모바일 최하단, 300x600) -->
      <div id="slot-9" class="venatus-ad-slot venatus-mobile-only" style="display: flex; justify-content: center; align-items: center; min-height: 600px; margin: 1.5rem 0;"></div>
      

      <footer>
         
        
        <div class="footer-links">
          <a href="/cdn-cgi/l/email-protection#8beae2e4e5b9ffe4e4e7a5e8e4e5ffeae8ffcbece6eae2e7a5e8e4e6b4f8fee9e1eee8ffb6bab1baab602733671613" class="footer-link-text" id="inquiry-link">1:1 문의</a>
          <span class="footer-separator">|</span>
          <button class="footer-link-text" id="terms-link" style="border: none; font-family: inherit; background: none; padding: 0; margin: 0;">이용 약관</button>
          <span class="footer-separator">|</span>
          <a href="/privacy" class="footer-link-text">개인정보 처리방침</a>
        </div>
        <div class="footer-copyright">
          <p style="margin-bottom: 0.75rem;">
            <strong style="color: #a78bfa;">본 사이트는 (주)엔씨소프트와 무관한 비공식 팬 사이트입니다.</strong><br>
            <span style="font-size: 0.8rem; opacity: 0.8;">This site is not associated with NCsoft Corporation & AION2.</span>
          </p>
          <p style="font-size: 0.85rem; opacity: 0.7;">© 2026 AION2 TOOL All Rights Reserved.</p>
        </div>
      </footer>

      </div><!-- END #content-container -->

      <!-- 이용 약관 모달 -->
      <div id="terms-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
          <div class="modal-header">
            <h2>서비스 이용약관</h2>
            <button class="modal-close" id="terms-close">&times;</button>
          </div>
          <div class="modal-body" id="terms-content"></div>
