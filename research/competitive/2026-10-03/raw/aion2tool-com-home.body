let cdCurrentCode = null;
let cdArcanaExpanded = {};   // { 부위: bool }
let cdArcanaCache = null;    // 마지막 arcana-skills 응답 (펼쳐보기 재렌더용)
let cdArcanaJob = null;

// 아르카나 세트 옵션 토큰 → 효과 키
const CD_SET_TOKEN = {
  '마력': 'magic', '魔力': 'magic',
  '활력': 'vitality', '活力': 'vitality',
  '순수': 'purity', '純粹': 'purity', '純種': 'purity', '純淨': 'purity',
  '광분': 'frenzy', '狂暴': 'frenzy', '狂奔': 'frenzy',
  '수호': 'guardian', '守護': 'guardian',
  '불굴': 'indomitable', '不屈': 'indomitable',
  '징벌': 'punishment', '懲罰': 'punishment'
};
const CD_SET_LABEL = {
  magic: () => TA('arcana.set.magic', '마력'),
  vitality: () => TA('arcana.set.vitality', '활력'),
  purity: () => TA('arcana.set.purity', '순수'),
  frenzy: () => TA('arcana.set.frenzy', '광분'),
  guardian: () => TA('arcana.set.guardian', '수호'),
  indomitable: () => TA('arcana.set.indomitable', '불굴'),
  punishment: () => TA('arcana.set.punishment', '징벌')
};
const CD_SET_EFFECT_KO = {
  magic_2: '정신력이 20% 이하로 감소할 경우, 1500의 정신력을 즉시 회복 [재사용 시간 30초]',
  magic_4: '정신력이 50%이상일 때, PVE 방어력 1000 증가',
