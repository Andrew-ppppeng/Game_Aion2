  if (tooltipSoul) tooltipSoul.textContent = `+${soulAccuracy}`;
  if (tooltipTitleEquip) tooltipTitleEquip.textContent = `+${(breakdown.titleEquipAdditionalAccuracy || 0) + (breakdown.titleEquipPveAccuracy || 0)}`;
