// 영혼 각인 옵션 (시뮬레이션용 - +15 고뇌하는 바카르마 메인 무기 전용)
const SIM_SOUL_OPTIONS_MAIN_BAKARMA = [
  { name: '전투 속도', unit: '%', defaultValue: 10.71, maxValue: 12.39 },
  { name: '무기 피해 증폭', unit: '%', defaultValue: 11.61, maxValue: 13.42 },
  { name: '피해 증폭', unit: '%', defaultValue: 4.81, maxValue: 5.6 },
  { name: '다단 히트 적중', unit: '%', defaultValue: 7.58, maxValue: 8.79 },
  { name: '위력', unit: '', defaultValue: 62, maxValue: 78 },
  { name: '정확', unit: '', defaultValue: 62, maxValue: 78 },
  { name: '공격력', unit: '', defaultValue: 25, maxValue: 36 },
  { name: '치명타', unit: '', defaultValue: 30, maxValue: 42 },
  { name: '명중', unit: '', defaultValue: 15, maxValue: 36 }
];

function getSimSoulOptionsForWeapon(simData, weaponSlot) {
  const customName = simData?.customWeaponName || '';
  const isBakarma = customName.includes('고뇌하는 바카르마');
  const isMyong = customName.includes('명룡') || customName.includes('암룡');
  const isCheon = customName.includes('천룡') || customName.includes('마룡');
  const isCheonShiny = isCheon && customName.includes('빛나는');

  if (isBakarma && weaponSlot === 'main') {
    return SIM_SOUL_OPTIONS_MAIN_BAKARMA;
  }
  if (isMyong) {
    return weaponSlot === 'main' ? SIM_SOUL_OPTIONS_MYONGRYONG : SIM_SOUL_OPTIONS_SUB_MYONGRYONG;
  }
  if (isCheonShiny) {
    return weaponSlot === 'main' ? SIM_SOUL_OPTIONS_CHEONRYONG_SHINY : SIM_SOUL_OPTIONS_SUB_CHEONRYONG_SHINY;
  }
  if (isCheon) {
    return weaponSlot === 'main' ? SIM_SOUL_OPTIONS_CHEONRYONG : SIM_SOUL_OPTIONS_SUB_CHEONRYONG;
  }
  return weaponSlot === 'main' ? SIM_SOUL_OPTIONS : SIM_SOUL_OPTIONS_SUB;
}

function getCustomWeaponEnhanceLevel(customName, customStats) {
  const enhanceLevel = Number(customStats?.enhanceLevel);
  if (!Number.isNaN(enhanceLevel) && enhanceLevel > 0) return enhanceLevel;
  if (customName.includes('고뇌하는 바카르마')) return 15;
  if (customName.includes('명룡') || customName.includes('암룡')) return 15;
  if (customName.includes('천룡') || customName.includes('마룡')) return 15;
  if (customName.includes('기룡') || customName.includes('응룡')) return 20;
  return 0;
}

function getCustomWeaponTheme(customName) {
  if (customName.includes('고뇌하는 바카르마')) {
    return { color: '250, 204, 21', text: '#facc15' };
  }
  const isUnique = customName.includes('명룡') || customName.includes('암룡') ||
    customName.includes('천룡') || customName.includes('마룡');
  if (isUnique) {
    return { color: '250, 204, 21', text: '#facc15' };
  }
  return { color: '249, 115, 22', text: '#f97316' };
}

