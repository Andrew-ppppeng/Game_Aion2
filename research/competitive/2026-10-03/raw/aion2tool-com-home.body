0b0\uc5d0 \ud3ec\ud568\ub429\ub2c8\ub2e4.\u003cbr\u003e\uc810\uc218\ub294 \uad6c\uac04\ubcc4 \uc778\uc6d0 \u003cb\u003e\ube44\uc728\u003c/b\u003e\ub300\ub85c \ub098\ub220 \uac00\uc9c0\ubbc0\ub85c \uadfc\uc18c\ud55c \uc778\uc6d0 \ucc28\uc774\ub294 \uadfc\uc18c\ud55c \uc810\uc218\ucc28\ub85c\ub9cc \ubc18\uc601\ub418\uba70, \ud45c\ubcf8\uc774 \uc801\uc740 \uad6c\uac04\uc740 50:50\uc5d0 \uac00\uae5d\uac8c \ubcf4\uc815\ub429\ub2c8\ub2e4.", "server_comparison.all_match_results": "\uc804\uccb4 \ub9e4\uce6d \uacb0\uacfc \ud55c\ub208\uc5d0 \ubcf4\uae30", "server_comparison.arh_desc": "\uc810\ub839\uc804 \ud68c\ucc28\uac00 \ub05d\ub0a0 \ub54c\ub9c8\ub2e4 \ub204\uc801 \uc810\ub839 \ud69f\uc218\ub85c \ub2e4\uc2dc \ub9e4\uae34 \uc21c\uc704\uc785\ub2c8\ub2e4. \uc5b4\ub5a4 \uc11c\ubc84\uac00 \uc5b8\uc81c\ubd80\ud130 1\uc704\uc600\ub294\uc9c0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.arh_empty": "\uc544\uc9c1 \uc810\ub839 \uae30\ub85d\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.arh_hint": "\uc11c\ubc84\ub97c \ub20c\ub7ec \uadf8\ub798\ud504\uc5d0 \ucd94\uac00/\uc81c\uac70 (\uc120 \uc0c9\uc774 \uad6c\ubd84\ub418\ub294 \ucd5c\ub300 {n}\uac1c\uae4c\uc9c0)", "server_comparison.arh_omitted": "{n}\uac1c \ud68c\ucc28\ub294 \ub2f9\uc2dc \ub9e4\uce6d \uad6c\ub3c4\ub97c \uc54c \uc218 \uc5c6\uc5b4 \uc81c\uc678\ud588\uc2b5\ub2c8\ub2e4 (\uc2dc\uc98c3 1\ucc28 \uc774\uc804 \uae30\ub85d).", "server_comparison.arh_open": "\uc810\ub839 \uc21c\uc704 \ubcc0\ub3d9 \uadf8\ub798\ud504 \ubcf4\uae30", "server_comparison.arh_round_fmt": "{season} {battle}\ud68c\ucc28", "server_comparison.arh_scope_all": "\uc804\uccb4 \uc2dc\uc98c", "server_comparison.arh_scope_season": "\uc774 \uc2dc\uc98c", "server_comparison.arh_streak": "{since}\ubd80\ud130 {n}\ud68c\ucc28 \uc5f0\uc18d 1\uc704 (\ub204\uc801 {cum}\ud68c \uc810\ub839)", "server_comparison.arh_title": "\ub204\uc801 \uc810\ub839 \uc21c\uc704 \ucd94\uc774", "server_comparison.arh_tooltip": "{server} \u00b7 {round} \u00b7 {rank}\uc704 (\ub204\uc801 {cum}\ud68c)", "server_comparison.arh_top": "TOP 3 \ubcf4\uae30", "server_comparison.artifact": "\uc544\ud2f0\ud329\ud2b8 \uc810\ub839", "server_comparison.artifact_desc": "\ucc55\ud1301 7\ucc28 \ub9e4\uce6d \uadf8\ub8f9\ubcc4 \uc5b4\ube44\uc2a4 \uc544\ud2f0\ud329\ud2b8 \uc810\ub839 \ud604\ud669\uc785\ub2c8\ub2e4. \uc810\ub839\uc804\uc740 \ub9e4\uc8fc \uc218/\ud1a0 \uadf8\ub8f9\ubcc4\ub85c 21:20 \u00b7 21:50 \u00b7 22:20\uc5d0 \uc2dc\uc791\ud558\uba70, \uc2dc\uc791 10\ubd84 \ud6c4\ubd80\ud130 \uc81c\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.artifact_grid_loading": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911\uc785\ub2c8\ub2e4.", "server_comparison.artifact_list_load_error": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc62c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.artifact_loading_hint": "\uc544\ud2f0\uc7c1 \uc9c4\ud589\uc77c\uc5d0\ub294 10\ucd08 \uc774\uc0c1 \uac78\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4", "server_comparison.artifact_notice_kst": "\ucc55\ud1301 7\ucc28 \ub9e4\uce6d \uadf8\ub8f9\ubcc4 \uc5b4\ube44\uc2a4 \uc544\ud2f0\ud329\ud2b8 \uc810\ub839 \ud604\ud669\uc785\ub2c8\ub2e4. \uc810\ub839\uc804\uc740 \ub9e4\uc8fc \uc218/\ud1a0 \uadf8\ub8f9\ubcc4\ub85c 21:20 \u00b7 21:50 \u00b7 22:20\uc5d0 \uc2dc\uc791\ud558\uba70, \uc2dc\uc791 10\ubd84 \ud6c4\ubd80\ud130 \uc81c\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.artifact_root": "\uc5d0\ub808\uc288\ub780\ud0c0\uc758 \ubfcc\ub9ac", "server_comparison.artifact_status": "\uc544\ud2f0\ud329\ud2b8 \uc810\ub839 \ud604\ud669", "server_comparison.asmo_pct_race": "{p}% \ub9c8\uc871", "server_comparison.asmo_server_wins": "\ub9c8\uc871 \uc11c\ubc84 {n}\uc2b9", "server_comparison.asmodian_alt": "\ub9c8\uc871", "server_comparison.battle_nth_ko": " ({n}\ucc28\uc804)", "server_comparison.battle_round_label": "{n}\ucc28\uc804", "server_comparison.can_report_failed": "\uc81c\ubcf4 \uac00\ub2a5 \uc5ec\ubd80 \ud655\uc778 \uc2e4\ud328:", "server_comparison.capture_count": "{n}\ud68c", "server_comparison.contributors_thanks": "\uc81c\ubcf4\uc790: {names} \ub2d8, \uac10\uc0ac\ud569\ub2c8\ub2e4!", "server_comparison.countdown_day_unit": "{d}\uc77c ", "server_comparison.countdown_next_ko": "\ub2e4\uc74c \uc810\ub839\uc804: \u003cstrong\u003e{date} {time}{battle}\u003c/strong\u003e \u00b7 \u003cspan class=\"artifact-countdown-accent\"\u003e{remain} \ub0a8\uc74c\u003c/span\u003e", "server_comparison.countdown_started": "\uc810\ub839\uc804\uc774 \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4!", "server_comparison.cumulative_by_race": "\uc885\uc871\ubcc4 \ub204\uc801 \uc544\ud2f0\ud329\ud2b8", "server_comparison.cumulative_score_total": "\uc804\uccb4 \ub204\uc801 \uc2a4\ucf54\uc5b4", "server_comparison.cumulative_short": "\ub204\uc801", "server_comparison.data_loading_modal": "\ub370\uc774\ud130 \ub85c\ub529 \uc911...", "server_comparison.detail_view_link": "\uc0c1\uc138 \ubcf4\uae30 \u003e\u003e", "server_comparison.dom_capture_missing": "\ub450 \uc11c\ubc84\uac00 \ub9de\ubd99\uc740 \uc810\ub839 \uae30\ub85d\uc774 \uc544\uc9c1 \uc5c6\uc5b4 \ub098\uba38\uc9c0 \uc9c0\ud45c\ub85c\ub9cc \uacc4\uc0b0\ud588\uc2b5\ub2c8\ub2e4.", "server_comparison.dom_disclaimer_body": "\ubcf8 \uc810\uc218\ub294 \uc544\ud234 DB\uc5d0 \ud3ec\ud568\ub41c \uc778\uad6c \uae30\uc900\uc73c\ub85c \uacc4\uc0b0\ud55c \uac83\uc73c\ub85c, \uc2e4\uc81c \uc11c\ubc84 \uc778\uad6c\uc640 \ucc28\uc774\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.dom_disclaimer_method_body": "\ub450 \uc11c\ubc84\ub97c \u003cb\u003e4\uac1c \uc9c0\ud45c\u003c/b\u003e\ub85c \ub9de\ub300\uacb0\uc2dc\ucf1c, \uac01 \uc9c0\ud45c\uc758 \uc810\uc720\uc728\uc744 \uc544\ub798 \uac00\uc911\uce58\ub85c \ud569\uc0b0\ud574 100\uc810\uc744 \ub098\ub215\ub2c8\ub2e4 (\uc544\ud234 \uc885\ud569 \uc11c\ubc84 \uc21c\uc704\uc640 \uac19\uc740 \ubc29\uc2dd). \uc778\uad6c\u00b7\uc804\ud22c\ub825\u00b7\ud480\uc0e4\ub4dc\ub294 \u003cb\u003e\ucd5c\uadfc 30\uc77c \uc544\ud234 \ud65c\uc131 \uce90\ub9ad\ud130\u003c/b\u003e \uae30\uc900\uc774\ub77c \uc544\ud234\uc5d0\uc11c \uac80\uc0c9\ub41c \uce90\ub9ad\ud130\ub9cc \ud45c\ubcf8\uc774\uba70, \uc2e4\uc81c \uc11c\ubc84 \uc778\uad6c\uc640\ub294 \ucc28\uc774\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\ub300 \uc804\uc801\uc740 \u003cb\u003e\ub450 \uc11c\ubc84\uac00 \uc9c0\uae08\uae4c\uc9c0 \ub9de\ubd99\uc740 \ubaa8\ub4e0 \ud68c\ucc28\uc5d0\uc11c \uac01\uc790 \uac00\uc838\uac04 \uc544\ud2f0\ud329\ud2b8 \uc218\u003c/b\u003e\uc785\ub2c8\ub2e4 (\uc2dc\uc98c\uc774 \ubc14\ub00c\uc5b4 \ub2e4\uc2dc \ub9cc\ub09c \uae30\ub85d\uae4c\uc9c0 \ub204\uc801). \ud45c\ubcf8\uc774 \uc801\uc740 \uc9c0\ud45c\uac00 \uc810\uc218\ub97c \ud06c\uac8c \ud754\ub4e4\uc9c0 \uc54a\ub3c4\ub85d \uc591\ucabd\uc5d0 \uc18c\ub7c9\uc758 \uac00\uc0c1 \ud45c\ubcf8\uc744 \ub354\ud574 \ubcf4\uc815\ud569\ub2c8\ub2e4. \u003cb\u003e\uc5b4\ube44\uc2a4 \ud3ec\uc778\ud2b8\ub294 \ub7ad\ud0b9 \uc815\ubcf4\uac00 \ub354 \uc774\uc0c1 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc544 \uc9c0\ud45c\uc5d0\uc11c \uc81c\uc678\u003c/b\u003e\ud588\uc2b5\ub2c8\ub2e4.", "server_comparison.dom_disclaimer_method_title": "\uc810\uc218 \uacc4\uc0b0 \ubc29\uc2dd", "server_comparison.dom_disclaimer_title": "\u26a0\ufe0f \uc8fc\uc758\uc0ac\ud56d", "server_comparison.dom_disclaimer_weights_title": "\ud56d\ubaa9\ubcc4 \uac00\uc911\uce58 (\ucd1d 100\uc810 \ub9cc\uc810)", "server_comparison.dom_metric_capture": "\uc544\ud2f0\ud329\ud2b8 \uc0c1\ub300 \uc804\uc801", "server_comparison.dom_metric_pop": "\uc544\ud234 \ud65c\uc131 \uc778\uad6c", "server_comparison.dom_metric_power": "\uc0c1\uc704 \uc804\ud22c\ub825 \uc778\uc6d0", "server_comparison.dom_metric_section": "\uc9c0\ud45c\ubcc4 \uc6b0\uc138", "server_comparison.dom_metric_shard": "\ud480\uc0e4\ub4dc \uc778\uc6d0", "server_comparison.dom_weight_lines": "\uc544\uc774\ud15c \ub808\ubca8 4500 \uc774\uc0c1: 10\uc810\n\uc544\uc774\ud15c \ub808\ubca8 4000~4500: 5\uc810\n\uc544\uc774\ud15c \ub808\ubca8 3000~4000: 3\uc810\n\uc544\uc774\ud15c \ub808\ubca8 3000 \ubbf8\ub9cc: 2\uc810\n\uc5b4\ube44\uc2a4 100\ub9cc \uc774\uc0c1: 50\uc810\n\uc5b4\ube44\uc2a4 20\ub9cc~100\ub9cc: 8\uc810\n\uc5b4\ube44\uc2a4 5\ub9cc~20\ub9cc: 4\uc810\n\uc5b4\ube44\uc2a4 1\ub9cc~5\ub9cc: 2\uc810\n\uc804\ud22c\ub825 60\ub9cc \uc774\uc0c1: 8\uc810\n\uc804\ud22c\ub825 50\ub9cc~60\ub9cc: 4\uc810\n\uc804\ud22c\ub825 40\ub9cc~50\ub9cc: 2\uc810\n\uc804\ud22c\ub825 40\ub9cc \uc774\ud558: 2\uc810", "server_comparison.dominance": "\uc11c\ubc84 \uc6b0\uc138", "server_comparison.dominance_desc": "\ub9e4\uce6d \uadf8\ub8f9\ubcc4 \uc11c\ubc84 \uc6b0\uc138\ub3c4\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694.", "server_comparison.dominance_status": "\uc11c\ubc84 \uc6b0\uc138 \ud604\ud669", "server_comparison.draw": "\ubb34\uc2b9\ubd80", "server_comparison.east_pct": "{p}% \ub3d9\ubd80", "server_comparison.east_wins": "\ub3d9\ubd80 \uc2b9", "server_comparison.elyos_alt": "\ucc9c\uc871", "server_comparison.elyos_pct_race": "\ucc9c\uc871 {p}%", "server_comparison.elyos_server_wins": "\ucc9c\uc871 \uc11c\ubc84 {n}\uc2b9", "server_comparison.error_occurred": "\uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "server_comparison.favorite_title": "\uc990\uaca8\ucc3e\uae30", "server_comparison.fmt_cp_between": "{a}\ub9cc~{b}\ub9cc", "server_comparison.fmt_cp_over": "{a}\ub9cc \uc774\uc0c1", "server_comparison.fmt_cp_under": "{a}\ub9cc \ubbf8\ub9cc", "server_comparison.fmt_il_between": "\uc544\uc774\ud15c \ub808\ubca8 {a}~{b}", "server_comparison.fmt_il_over": "\uc544\uc774\ud15c \ub808\ubca8 {a} \uc774\uc0c1", "server_comparison.fmt_il_under": "\uc544\uc774\ud15c \ub808\ubca8 {a} \ubbf8\ub9cc", "server_comparison.fortress": "\uc624\uc5fc\ub41c \ub2aa\uc9c0", "server_comparison.history_no_records": "\uc544\uc9c1 \uae30\ub85d\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.history_past_none": "\uc774\uc804 \uc2dc\uc98c\uc5d0 {a} vs {b} \ub85c \ub9de\ubd99\uc740 \uae30\ub85d\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.history_past_swapped": "\u21c4 \uc774 \uc2dc\uc98c\uc5d0\ub294 \uc88c\u00b7\uc6b0\uac00 \uc9c0\uae08\uacfc \ubc18\ub300\uc600\uc2b5\ub2c8\ub2e4. \ud45c\ub294 \ud604\uc7ac \ub9e4\uce6d \uae30\uc900(\uc67c\ucabd=\uc9c0\uae08 \uc67c\ucabd \uc11c\ubc84)\uc73c\ub85c \ub9de\ucdb0 \ud45c\uc2dc\ud569\ub2c8\ub2e4.", "server_comparison.history_past_total": "\uc2dc\uc98c \ud569\uacc4", "server_comparison.history_tab_current": "\uc774\ubc88 \ub9e4\uce6d", "server_comparison.history_tab_past": "\uacfc\uac70 \ub9e4\uce6d", "server_comparison.history_title_suffix": " \uae30\ub85d", "server_comparison.history_view": "\uacfc\uac70 \uae30\ub85d \ubcf4\uae30", "server_comparison.last_update_kst": "\ub9c8\uc9c0\ub9c9 \uc5c5\ub370\uc774\ud2b8: {t} (KST)", "server_comparison.last_update_plain": "\ub9c8\uc9c0\ub9c9 \uc5c5\ub370\uc774\ud2b8: {t}", "server_comparison.layer_lower": "\ud558\uce35", "server_comparison.layer_lower_abbr": "\ud558", "server_comparison.layer_lower_ersh": "\ud558\uce35 (\uc5d0\ub808\uc288\ub780\ud0c0)", "server_comparison.layer_upper": "\uc911\uce35", "server_comparison.layer_upper_abbr": "\uc911", "server_comparison.layer_upper_ersh": "\uc911\uce35 (\uc5d0\ub808\uc288\ub780\ud0c0)", "server_comparison.load_failed_log": "\uc544\ud2f0\ud329\ud2b8 \ub370\uc774\ud130 \ub85c\ub4dc \uc2e4\ud328:", "server_comparison.lower_floor": "\ud558\uce35 (\uc5d0\ub808\uc288\ub780\ud0c0)", "server_comparison.match_line": "\ub9e4\uce6d {id}: {a} vs {b}", "server_comparison.may_take_10s": "10\ucd08 \uc774\uc0c1 \uac78\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.may_take_10s_artifact": "\uc544\ud2f0\uc7c1 \uc9c4\ud589\uc77c\uc5d0\ub294 10\ucd08 \uc774\uc0c1 \uac78\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4", "server_comparison.middle_floor": "\uc911\uce35 (\uc5d0\ub808\uc288\ub780\ud0c0)", "server_comparison.month_day_label": "{m}\uc6d4 {d}\uc77c", "server_comparison.network_error": "\ub124\ud2b8\uc6cc\ud06c \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "server_comparison.nickname_placeholder": "\ub2c9\ub124\uc784 (\uc120\ud0dd)", "server_comparison.no_capture": "\uc810\ub839 \uc5c6\uc74c", "server_comparison.no_data_yet": "\uc544\uc9c1 \ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.observatory": "\uce68\uc2dd\ub41c \uc911\uc559\uc12c", "server_comparison.overall_best_rank": "\uc5ed\ub300 \ucd5c\uace0 {n}\uc704", "server_comparison.overall_change_new": "NEW", "server_comparison.overall_change_tip": "\uc9c0\ub09c\uc8fc {p}\uc704 \u2192 \uc774\ubc88 \uc8fc {c}\uc704", "server_comparison.overall_change_tip_new": "\uc9c0\ub09c\uc8fc \uae30\ub85d \uc5c6\uc74c", "server_comparison.overall_change_tip_same": "\uc9c0\ub09c\uc8fc\uc640 \ub3d9\uc77c ({c}\uc704)", "server_comparison.overall_col_change": "\uc804\uc8fc \ub300\ube44", "server_comparison.overall_col_score": "\uc885\ud569 \uc810\uc218", "server_comparison.overall_desc": "\uc804\uccb4 42\uac1c \uc11c\ubc84\ub97c \uc778\uad6c\u00b7\uc804\ud22c\ub825\u00b7\uc5d4\ub4dc\ucee8\ud150\uce20\u00b7\uc810\ub839 \uc131\uc801 4\uac1c \uc9c0\ud45c\ub85c \ud3c9\uac00\ud574 \uc885\ud569 \uc21c\uc704\ub97c \ub9e4\uacbc\uc2b5\ub2c8\ub2e4. \uac01 \uc9c0\ud45c\uc758 \uc6d0\ubcf8 \uc218\uce58\uc640 \uac1c\ubcc4 \uc21c\uc704\ub3c4 \ud568\uaed8 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.overall_detail_best": "\uc5ed\ub300 \ucd5c\uace0", "server_comparison.overall_detail_collapse": "\uc811\uae30", "server_comparison.overall_detail_none": "\uc544\uc9c1 \uc774 \uc11c\ubc84\uc758 \uc8fc\uac04 \uae30\ub85d\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.", "server_comparison.overall_detail_prev": "\uc9c0\ub09c\uc8fc", "server_comparison.overall_detail_title": "{server} \uc8fc\uac04 \uc21c\uc704 \ubcc0\ub3d9", "server_comparison.overall_detail_weeks": "\uae30\ub85d \uc8fc\ucc28", "server_comparison.overall_detail_weeks_unit": "{n}\uc8fc", "server_comparison.overall_first_week_notice": "\uc774\ubc88 \uc8fc\uac00 \u003cb\u003e\uccab \uc2a4\ub0c5\uc0f7\u003c/b\u003e\uc774\ub77c \ubaa8\ub4e0 \uc11c\ubc84\uac00 \u003cb\u003e\ubcc0\ub3d9 \uc5c6\uc74c(\u2013)\u003c/b\u003e\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc \uc6d4\uc694\uc77c 05\uc2dc(KST) \uc2a4\ub0c5\uc0f7\ubd80\ud130 \uc2e4\uc81c \u25b2\u25bc \ubcc0\ub3d9\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. (\uae30\uc900 \uc8fc\ucc28: {w})", "server_comparison.overall_m_capture": "\uc810\ub839\ub960", "server_comparison.overall_m_capture_desc": "\uc5ed\ub300 \uc544\ud2f0\ud329\ud2b8 \uc810\ub839\uc804\uc5d0\uc11c \uc2e4\uc81c\ub85c \ucc28\uc9c0\ud55c \uc544\ud2f0\ud329\ud2b8 \ube44\uc728. \uc11c\ubc84\uc758 PvP \uc131\uc801\uc785\ub2c8\ub2e4.", "server_comparison.overall_m_pop": "\uc544\ud234 \ud65c\uc131 \uc778\uad6c", "server_comparison.overall_m_pop_desc": "\ucd5c\uadfc 30\uc77c \ub0b4 \uc544\ud234\uc5d0\uc11c \uac80\uc0c9\ub41c \uce90\ub9ad\ud130 \uc218. \uc11c\ubc84\uc758 \uc2e4\uc81c \ud65c\ub3d9\ub7c9\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.", "server_comparison.overall_m_power": "\uc0c1\uc704 20% \uc804\ud22c\ub825", "server_comparison.overall_m_power_desc": "\ud65c\uc131 \uce90\ub9ad\ud130\ub97c \uc804\ud22c\ub825\uc21c\uc73c\ub85c \uc904 \uc138\uc6cc \uc0c1\uc704 20%\ub9cc \ubf51\uc740 \ub4a4 \uadf8 \uc911\uc559\uac12. \uc11c\ubc84 \uc8fc\ub825\uce35\uc758 \uc2a4\ud399 \uc218\uc900\uc785\ub2c8\ub2e4.", "server_comparison.overall_m_shard": "\ud480\uc0e4\ub4dc \uc778\uc6d0", "server_comparison.overall_m_shard_desc": "\uc2a4\ud2f0\uadf8\ub9c8 \uc0e4\ub4dc\ub97c \uc0c1\ud55c\uce58\uc778 975\uac1c \uc774\uc0c1 \ubcf4\uc720\ud55c \uce90\ub9ad\ud130 \uc218. \uc5d4\ub4dc\ucee8\ud150\uce20 \ud22c\uc790\uce35\uc758 \ub450\uaed8\uc785\ub2c8\ub2e4.", "server_comparison.overall_method_note": "\uac01 \uc9c0\ud45c\ub97c \u003cb\u003e42\uac1c \uc11c\ubc84 \uc911 \ucd5c\uc800=0\uc810, \ucd5c\uace0=100\uc810\u003c/b\u003e\uc73c\ub85c \ud658\uc0b0\ud55c \ub4a4 \uc704 \uac00\uc911\uce58\ub85c \ud569\uc0b0\ud569\ub2c8\ub2e4 (\ucd1d\uc810 100\uc810). \uc778\uad6c\u00b7\uc804\ud22c\ub825\u00b7\ud480\uc0e4\ub4dc\ub294 \u003cb\u003e\ucd5c\uadfc 30\uc77c \ud65c\uc131 \uce90\ub9ad\ud130\u003c/b\u003e \uae30\uc900\uc774\uba70, \uc544\ud234\uc5d0\uc11c \uac80\uc0c9\ub41c \uce90\ub9ad\ud130\ub9cc \ud45c\ubcf8\uc774\ub77c \uc2e4\uc81c \uc11c\ubc84 \uc778\uad6c\uc640\ub294 \ucc28\uc774\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\ub839\ub960\uc740 \u003cb\u003e\uc2dc\uc98c3 1\ucc28(4/9) \uc774\ud6c4 \ubaa8\ub4e0 \ud68c\ucc28 \ub204\uc801\u003c/b\u003e\uc774\uba70, \uadf8 \uc774\uc804 \uae30\ub85d\uc740 \ub2f9\uc2dc \ub9e4\uce6d \uad6c\ub3c4\ub97c \uc54c \uc218 \uc5c6\uc5b4 \uc81c\uc678\ud588\uc2b5\ub2c8\ub2e4. \uc9c0\ud45c \uc911 \ud65c\uc131 \uc778\uad6c\uc640 \ud480\uc0e4\ub4dc \uc778\uc6d0\uc740 \uc11c\ubc84 \uaddc\ubaa8\uc5d0 \ud568\uaed8 \uc601\ud5a5\uc744 \ubc1b\uc73c\ubbc0\ub85c, \uaddc\ubaa8\uc640 \ubb34\uad00\ud55c \uc0c1\uc704 20% \uc804\ud22c\ub825\u00b7\uc810\ub839\ub960\uc5d0 \uc808\ubc18\uc758 \uac00\uc911\uce58(50%)\ub97c \ub450\uc5b4 \uade0\ud615\uc744 \ub9de\ucdc4\uc2b5\ub2c8\ub2e4. \ud558\ub8e8 1\ud68c \uac31\uc2e0\ub429\ub2c8\ub2e4.", "server_comparison.overall_method_title": "\uc885\ud569 \uc810\uc218 \uacc4\uc0b0 \ubc29\uc2dd", "server_comparison.overall_modal_close": "\ub2eb\uae30", "server_comparison.overall_rank_suffix": "\uc704", "server_comparison.overall_row_hint": "\ud83d\udca1 \uc11c\ubc84 \ud589\uc744 \ub204\ub974\uba74 \uadf8 \uc11c\ubc84\uc758 \uc8fc\uac04 \uc21c\uc704 \ubcc0\ub3d9\uc744 \ud3bc\uccd0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "server_comparison.overall_score_unit": "\uc810", "server_comparison.overall_streak": "{n}\uc8fc \uc5f0\uc18d 1\uc704", "server_comparison.overall_title": "\uc544\ud234 \uc885\ud569 \uc11c\ubc84 \uc21c\uc704", "server_comparison.overall_trend_axis_rank": "\uc21c\uc704", "server_comparison.overall_trend_clear": "\uc804\uccb4 \ud574\uc81c", "server_comparison.overall_trend_desc": "\uc8fc\uac00 \uc313\uc77c\uc218\ub85d \uc11c\ubc84\ubcc4 \uc21c\uc704 \ud750\ub984\uc774 \ubcf4\uc785\ub2c8\ub2e4. \uc11c\ubc84\ub97c \uc120\ud0dd\ud574 \ube44\uad50\ud574 \ubcf4\uc138\uc694.", "server_comparison.overall_trend_empty_sel": "\uc544\ub798\uc5d0\uc11c \uc11c\ubc84\ub97c \uc120\ud0dd\ud558\uba74 \uc21c\uc704 \ucd94\uc774\uac00 \uadf8\ub824\uc9d1\ub2c8\ub2e4.", "server_comparison.overall_trend_flat_note": "\uccab \uc8fc\ucc28 \uc2a4\ub0c5\uc0f7\uc774\ub77c \ube44\uad50 \uae30\uc900\uc774 \uc5c6\uc5b4 \ud3c9\ud0c4\ud558\uac8c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc\ubd80\ud130 \uc2e4\uc81c \ubcc0\ub3d9\uc120\uc774 \uadf8\ub824\uc9d1\ub2c8\ub2e4.", "server_comparison.overall_trend_hint": "\uc11c\ubc84\ub97c \ub20c\ub7ec \uadf8\ub798\ud504\uc5d0 \ucd94\uac00/\uc81c\uac70 (\uc120 \uc0c9\uc774 \uad6c\ubd84\ub418\ub294 \ucd5c\ub300 {n}\uac1c\uae4c\uc9c0)", "server_comparison.overall_trend_one_week": "\uc544\uc9c1 \uc2a4\ub0c5\uc0f7\uc774 1\uc8fc\uce58\ubfd0\uc774\ub77c \ucd94\uc774\ub97c \uadf8\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc\ubd80\ud130 \uc120\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4.", "server_comparison.overall_trend_open": "\uc804\uccb4 \uc11c\ubc84 \ubcc0\ub3d9 \uadf8\ub798\ud504 \ubcf4\uae30", "server_comparison.overall_trend_range_all": "\uc804\uccb4", "server_comparison.overall_trend_range_weeks": "{n}\uc8fc", "server_comparison.overall_trend_title": "\uc8fc\uac04 \uc21c\uc704 \ucd94\uc774", "server_comparison.overall_trend_tooltip": "{server} \u00b7 {week} \u00b7 {rank}\uc704 ({score}\uc810)", "server_comparison.overall_trend_top5": "TOP 3 \ubcf4\uae30", "server_comparison.overall_weekly_notice": "\uc21c\uc704 \ubcc0\ub3d9\uc740 \u003cb\u003e\ub9e4\uc8fc \uc6d4\uc694\uc77c 05\uc2dc(KST)\u003c/b\u003e\uc5d0 \uc800\uc7a5\ub418\ub294 \uc8fc\uac04 \uc2a4\ub0c5\uc0f7 \uae30\uc900\uc785\ub2c8\ub2e4. \uae30\uc900 \uc8fc\ucc28: {w}", "server_comparison.overall_weekly_pending": "\ud83d\udcc5 \uc8fc\uac04 \uc2a4\ub0c5\uc0f7\uc744 \ubaa8\uc73c\ub294 \uc911\uc785\ub2c8\ub2e4. \uccab \uc2a4\ub0c5\uc0f7\uc774 \uc313\uc774\ub294 \ub2e4\uc74c \uc8fc \uc6d4\uc694\uc77c\ubd80\ud130 \uc21c\uc704 \ubcc0\ub3d9\uacfc \ucd94\uc774 \uadf8\ub798\ud504\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4.", "server_comparison.overview": "\ud55c\ub208\uc5d0 \uc804\uccb4 \uacb0\uacfc \ubcf4\uae30", "server_comparison.overview_badge_collecting": "\uc811\uc218 \uc911", "server_comparison.overview_badge_confirmed": "\u2705 \uc9d1\uacc4\uc644\ub8cc", "server_comparison.overview_badge_progress": "\u2694\ufe0f \uc9c4\ud589 \uc911", "server_comparison.overview_badge_wait": "\ub300\uae30", "server_comparison.overview_btn_battle": "\ud83d\udcca \ud55c\ub208\uc5d0 {n}\ucc28\uc804 \uacb0\uacfc \ubcf4\uae30", "server_comparison.overview_modal_title": "\ud83d\udcca \uc804\uccb4 \ub9e4\uce6d \uacb0\uacfc \ud55c\ub208\uc5d0 \ubcf4\uae30", "server_comparison.overview_title_battle": "\u2694\ufe0f \uc804\uc11c\ubc84 \uc544\ud2f0\uc7c1 {n}\ucc28\uc804 ({date}) \uacb0\uacfc", "server_comparison.overview_title_plain": "\u2694\ufe0f \uc804\uc11c\ubc84 \uc544\ud2f0\uc7c1 \uacb0\uacfc", "server_comparison.past_season_badge": "\uacfc\uac70 \uc2dc\uc98c", "server_comparison.past_season_notice": "\ud83d\udcdc \uacfc\uac70 \uc2dc\uc98c\uc758 \uae30\ub85d\uc744 \uc870\ud68c \uc911\uc785\ub2c8\ub2e4. \uc81c\ubcf4\u00b7\uce74\uc6b4\ud2b8\ub2e4\uc6b4\uc740 \ube44\ud65c\uc131 \uc0c1\ud0dc\uc774\uba70, \ub9c8\uc9c0\ub9c9 \ub77c\uc6b4\ub4dc \uacb0\uacfc\uc640 \ub204\uc801 \uc810\ub839 \ud604\ud669\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4.", "server_comparison.report_all_none_confirm": "6\uac1c \uc544\ud2f0\ud329\ud2b8 \ubaa8\ub450 \"\uc810\ub839 \uc5c6\uc74c\"\uc73c\ub85c \uc81c\ubcf4\ud560\uae4c\uc694?", "server_comparison.report_artifact": "\uc544\ud2f0\ud329\ud2b8 \uc810\ub839 \uc81c\ubcf4", "server_comparison.report_btn": "\uc81c\ubcf4\ud558\uae30", "server_comparison.report_failed": "\uc81c\ubcf4 \uc2e4\ud328", "server_comparison.report_none_hint": "\uc544\ubb34\ub3c4 \uc810\ub839\ud558\uc9c0 \ubabb\ud55c \uc544\ud2f0\ud329\ud2b8\ub294 \uc120\u