    </p>
    <div id="home-board-section" class="card-grid" style="grid-column: 1 / -1; margin-bottom: 1.5rem;">
      <article class="hero-card" style="grid-column: 1 / -1;">
        <div class="home-board-grid">
          <!-- 좌: 종합 순위 TOP 5 -->
          <div class="home-board-col">
            <div class="home-board-colhead">
