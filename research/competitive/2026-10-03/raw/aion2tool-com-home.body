            <!-- 성장기록 탭 패널 -->
            <div class="character-tab-card character-tab-panel" id="panel-growth-history" style="display: none;">
              <div id="growth-history-content" style="min-height: 400px; width: 100%; max-width: 100%; overflow: hidden;">
