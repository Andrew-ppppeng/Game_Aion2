  if (tooltipPassive) tooltipPassive.textContent = `+${passiveAccuracy}`;
  
  // 야성 펫작 명중 표시
  const wildPetMin = breakdown.wildPetAccuracyMin || 0;
  const wildPetMax = breakdown.wildPetAccuracyMax || 65;
  if (tooltipWildPet) {
    if (wildPetMin === wildPetMax) {
      tooltipWildPet.textContent = `+${wildPetMin}`;
    } else {
      tooltipWildPet.textContent = `+${wildPetMin}~${wildPetMax}`;
    }
  }
  
  if (tooltipFreedom) tooltipFreedom.textContent = `+${freedomPercent.toFixed(1)}%`;
  
  // 정확 표시 (캡 200 적용)
  if (tooltipPrecision) {
    tooltipPrecision.textContent = `+${precisionPercent.toFixed(1)}%`;
  }
  
  if (tooltipTotal) {
    if (finalAccuracyMin === finalAccuracyMax) {
      tooltipTotal.textContent = `+${finalAccuracyMin}`;
    } else {
      tooltipTotal.textContent = `+${finalAccuracyMin}~${finalAccuracyMax}`;
    }
  }
  
  // 컨테이너 표시
  const accuracyContainer = document.getElementById('accuracy-container');
