                <button class="daevanion-subtab-btn active" data-boardid="41" style="padding: 0.35rem 0.65rem; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(157, 140, 255, 0.12); border-color: rgba(157, 140, 255, 0.3); color: var(--accent); cursor: pointer; border-radius: 8px; font-size: 0.8rem; font-weight: 500; transition: all 0.2s;">
