  }
  
  // 재사용 대기 시간 감소
  const cooldownReductionBtn = document.querySelector('.cooldown-reduction-info-icon');
  if (cooldownReductionBtn) {
    cooldownReductionBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const cooldownValue = parseFloat(document.getElementById('cooldown-reduction-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      const breakdownData = [
        { label: '타이틀', value: document.getElementById('tooltip-title-cooldown')?.textContent || '+0%' },
        { label: '주신 스탯 (환상)', value: document.getElementById('tooltip-illusion-cooldown')?.textContent || '+0%' },
        { label: '데바니온 (네자칸)', value: document.getElementById('tooltip-daevanion-cooldown')?.textContent || '+0%' }
      ];
      
      // 날개 효과 항상 추가
      const wingCooldownValue = document.getElementById('tooltip-wing-cooldown')?.textContent || '+0%';
      breakdownData.push({ label: '날개 (장착 효과)', value: wingCooldownValue });
      
      // 쿨감으로 인한 딜증 계산
      // 쿨감 x%는 스킬 사용 빈도가 100/(100-x) 배 증가 → 딜증 = 100/(100-x) - 1
      // 실제로는 평균적으로 30% 정도만 소화 가능하다고 가정
      const COOLDOWN_EFFICIENCY = 0.3;
      const cooldownMultiplier = 100 / (100 - cooldownValue);
      const theoreticalDamageIncrease = (cooldownMultiplier - 1) * 100;
      const actualDamageIncrease = theoreticalDamageIncrease * COOLDOWN_EFFICIENCY;
      
      const description = {
        text: '<div style="background: rgba(255, 200, 100, 0.15); border: 1px solid rgba(255, 200, 100, 0.3); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; color: #fbbf24; line-height: 1.5;">동일 클래스 내 비교를 가정하며, 실제 효율은 다를 수 있습니다. 쿨감을 100% 소화하는 것은 물리적으로 불가하기에, <strong>평균적으로 30% 정도의 쿨감 성능을 소화한다는 가정</strong>하에 계산합니다.<br><br>실제 쿨감으로 인한 딜증가량은 클래스 주력기 쿨타임, 스킬 딜 비중 등 변수에 따라 달라질 수 있습니다.</div>재사용 대기 시간 감소(쿨타임 감소)는 스킬 사용 빈도를 높여 DPS를 증가시킵니다.<br><br><strong>계산식:</strong><br>쿨감 x%일 때, 스킬 사용 빈도가 <strong>100 / (100 - x)</strong>배 증가<br><br><div style="margin: 0.75rem 0; padding: 0.75rem; background: rgba(157, 140, 255, 0.1); border-left: 3px solid rgba(157, 140, 255, 0.5); font-family: monospace; font-size: 0.9rem; line-height: 1.6;">딜 상승률(%) = (100/(100 - x) - 1) × 0.3</div><br><strong>예시:</strong><br>쿨감 ' + cooldownValue.toFixed(1) + '%일 때:<br>이론상 딜증 = 100 / (100 - ' + cooldownValue.toFixed(1) + ') - 1 = <span style="color:#60a5fa;">' + theoreticalDamageIncrease.toFixed(2) + '%</span><br>전 클래스 평균 딜증 (×0.3배수 적용) = ' + theoreticalDamageIncrease.toFixed(2) + '% × 0.3 = <span style="color:#4ade80;">' + actualDamageIncrease.toFixed(2) + '%</span>',
        damageIncrease: actualDamageIncrease.toFixed(2) + '%'
      };
      
      openStatModal('cooldown-reduction', cooldownValue, breakdownData, description);
    });
  }
  
  // 치명타
  const criticalHitBtn = document.querySelector('.critical-hit-info-icon');
  if (criticalHitBtn) {
    criticalHitBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      
      const wingCriticalValue = document.getElementById('tooltip-wing-critical')?.textContent || '+0';
      
      // 정확 표시 (치명타용, 캡 200 적용)
      const criticalHitResult = window.criticalHitResult || {};
      const criticalBreakdown = criticalHitResult.breakdown || {};
      const accuracyCriticalHitPercent = criticalBreakdown.accuracyCriticalHitPercent || 0;
      const accuracyDisplay = `+${accuracyCriticalHitPercent.toFixed(1)}%`;
      
      // 지성 펫작 치명타 표시 값
      const intelligentPetCritMin = criticalBreakdown.intelligentPetCriticalMin || 0;
      const intelligentPetCritMax = criticalBreakdown.intelligentPetCriticalMax || 41;
      const intelligentPetDisplay = (intelligentPetCritMin === intelligentPetCritMax) ? `+${intelligentPetCritMin}` : `+${intelligentPetCritMin}~${intelligentPetCritMax}`;
      
      // 타이틀 보유효과 (고정 범위: 60~80)
      const titleCritMin = 60;
      const titleCritMax = 80;
      const titleCritDisplay = `+${titleCritMin}~${titleCritMax}`;
      
      const breakdownData = [
        { label: '장비 기본 옵션', value: document.getElementById('tooltip-base-critical')?.textContent || '+0' },
        { label: '영혼 각인', value: document.getElementById('tooltip-soul-critical')?.textContent || '+0' },
        { label: '마석 각인', value: document.getElementById('tooltip-stone-critical')?.textContent || '+0' },
        { label: '데바니온', value: document.getElementById('tooltip-daevanion-critical')?.textContent || '+0' },
        { label: '데바니온 (마르쿠탄) - 치명타', value: document.getElementById('tooltip-daevanion-markutan-critical')?.textContent || '+0' },
        { label: '날개 (장착 효과)', value: wingCriticalValue },
        { label: '타이틀 (장착 효과)', value: document.getElementById('tooltip-title-equip-critical')?.textContent || '+0' },
        { label: '지성 펫작 (치명타)', value: intelligentPetDisplay },
        { label: '타이틀 보유 효과', value: titleCritDisplay },
        { label: '주신 스탯 (죽음)', value: document.getElementById('tooltip-death-critical')?.textContent || '+0%', isPercent: true },
        { label: '일반 스탯 (정확)', value: accuracyDisplay, isPercent: true }
      ];
      
      // breakdown 합계 계산 (정수와 퍼센트 분리) - 전역 변수에서 직접 가져옴
      const baseCriticalHitInteger = criticalBreakdown.baseCriticalHitInteger || 0;
      const soulCriticalHitInteger = criticalBreakdown.soulCriticalHitInteger || 0;
      const stoneCriticalHitInteger = criticalBreakdown.stoneCriticalHitInteger || 0;
      const daevanionCriticalHitInteger = criticalBreakdown.daevanionCriticalHitInteger || 0;
      const wingCriticalHitInteger = criticalBreakdown.wingCriticalHitInteger || 0;
      const titleEquipCriticalHit = criticalBreakdown.titleEquipCriticalHit || 0;
      const deathCriticalHitPercent = criticalBreakdown.deathCriticalHitPercent || 0;
      // 정확은 캡 적용된 값 사용 (accuracyCriticalHitPercent)
      
      const breakdownInteger = baseCriticalHitInteger + soulCriticalHitInteger + stoneCriticalHitInteger + daevanionCriticalHitInteger + wingCriticalHitInteger + titleEquipCriticalHit;
      
      // breakdown 합계에서 최종 치명타 스탯 계산 (퍼센트 합연산, 지성 펫작 + 타이틀 보유효과 포함)
      const totalPercentMultiplier = 1 + ((deathCriticalHitPercent + accuracyCriticalHitPercent) / 100);
      const finalCriticalHitStatMin = Math.round((breakdownInteger + intelligentPetCritMin + titleCritMin) * totalPercentMultiplier);
      const finalCriticalHitStatMax = Math.round((breakdownInteger + intelligentPetCritMax + titleCritMax) * totalPercentMultiplier);
      
      // 치명타 스탯을 확률로 변환 (대만 커뮤니티 테이블 기반)
      const finalCriticalChanceMinRaw = convertCritStatToChance(finalCriticalHitStatMin);
      const finalCriticalChanceMaxRaw = convertCritStatToChance(finalCriticalHitStatMax);
      // 치명타 확률 80% 캡 적용
      const finalCriticalChanceMin = Math.min(finalCriticalChanceMinRaw, 80);
      const finalCriticalChanceMax = Math.min(finalCriticalChanceMaxRaw, 80);
      
      // 합계 표시용 문자열 (범위)
      const critStatDisplay = (finalCriticalHitStatMin === finalCriticalHitStatMax) ? finalCriticalHitStatMin : `${finalCriticalHitStatMin} ~ ${finalCriticalHitStatMax}`;
      
      // 80% 캡 초과 여부 표시
      const isOverCritCap = finalCriticalChanceMaxRaw > 80;
      let critChanceDisplay;
      if (isOverCritCap) {
        const rawDisplay = (finalCriticalChanceMinRaw === finalCriticalChanceMaxRaw) ? 
          finalCriticalChanceMinRaw.toFixed(1) + '%' : 
          finalCriticalChanceMinRaw.toFixed(1) + '% ~ ' + finalCriticalChanceMaxRaw.toFixed(1) + '%';
        const cappedDisplay = (finalCriticalChanceMin === finalCriticalChanceMax) ? 
          finalCriticalChanceMin.toFixed(1) + '%' : 
          finalCriticalChanceMin.toFixed(1) + '% ~ ' + finalCriticalChanceMax.toFixed(1) + '%';
        critChanceDisplay = '<span style="text-decoration: line-through; color: #ef4444;">' + rawDisplay + '</span> → <span style="color: #a78bfa;">' + cappedDisplay + '</span> (캡 80%)';
      } else {
        critChanceDisplay = (finalCriticalChanceMin === finalCriticalChanceMax) ? 
          finalCriticalChanceMin.toFixed(1) + '%' : 
          finalCriticalChanceMin.toFixed(1) + '% ~ ' + finalCriticalChanceMax.toFixed(1) + '%';
      }
      
      const description = {
        conclusion: '치명타 스탯',
        text: '<div><strong>치명타 스탯:</strong> ' + critStatDisplay + '<br><br><strong>치명타 확률 계산:</strong><br>계산식: (치명타 스탯 × 0.4) ÷ 10 = 확률% (최대 80%)<br>추정 치명타 확률: <strong style="color:#60a5fa;">' + critChanceDisplay + '</strong>' + (isOverCritCap ? '<br><div style="background: rgba(248, 113, 113, 0.2); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 6px; padding: 0.5rem; margin-top: 0.5rem; font-size: 0.75rem; color: #f87171; line-height: 1.4;"><strong>⚠️ 치명타 캡 초과:</strong> 계산된 치명타 확률이 80%를 초과하여 80%로 적용됩니다.</div>' : '') + '<br><br>※ 치명타로 인한 딜 상승률은 <strong>치명타 피해 증폭</strong>에서 확인하세요.</div>',
        damageIncrease: null
      };
      
      // finalCriticalHitStatMax를 전달하여 breakdown 합계와 일치시킴
      openStatModal('critical-hit', critStatDisplay, breakdownData, description);
    });
  }
  
  // 강타
  const stunHitBtn = document.querySelector('.stun-hit-info-icon');
  if (stunHitBtn) {
    stunHitBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const stunHitValue = parseFloat(document.getElementById('stun-hit-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      // 강타 저항 5%p 적용: 실제 딜증 = 강타 - 5% (5% 미만이면 0%)
      const actualDamageIncrease = stunHitValue >= 5 ? (stunHitValue - 5) : 0;
      
      const breakdownData = [
        { label: '타이틀', value: document.getElementById('tooltip-title-stun')?.textContent || '+0%' },
        { label: '주신 스탯 (지혜)', value: document.getElementById('tooltip-wisdom-stun')?.textContent || '+0%' },
        { label: '장비 (영혼 각인)', value: document.getElementById('tooltip-soul-stun')?.textContent || '+0%' },
        { label: '날개 (장착 효과)', value: document.getElementById('tooltip-wing-stun')?.textContent || '+0%' }
      ];
      
      const description = {
        conclusion: '강타 저항 5%p 적용',
        text: '<div style="background: rgba(255, 200, 100, 0.15); border: 1px solid rgba(255, 200, 100, 0.3); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; color: #fbbf24; line-height: 1.5;">쫄몹이나 허수아비는 저항이 낮지만, 보스마다 다르기 때문에 정확한 강타 확률 계산이 불가합니다. 아래는 평균 추정 수치이며, 강타 스탯 연구가 진행됨에 따라 수정될 수 있습니다.</div>강타/완벽/치명타는 독립적인 확률로 발동됩니다.<br><br>강타는 <strong>강타(DOUBLE)</strong>가 발동될 확률로, 발동시 <strong>2배 대미지</strong>를 가합니다.<br><br>완벽은 <strong>완벽(PERFECT)</strong>가 발동될 확률로, 발동시 <strong>무기 최대 대미지로 딜을 가합니다</strong>.<br><br><strong>강타로 인한 딜 증:</strong><br><br><div style="background: rgba(255, 200, 100, 0.15); border: 1px solid rgba(255, 200, 100, 0.3); border-radius: 6px; padding: 0.75rem; margin-top: 0.75rem; margin-bottom: 0.75rem; font-size: 0.8rem; color: #fbbf24; line-height: 1.5;"><strong>⚠️ 강타 저항 적용</strong><br>현 엔드컨텐츠 드라마타의 경우 강타 저항이 약 30% 정도로 확인되고 있습니다. 하지만 펫 이해도, 패시브 스킬, 각종 시너지 스킬로 인한 강타 스탯은 아툴 "강타" 수치에 포함되지 않기 때문에 30% 저항을 그대로 적용하기 어렵습니다.<br><br>이에 <strong>최소한의 강타 저항 5%p만 적용</strong>하여 딜증을 계산합니다.</div><div style="margin: 0.75rem 0; padding: 0.75rem; background: rgba(157, 140, 255, 0.1); border-left: 3px solid rgba(157, 140, 255, 0.5); font-family: monospace; font-size: 0.9rem; line-height: 1.6;">딜 상승률(%) = max(0, 강타 확률(%) - 5)</div><br>현재 강타 확률: <strong style="color:#60a5fa;">' + stunHitValue.toFixed(1) + '%</strong><br>실제 딜증: <strong style="color:#4ade80;">' + actualDamageIncrease.toFixed(1) + '%</strong>',
        damageIncrease: actualDamageIncrease.toFixed(1) + '%'
      };
      
      openStatModal('stun-hit', stunHitValue, breakdownData, description);
    });
  }
  
  // 완벽
  const perfectBtn = document.querySelector('.perfect-info-icon');
  if (perfectBtn) {
    perfectBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const perfectValue = parseFloat(document.getElementById('perfect-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      // 무기 최소/최대 공격력 가져오기
      const weaponMin = window.weaponMinAttack || 0;
      const weaponMax = window.weaponMaxAttack || 0;
      
      // 완벽 딜 증가량 계산: 완벽 확률 × (최대공 - 최소공) / (최대공 + 최소공)
      let damageIncreaseFromPerfect = 0;
      if (weaponMin > 0 && weaponMax > 0 && weaponMax > weaponMin) {
        damageIncreaseFromPerfect = perfectValue * ((weaponMax - weaponMin) / (weaponMax + weaponMin));
      }
      
      const breakdownData = [
        { label: '타이틀', value: document.getElementById('tooltip-title-perfect')?.textContent || '+0%' },
        { label: '주신 스탯 (정의)', value: document.getElementById('tooltip-justice-perfect')?.textContent || '+0%' },
        { label: '장신구 기본 옵션', value: document.getElementById('tooltip-accessory-perfect')?.textContent || '+0%' },
        { label: '장비 (영혼 각인)', value: document.getElementById('tooltip-soul-perfect')?.textContent || '+0%' },
        { label: '데바니온 (유스티엘)', value: document.getElementById('tooltip-daevanion-yustiel-perfect')?.textContent || '+0%' }
      ];
      
      const weaponInfo = (weaponMax > 0) ? `<br><br>현재 무기: 최소공 ${weaponMin}, 최대공 ${weaponMax}` : '<br><br>무기 정보를 찾을 수 없습니다.';
      
      const description = {
        conclusion: '무기 대미지의 \'편차(Min-Max 차이)\'가 클수록 딜증이 높음',
        text: '강타/완벽/치명타는 독립적인 확률로 발동됩니다.<br><br>강타는 <strong>강타(DOUBLE)</strong>가 발동될 확률로, 발동시 <strong>2배 대미지</strong>를 가합니다.<br><br>완벽은 <strong>완벽(PERFECT)</strong>가 발동될 확률로, 발동시 <strong>무기 최대 대미지로 딜을 가합니다</strong>.<br><br>(평균 대미지와 최대 대미지 사이의 간격만큼 이득을 보는 구조)<br><br>완벽으로 인한 딜 증:<br><br>$$기대 딜 상승률(%) = 완벽 확률(%) × (최대공 - 최소공) / (최대공 + 최소공)$$' + weaponInfo,
        damageIncrease: damageIncreaseFromPerfect.toFixed(2) + '%'
      };
      
      openStatModal('perfect', perfectValue, breakdownData, description);
    });
  }
  
  // 다단 히트 적중
  const multiHitBtn = document.querySelector('.multi-hit-info-icon');
  if (multiHitBtn) {
    multiHitBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const multiHitStatValue = parseFloat(document.getElementById('multi-hit-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      // 다단 히트 적중 딜증 계산: y = 11.1x + 13.9x^2 + 17.8x^3 + 23.9x^4
      // x는 다단 히트 적중 퍼센트를 소수로 변환한 값 (예: 11% = 0.11)
      // 기본 다단 히트 확률 18% (스탯에 표기되지 않음)
      const baseMultiHitPercent = 18;
      const totalMultiHitPercent = baseMultiHitPercent + multiHitStatValue;
      
      // 기본 18%일 때의 딜증 계산
      const xBase = baseMultiHitPercent / 100;
      const baseDamageIncrease = 11.1 * xBase + 13.9 * Math.pow(xBase, 2) + 17.8 * Math.pow(xBase, 3) + 23.9 * Math.pow(xBase, 4);
      
      // 18% + 스탯일 때의 딜증 계산
      const xTotal = totalMultiHitPercent / 100;
      const totalDamageIncrease = 11.1 * xTotal + 13.9 * Math.pow(xTotal, 2) + 17.8 * Math.pow(xTotal, 3) + 23.9 * Math.pow(xTotal, 4);
      
      // 스탯으로 인한 실제 딜 증가율 = (1 + 총딜증) / (1 + 기본딜증) - 1
      // 기존 딜 대비 얼마나 증가했는지 계산
      const baseMultiplier = 1 + baseDamageIncrease / 100;
      const totalMultiplier = 1 + totalDamageIncrease / 100;
      const actualDamageIncrease = ((totalMultiplier / baseMultiplier) - 1) * 100;
      
      const breakdownData = [
        { label: '장비/장신구 영혼 각인', value: document.getElementById('tooltip-soul-multi-hit')?.textContent || '+0.0%' },
        { label: '장비/장신구 기본 옵션', value: document.getElementById('tooltip-base-multi-hit')?.textContent || '+0.0%' },
        { label: '데바니온 (트리니엘)', value: document.getElementById('tooltip-daevanion-multi-hit')?.textContent || '+0.0%' }
      ];
      
      const description = {
        conclusion: '최대 4타 확률 연쇄 발동으로 인한 딜증',
        text: '다단 히트 적중 스탯에 따라 최대 4타까지 확률로 연쇄 발동됩니다.<br><br><div style="background: rgba(255, 100, 100, 0.15); border: 1px solid rgba(255, 100, 100, 0.3); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; color: #ff6b6b; line-height: 1.5;"><strong>※ 스탯에 표기되지 않는 기본 다단 히트 확률이 약 18% 있습니다.</strong><br><strong>※ 다단 히트는 신석을 발동시키지 않습니다.</strong><br><strong>※ 주력 스킬의 채용 특화에 따라 실제 효율은 표기 값보다 더 좋아질 수 있습니다. <br>예를 들어, 주력기 다단히트 50% 특화 채용할 경우 실제 효율은 더 높을 수 있음. </strong></div>기본 기대값은 1타이며, 다단 히트 적중 확률에 따라 2타, 3타, 4타까지 연쇄 발동 가능합니다.<br><br>인던 기준 타수별 5%, 10%, 15%, 20% 추가 피해를 가합니다.',
        damageIncrease: actualDamageIncrease.toFixed(2) + '%'
      };
      
      openStatModal('multi-hit', multiHitStatValue, breakdownData, description);
    });
  }
}

// 모든 스탯의 딜증 계산 및 표시
function updateAllDamageIncreaseBadges() {
  // ★ 핵심 1: 모든 배지를 먼저 숨김 (이전 캐릭터 데이터 잔류 방지)
  const allBadgeIds = [
    'combat-speed-damage-badge',
    'weapon-damage-amplification-damage-badge',
    'damage-amplification-damage-badge',
    'critical-damage-amplification-damage-badge',
    'skill-damage-damage-badge',
    'cooldown-reduction-damage-badge',
    'stun-hit-damage-badge',
    'perfect-damage-badge',
    'multi-hit-damage-badge'
  ];
  allBadgeIds.forEach(id => {
    const badge = document.getElementById(id);
    if (badge) {
      badge.style.display = 'none';
      badge.textContent = '';
    }
  });
  
  // 공격력 값 가져오기 (최종 전투 점수 계산용)
  // ★ 핵심 2: 전역 변수에서 직접 가져오기 (DOM 파싱 의존성 제거)
  const attackPowerFromGlobal = window.attackPowerResult?.finalAttack;
  let attackPower = (attackPowerFromGlobal !== undefined && attackPowerFromGlobal !== null && attackPowerFromGlobal > 0)
    ? attackPowerFromGlobal
    : (parseFloat(document.getElementById('attack-power-value')?.textContent?.replace(/,/g, '').replace(/[^0-9.-]/g, '') || '0') || 0);

  let damageIncreaseValues = {};
  
  // ★ 전역 변수에서 직접 가져오기 (DOM 파싱 대신) - 이전 캐릭터 데이터 혼입 방지
  
  // 1. 전투 속도 (스탯% = 딜증% 1:1)
  const combatSpeedValue = window.combatSpeedResult?.totalCombatSpeed || 0;
  if (combatSpeedValue > 0) {
    damageIncreaseValues.combatSpeed = combatSpeedValue;
    const badge = document.getElementById('combat-speed-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${combatSpeedValue.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 2. 무기 피해 증폭
  const weaponDamageAmpValue = window.damageAmplificationResult?.weaponDamageAmp?.totalPercent || 0;
  if (weaponDamageAmpValue > 0) {
    const damageIncrease = weaponDamageAmpValue * 0.66;
    damageIncreaseValues.weaponDamageAmp = damageIncrease;
    const badge = document.getElementById('weapon-damage-amplification-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${damageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 3. 피해 증폭 (PVE + 일반 합산)
  const pveDamageAmp = window.damageAmplificationResult?.pveDamageAmp?.totalPercent || 0;
  const generalDamageAmp = window.damageAmplificationResult?.damageAmp?.totalPercent || 0;
  // 전방/후방은 따로 집계하지만 딜증 기여도는 종전과 동일하게 합산해 둔다
  const totalDamageAmpValue = pveDamageAmp + generalDamageAmp + (window.damageAmplificationResult?.frontRearDamageAmp?.totalPercent || 0);
  if (totalDamageAmpValue > 0) {
    damageIncreaseValues.damageAmp = totalDamageAmpValue;
    const badge = document.getElementById('damage-amplification-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${totalDamageAmpValue.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 4. 치명타 피해 증폭
  const criticalDamageAmpValue = window.damageAmplificationResult?.criticalDamageAmp?.totalPercent || 0;
  
  // 치명타 확률 계산 (모달과 동일: max 값 기준, 펫/타이틀 포함)
  let criticalChance = 0;
  if (window.criticalHitResult && window.criticalHitResult.breakdown) {
    const breakdown = window.criticalHitResult.breakdown;
    const baseCrit = breakdown.baseCriticalHitInteger || 0;
    const soulCrit = breakdown.soulCriticalHitInteger || 0;
    const stoneCrit = breakdown.stoneCriticalHitInteger || 0;
    const daevanionCrit = breakdown.daevanionCriticalHitInteger || 0;
    const wingCrit = breakdown.wingCriticalHitInteger || 0;
    const titleEquipCrit = breakdown.titleEquipCriticalHit || 0;
    const petCritMax = breakdown.intelligentPetCriticalMax || 41;  // Critical 포함된 이름
    const titleCritMax = 80;  // 타이틀은 고정값
    const deathPercent = breakdown.deathCriticalHitPercent || 0;
    const accPercent = breakdown.accuracyCriticalHitPercent || 0;
    const totalCrit = baseCrit + soulCrit + stoneCrit + daevanionCrit + wingCrit + titleEquipCrit + petCritMax + titleCritMax;
    const percentMultiplier = 1 + ((deathPercent + accPercent) / 100);
    const finalCritStatMax = Math.round(totalCrit * percentMultiplier);
    criticalChance = convertCritStatToChance(finalCritStatMax);
  } else {
    criticalChance = parseFloat(document.getElementById('critical-hit-value')?.dataset?.criticalChanceMax || '0');
  }
  
  // 치명타 확률 80% 캡 적용
  criticalChance = Math.min(criticalChance, 80);
  
  // 검은 파편의 날개 특수 효과: 치명타 공격력 (95 * 치명타 확률%)
  const wingEffects = getWingEffects();
  if (wingEffects && wingEffects.criticalAttackPower && criticalChance > 0) {
    const criticalAttackPowerBonus = wingEffects.criticalAttackPower * (criticalChance / 100);
    attackPower += criticalAttackPowerBonus;
  }
  
  if (criticalChance > 0) {
    // 치명타 + 치피증으로 인한 딜증 계산: 증폭 후 기대 딜 - 1 (치명타 80% 캡 적용됨)
    const BASE_CRITICAL_DAMAGE = 1.5;
    const amplifiedCriticalDamage = BASE_CRITICAL_DAMAGE + (criticalDamageAmpValue / 100);
    const p = criticalChance / 100;
    const amplifiedExpectedDamage = (1 - p) * 1 + p * amplifiedCriticalDamage;
    const damageIncrease = (amplifiedExpectedDamage - 1) * 100;
    damageIncreaseValues.criticalDamageAmp = damageIncrease;
    const badge = document.getElementById('critical-damage-amplification-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${damageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 5. 스킬 딜증 - window.skillDamageResult에서 이미 계산된 값 사용
  if (window.skillDamageResult && window.skillDamageResult.totalSkillDamage > 0) {
    const totalDamage = window.skillDamageResult.totalSkillDamage;
    damageIncreaseValues.skillDamage = totalDamage;
    const badge = document.getElementById('skill-damage-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${totalDamage.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 6. 재사용 대기 시간 감소
  const cooldownValue = window.cooldownReductionResult?.totalCooldownReduction || 0;
  if (cooldownValue > 0) {
    const COOLDOWN_EFFICIENCY = 0.3;
    const cooldownMultiplier = 100 / (100 - cooldownValue);
    const theoreticalDamageIncrease = (cooldownMultiplier - 1) * 100;
    const actualDamageIncrease = theoreticalDamageIncrease * COOLDOWN_EFFICIENCY;
    damageIncreaseValues.cooldownReduction = actualDamageIncrease;
    const badge = document.getElementById('cooldown-reduction-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${actualDamageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 7. 강타 (강타 저항 5%p 적용: 강타 - 5%, 5% 미만이면 0%)
  const stunHitValue = window.stunHitResult?.totalStunHitPercent || 0;
  const stunHitDamageIncrease = stunHitValue >= 5 ? (stunHitValue - 5) : 0;
  if (stunHitValue > 0) {
    damageIncreaseValues.stunHit = stunHitDamageIncrease;
    const badge = document.getElementById('stun-hit-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${stunHitDamageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 8. 완벽
  const perfectValue = window.perfectResult?.totalPerfectPercent || 0;
  const weaponMin = window.weaponMinAttack || 0;
  const weaponMax = window.weaponMaxAttack || 0;
  if (perfectValue > 0 && weaponMin > 0 && weaponMax > 0 && weaponMax > weaponMin) {
    const damageIncrease = perfectValue * ((weaponMax - weaponMin) / (weaponMax + weaponMin));
    damageIncreaseValues.perfect = damageIncrease;
    const badge = document.getElementById('perfect-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${damageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 9. 다단 히트 적중
  const multiHitStatValue = window.multiHitResult?.totalMultiHitPercent || 0;
  if (multiHitStatValue > 0) {
    const baseMultiHitPercent = 18;
    const totalMultiHitPercent = baseMultiHitPercent + multiHitStatValue;
    
    const xBase = baseMultiHitPercent / 100;
    const baseDamageIncrease = 11.1 * xBase + 13.9 * Math.pow(xBase, 2) + 17.8 * Math.pow(xBase, 3) + 23.9 * Math.pow(xBase, 4);
    
    const xTotal = totalMultiHitPercent / 100;
    const totalDamageIncrease = 11.1 * xTotal + 13.9 * Math.pow(xTotal, 2) + 17.8 * Math.pow(xTotal, 3) + 23.9 * Math.pow(xTotal, 4);
    
    const baseMultiplier = 1 + baseDamageIncrease / 100;
    const totalMultiplier = 1 + totalDamageIncrease / 100;
    const actualDamageIncrease = ((totalMultiplier / baseMultiplier) - 1) * 100;
    
    damageIncreaseValues.multiHit = actualDamageIncrease;
    const badge = document.getElementById('multi-hit-damage-badge');
    if (badge) {
      badge.innerHTML = `전투 점수<br>+${actualDamageIncrease.toFixed(1)}%`;
      badge.style.display = 'block';
    }
  }
  
  // 명중: 전투 점수에 미포함 (정보 표시만)
  
  // 최종 전투 점수 계산 (공격력 × 모든 딜증의 곱)
  // 공격력 제외, 치명타 제외
  // 딜증은 곱연산으로 계산 (1 + 딜증1/100) × (1 + 딜증2/100) × ...
  let totalMultiplier = 1.0;
  for (const key in damageIncreaseValues) {
    const damageIncrease = damageIncreaseValues[key];
    totalMultiplier *= (1 + damageIncrease / 100);
  }
  
  const finalCombatScore = attackPower * totalMultiplier;
  
  // 계산된 전투 점수를 화면에 표시
  const dpsScoreValue = document.getElementById('dps-score-value');
  if (dpsScoreValue && attackPower > 0) {
    dpsScoreValue.textContent = Math.round(finalCombatScore).toLocaleString(undefined, {maximumFractionDigits: 0});
  }
  
  // 계산된 값을 window에 저장 (시뮬레이션에서 사용)
  window.damageIncreaseValues = damageIncreaseValues;
  
  // 계산된 값 반환 (DOM 파싱 의존성 제거용)
  return { finalCombatScore, attackPower, totalMultiplier };
}

