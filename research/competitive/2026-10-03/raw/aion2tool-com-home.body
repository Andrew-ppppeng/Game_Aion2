  <!-- 중앙 메인: 검색 카드 -->
  <section class="main-content">
    <!-- 스펙업 순서 탭 전용 검색 카드 (비교하기 스타일 · 스펙업 모드에서만 표시) -->
    <div id="specup-search-card">
      <p class="badge" style="margin: 0 0 0.75rem; padding-top: 0;">🔍 캐릭터 검색</p>
      <div class="specup-search-box">
        <div class="specup-search-row specup-search-r1">
          <select id="specup-race-select" class="specup-search-select">
            <option value="">종족 선택</option>
            <option value="1">천족</option>
            <option value="2">마족</option>
          </select>
          <select id="specup-server-select" class="specup-search-select" data-ph="서버 선택" disabled>
            <option value="">서버 선택</option>
          </select>
        </div>
        <div class="specup-search-row specup-search-r2">
          <input type="text" id="specup-nickname-input" class="specup-search-nick" placeholder="캐릭터 닉네임 입력" autocomplete="off" />
          <button id="specup-search-btn" class="specup-search-btn">검색</button>
        </div>
      </div>
    </div>

    
    <!-- 캐릭터 검색 제목과 폼 (dashboard 밖) -->
    <div id="character-search-wrapper" style="display: none;">
      <p class="badge" style="margin-bottom: 0.75rem; margin-top: 0; padding-top: 0;">🔍 캐릭터 검색</p>
      <div class="character-search-form" style="margin-bottom: 1.5rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 0.75rem clamp(0.5rem, 2vw, 1rem); position: relative;">
        <div class="search-container">
          <div class="search-row-first">
            <div id="race-buttons" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button id="race-all" class="race-button active" data-race="">전체</button>
              <button id="race-elyos" class="race-button" data-race="1">천족</button>
              <button id="race-asmodian" class="race-button" data-race="2">마족</button>
            </div>
            <select id="server-select" class="search-select">
              <option value="all">전체 서버 검색</option>
            </select>
          </div>
          <div class="search-row-second" style="position: relative;">
            <input type="text" id="character-keyword" class="search-input" placeholder="캐릭터 닉네임 입력" autocomplete="off" />
            <button id="search-button" class="search-button">검색</button>
            <!-- 검색 드롭다운 패널 (최근 검색 + 즐겨찾기) -->
            <div id="search-dropdown-panel" style="display: none; position: absolute; left: 0; right: 0; top: 100%; z-index: 100; background: #161b22; border: 1px solid rgba(88,166,255,0.25); border-top: none; border-radius: 0 0 12px 12px; box-shadow: 0 12px 32px rgba(0,0,0,0.7), 0 0 0 1px rgba(88,166,255,0.08); max-height: 420px; overflow: hidden;">
          <!-- 서브탭 -->
          <div style="display: flex; background: #0d1117; position: relative; border-bottom: 1px solid rgba(255,255,255,0.08);">
            <div id="search-tab-indicator" style="position: absolute; bottom: -1px; left: 0; width: 50%; height: 3px; background: linear-gradient(90deg, #58a6ff, #79c0ff); border-radius: 3px 3px 0 0; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);"></div>
            <button id="search-tab-recent" class="search-dropdown-tab active" style="flex: 1; padding: 0.7rem 0.5rem; background: rgba(88,166,255,0.08); border: none; color: #58a6ff; font-size: 0.83rem; font-weight: 700; cursor: pointer; transition: all 0.2s; letter-spacing: 0.02em; text-shadow: 0 0 12px rgba(88,166,255,0.5);">🕐 최근 검색</button>
            <button id="search-tab-favorites" class="search-dropdown-tab" style="flex: 1; padding: 0.7rem 0.5rem; background: none; border: none; color: rgba(255,255,255,0.28); font-size: 0.83rem; font-weight: 600; cursor: pointer; transition: all 0.2s; letter-spacing: 0.02em;">⭐ 즐겨찾기</button>
          </div>
          <!-- 최근 검색 목록 -->
          <div id="search-recent-list" style="overflow-y: auto; max-height: 365px; padding: 0.3rem 0;"></div>
          <!-- 즐겨찾기 목록 -->
          <div id="search-favorites-list" style="display: none; overflow-y: auto; max-height: 365px; padding: 0.3rem 0;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- NOTICE 배너 (캐릭터 검색 아래) -->
    <div id="notice-banner" style="display: none; margin-bottom: 1rem; background: #fafafa; border-radius: 10px; padding: 0.5rem 0.75rem; position: relative; border: 1px solid #e5e7eb; cursor: pointer; transition: all 0.2s ease;">
      <!-- 접힌 상태: 한 줄 캐러셀 -->
      <div id="notice-collapsed" class="notice-inner" style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
        <span class="notice-badge" style="background: #ef4444; color: #fff; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; letter-spacing: 0.5px; flex-shrink: 0;">NOTICE</span>
        <div id="notice-content" class="notice-text-wrap" style="flex: 1; overflow: hidden; min-width: 0; position: relative;">
          <!-- 동적으로 생성 -->
        </div>
        <div class="notice-nav" style="display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0;">
          <button id="notice-prev" style="background: none; border: none; color: #9ca3af; cursor: pointer; font-size: 0.9rem; padding: 0.1rem 0.3rem; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#374151'" onmouseout="this.style.color='#9ca3af'">‹</button>
          <span id="notice-page" style="font-size: 0.7rem; color: #9ca3af; min-width: 2rem; text-align: center;">1/3</span>
          <button id="notice-next" style="background: none; border: none; color: #9ca3af; cursor: pointer; font-size: 0.9rem; padding: 0.1rem 0.3rem; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#374151'" onmouseout="this.style.color='#9ca3af'">›</button>
        </div>
      </div>
      <!-- 펼친 상태: 모든 공지 표시 -->
      <div id="notice-expanded" style="display: none; width: 100%;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
          <span class="notice-badge" style="background: #ef4444; color: #fff; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; letter-spacing: 0.5px; flex-shrink: 0;">NOTICE</span>
        </div>
        <div id="notice-all-list" style="display: flex; flex-direction: column; gap: 0.25rem; padding-left: 0.15rem;">
          <!-- 동적으로 생성 -->
        </div>
      </div>
    </div>
    
