// 시뮬레이션 원래 세팅으로 리셋
function resetSimulationToOriginal() {
  // 무기 시뮬레이션 데이터 리셋
  if (window.simulationData?.weapons?.mainWeapon) {
    const main = window.simulationData.weapons.mainWeapon;
    main.soulEngravings = JSON.parse(JSON.stringify(main.originalSoulEngravings || []));
    main.runestones = JSON.parse(JSON.stringify(main.originalRunestones || []));
    main.transcendence = main.originalTranscendence || 0;
    main.useCustomWeapon = false;
    main.customWeaponName = null;
    main.customWeaponStats = null;
    main.rudraEnhanceBonus = 0;  // 루드라 강화 보너스 리셋
  }
  if (window.simulationData?.weapons?.subWeapon) {
    const sub = window.simulationData.weapons.subWeapon;
    sub.soulEngravings = JSON.parse(JSON.stringify(sub.originalSoulEngravings || []));
    sub.runestones = JSON.parse(JSON.stringify(sub.originalRunestones || []));
    sub.transcendence = sub.originalTranscendence || 0;
    sub.useCustomWeapon = false;
    sub.customWeaponName = null;
    sub.customWeaponStats = null;
    sub.rudraEnhanceBonus = 0;  // 루드라 강화 보너스 리셋
  }
  
  // 장비 시뮬레이션 데이터 리셋
  if (window.simulationData?.equipment) {
    Object.values(window.simulationData.equipment).forEach(item => {
      if (item) {
        item.soulEngravings = JSON.parse(JSON.stringify(item.originalSoulEngravings || []));
        item.runestones = JSON.parse(JSON.stringify(item.originalRunestones || []));
        item.transcendence = item.originalTranscendence || 0;
      }
    });
  }
  
  // 장신구 시뮬레이션 데이터 리셋
  if (window.simulationData?.accessories) {
    Object.values(window.simulationData.accessories).forEach(item => {
      if (item) {
        item.soulEngravings = JSON.parse(JSON.stringify(item.originalSoulEngravings || []));
        item.runestones = JSON.parse(JSON.stringify(item.originalRunestones || []));
        item.transcendence = item.originalTranscendence || 0;
        item.endBraceletEnhanceBonus = null;  // 루드라/심연 팔찌 강화 보너스 리셋
        item.useCustomBracelet = false;
        item.customBraceletType = null;
        item.customBraceletStats = null;
        item.useCustomNecklace = false;
        item.customNecklaceType = null;
        item.customNecklaceStats = null;
        item.useCustomEarring = false;
        item.customEarringType = null;
        item.customEarringStats = null;
        item.useCustomRing = false;
        item.customRingType = null;
        item.customRingStats = null;
      }
    });
  }
  
  // 주신 스탯 리셋
  if (window.simulationData?.divineStats && window.simulationData?.originalDivineStats) {
    window.simulationData.divineStats = JSON.parse(JSON.stringify(window.simulationData.originalDivineStats));
  }
  
  // 일반 스탯 리셋
  if (window.simulationData?.normalStats && window.simulationData?.originalNormalStats) {
    window.simulationData.normalStats = JSON.parse(JSON.stringify(window.simulationData.originalNormalStats));
  }
  
  // 아리엘 보드 리셋
  if (window.simulationData?.arielBoard && window.simulationData?.originalArielBoard) {
    window.simulationData.arielBoard = JSON.parse(JSON.stringify(window.simulationData.originalArielBoard));
  }
  
  // 마르쿠탄 보드 리셋
  if (window.simulationData?.markutanBoard && window.simulationData?.originalMarkutanBoard) {
    window.simulationData.markutanBoard = JSON.parse(JSON.stringify(window.simulationData.originalMarkutanBoard));
  }
  
  // UI 새로고침
  refreshSimWeaponCards();
  refreshSimEquipmentCards();
  initializeSimulationDivineStats();
  initializeSimulationNormalStats();
  initializeSimulationArielBoard();
  initializeSimulationMarkutanBoard();
  
  // 점수 초기화
  const originalScoreEl = document.getElementById('sim-original-combat-score');
  const newScoreEl = document.getElementById('sim-new-combat-score');
  const diffEl = document.getElementById('sim-score-diff');
  const calcLogEl = document.getElementById('sim-calc-log');
  const summaryEl = document.getElementById('sim-changes-summary');
  
  const currentCP = window.currentNcCombatPower || window.currentCombatPower2 || 0;
  const currentCPStr = currentCP > 0 ? currentCP.toLocaleString() : '-';
  if (originalScoreEl) originalScoreEl.textContent = currentCPStr;
  if (newScoreEl) {
    newScoreEl.textContent = currentCPStr;
    newScoreEl.style.color = '#4ade80';
    newScoreEl.style.textShadow = '0 0 20px rgba(74, 222, 128, 0.3)';
  }
  if (diffEl) diffEl.innerHTML = '';
  if (calcLogEl) {
    calcLogEl.innerHTML = '';
    calcLogEl.style.display = 'none';
  }
  if (summaryEl) {
    summaryEl.innerHTML = '';
    summaryEl.style.display = 'none';
  }

  // 플로팅 바 점수 동기화
  if (typeof window.updateSimFloatingBar === 'function') {
    window.updateSimFloatingBar();
  }
}

// 시뮬레이션 플로팅 바 생성 및 관리
function initSimScoreStickyBar() {
  const simulationPanel = document.getElementById('panel-simulation');
  const scoreContainer = document.getElementById('sim-score-container');
  
  if (!simulationPanel || !scoreContainer) return;
  
  // 기존 플로팅 바 제거
  const existingFloating = document.getElementById('sim-floating-score-bar');
  if (existingFloating) existingFloating.remove();
  
  // 플로팅 바 생성
  const floatingBar = document.createElement('div');
  floatingBar.id = 'sim-floating-score-bar';
  floatingBar.style.cssText = `
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    display: none;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, rgba(15, 15, 30, 0.98) 0%, rgba(25, 25, 45, 0.98) 100%);
    border-bottom: 1px solid rgba(157, 140, 255, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  `;
  
  const isMobile = window.innerWidth <= 770;
  const fontSize = isMobile ? '1rem' : '1.25rem';
  const gap = isMobile ? '0.75rem' : '1.5rem';
  
  floatingBar.innerHTML = `
    <div style="display: flex; align-items: center; justify-content: center; gap: ${gap}; flex-wrap: wrap; max-width: 1200px; margin: 0 auto;">
      <div style="text-align: center;">
        <div style="font-size: 0.65rem; color: var(--text-muted); margin-bottom: 0.2rem;">현재</div>
        <div id="sim-floating-original-score" style="font-size: ${fontSize}; font-weight: 700; color: var(--accent);">-</div>
      </div>
      <div style="font-size: 1rem; color: rgba(157, 140, 255, 0.5);">→</div>
      <div style="text-align: center;">
        <div style="font-size: 0.65rem; color: var(--text-muted); margin-bottom: 0.2rem;">시뮬</div>
        <div id="sim-floating-new-score" style="font-size: ${fontSize}; font-weight: 700; color: #4ade80;">-</div>
      </div>
      <div id="sim-floating-diff" style="font-size: 0.8rem; font-weight: 600; color: #4ade80;"></div>
      <div style="display: flex; gap: 0.5rem;">
        <button onclick="recalculateSimulationCombatScore()" style="padding: 0.4rem 0.8rem; background: rgba(124, 108, 224, 0.2); color: #9d8cff; border: 1px solid rgba(157, 140, 255, 0.4); border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">⚡ 계산</button>
        <button onclick="resetSimulationToOriginal()" style="padding: 0.4rem 0.8rem; background: rgba(248, 113, 113, 0.1); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">↩️ 리셋</button>
      </div>
    </div>
  `;
  
  document.body.appendChild(floatingBar);
  
  // 이전 리스너 제거
  if (window._simScrollHandler) {
    window.removeEventListener('scroll', window._simScrollHandler);
  }
  
  let rafPending = false;
  let lastVisible = null;
  let lastOrig = null;
  let lastNew = null;
  let lastDiff = null;
  
  const updateFloatingBar = () => {
    // 시뮬레이션 탭이 보이지 않으면 숨김
    if (simulationPanel.style.display === 'none') {
      if (lastVisible !== false) {
        floatingBar.style.display = 'none';
        lastVisible = false;
      }
      return;
    }
    
    const scoreRect = scoreContainer.getBoundingClientRect();
    const shouldShow = scoreRect.bottom < 0;
    
    if (shouldShow !== lastVisible) {
      floatingBar.style.display = shouldShow ? 'block' : 'none';
      lastVisible = shouldShow;
    }
    
    if (!shouldShow) return;
    
    // 점수 동기화 (변경 시에만 DOM 업데이트)
    const origScore = document.getElementById('sim-original-combat-score')?.textContent || '-';
    const newScore = document.getElementById('sim-new-combat-score')?.textContent || '-';
    const diffHtml = document.getElementById('sim-score-diff')?.innerHTML || '';
    
    if (origScore !== lastOrig) {
      document.getElementById('sim-floating-original-score').textContent = origScore;
      lastOrig = origScore;
    }
    if (newScore !== lastNew) {
      document.getElementById('sim-floating-new-score').textContent = newScore;
      lastNew = newScore;
    }
    if (diffHtml !== lastDiff) {
      document.getElementById('sim-floating-diff').innerHTML = diffHtml;
      lastDiff = diffHtml;
    }
  };
  
  window._simScrollHandler = function() {
    if (rafPending) return;
    rafPending = true;
    window.requestAnimationFrame(() => {
      rafPending = false;
      updateFloatingBar();
    });
  };
  
  // 외부에서 수동 동기화할 수 있게 노출
  window.updateSimFloatingBar = updateFloatingBar;
  
  window.addEventListener('scroll', window._simScrollHandler, { passive: true });
}

// 시뮬레이션 변경 사항 요약 생성
function generateSimulationChangesSummary() {
  const topChanges = [];
  const changes = [];
  const normalizeName = (name) => String(name || '').replace(/^\+\d+\s*/, '').trim();
  const formatNameWithEnhance = (name, enhanceLevel) => {
    const cleanName = normalizeName(name);
    if (!cleanName) return '';
    const level = parseInt(enhanceLevel, 10) || 0;
    return level > 0 ? `+${level} ${cleanName}` : cleanName;
  };
  const _empty = TA('sim.change_empty', '(비어있음)');
  const _btApplied = TA('sim.change_bt_applied', '(돌파 적용)');
  
  // 무기 변경 사항
  if (window.simulationData?.weapons?.mainWeapon) {
    const main = window.simulationData.weapons.mainWeapon;
    const originalWeaponName = formatNameWithEnhance(main.originalItem?.name, main.originalItem?.enhance_level);
    const customWeaponName = formatNameWithEnhance(
      translateCustomWeaponName(main.customWeaponName || TA('sim.default_custom_weapon', '기룡/응룡왕 무기')),
      getCustomWeaponEnhanceLevel(main.customWeaponName || '', main.customWeaponStats)
    );
    const currentWeaponName = main.useCustomWeapon ? customWeaponName : originalWeaponName;
    
    if (main.useCustomWeapon && originalWeaponName && currentWeaponName && currentWeaponName !== originalWeaponName) {
      topChanges.push(`<span style="color: #60a5fa;">${TA('sim.change_weapon', '무기 변경')}:</span> ${originalWeaponName} → <span style="color: #4ade80;">${currentWeaponName}</span>`);
    }
    
    // 초월 변경
    if (main.transcendence !== main.originalTranscendence) {
      changes.push(`<span style="color: #60a5fa;">${TA('sim.change_weapon_bt', '무기 돌파')}:</span> ${main.originalTranscendence} → <span style="color: #4ade80;">${main.transcendence}</span>`);
    }
    
    // 루드라 무기 강화 보너스 변경 (돌파로 인한 강화 +20) - 커스텀 무기가 아닌 경우만
    if (!main.useCustomWeapon) {
      const mainRudraBonus = main.rudraEnhanceBonus || 0;
      const mainOriginalEnhance = main.originalItem?.enhance_level || 0;
      if (mainRudraBonus > 0 && mainOriginalEnhance < 20) {
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_weapon_enhance', '무기 강화')}:</span> +${mainOriginalEnhance} → <span style="color: #4ade80;">+20</span> <span style="color: #facc15;">${_btApplied}</span>`);
      }
    }
    
    // 영혼각인 변경
    main.soulEngravings?.forEach((eng, idx) => {
      const orig = main.originalSoulEngravings?.[idx];
      if (orig && (eng.name !== orig.name || eng.value !== orig.value)) {
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_weapon_soul', '무기 영혼각인')} ${idx+1}:</span> ${localizeEquipStatName(orig.name)} ${orig.value} → <span style="color: #4ade80;">${localizeEquipStatName(eng.name)} ${eng.value}</span>`);
      }
    });
    
    // 마석각인 변경
    main.runestones?.forEach((rune, idx) => {
      const orig = main.originalRunestones?.[idx];
      if (orig && (rune.name !== orig.name || rune.value !== orig.value)) {
        const origVal = String(orig.value || '').replace(/^\+/, '');
        const newVal = String(rune.value || '').replace(/^\+/, '');
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_weapon_stone', '무기 마석각인')} ${idx+1}:</span> ${localizeEquipStatName(orig.name)} +${origVal} → <span style="color: #4ade80;">${localizeEquipStatName(rune.name)} +${newVal}</span>`);
      }
    });
  }
  
  // 가더 변경 사항
  if (window.simulationData?.weapons?.subWeapon) {
    const sub = window.simulationData.weapons.subWeapon;
    const originalSubName = formatNameWithEnhance(sub.originalItem?.name, sub.originalItem?.enhance_level);
    const customSubName = formatNameWithEnhance(
      translateCustomWeaponName(sub.customWeaponName || TA('sim.default_custom_guarder', '기룡/응룡왕의 가더')),
      getCustomWeaponEnhanceLevel(sub.customWeaponName || '', sub.customWeaponStats)
    );
    const currentSubName = sub.useCustomWeapon ? customSubName : originalSubName;
    
    if (sub.useCustomWeapon && originalSubName && currentSubName && currentSubName !== originalSubName) {
      topChanges.push(`<span style="color: #60a5fa;">${TA('sim.change_guarder', '가더 변경')}:</span> ${originalSubName} → <span style="color: #4ade80;">${currentSubName}</span>`);
    }
    
    if (sub.transcendence !== sub.originalTranscendence) {
      changes.push(`<span style="color: #60a5fa;">${TA('sim.change_guarder_bt', '가더 초월')}:</span> ${sub.originalTranscendence} → <span style="color: #4ade80;">${sub.transcendence}</span>`);
    }
    
    // 루드라 가더 강화 보너스 변경 (돌파로 인한 강화 +20) - 커스텀 무기가 아닌 경우만
    if (!sub.useCustomWeapon) {
      const subRudraBonus = sub.rudraEnhanceBonus || 0;
      const subOriginalEnhance = sub.originalItem?.enhance_level || 0;
      if (subRudraBonus > 0 && subOriginalEnhance < 20) {
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_guarder_enhance', '가더 강화')}:</span> +${subOriginalEnhance} → <span style="color: #4ade80;">+20</span> <span style="color: #facc15;">${_btApplied}</span>`);
      }
    }
    
    sub.soulEngravings?.forEach((eng, idx) => {
      const orig = sub.originalSoulEngravings?.[idx];
      if (orig && (eng.name !== orig.name || eng.value !== orig.value)) {
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_guarder_soul', '가더 영혼각인')} ${idx+1}:</span> ${localizeEquipStatName(orig.name)} ${orig.value} → <span style="color: #4ade80;">${localizeEquipStatName(eng.name)} ${eng.value}</span>`);
      }
    });
    sub.runestones?.forEach((rune, idx) => {
      const orig = sub.originalRunestones?.[idx];
      if (orig && (rune.name !== orig.name || rune.value !== orig.value)) {
        const origVal = String(orig.value || '').replace(/^\+/, '');
        const newVal = String(rune.value || '').replace(/^\+/, '');
        changes.push(`<span style="color: #60a5fa;">${TA('sim.change_guarder_stone', '가더 마석각인')} ${idx+1}:</span> ${localizeEquipStatName(orig.name)} +${origVal} → <span style="color: #4ade80;">${localizeEquipStatName(rune.name)} +${newVal}</span>`);
      }
    });
  }
  
  // 장비 변경 사항
  if (window.simulationData?.equipment) {
    Object.entries(window.simulationData.equipment).forEach(([key, item]) => {
      if (!item) return;
      const itemName = (item.useCustomBracelet && item.customBraceletStats?.name)
        ? item.customBraceletStats.name
        : (item.originalItem?.name?.replace(/\+\d+\s*/, '') || key);
      
      if (item.transcendence !== item.originalTranscendence) {
        changes.push(`<span style="color: #fbbf24;">${itemName} ${TA('sim.change_armor_bt', '돌파')}:</span> ${item.originalTranscendence} → <span style="color: #4ade80;">${item.transcendence}</span>`);
      }
      item.soulEngravings?.forEach((eng, idx) => {
        const orig = item.originalSoulEngravings?.[idx];
        if (orig && (eng.name !== orig.name || eng.value !== orig.value)) {
          changes.push(`<span style="color: #fbbf24;">${itemName} ${TA('sim.change_armor_soul', '영혼각인')}:</span> ${localizeEquipStatName(orig.name)} ${orig.value} → <span style="color: #4ade80;">${localizeEquipStatName(eng.name)} ${eng.value}</span>`);
        }
      });
      item.runestones?.forEach((rune, idx) => {
        const orig = item.originalRunestones?.[idx];
        if (orig && (rune.name !== orig.name || rune.value !== orig.value)) {
          const origVal = String(orig.value || '').replace(/^\+/, '');
          const newVal = String(rune.value || '').replace(/^\+/, '');
          changes.push(`<span style="color: #fbbf24;">${itemName} ${TA('sim.change_armor_stone', '마석각인')}:</span> ${localizeEquipStatName(orig.name)} +${origVal} → <span style="color: #4ade80;">${localizeEquipStatName(rune.name)} +${newVal}</span>`);
        }
      });
    });
  }
  
  // 장신구 변경 사항
  if (window.simulationData?.accessories) {
    Object.entries(window.simulationData.accessories).forEach(([key, item]) => {
      if (!item) return;
      const baseItemName = item.originalItem?.name?.replace(/\+\d+\s*/, '') || key;
      const originalAccessoryName = formatNameWithEnhance(baseItemName, item.originalItem?.enhance_level);
      const customName = item.useCustomBracelet && item.customBraceletStats?.name
        ? item.customBraceletStats.name
        : (item.useCustomNecklace && item.customNecklaceStats?.name
          ? item.customNecklaceStats.name
          : (item.useCustomEarring && item.customEarringStats?.name
            ? item.customEarringStats.name
            : (item.useCustomRing && item.customRingStats?.name ? item.customRingStats.name : null)));
      const customEnhance = item.useCustomBracelet ? item.customBraceletStats?.enhanceLevel
        : (item.useCustomNecklace ? item.customNecklaceStats?.enhanceLevel
          : (item.useCustomEarring ? item.customEarringStats?.enhanceLevel
            : (item.useCustomRing ? item.customRingStats?.enhanceLevel : 0)));
      const customAccessoryName = customName ? formatNameWithEnhance(customName, customEnhance) : null;
      const itemName = customName || baseItemName;
      
      // 커스텀 장신구 장착 변경 (우선 표시)
      if (customName && customName !== baseItemName) {
        topChanges.push(`<span style="color: #f472b6;">${TA('sim.change_acc_change', '장신구 변경')}:</span> ${originalAccessoryName || baseItemName} → <span style="color: #4ade80;">${customAccessoryName || customName}</span>`);
        
        const sumMainStats = (statsList) => {
          const totals = { attack: 0, defense: 0, damageAmp: 0 };
          (statsList || []).forEach(stat => {
            const name = stat?.name || stat?.id || '';
            const baseVal = parseFloat(String(stat?.value || '0').replace(/[^0-9.-]/g, '')) || 0;
            const extraVal = parseFloat(String(stat?.extra || '0').replace(/[^0-9.-]/g, '')) || 0;
            if (name.includes('공격력') || name.includes('攻擊力')) totals.attack += (baseVal + extraVal);
            if (name.includes('방어력') || name.includes('防禦力')) totals.defense += (baseVal + extraVal);
            if ((name.includes('피해 증폭') || name.includes('傷害增幅')) && !name.includes('PVP')) totals.damageAmp += (baseVal + extraVal);
          });
          return totals;
        };
        
        const customStats = item.useCustomBracelet ? item.customBraceletStats
          : (item.useCustomNecklace ? item.customNecklaceStats
            : (item.useCustomEarring ? item.customEarringStats : item.customRingStats));
        const originalTotals = sumMainStats(item.originalItem?.main_stats || []);
        const simTotals = sumMainStats(customStats?.main_stats || []);
        const attackDiff = simTotals.attack - originalTotals.attack;
        const defenseDiff = simTotals.defense - originalTotals.defense;
        const damageAmpDiff = simTotals.damageAmp - originalTotals.damageAmp;
        if (attackDiff !== 0 || defenseDiff !== 0 || damageAmpDiff !== 0) {
          const attackText = `${TA('sim.change_atk', '공격력')} ${originalTotals.attack} → ${simTotals.attack}`;
          const defenseText = `${TA('sim.change_def', '방어력')} ${originalTotals.defense} → ${simTotals.defense}`;
          const damageAmpText = `${TA('sim.change_pve_amp', 'PVE 피해 증폭')} ${originalTotals.damageAmp} → ${simTotals.damageAmp}%`;
          topChanges.push(`<span style="color: #f472b6;">${TA('sim.change_basic_option', '기본 옵션 변경')}:</span> ${attackText}, ${defenseText}, ${damageAmpText}`);
        }
      }
      
      if (item.transcendence !== item.originalTranscendence) {
        changes.push(`<span style="color: #f472b6;">${itemName} ${TA('sim.change_armor_bt', '돌파')}:</span> ${item.originalTranscendence} → <span style="color: #4ade80;">${item.transcendence}</span>`);
      }
      
      // 루드라/심연 팔찌 강화 보너스 변경 - 커스텀 장신구가 아닌 경우만
      if (!item.useCustomBracelet && !item.useCustomNecklace && !item.useCustomEarring && !item.useCustomRing) {
        const endBonus = item.endBraceletEnhanceBonus;
        const originalEnhance = item.originalItem?.enhance_level || 0;
        const targetEnhance = endBonus?.targetEnhance || 20;
        if (endBonus && originalEnhance < targetEnhance) {
          changes.push(`<span style="color: #f472b6;">${itemName} ${TA('sim.change_armor_enhance', '강화')}:</span> +${originalEnhance} → <span style="color: #4ade80;">+${targetEnhance}</span> <span style="color: #facc15;">${_btApplied}</span>`);
        }
      }
      
      item.soulEngravings?.forEach((eng, idx) => {
        const orig = item.originalSoulEngravings?.[idx] || { name: '', value: '' };
        const hasEng = eng && ((eng.name && String(eng.name).trim() !== '') || (eng.value && String(eng.value).trim() !== ''));
        if (hasEng && (eng.name !== orig.name || eng.value !== orig.value)) {
          const origText = `${localizeEquipStatName(orig.name || _empty)} ${orig.value || ''}`.trim();
          const newText = `${localizeEquipStatName(eng.name || _empty)} ${eng.value || ''}`.trim();
          changes.push(`<span style="color: #f472b6;">${itemName} ${TA('sim.change_armor_soul', '영혼각인')}:</span> ${origText} → <span style="color: #4ade80;">${newText}</span>`);
        }
      });
      item.runestones?.forEach((rune, idx) => {
        const orig = item.originalRunestones?.[idx] || { name: '', value: '' };
        const hasRune = rune && ((rune.name && String(rune.name).trim() !== '') || (rune.value && String(rune.value).trim() !== ''));
        if (hasRune && (rune.name !== orig.name || rune.value !== orig.value)) {
          const origVal = String(orig.value || '').replace(/^\+/, '');
          const newVal = String(rune.value || '').replace(/^\+/, '');
          const origName = localizeEquipStatName(orig.name || _empty);
          const newName = localizeEquipStatName(rune.name || _empty);
          changes.push(`<span style="color: #f472b6;">${itemName} ${TA('sim.change_armor_stone', '마석각인')}:</span> ${origName} +${origVal || '0'} → <span style="color: #4ade80;">${newName} +${newVal || '0'}</span>`);
        }
      });
    });
  }
  
  // 아리엘 보드 변경
  const arielEffect = calculateSimulationArielBoardEffect();
  if (arielEffect.hasChanges) {
    if (arielEffect.attackDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_ariel_atk', '아리엘 보드 공격력')}:</span> ${arielEffect.attackDiff > 0 ? '+' : ''}${arielEffect.attackDiff}`);
    }
    if (arielEffect.damageAmpDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_ariel_amp', '아리엘 보드 피해 증폭')}:</span> ${arielEffect.damageAmpDiff > 0 ? '+' : ''}${arielEffect.damageAmpDiff.toFixed(1)}%`);
    }
    if (arielEffect.pveAccuracyDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_ariel_pve_acc', '아리엘 보드 PVE 명중')}:</span> ${arielEffect.pveAccuracyDiff > 0 ? '+' : ''}${arielEffect.pveAccuracyDiff}`);
    }
    for (const [k, v] of Object.entries(arielEffect.genericStatsDiff || {})) {
      const sign = v > 0 ? '+' : '';
      const isP = k.endsWith('%');
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_ariel_board', '아리엘 보드')} ${getStatKeyDisplayName(k.replace('%',''))}:</span> ${sign}${isP ? v.toFixed(1) + '%' : Math.round(v)}`);
    }
  }
  
  // 마르쿠탄 보드 변경
  const markutanEffect = calculateSimulationMarkutanBoardEffect();
  if (markutanEffect.hasChanges) {
    if (markutanEffect.attackDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_markutan_atk', '마르쿠탄 보드 추가 공격력')}:</span> ${markutanEffect.attackDiff > 0 ? '+' : ''}${markutanEffect.attackDiff}`);
    }
    if (markutanEffect.weaponAmpDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_markutan_weapon_amp', '마르쿠탄 보드 무기 피해 증폭')}:</span> ${markutanEffect.weaponAmpDiff > 0 ? '+' : ''}${markutanEffect.weaponAmpDiff.toFixed(1)}%`);
    }
    if (markutanEffect.criticalDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_markutan_critical', '마르쿠탄 보드 치명타')}:</span> ${markutanEffect.criticalDiff > 0 ? '+' : ''}${markutanEffect.criticalDiff}`);
    }
    if (markutanEffect.accuracyDiff !== 0) {
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_markutan_acc', '마르쿠탄 보드 추가 명중')}:</span> ${markutanEffect.accuracyDiff > 0 ? '+' : ''}${markutanEffect.accuracyDiff}`);
    }
    for (const [k, v] of Object.entries(markutanEffect.genericStatsDiff || {})) {
      const sign = v > 0 ? '+' : '';
      const isP = k.endsWith('%');
      changes.push(`<span style="color: #fb923c;">${TA('sim.change_markutan_board', '마르쿠탄 보드')} ${getStatKeyDisplayName(k.replace('%',''))}:</span> ${sign}${isP ? v.toFixed(1) + '%' : Math.round(v)}`);
    }
  }
  
  return [...topChanges, ...changes];
}

// ========== 모바일에서 시뮬레이션 레이아웃 강제 적용 ==========
function applySimulationMobileLayout() {
  const isMobile = window.innerWidth <= 770;
  
  if (!isMobile) return;
  
  // 장비/장신구 2컬럼 → 1컬럼 강제 변경
  const twoColumn = document.getElementById('sim-equipment-two-column');
  if (twoColumn) {
    twoColumn.style.cssText = `
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: none !important;
      gap: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      overflow: visible !important;
      position: relative !important;
    `;
  }
  
  // 장비 컬럼 - 박스 컨테이너 스타일
  const equipColumn = document.getElementById('sim-equipment-column');
  if (equipColumn) {
    equipColumn.style.cssText = `
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      position: relative !important;
      overflow: visible !important;
      margin-bottom: 0 !important;
      background: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    `;
    // 라벨 스타일 적용
    const label = equipColumn.querySelector('div:first-child');
    if (label && label.textContent.includes('장비')) {
      label.style.cssText = `
        display: none !important;
      `;
    }
  }
  
  // 장신구 컬럼 - 박스 컨테이너 스타일
  const accColumn = document.getElementById('sim-accessories-column');
  if (accColumn) {
    accColumn.style.cssText = `
      display: none !important;
      width: 100% !important;
      max-width: 100% !important;
      position: relative !important;
      overflow: visible !important;
      margin-bottom: 0 !important;
      background: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    `;
  }
  
  // 장비 컨테이너 - 내부 스크롤 가능
  const equipContainer = document.getElementById('sim-equipment-container');
  if (equipContainer) {
    equipContainer.style.cssText = `
      display: flex !important;
      flex-direction: column !important;
      gap: 0.75rem !important;
      width: 100% !important;
      max-width: 100% !important;
      max-height: none !important;
      min-height: 0 !important;
      height: auto !important;
      overflow: visible !important;
      padding-right: 0 !important;
    `;
  }
  
  // 장신구 컨테이너 - 내부 스크롤 가능
  const accContainer = document.getElementById('sim-accessories-container');
  if (accContainer) {
    accContainer.style.cssText = `
      display: none !important;
      height: 0 !important;
      overflow: hidden !important;
    `;
  }
  
  // 시뮬레이션 패널
  const simPanel = document.getElementById('panel-simulation');
  if (simPanel) {
    simPanel.style.overflow = 'visible';
    simPanel.style.overflowX = 'hidden';
    simPanel.style.overflowY = 'visible';
  }
  
  // 시뮬레이션 콘텐츠
  const simContent = document.getElementById('simulation-content');
  if (simContent) {
    simContent.style.overflow = 'visible';
    simContent.style.overflowX = 'hidden';
    simContent.style.overflowY = 'visible';
  }
  
  // 장비 아이템들 스타일 적용
  setTimeout(() => {
    document.querySelectorAll('.sim-equipment-item').forEach(item => {
      item.style.cssText = `
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow: visible !important;
        position: relative !important;
        margin-bottom: 0.5rem !important;
        box-sizing: border-box !important;
      `;
    });
  }, 100);
}

// 화면 크기 변경 시 레이아웃 재적용
window.addEventListener('resize', function() {
  const simPanel = document.getElementById('panel-simulation');
  if (simPanel && simPanel.style.display !== 'none') {
    applySimulationMobileLayout();
  }
});

// 시뮬레이션 탭 초기화 함수
function initializeSimulationTab() {
  // ========== 모바일 레이아웃 강제 적용 ==========
  applySimulationMobileLayout();
  
  // 스크롤 고정 바 초기화
  setTimeout(() => initSimScoreStickyBar(), 100);
  
  // 현재 전투력 표시 (nc_combat_power = 현재 전투력)
  const originalScoreEl = document.getElementById('sim-original-combat-score');
  const currentCP = window.currentNcCombatPower || window.currentCombatPower2 || 0;
  const currentCPStr = currentCP > 0 ? currentCP.toLocaleString() : '-';
  if (originalScoreEl) {
    originalScoreEl.textContent = currentCPStr;
  }
  
  // 시뮬레이션 전투력 초기화
  const newScoreEl = document.getElementById('sim-new-combat-score');
  if (newScoreEl) {
    newScoreEl.textContent = currentCPStr;
    newScoreEl.style.color = '#4ade80';
  }
  
  // 차이 표시 초기화
  const diffEl = document.getElementById('sim-score-diff');
  if (diffEl) {
    diffEl.textContent = '';
  }
  
  // 계산 로그 초기화
  const calcLogEl = document.getElementById('sim-calc-log');
  if (calcLogEl) {
    calcLogEl.innerHTML = '';
    calcLogEl.style.display = 'none';
  }
  
  // 무기 시뮬레이션 초기화
  initializeSimulationWeapons();
  
  // 장비/장신구 시뮬레이션 초기화
  initializeSimulationEquipment();
  
  // 주신 스탯 데이터 복사 및 표시
  initializeSimulationDivineStats();
  
  // 일반 스탯 데이터 복사 및 표시
  initializeSimulationNormalStats();
  
  // ================================================
  // 스킬 시뮬레이션 (일시적으로 비활성화)
  // 나중에 활성화하려면 아래 주석을 해제하세요
  // ================================================
  // initializeSimulationSkills();
  
  // 데바니온 아리엘 보드 초기화
  initializeSimulationArielBoard();
  // 데바니온 마르쿠탄 보드 초기화
  initializeSimulationMarkutanBoard();
}

// 시뮬레이션 주신 스탯 초기화
function initializeSimulationDivineStats() {
  const container = document.getElementById('sim-stats-container');
  if (!container) return;
  container.innerHTML = '';
  
  const statData = window.currentStatData;
  if (!statData || !statData.statList) return;
  
  const divineStatTypes = ['Justice', 'Freedom', 'Illusion', 'Life', 'Time', 'Destruction', 'Death', 'Wisdom', 'Destiny', 'Space'];
  const divineStats = statData.statList.filter(stat => divineStatTypes.includes(stat.type));
  
  // 타입 순서대로 정렬
  const sortedStats = divineStats.sort((a, b) => {
    const indexA = divineStatTypes.indexOf(a.type);
    const indexB = divineStatTypes.indexOf(b.type);
    return indexA - indexB;
  });
  
  // 시뮬레이션 데이터에 복사 (원래 값도 함께 저장)
  window.simulationData.divineStats = {};
  window.simulationData.originalDivineStats = {};
  sortedStats.forEach(stat => {
    const value = parseInt(stat.value || 0);
    window.simulationData.divineStats[stat.type] = value;
    window.simulationData.originalDivineStats[stat.type] = value;  // 원래 값 저장
  });
  
  // 총합 계산 및 헤더 업데이트
  updateSimDivineStatsTotal();
  
  // 스탯 카드 생성
  sortedStats.forEach(stat => {
    const card = createSimulationDivineStatCard(stat);
    container.appendChild(card);
  });
}

// 시뮬레이션 일반 스탯 초기화
function initializeSimulationNormalStats() {
  const container = document.getElementById('sim-normal-stats-container');
  if (!container) return;
  container.innerHTML = '';
  
  const statData = window.currentStatData;
  if (!statData || !statData.statList) return;
  
  const normalStatTypes = ['STR', 'DEX', 'INT', 'CON', 'AGI', 'WIS'];
  const normalStats = statData.statList.filter(stat => normalStatTypes.includes(stat.type));
  
  // 타입 순서대로 정렬
  const sortedStats = normalStats.sort((a, b) => {
    const indexA = normalStatTypes.indexOf(a.type);
    const indexB = normalStatTypes.indexOf(b.type);
    return indexA - indexB;
  });
  
  // 시뮬레이션 데이터에 복사 (원래 값도 함께 저장)
  window.simulationData.normalStats = {};
  window.simulationData.originalNormalStats = {};
  sortedStats.forEach(stat => {
    const value = parseInt(stat.value || 0);
    window.simulationData.normalStats[stat.type] = value;
    window.simulationData.originalNormalStats[stat.type] = value;  // 원래 값 저장
  });
  
  // 스탯 카드 생성
  sortedStats.forEach(stat => {
    const card = createSimulationNormalStatCard(stat);
    container.appendChild(card);
  });
}

// 시뮬레이션 스킬 초기화
function initializeSimulationSkills() {
  // 스킬 데이터 가져오기
  const skills = window.currentSkills || [];
  const stigmas = window.currentStigmas || [];
  const skillResult = window.skillDamageResult;
  
  if (!skillResult) return;
  
  // 시뮬레이션 스킬 데이터 초기화
  window.simulationData.skills = {
    active: {},
    passive: {},
    stigma: {}
  };
  window.simulationData.originalSkills = {
    active: {},
    passive: {},
    stigma: {}
  };
  
  // 원래 스킬 점수 저장
  window.simulationData.originalSkillScore = skillResult.totalSkillDamage || 0;
  
  // 원래 점수 표시
  const originalScoreEl = document.getElementById('sim-skill-original-score');
  if (originalScoreEl) {
    originalScoreEl.textContent = window.simulationData.originalSkillScore.toFixed(1) + '%';
  }
  
  // 액티브 스킬 초기화
  const activeContainer = document.getElementById('sim-active-skills-container');
  if (activeContainer && skillResult.details?.active) {
    activeContainer.innerHTML = '';
    const activeScore = skillResult.breakdown?.activeSkillDamage || 0;
    document.getElementById('sim-active-score').textContent = activeScore.toFixed(1) + '%';
    
    skillResult.details.active.forEach(skill => {
      window.simulationData.skills.active[skill.skillName] = skill.characterLevel;
      window.simulationData.originalSkills.active[skill.skillName] = skill.characterLevel;
      const card = createSimulationSkillCard(skill, 'active');
      activeContainer.appendChild(card);
    });
  }
  
  // 패시브 스킬 초기화
  const passiveContainer = document.getElementById('sim-passive-skills-container');
  if (passiveContainer && skillResult.details?.passive) {
    passiveContainer.innerHTML = '';
    const passiveScore = skillResult.breakdown?.passiveSkillDamage || 0;
    document.getElementById('sim-passive-score').textContent = passiveScore.toFixed(1) + '%';
    
    skillResult.details.passive.forEach(skill => {
      window.simulationData.skills.passive[skill.skillName] = skill.characterLevel;
      window.simulationData.originalSkills.passive[skill.skillName] = skill.characterLevel;
      const card = createSimulationSkillCard(skill, 'passive');
      passiveContainer.appendChild(card);
    });
  }
  
  // 스티그마 스킬 초기화
  const stigmaContainer = document.getElementById('sim-stigma-skills-container');
  if (stigmaContainer && skillResult.details?.stigma) {
    stigmaContainer.innerHTML = '';
    const stigmaScore = skillResult.breakdown?.stigmaSkillDamage || 0;
    document.getElementById('sim-stigma-score').textContent = stigmaScore.toFixed(1) + '%';
    
    skillResult.details.stigma.forEach(skill => {
      window.simulationData.skills.stigma[skill.skillName] = skill.characterLevel;
      window.simulationData.originalSkills.stigma[skill.skillName] = skill.characterLevel;
      const card = createSimulationSkillCard(skill, 'stigma');
      stigmaContainer.appendChild(card);
    });
  }
  
  // 총합 표시
  updateSimSkillTotalScore();
}

// 시뮬레이션 스킬 카드 생성
function createSimulationSkillCard(skill, skillType) {
  const card = document.createElement('div');
  card.className = 'sim-skill-card';
  card.style.cssText = 'background: rgba(255, 255, 255, 0.03); border-radius: 8px; padding: 0.5rem; border: 1px solid rgba(255, 255, 255, 0.1); text-align: center; min-width: 75px;';
  
  // 스킬 아이콘
  if (skill.icon) {
    const iconDiv = document.createElement('div');
    iconDiv.style.cssText = 'width: 40px; height: 40px; margin: 0 auto 0.25rem; position: relative;';
    const img = document.createElement('img');
    img.src = skill.icon;
    img.alt = skill.skillName;
    img.style.cssText = 'width: 100%; height: 100%; object-fit: cover; border-radius: 6px;';
    img.onerror = () => { img.style.display = 'none'; };
    iconDiv.appendChild(img);
    card.appendChild(iconDiv);
  }
  
  // 스킬 이름
  const nameDiv = document.createElement('div');
  nameDiv.style.cssText = 'font-size: 0.65rem; color: var(--text-muted); margin-bottom: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;';
  nameDiv.textContent = skill.skillName;
  nameDiv.title = skill.skillName;
  card.appendChild(nameDiv);
  
  // 원래 레벨 표시
  const originalLevelDiv = document.createElement('div');
  originalLevelDiv.style.cssText = 'font-size: 0.6rem; color: #94a3b8; margin-bottom: 0.25rem;';
  originalLevelDiv.textContent = `기존: Lv.${skill.characterLevel}`;
  card.appendChild(originalLevelDiv);
  
  // 레벨 조절 컨트롤
  const controlDiv = document.createElement('div');
  controlDiv.style.cssText = 'display: flex; align-items: center; justify-content: center; gap: 0.25rem;';
  
  // 마이너스 버튼
  const minusBtn = document.createElement('button');
  minusBtn.textContent = '−';
  minusBtn.style.cssText = 'width: 20px; height: 20px; border: none; background: rgba(248, 113, 113, 0.2); color: #f87171; border-radius: 4px; cursor: pointer; font-size: 0.9rem; font-weight: bold; display: flex; align-items: center; justify-content: center;';
  minusBtn.onclick = () => changeSimSkillLevel(skill.skillName, skillType, -1);
  controlDiv.appendChild(minusBtn);
  
  // 레벨 입력
  const levelInput = document.createElement('input');
  levelInput.type = 'number';
  levelInput.id = `sim-skill-${skillType}-${skill.skillName.replace(/[^a-zA-Z0-9가-힣]/g, '_')}`;
  levelInput.value = skill.characterLevel;
  levelInput.min = 0;
  levelInput.max = 20;
  levelInput.style.cssText = 'width: 35px; font-size: 0.8rem; color: #a78bfa; font-weight: 700; text-align: center; background: rgba(167, 139, 250, 0.1); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 4px; padding: 0.15rem; outline: none;';
  levelInput.onchange = (e) => setSimSkillLevel(skill.skillName, skillType, parseInt(e.target.value) || 0);
  controlDiv.appendChild(levelInput);
  
  // 플러스 버튼
  const plusBtn = document.createElement('button');
  plusBtn.textContent = '+';
  plusBtn.style.cssText = 'width: 20px; height: 20px; border: none; background: rgba(74, 222, 128, 0.2); color: #4ade80; border-radius: 4px; cursor: pointer; font-size: 0.9rem; font-weight: bold; display: flex; align-items: center; justify-content: center;';
  plusBtn.onclick = () => changeSimSkillLevel(skill.skillName, skillType, 1);
  controlDiv.appendChild(plusBtn);
  
  card.appendChild(controlDiv);
  
  return card;
}

// 스킬 레벨 변경 (버튼)
function changeSimSkillLevel(skillName, skillType, delta) {
  const currentLevel = window.simulationData.skills[skillType][skillName] || 0;
  const newLevel = Math.max(0, Math.min(20, currentLevel + delta));
  setSimSkillLevel(skillName, skillType, newLevel);
}

// 스킬 레벨 직접 설정
function setSimSkillLevel(skillName, skillType, newLevel) {
  newLevel = Math.max(0, Math.min(20, newLevel));
  window.simulationData.skills[skillType][skillName] = newLevel;
  
  // 입력 필드 업데이트
  const inputId = `sim-skill-${skillType}-${skillName.replace(/[^a-zA-Z0-9가-힣]/g, '_')}`;
  const input = document.getElementById(inputId);
  if (input) {
    input.value = newLevel;
    const originalLevel = window.simulationData.originalSkills[skillType][skillName] || 0;
    input.style.color = newLevel !== originalLevel ? '#fbbf24' : '#a78bfa';
  }
  
  // 스킬 점수 총합 업데이트
  updateSimSkillTotalScore();
}

// 시뮬레이션 스킬 총합 업데이트
function updateSimSkillTotalScore() {
  // 시뮬레이션 스킬 점수 재계산
  const simScore = calculateSimulationSkillScore();
  
  // 총합 표시
  const totalEl = document.getElementById('sim-skill-total-score');
  if (totalEl) {
    const originalScore = window.simulationData.originalSkillScore || 0;
    totalEl.textContent = simScore.total.toFixed(1) + '%';
    totalEl.style.color = Math.abs(simScore.total - originalScore) > 0.01 ? '#fbbf24' : '#a78bfa';
  }
  
  // 개별 점수 표시
  document.getElementById('sim-active-score').textContent = simScore.active.toFixed(1) + '%';
  document.getElementById('sim-passive-score').textContent = simScore.passive.toFixed(1) + '%';
  document.getElementById('sim-stigma-score').textContent = simScore.stigma.toFixed(1) + '%';
}

// 시뮬레이션 스킬 점수 계산 (기존 로직 복제)
function calculateSimulationSkillScore() {
  const skillPriorities = window.currentSkillPriorities;
  if (!skillPriorities) {
    return { active: 0, passive: 0, stigma: 0, total: 0 };
  }
  
  const MAX_ACTIVE_SKILLS = 12;
  const MAX_PASSIVE_SKILLS = 10;
  
  // 액티브 스킬 점수 계산
  let activeScore = calculateSimSkillTypeScore(
    window.simulationData.skills.active,
    skillPriorities.active || [],
    MAX_ACTIVE_SKILLS,
    'active'
  );
  
  // 패시브 스킬 점수 계산
  let passiveScore = calculateSimSkillTypeScore(
    window.simulationData.skills.passive,
    skillPriorities.passive || [],
    MAX_PASSIVE_SKILLS,
    'passive'
  );
  
  // 스티그마 스킬 점수 계산
  let stigmaScore = calculateSimStigmaScore(
    window.simulationData.skills.stigma,
    skillPriorities.stigma || [],
    skillPriorities
  );
  
  return {
    active: activeScore,
    passive: passiveScore,
    stigma: stigmaScore,
    total: activeScore + passiveScore + stigmaScore
  };
}

// 클래스별 액티브 스킬 DPS 지분 weight 데이터 (시뮬레이션용 - 메인과 동일)
const SIM_ACTIVE_SKILL_DPS_WEIGHTS = {
  '검성': { '내려찍기': 50, '절단의 맹타': 30, '파멸의 맹타': 10 },
  '살성': { '심장 찌르기': 25, '문양 폭발': 15, '기습': 15, '빠른 베기': 15, '맹수의 포효': 15 },
  '궁성': { '속사': 35, '저격': 25, '조준 화살': 10, '광풍 화살': 6, '송곳 화살': 6 },
  '정령성': { '화염 전소': 44, '냉기 충격': 26, '원소 융합': 20 },
  '수호성': { '연속 난타': 20, '맹렬한 일격': 30, '심판': 40 },
  '마도성': { '혹한의 바람': 18, '불꽃 폭발': 20, '불꽃 화살': 20, '집중의 기원': 15, '얼음 사슬': 10 },
  '호법성': { '암격쇄': 35, '격파쇄': 25, '백열격': 10, '회전격': 8, '쾌유의 주문' : 10 },
  '치유성': { '쾌유의 광휘': 30, '심판의 번개': 30, '치유의 빛': 10, '재생의 빛': 10, '단죄': 10 }
};

// 클래스별 패시브 스킬 DPS 지분 weight 데이터 (시뮬레이션용 - 메인과 동일)
const SIM_PASSIVE_SKILL_DPS_WEIGHTS = {
  '검성': { '공격 준비': 20, '충격 적중': 20, '약점 파악': 15, '노련한 반격': 15 },
  '수호성': { '격앙': 25, '충격 적중': 20, '철벽 방어': 15 },
  '살성': { '강습 자세': 25, '배후 강타': 25, '빈틈 노리기': 20, '충격 적중': 20 },
  '궁성': { '집중의 눈': 25, '사냥꾼의 결의': 25, '사냥꾼의 혼': 20 },
  '마도성': { '불꽃의 로브': 30, '불의 표식': 25, '생기 증발': 15, '냉기 소환': 15 },
  '정령성': { '정령 타격': 30, '정신 집중': 25, '침식': 15 },
  '치유성': { '대지의 은총': 25, '치유력 강화': 20, '주신의 은총': 15 },
  '호법성': { '공격 준비': 25, '충격 적중': 20, '고취의 주문': 15 }
};

function getSimSkillDpsMultiplier(skillName, classJob, maxSlots, weightTable) {
  if (!classJob || !weightTable[classJob]) {
    return 1.0;
  }
  const dpsWeights = weightTable[classJob];
  const totalKeyWeight = Object.values(dpsWeights).reduce((s, v) => s + v, 0);
  const keySkillCount = Object.keys(dpsWeights).length;
  const nonKeyCount = maxSlots - keySkillCount;
  const remainingWeight = 100 - totalKeyWeight;
  const nonKeyWeight = nonKeyCount > 0 ? remainingWeight / nonKeyCount : 0;
  const skillWeight = (dpsWeights[skillName] !== undefined) ? dpsWeights[skillName] : nonKeyWeight;
  return (skillWeight / 100) * maxSlots;
}

// 액티브/패시브 스킬 점수 계산
function calculateSimSkillTypeScore(skillLevels, priorityList, maxSlots, skillType) {
  const filteredPriorityList = priorityList.filter(p => (p.adoption_rate || 0) >= 10);
  const effectivePriorityList = filteredPriorityList.slice(0, maxSlots);
  
  let totalScore = 0;
  const totalSlots = effectivePriorityList.length;
  const simClassJob = window.currentCharacterJob || '';
  
  effectivePriorityList.forEach((prioritySkill, index) => {
    const skillName = prioritySkill.skill_name;
    const characterSkillLevel = skillLevels[skillName] || 0;
    
    if (characterSkillLevel === 0) return;
    
    // 기본 점수 (레벨당 1점)
    let baseScore = characterSkillLevel * 1;
    
    // 보너스 점수
    let bonusScore = 0;
    if (skillType === 'active') {
      if (characterSkillLevel >= 8) bonusScore += 5;
      if (characterSkillLevel >= 12) bonusScore += 10;
      if (characterSkillLevel >= 16) bonusScore += 15;
      if (characterSkillLevel >= 20) bonusScore += 10;
    }
    
    // 액티브/패시브: DPS 지분 weight 적용
    let multiplier = 1.0;
    if (skillType === 'active') {
      multiplier = getSimSkillDpsMultiplier(skillName, simClassJob, maxSlots, SIM_ACTIVE_SKILL_DPS_WEIGHTS);
    } else if (skillType === 'passive') {
      multiplier = getSimSkillDpsMultiplier(skillName, simClassJob, maxSlots, SIM_PASSIVE_SKILL_DPS_WEIGHTS);
    }
    
    totalScore += (baseScore + bonusScore) * multiplier;
  });
  
  return totalScore / maxSlots;
}

// 스티그마 스킬 점수 계산 (복잡한 로직)
function calculateSimStigmaScore(skillLevels, priorityList, skillPriorities) {
  const filteredPriorityList = priorityList.filter(p => (p.adoption_rate || 0) >= 10);
  if (filteredPriorityList.length === 0) return 0;
  
  // 캐릭터가 찍은 스킬 중 레벨 높은 4개 선택
  const characterStigmas = filteredPriorityList
    .map(p => ({
      ...p,
      characterLevel: skillLevels[p.skill_name] || 0
    }))
    .filter(p => p.characterLevel > 0)
    .sort((a, b) => {
      if (b.characterLevel !== a.characterLevel) return b.characterLevel - a.characterLevel;
      return (a.priority || 0) - (b.priority || 0);
    })
    .slice(0, 4);
  
  // 정규화 중요도 계산
  const maxAvgLevel = Math.max(...filteredPriorityList.map(p => p.average_level || 0));
  const top4Skills = filteredPriorityList.slice(0, 4);
  
  let top4RawMultipliers = top4Skills.map(p => {
    const avgLvl = p.average_level || 0;
    if (maxAvgLevel > 0 && avgLvl > 0) return (avgLvl / maxAvgLevel) * 1.5;
    return 0.2;
  });
  
  const top4RawSum = top4RawMultipliers.reduce((sum, m) => sum + m, 0);
  const targetSum = 4.0;
  const maxCap = 1.5;
  
  let top4Normalized = [1.5];
  if (top4RawSum > 0 && top4Skills.length > 1) {
    const remaining2to4RawSum = top4RawMultipliers.slice(1).reduce((sum, m) => sum + m, 0);
    const remainingTargetSum = targetSum - 1.5;
    
    if (remaining2to4RawSum > 0) {
      for (let i = 1; i < top4RawMultipliers.length; i++) {
        const rawValue = top4RawMultipliers[i];
        const normalizedValue = (rawValue / remaining2to4RawSum) * remainingTargetSum;
        top4Normalized[i] = Math.max(0.2, Math.min(maxCap, normalizedValue));
      }
    }
  }
  
  const normalizedTop4Sum = top4Normalized.reduce((s, m) => s + m, 0);
  const scaleRatio = top4RawSum > 0 ? normalizedTop4Sum / top4RawSum : 1.0;
  
  // 정규화 맵 생성
  const normalizedMultiplierMap = {};
  top4Skills.forEach((p, i) => {
    normalizedMultiplierMap[p.skill_name] = Math.max(0.2, top4Normalized[i] || 0.2);
  });
  
  // NEW META 체크 및 5순위 이하
  filteredPriorityList.slice(4).forEach((p, idx) => {
    const skillRankIndex = idx + 4;
    const usageRates = p.usage_rates || [0, 0, 0, 0];
    const usageRate15 = usageRates[2] || 0;
    const isSkillNewMeta = isNewMetaSkill(p.skill_name, skillRankIndex, usageRate15);
    
    const avgLvl = p.average_level || 0;
    let rawMultiplier = 0.2;
    if (maxAvgLevel > 0 && avgLvl > 0) rawMultiplier = (avgLvl / maxAvgLevel) * 1.5;
    let normalizedMultiplier = Math.max(0.2, Math.min(maxCap, rawMultiplier * scaleRatio));
    
    if (isSkillNewMeta) normalizedMultiplier *= 2;
    normalizedMultiplierMap[p.skill_name] = normalizedMultiplier;
  });
  
  // 점수 계산
  let totalScore = 0;
  // 클래스별 고정 avgShards 사용 (시뮬레이션용)
  const JOB_FIXED_AVG_SHARDS_SIM = {
    '살성': 140.35, '마도성': 135.29, '궁성': 131.355, '치유성': 122.24,
    '정령성': 133.675, '검성': 137.88, '수호성': 126.875, '호법성': 144.455
  };
  const currentJobSim = window.currentCharacterJob || '';
  const avgShards = JOB_FIXED_AVG_SHARDS_SIM[currentJobSim] || 120;
  const standardShards = 120;  // 고정
  const jobCorrectionK = avgShards > 0 ? standardShards / avgShards : 1;
  
  characterStigmas.forEach(skill => {
    const skillName = skill.skill_name;
    const characterSkillLevel = skill.characterLevel;
    
    let baseScore = characterSkillLevel * 1;
    let bonusScore = 0;
    
    let usageRates = skill.usage_rates || [1, 1, 1, 1];
    const usageRate15 = usageRates[2] || 0;
    const isThisNewMeta = isNewMetaSkill(skillName, skill.priority - 1 || 0, usageRate15);
    if (isThisNewMeta) usageRates = usageRates.map(r => Math.min(1.0, r * 2));
    
    if (characterSkillLevel >= 5) bonusScore += 5 * usageRates[0] * jobCorrectionK;
    if (characterSkillLevel >= 10) bonusScore += 10 * usageRates[1] * jobCorrectionK;
    if (characterSkillLevel >= 15) bonusScore += 20 * usageRates[2] * jobCorrectionK;
    if (characterSkillLevel >= 20) bonusScore += 40 * usageRates[3] * jobCorrectionK;
    
    const multiplier = normalizedMultiplierMap[skillName] || 0.5;
    totalScore += (baseScore + bonusScore) * multiplier;
  });
  
  return totalScore / 4;
}

