}

// 모달 외부 클릭 시 닫기
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('stat-info-modal');
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        closeStatModal();
      }
    });
    
    const closeBtn = modal.querySelector('.stat-info-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeStatModal);
    }
  }

  const combatHelpModal = document.getElementById('combat-score-help-modal');
  if (combatHelpModal) {
    combatHelpModal.addEventListener('click', function(e) {
      if (e.target === combatHelpModal) {
        closeCombatScoreHelpModal();
      }
    });

    const closeBtn = combatHelpModal.querySelector('.stat-info-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeCombatScoreHelpModal);
    }
  }

  const combatPatchModal = document.getElementById('combat-score-patch-modal');
  if (combatPatchModal) {
    combatPatchModal.addEventListener('click', function(e) {
      if (e.target === combatPatchModal) {
        closeCombatScorePatchModal();
      }
    });

    const closeBtn = combatPatchModal.querySelector('.stat-info-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeCombatScorePatchModal);
    }
  }
  
  // ESC 키로 모달 닫기
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (currentStatModal === 'soul-engraving-grade') {
        closeSoulEngravingGradeModal();
      } else if (currentStatModal === 'combat-score-help') {
        closeCombatScoreHelpModal();
      } else if (currentStatModal === 'combat-score-patch') {
        closeCombatScorePatchModal();
      } else if (currentStatModal) {
        closeStatModal();
      }
    }
  });
  
  // 각 i 버튼에 클릭 이벤트 추가
  setupStatInfoButtons();
  
  // 영혼각인 등급 설명 모달 닫기 버튼 이벤트
  const soulEngravingGradeModal = document.getElementById('soul-engraving-grade-modal');
  if (soulEngravingGradeModal) {
    const closeBtn = soulEngravingGradeModal.querySelector('.stat-info-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeSoulEngravingGradeModal);
    }
    
    // 모달 배경 클릭 시 닫기
    soulEngravingGradeModal.addEventListener('click', function(e) {
      if (e.target === soulEngravingGradeModal) {
        closeSoulEngravingGradeModal();
      }
    });
  }
  
  // "장비" 제목 옆 "?" 버튼 이벤트 리스너
  function setupSoulEngravingGradeHelpButton() {
    const helpBtn = document.querySelector('.soul-engraving-grade-help-btn');
    if (helpBtn) {
      helpBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        openSoulEngravingGradeModal();
      });
    }
  }
  
  // "장비" 제목 옆 "장비 한눈에 보기" 버튼 이벤트 리스너
  function setupEquipmentSummaryButton() {
    const summaryBtn = document.querySelector('.equipment-summary-btn');
    if (summaryBtn) {
      summaryBtn.removeEventListener('click', handleEquipmentSummaryClick);
      summaryBtn.addEventListener('click', handleEquipmentSummaryClick);
    }
  }
  
  function handleEquipmentSummaryClick(e) {
    e.stopPropagation();
    openEquipmentSummaryModal();
  }
  
  // 초기 설정 및 장비 정보 표시 시마다 설정
  setupSoulEngravingGradeHelpButton();
  setupEquipmentSummaryButton();
  
  // 장비 정보가 동적으로 추가될 때를 대비해 MutationObserver 사용
  const equipmentInfo = document.getElementById('equipment-info');
  if (equipmentInfo) {
    const observer = new MutationObserver(function(mutations) {
      setupSoulEngravingGradeHelpButton();
      setupEquipmentSummaryButton();
    });
    observer.observe(equipmentInfo, { childList: true, subtree: true });
  }
  
  // 장비/장신구 요약 모달 닫기 이벤트
  const equipmentSummaryModal = document.getElementById('equipment-summary-modal');
  if (equipmentSummaryModal) {
    const closeBtn = equipmentSummaryModal.querySelector('.stat-info-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeEquipmentSummaryModal);
    }
    
    // 모달 배경 클릭 시 닫기
    equipmentSummaryModal.addEventListener('click', function(e) {
      if (e.target === equipmentSummaryModal) {
        closeEquipmentSummaryModal();
      }
    });
  }
  
  // ESC 키로 모달 닫기
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const equipmentSummaryModal = document.getElementById('equipment-summary-modal');
      if (equipmentSummaryModal && equipmentSummaryModal.classList.contains('active')) {
        closeEquipmentSummaryModal();
        return;
      }
      
      const soulEngravingGradeModal = document.getElementById('soul-engraving-grade-modal');
      if (soulEngravingGradeModal && soulEngravingGradeModal.classList.contains('active')) {
        closeSoulEngravingGradeModal();
      }
    }
  });
});

function setupStatInfoButtons() {
  // 전투 속도
  const combatSpeedBtn = document.querySelector('.combat-speed-info-icon');
  if (combatSpeedBtn) {
    combatSpeedBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const combatSpeedValue = parseFloat(document.getElementById('combat-speed-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      const breakdownData = [
        { label: '장비 영혼 각인', value: document.getElementById('tooltip-soul-combat-speed')?.textContent || '+0%' },
        { label: '장신구 기본 옵션', value: document.getElementById('tooltip-accessory-combat-speed')?.textContent || '+0%' },
        { label: '주신 스탯 (시간)', value: document.getElementById('tooltip-time-combat-speed')?.textContent || '+0%' },
        { label: '데바니온 (네자칸)', value: document.getElementById('tooltip-daevanion-combat-speed')?.textContent || '+0%' },
        { label: '타이틀', value: document.getElementById('tooltip-title-combat-speed')?.textContent || '+0%' }
      ];
      const description = {
        conclusion: `${combatSpeedValue}% 전투 속도 향상은 ${combatSpeedValue}% 이상의 전투 점수 증가`,
        text: `스펙업 체감이 가장 크고, 딜 상승에 직접적인 영향을 주는 스탯. 캐릭터의 평타, 스킬 시전 속도, 스킬 사용 후의 모션/경직(후딜레이) 등 공격에 관련된 모든 동작의 재생 속도를 가속함.<br><br>즉, 공격력이 그대로여도 시간당 쏟아붓는 총 대미지(DPS)가 획기적으로 늘어나는 구조임. 캐스팅 시간과 모션 단축이 생명인 마법 계열 클래스는 물론, 아이온2 전투 특성상 기본적인 연속기 템포가 빨라지기 떄문에 모두에게 필수적.<br><br> 이론 상 ${combatSpeedValue}% 전투 속도 향상은 ${combatSpeedValue}% 이상의 DPS 증가로 이어질 수도 있지만, 쿨감/정신력 등 기타 스탯이 부족하면 그만큼 쿨이 밀리는 현상이 오히려 발생할 수도 있어 동일 % 딜증으로 계산.`,
        damageIncrease: `${combatSpeedValue}%`
      };
      openStatModal('combat-speed', combatSpeedValue, breakdownData, description);
    });
  }
  
  // 공격력
  const attackPowerBtn = document.querySelector('.attack-power-info-icon');
  if (attackPowerBtn) {
    attackPowerBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      // 실제 공격력 값 가져오기 (전역 변수에서 직접)
      const actualAttackPower = window.attackPowerResult?.finalAttack || 0;
      const wingAttackValue = document.getElementById('tooltip-wing-attack')?.textContent || '+0';
      
      // 위력 표시 (캡 200 적용)
      const attackBreakdown = window.attackPowerResult?.breakdown || {};
      const normalStatPowerPercent = attackBreakdown.normalStatPowerPercent || 0;
      const powerDisplay = `+${normalStatPowerPercent.toFixed(1)}%`;
      
      const titleAttackValue = document.getElementById('tooltip-title-attack')?.textContent || '+0';
      
      const wingBossAttackValue = document.getElementById('tooltip-wing-boss-attack')?.textContent || '+0';
      
      const soulAttackIncreaseDisplay = document.getElementById('tooltip-soul-attack-increase')?.textContent || '+0%';
      
      const breakdownData = [
        { label: '데바니온', value: document.getElementById('tooltip-daevanion')?.textContent || '+0', phase: 'pre' },
        { label: '데바니온 (마르쿠탄) - 추가 공격력', value: document.getElementById('tooltip-daevanion-markutan-attack')?.textContent || '+0', phase: 'pre' },
        { label: '장비/장신구', value: document.getElementById('tooltip-equipment-base')?.textContent || '+0', phase: 'pre' },
        { label: '장비/장신구 (초월 정수)', value: document.getElementById('tooltip-equipment-transcend-integer')?.textContent || '+0', phase: 'pre' },
        { label: '날개 장착 효과 - 추가 공격력', value: wingAttackValue, phase: 'pre' },
        { label: '타이틀 장착 효과', value: titleAttackValue, phase: 'pre' },
        { label: '장비/장신구 (초월 퍼센트)', value: document.getElementById('tooltip-equipment-transcend-percent')?.textContent || '+0%', phase: 'percent' },
        { label: '주신 스탯 (파괴)', value: document.getElementById('tooltip-destruction')?.textContent || '+0%', phase: 'percent' },
        { label: '일반스탯 (위력)', value: powerDisplay, phase: 'percent' },
        { label: '영혼 각인 - 공격력 증가', value: soulAttackIncreaseDisplay, phase: 'percent' },
        { label: '데바니온 (유스티엘) - 공격력 증가', value: document.getElementById('tooltip-daevanion-yustiel-attack-increase')?.textContent || '+0%', phase: 'cap' },
        { label: '데바니온 - 아리엘 (PVE, 보스)', value: document.getElementById('tooltip-daevanion-ariel')?.textContent || '+0', phase: 'post' },
        { label: '날개 장착 효과 - PVE/보스 공격력', value: wingBossAttackValue, phase: 'post' },
        { label: '아르카나 - 광분 2세트 효과', value: document.getElementById('tooltip-arcana-frenzy-attack')?.textContent || '+0', color: '#f59e0b', phase: 'post' },
        { label: '아르카나 - 징벌 4세트 효과', value: document.getElementById('tooltip-arcana-punishment-attack')?.textContent || '+0', color: '#f59e0b', phase: 'post' },
        { label: '아르카나 - 활력 2세트 효과', value: document.getElementById('tooltip-arcana-vitality-2-attack')?.textContent || '+0', color: '#f59e0b', phase: 'post' },
        { label: '아르카나 - 활력 4세트 효과', value: document.getElementById('tooltip-arcana-vitality-4-attack')?.textContent || '+0', color: '#f59e0b', phase: 'post' },
        { label: '데바니온 (유스티엘) - 최대 공격력', value: document.getElementById('tooltip-daevanion-yustiel-attack')?.textContent || '+0', phase: 'post' }
      ];
      
      openStatModal('attack-power', actualAttackPower, breakdownData, null);
    });
  }
  
  // 무기 피해 증폭
  const weaponDamageAmpBtn = document.querySelector('.weapon-damage-amplification-info-icon');
  if (weaponDamageAmpBtn) {
    weaponDamageAmpBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const weaponDamageAmpValue = parseFloat(document.getElementById('weapon-damage-amplification-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      const breakdownData = [
        { label: '장비 영혼 각인', value: document.getElementById('tooltip-soul-weapon-damage-amp')?.textContent || '+0%' },
        { label: '장비 기본 옵션', value: document.getElementById('tooltip-equipment-base-weapon-damage-amp')?.textContent || '+0%' },
        { label: '마석 각인', value: document.getElementById('tooltip-stone-weapon-damage-amp')?.textContent || '+0' },
        { label: '데바니온 (마르쿠탄)', value: document.getElementById('tooltip-daevanion-weapon-damage-amp')?.textContent || '+0%' },
        { label: '타이틀 장착 효과', value: document.getElementById('tooltip-title-weapon-damage-amp')?.textContent || '+0%' },
        { label: '아르카나 - 수호 4세트 효과', value: document.getElementById('tooltip-arcana-guardian-weapon-damage-amp')?.textContent || '+0%', color: '#f59e0b' }
      ];
      const damageIncreasePercent = (weaponDamageAmpValue * 0.66).toFixed(2);
      const description = {
        conclusion: `${weaponDamageAmpValue}% 무기 피해 증폭 향상은 ${damageIncreasePercent}%의 전투 점수 증가`,
        text: `실험 결과, 기타 피해 증폭류와 달리 독자적인 곱연산 구간을 가진 것으로 추정. <br><br>$$실질 딜 상승량(%) ≈ 무기 피해 증폭 수치(%) × 0.66$$`,
        damageIncrease: `${damageIncreasePercent}%`
      };
      openStatModal('weapon-damage-amplification', weaponDamageAmpValue, breakdownData, description);
    });
  }
  
  // 피해 증폭 (PVE/보스 피해 증폭 + 일반 피해 증폭 통합)
  const damageAmpBtn = document.querySelector('.damage-amplification-info-icon');
  if (damageAmpBtn) {
    damageAmpBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const totalDamageAmpValue = parseFloat(document.getElementById('damage-amplification-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      const breakdownData = [
        { label: '장비 영혼 각인', value: document.getElementById('tooltip-soul-damage-amp')?.textContent || '+0%' },
        { label: '장비 기본 옵션', value: document.getElementById('tooltip-equipment-base-damage-amp')?.textContent || '+0%' },
        { label: '마석 각인', value: document.getElementById('tooltip-stone-damage-amp')?.textContent || '+0' },
        { label: '데바니온 (지켈)', value: document.getElementById('tooltip-daevanion-damage-amp')?.textContent || '+0%' },
        { label: '데바니온 - 아리엘', value: document.getElementById('tooltip-daevanion-ariel-damage-amp')?.textContent || '+0%' },
        { label: '타이틀 장착 효과', value: document.getElementById('tooltip-title-damage-amp')?.textContent || '+0%' }
      ];
      
      // 날개 효과 항상 추가
      const wingDamageAmpValue = document.getElementById('tooltip-wing-damage-amp')?.textContent || '+0%';
      breakdownData.push({ label: '날개 (장착 효과)', value: wingDamageAmpValue });
      
      // 아르카나 - 광분 4세트 효과 항상 추가
      const arcanaFrenzyDamageAmpValue = document.getElementById('tooltip-arcana-frenzy-damage-amp')?.textContent || '+0%';
      breakdownData.push({ label: '아르카나 - 광분 4세트 효과', value: arcanaFrenzyDamageAmpValue, color: '#f59e0b' });
      const arcanaPunishmentDamageAmpValue = document.getElementById('tooltip-arcana-punishment-damage-amp')?.textContent || '+0%';
      breakdownData.push({ label: '아르카나 - 징벌 4세트 효과', value: arcanaPunishmentDamageAmpValue, color: '#f59e0b' });
      
      // PVP 장비 디버프 4줄 (무조건 표시)
      const pvpDebuffColor = '#ef4444';
      breakdownData.push({
        label: '십부장 디버프',
        value: document.getElementById('tooltip-pvp-gear-sipbujang')?.textContent || '0.0%',
        color: pvpDebuffColor
      });
      breakdownData.push({
        label: '백부장 디버프',
        value: document.getElementById('tooltip-pvp-gear-baekbujang')?.textContent || '0.0%',
        color: pvpDebuffColor
      });
      breakdownData.push({
        label: '천부장 디버프',
        value: document.getElementById('tooltip-pvp-gear-cheonbujang')?.textContent || '0.0%',
        color: pvpDebuffColor
      });
      breakdownData.push({
        label: '군단장 디버프',
        value: document.getElementById('tooltip-pvp-gear-gundanjang')?.textContent || '0.0%',
        color: pvpDebuffColor
      });
      
      const description = {
        conclusion: '위 세 옵션은 합연산으로 가정하여 합산',
        text: 'PVE 피해 증폭, 보스 피해 증폭, 피해 증폭 모두 같은 카테고리로 묶여서 합연산 처리된다는 가정.<br><br>\'조건부 효율\'만 다를 것으로 추정 되고 있음.<br><br>- <strong>일반 피해 증폭:</strong> PVP, 일반 몹, 보스 가리지 않고 무조건 적용<br>- <strong>PVE 피해 증폭:</strong> 사람(PVP) 때릴 땐 0% 처리, 몬스터한테만 합산<br>- <strong>보스 피해 증폭:</strong> 일반 쫄몹이나 사람 때릴 땐 0% 처리, 보스한테만 합산<br>- <strong>후방 피해 증폭:</strong> 백어택시 피해 증폭, 100% 백어택 가정하여 합연산 적용 (향후 곱연산 적용 고려 중이나, 현재 마석으로 인한 후피증만 포함되고 있어 큰 차이는 없을 것으로 예상 됨), 패시브로 인한 후피증은 "스킬"에 포함.<br><br>$$최종 증폭 계수 = 1 + (피해 증폭 + PVE 피증 + 보스 피증* + 후방 피해 증폭) / 100$$<br><br>(단, 보스 피증*은 타겟이 보스일 때만 활성화)',
        damageIncrease: totalDamageAmpValue.toFixed(1) + '%'
      };
      
      openStatModal('damage-amplification', totalDamageAmpValue, breakdownData, description);
    });
  }
  
  // 치명타 피해 증폭
  const criticalDamageAmpBtn = document.querySelector('.critical-damage-amplification-info-icon');
  if (criticalDamageAmpBtn) {
    criticalDamageAmpBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const criticalDamageAmpValue = parseFloat(document.getElementById('critical-damage-amplification-value')?.textContent?.replace(/[^0-9.-]/g, '') || '0');
      
      // 치명타 확률 계산 (breakdown에서 직접 계산)
      let criticalChanceRaw = 0;
      if (window.criticalHitResult && window.criticalHitResult.breakdown) {
        const breakdown = window.criticalHitResult.breakdown;
        const totalCrit = (breakdown.baseCriticalHitInteger || 0) + 
                          (breakdown.soulCriticalHitInteger || 0) + 
                          (breakdown.stoneCriticalHitInteger || 0) + 
                          (breakdown.daevanionCriticalHitInteger || 0) + 
                          (breakdown.wingCriticalHitInteger || 0) + 
                          (breakdown.titleEquipCriticalHit || 0) + 
                          (breakdown.intelligentPetCriticalMax || 41) + 
                          80;  // 타이틀 보유 효과 고정값
        const percentMultiplier = 1 + (((breakdown.deathCriticalHitPercent || 0) + (breakdown.accuracyCriticalHitPercent || 0)) / 100);
        const finalCritStatMax = Math.round(totalCrit * percentMultiplier);
        criticalChanceRaw = convertCritStatToChance(finalCritStatMax);
      }
      // 치명타 확률 80% 캡 적용
      const criticalChance = Math.min(criticalChanceRaw, 80);
      
      // 치명타 + 치피증으로 인한 딜증 계산
      // 기본 치명타 피해: 150% (1.5배)
      const BASE_CRITICAL_DAMAGE = 1.5;
      const amplifiedCriticalDamage = BASE_CRITICAL_DAMAGE + (criticalDamageAmpValue / 100);
      
      // p = 치명타 확률 (0~1), 80% 캡 적용됨
      const p = criticalChance / 100;
      
      // 증폭 후 기대 딜: (1 - p) × 1 + p × (1.5 + 치피증)
      const amplifiedExpectedDamage = (1 - p) * 1 + p * amplifiedCriticalDamage;
      
      // 딜증 = 증폭 후 기대 딜 - 1
      const damageIncreaseFromCrit = (amplifiedExpectedDamage - 1) * 100;
      
      // 80% 캡 초과 여부
      const isOverCritCap = criticalChanceRaw > 80;
      const critChanceDisplayText = isOverCritCap 
        ? '<span style="text-decoration: line-through; color: #ef4444;">' + criticalChanceRaw.toFixed(1) + '%</span> → ' + criticalChance.toFixed(1) + '% (캡 80%)'
        : criticalChance.toFixed(1) + '%';
      
      const breakdownData = [
        { label: '장비 영혼 각인', value: document.getElementById('tooltip-soul-critical-damage-amp')?.textContent || '+0%' },
        { label: '장비 기본 옵션', value: document.getElementById('tooltip-equipment-base-critical-damage-amp')?.textContent || '+0%' },
        { label: '마석 각인', value: document.getElementById('tooltip-stone-critical-damage-amp')?.textContent || '+0' },
        { label: '데바니온 (바이젤)', value: document.getElementById('tooltip-daevanion-critical-damage-amp')?.textContent || '+0%' },
        { label: '타이틀 장착 효과', value: document.getElementById('tooltip-title-critical-damage-amp')?.textContent || '+0%' },
        { label: '아르카나 - 순수 4세트 효과', value: document.getElementById('tooltip-arcana-purity-critical-damage-amp')?.textContent || '+0%', color: '#f59e0b' }
      ];
      
      const description = {
        conclusion: '치명타 + 치피증으로 인한 총 딜증',
        text: '실험 결과, 아이온2는 치명타 대미지가 <strong>1.5배(150%)</strong> 정도 들어가게 설계된 것으로 추정. \'치명타 피해 증폭\'은 이 배율에 합연산(+)으로 더해 계산.<br><br>현재 치명타 확률: <strong style="color:#60a5fa;">' + critChanceDisplayText + '</strong>' + (isOverCritCap ? '<br><span style="font-size: 0.75rem; color: #f87171;">※ 치명타 확률이 80%를 초과하여 80%로 적용됩니다.</span>' : '') + '<br>기본 치명타 피해: <strong>150% (×1.5)</strong><br>증폭 후 치명타 피해: <strong style="color:#a78bfa;">' + (amplifiedCriticalDamage * 100).toFixed(1) + '% (×' + amplifiedCriticalDamage.toFixed(3) + ')</strong><br><br><strong>딜 상승률 계산:</strong><br><br><div style="margin: 0.75rem 0; padding: 0.75rem; background: rgba(157, 140, 255, 0.1); border-left: 3px solid rgba(157, 140, 255, 0.5); font-family: monospace; font-size: 0.85rem; line-height: 1.6;">증폭 후 기대 딜 = (1-p)×1 + p×' + amplifiedCriticalDamage.toFixed(3) + '<br>딜 상승률 = 증폭 후 기대 딜 - 1</div><br>증폭 후 기대 딜 = (1 - ' + p.toFixed(3) + ') × 1 + ' + p.toFixed(3) + ' × ' + amplifiedCriticalDamage.toFixed(3) + ' = <strong style="color:#a78bfa;">×' + amplifiedExpectedDamage.toFixed(4) + '</strong><br><br>딜 상승률 = ' + amplifiedExpectedDamage.toFixed(4) + ' - 1 = <strong style="color:#4ade80;">' + damageIncreaseFromCrit.toFixed(2) + '%</strong>',
        damageIncrease: damageIncreaseFromCrit.toFixed(2) + '%'
      };
      
      openStatModal('critical-damage-amplification', criticalDamageAmpValue, breakdownData, description);
    });
  }
  
  // 스킬 딜증
  const skillDamageBtn = document.querySelector('.skill-damage-info-icon');
  if (skillDamageBtn) {
    skillDamageBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      
      // ★ 수정: 이미 계산된 결과를 window.skillDamageResult에서 가져오기
      const skillDamageResult = window.skillDamageResult;
      
      if (!skillDamageResult) {
        console.warn('[스킬 모달] skillDamageResult가 없습니다.');
        return;
      }
      
      // 계산된 결과에서 값 추출
      const activeDamage = skillDamageResult.breakdown?.activeSkillDamage || 0;
      const passiveDamage = skillDamageResult.breakdown?.passiveSkillDamage || 0;
      const stigmaDamage = skillDamageResult.breakdown?.stigmaSkillDamage || 0;
      const totalDamage = skillDamageResult.totalSkillDamage || 0;
      
      // 스킬 정보 가져오기
      const skills = window.currentSkills || [];
      const stigmas = window.currentStigmas || [];
      const skillPriorities = window.currentSkillPriorities || null;
      
      // 액티브/패시브 스킬 분류
      const activeSkills = skills.filter(skill => {
        const group = skill.group || '';
        return group.toLowerCase().includes('active') || group === '액티브';
      });
      const passiveSkills = skills.filter(skill => {
        const group = skill.group || '';
        return group.toLowerCase().includes('passive') || group === '패시브';
      });
      
      // 스킬 목록 HTML 생성 (우선순위 기반 새 UI)
      let skillListHtml = '';
      
      // 설명 메시지
      skillListHtml += `
        
      `;
      
      // 우선순위 기반 스킬 목록 생성
      if (skillPriorities) {
        // 캐릭터 스킬 맵 생성
        const characterSkillMap = {};
        [...activeSkills, ...passiveSkills, ...stigmas].forEach(skill => {
          const skillName = skill.name || '';
          const skillLevel = skill.level_int || parseInt(skill.level || '0', 10) || 0;
          const iconUrl = skill.icon || skill.icon_url || '';
          if (skillName) {
            characterSkillMap[skillName] = { level: skillLevel, icon: iconUrl };
          }
        });
        
        // 액티브 스킬 표시
        if (skillPriorities.active && skillPriorities.active.length > 0) {
          skillListHtml += `
            <div style="margin-bottom: 1.5rem;">
              <div style="background: rgba(147, 51, 234, 0.15); border-radius: 8px; padding: 0.75rem; margin-bottom: 0.75rem;">
                <div style="font-weight: 600; color: #a78bfa; margin-bottom: 0.5rem; font-size: 1rem;">액티브</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">
                  레벨당 +1.35%, 8/12/16/20 레벨 달성 시 +5/10/15/10%<br>
                  <span style="color: #c084fc;">※ 스킬별 딜 지분 데이터 기반 weight 적용하여 계산. (아래 스킬 순서는 weight와 무관한, 단순 랭커 채용 스킬 순위입니다.) </span>
                </div>
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
