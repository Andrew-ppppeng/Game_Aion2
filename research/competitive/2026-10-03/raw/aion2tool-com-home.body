    <div id="slot-8" class="venatus-ad-slot venatus-mobile-only" style="display: flex; justify-content: center; align-items: center; min-height: 250px; margin: 1rem 0;"></div>
    

    <!-- 종합 서버 순위 보드 (검색 폼 아래, 홈 화면에 항상 표시) -->
    <p id="home-board-title" class="badge" style="margin-bottom: 0.75rem; margin-top: 0 !important; padding-top: 0 !important;">
