<style>
@keyframes rainbow-shift-home {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
#server-info-btn.rainbow-active {
  background: linear-gradient(135deg, #667eea, #764ba2, #f093fb, #f5576c, #fda085, #f6d365, #667eea) !important;
  background-size: 300% 300% !important;
  animation: rainbow-shift-home 4s ease infinite !important;
  color: #fff !important; border: none !important; font-weight: 700 !important;
  text-shadow: 0 1px 3px rgba(0,0,0,1) !important;
  box-shadow: 0 2px 12px rgba(118,75,162,0.35) !important;
}
#server-info-btn.rainbow-active:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 20px rgba(118,75,162,0.5) !important;
  animation: rainbow-shift-home 2s ease infinite !important;
}
</style>
<script>
// ========== 홈 서버정보 버튼 점령전 시간 감지 ==========
(function() {
  let _allConfirmedCache = false; // 전체 확정 여부 캐시
  const _SERVER_INFO_LABEL_ORIGINAL = "\uc544\ud2f0\uc7c1 \ud604\ud669 \ubcf4\uae30 \u003e";
  const _SERVER_INFO_LABEL_SIEGE = "\ub0b4 \uc11c\ubc84 \uc810\ub839\uc804 \uc81c\ubcf4 \ud83d\udce2";

  function _setOriginal(btn) {
    btn.classList.remove('rainbow-active');
    btn.textContent = _SERVER_INFO_LABEL_ORIGINAL;
  }
  function _setRainbow(btn) {
    btn.classList.add('rainbow-active');
    btn.textContent = _SERVER_INFO_LABEL_SIEGE;
  }

  function updateServerInfoBtn() {
    const btn = document.getElementById('server-info-btn');
    if (!btn) return;
    const now = new Date();
    const h = now.getHours(), m = now.getMinutes(), day = now.getDay();
    const battleDays = [3, 6];
    const isBattleDay = battleDays.includes(day);
    const prevDay = (day + 6) % 7;
    const prevWasBattle = battleDays.includes(prevDay);
    const inWindow = (isBattleDay && ((h === 22 && m >= 10) || h === 23))
                   || (prevWasBattle && h < 3);

    if (!inWindow) {
      _setOriginal(btn);
      _allConfirmedCache = false; // 윈도우 밖이면 캐시 리셋
      return;
    }

    // 이미 전체 확정 확인된 경우 API 재호출 불필요
    if (_allConfirmedCache) {
      _setOriginal(btn);
      return;
    }

    // 제보 윈도우 내 → 캐시된 API로 전체 확정 여부 확인 (7분 Redis 캐시)
    var _pfx = (window.location.pathname.indexOf('/zh-tw') === 0) ? '/zh-tw' : '';
    var _isTw = _pfx === '/zh-tw';
    var _totalMatches = _isTw ? 18 : 21;
    fetch(_pfx + '/api/artifact/status')
      .then(r => r.json())
      .then(res => {
        if (res.success && res.data && res.data.confirmed_matches) {
          if (res.data.confirmed_matches.length >= _totalMatches) {
            _allConfirmedCache = true;
            _setOriginal(btn);
          } else {
            _setRainbow(btn);
          }
        } else {
          _setRainbow(btn);
        }
      })
      .catch(() => {
        _setRainbow(btn);
      });
  }
  updateServerInfoBtn();
  setInterval(updateServerInfoBtn, 600000);
})();

// ========== 서버에서 전달된 초기 데이터 ==========



// ========== 로딩 오버레이 강제 유지 ==========
// 검색 중에는 어떤 코드가 display:none을 설정해도 오버레이가 사라지지 않도록 보호
window.forceLoadingOverlayActive = false;

function lockLoadingOverlay() {
  window.forceLoadingOverlayActive = true;
  if (document.body) {
    document.body.classList.add('force-loading-overlay');
  }
  const loadingOverlay = document.getElementById('fullscreen-loading-overlay');
  if (loadingOverlay) {
    loadingOverlay.style.display = 'flex';
    loadingOverlay.style.visibility = 'visible';
    loadingOverlay.style.opacity = '1';
  }
}

function unlockLoadingOverlay() {
  window.forceLoadingOverlayActive = false;
  if (document.body) {
    document.body.classList.remove('force-loading-overlay');
  }
  const loadingOverlay = document.getElementById('fullscreen-loading-overlay');
  if (loadingOverlay) {
    loadingOverlay.style.display = 'none';
  }
}

// ========== 공통 URL 라우팅 유틸리티 ==========
// URL 업데이트 함수 (실제 URL로 변경, 페이지 리로드)
function updateURL(hash, replace = false, clearPathname = false) {
  let newURL;
  const _pfx = SITE_URL_PREFIX || '';
  if (clearPathname || hash) {
    if (hash === 'character' || hash === '') {
      newURL = _pfx + '/';
    } else if (hash === 'ranking') {
      newURL = _pfx + '/ranking';
    } else if (hash === 'statistics') {
      newURL = _pfx + '/statistics';
    } else if (hash.startsWith('ranking/')) {
      newURL = _pfx + '/ranking';
    } else if (hash.startsWith('statistics/')) {
      newURL = _pfx + '/statistics';
    } else {
      newURL = hash ? `${_pfx}/${hash}` : _pfx + '/';
    }
  } else {
    if (hash === 'character' || hash === '') {
      newURL = _pfx + '/';
    } else if (hash === 'ranking') {
      newURL = _pfx + '/ranking';
    } else if (hash === 'statistics') {
      newURL = _pfx + '/statistics';
    } else if (hash.startsWith('ranking/')) {
      newURL = _pfx + '/ranking';
    } else if (hash.startsWith('statistics/')) {
      newURL = _pfx + '/statistics';
    } else {
      newURL = hash ? `${_pfx}/${hash}` : window.location.pathname;
    }
  }
  if (replace) {
    window.history.replaceState(null, '', newURL);
  } else {
    window.history.pushState(null, '', newURL);
  }
  // 무한 루프 방지: updateURL에서 activateTabByPath 호출 제거
  // 탭 활성화는 탭 클릭 이벤트나 페이지 로드 시에만 수행
}

// URL에서 해시 파싱 함수
function parseHash() {
  const hash = window.location.hash.substring(1); // # 제거
  if (!hash) return null;
  
  const parts = hash.split('/');
  return {
    tab: parts[0] || null,
    params: parts.slice(1) || []
  };
}

// 랭킹 탭 URL 생성
function buildRankingURL(job, server, race) {
  const parts = ['ranking'];
  if (job && job !== 'all') parts.push(job);
  if (race && race !== 'all') {
    const elyosLabel = IS_TW ? '天族' : '천족';
    const asmodianLabel = IS_TW ? '魔族' : '마족';
    parts.push(race === 'elyos' ? elyosLabel : race === 'asmodian' ? asmodianLabel : race);
  }
  if (server && server !== 'all') parts.push(server);
  return parts.join('/');
}

function buildInternalRankingURL(type, job, race, server) {
  const parts = ['ranking', 'farming'];
  
  const typeMap = {
    'title': 'title',
    'stigma': 'stigma',
    'total_stat': 'total_stat'
  };
  const typeValue = typeMap[type] || 'title';
  parts.push(typeValue);
  
  if (job && job !== 'all') parts.push(job);
  if (race && race !== 'all') {
    const elyosLabel = IS_TW ? '天族' : '천족';
    const asmodianLabel = IS_TW ? '魔族' : '마족';
    parts.push(race === 'elyos' ? elyosLabel : race === 'asmodian' ? asmodianLabel : race);
  }
  if (server && server !== 'all') parts.push(server);
  
  return parts.join('/');
}

// 통계 탭 URL 생성
function buildStatisticsURL(subtab) {
  if (subtab === 'skillstat' || subtab === 'skill-statistics') {
    return 'statistics/skillstat';
  }
  if (subtab === 'itemstats' || subtab === 'item-statistics') {
    return 'statistics/itemstats';
  }
  return 'statistics/jobstats';
}

// 티어 탭 URL 생성
function buildTierURL(subtab) {
  if (subtab === 'ranker' || subtab === 'ranker-tier') {
    return 'tier/ranker';
  }
  return 'tier/combatpower';
}

// 스펙 비교 탭 URL 생성
function buildCompareURL(char1, char2) {
  if (!char1 || !char2) return 'compare';
  const encodeChar = (c) => encodeURIComponent(c.nickname || '') + '/' + (c.race || '') + '/' + (c.server || '');
  return `compare/${encodeChar(char1)}/${encodeChar(char2)}`;
}

// 서버 비교 탭 URL 생성
function buildServerComparisonURL(matchId) {
  if (!matchId || matchId === 'all') return 'server-comparison';
  return `server-comparison/${matchId}`;
}

// 캐릭터 검색 URL 생성
function buildCharacterURL(nickname, serverId, race) {
  if (!nickname || !serverId) return null;
  return `char/serverid=${serverId}/${encodeURIComponent(nickname)}`;
}

function getServerNameById(serverId) {
  const serverDataEl = document.getElementById('server-data');
  let servers = { elyos: [], asmodian: [] };
  if (serverDataEl && serverDataEl.textContent) {
    try { servers = JSON.parse(serverDataEl.textContent); } catch (e) {}
  }
  for (const s of [...(servers.elyos || []), ...(servers.asmodian || [])]) {
    if (String(s.id) === String(serverId)) return s.name || '';
  }
  return '';
}

function updateCharacterDocumentTitle(nickname, serverName) {
  if (!nickname) return;
  const site = TA('meta.site_name', '아툴');
  const serverPart = serverName ? ` - ${serverName}` : '';
  const title = `${nickname}${serverPart} | ${site}`;
  document.title = title;
  const h1 = document.querySelector('h1.sr-only');
  if (h1) h1.textContent = title;
  const ogTitle = document.querySelector('meta[property="og:title"]');
  if (ogTitle) ogTitle.setAttribute('content', title);
}

// URL에서 상태 복원 함수
function restoreStateFromURL() {
  const hash = window.location.hash.substring(1);
  
  // char/serverid=xxx/닉네임 형식 처리
  if (hash.startsWith('char/serverid=')) {
    const charMatch = hash.match(/^char\/serverid=(\d+)\/(.+)$/);
    if (charMatch) {
      const serverId = charMatch[1];
      const nickname = decodeURIComponent(charMatch[2]);
      
      // 서버 정보 찾기
      const serverDataEl = document.getElementById('server-data');
      let servers = { elyos: [], asmodian: [] };
      if (serverDataEl && serverDataEl.textContent) {
        try {
          servers = JSON.parse(serverDataEl.textContent);
        } catch (e) {
        }
      }
      
      let race = null;
      let server = null;
      for (const serverList of [servers.elyos || [], servers.asmodian || []]) {
        for (const s of serverList) {
          if (s.id == serverId) {
            server = s.id;
            race = servers.elyos && servers.elyos.some(es => es.id == serverId) ? '1' : '2';
            break;
          }
        }
        if (race) break;
      }
      
      if (nickname && race && server) {
        const characterTab = document.getElementById('tab-character');
        if (characterTab) {
          characterTab.checked = true;
          characterTab.dispatchEvent(new Event('change'));
          updateSidebarVisibility();
          
          // 검색 폼에 값 설정
          const serverSelect = document.getElementById('server-select');
          const keywordInput = document.getElementById('character-keyword');
          
          // 종족 버튼 업데이트 (캐릭터 링크 클릭이므로 localStorage에 저장하지 않음)
          if (race) {
            updateRaceSelection(race, true);
          }
          
          setTimeout(() => {
            if (serverSelect) {
              serverSelect.value = server;
              if (keywordInput) keywordInput.value = nickname;
              
              // 로딩 표시 유지
              document.getElementById('character-loading').style.display = 'block';
              lockLoadingOverlay();
              
              // 검색 실행
              performSearch();
            }
          }, 300);
        }
        return;
      }
    }
  }
  
  const parsed = parseHash();
  if (!parsed) return;
  
  const { tab, params } = parsed;
  
  // 랭킹 탭
  if (tab === 'ranking') {
    // 컨텐츠 랭킹 서브탭 체크
    if (params.length > 0 && params[0] === 'contentsRanking') {
      const rankingTab = document.getElementById('tab-ranking');
      if (rankingTab) {
        rankingTab.checked = true;
        rankingTab.dispatchEvent(new Event('change'));
        
        // 컨텐츠 랭킹 탭 활성화
        setTimeout(() => {
          const contentsTab = document.querySelector('#panel-ranking .statistics-sub-tab-btn[data-target="contents-ranking"]');
          if (contentsTab) {
            contentsTab.click();
            
            // URL 파라미터에서 필터 복원
            const urlParams = new URLSearchParams(window.location.search);
            const contentType = urlParams.get('contentType') || 'abyss';
            const job = urlParams.get('job') || 'all';
            const race = urlParams.get('race') || 'all';
            const server = urlParams.get('server') || 'all';
            const page = parseInt(urlParams.get('page')) || 1;
            
            setTimeout(() => {
              if (typeof initializeContentsRankingFilters === 'function') {
                initializeContentsRankingFilters();
              }
              
              // 필터 상태 복원
              currentContentsRankingType = contentType;
              currentContentsJobFilter = job;
              currentContentsServerRaceFilter = race;
              currentContentsServerFilter = server;
              currentContentsPage = page;
              
              // 서브탭 활성화
              const contentsSubTabs = document.querySelectorAll('.contents-sub-tab');
              contentsSubTabs.forEach(tab => {
                tab.classList.remove('active');
                if (tab.dataset.contentType === contentType) {
                  tab.classList.add('active');
                }
              });
              
              // 직업 필터 활성화
              const jobFilterButtons = document.querySelectorAll('#contents-ranking-job-filters .ranking-filter-btn');
              jobFilterButtons.forEach(btn => {
                btn.classList.remove('active');
                if (btn.getAttribute('data-value') === job) {
                  btn.classList.add('active');
                }
              });
              
              // 서버 필터 탭 활성화
              const serverTabButtons = document.querySelectorAll('.contents-server-tab');
              serverTabButtons.forEach(btn => {
                btn.classList.remove('active');
                btn.style.background = 'rgba(255, 255, 255, 0.05)';
                btn.style.borderColor = 'var(--card-border)';
                btn.style.color = 'var(--text-primary)';
                if (btn.getAttribute('data-race') === race) {
                  btn.classList.add('active');
                  btn.style.background = 'rgba(157, 140, 255, 0.16)';
                  btn.style.borderColor = 'rgba(157, 140, 255, 0.9)';
                  btn.style.color = 'var(--accent)';
                }
              });
              
              // 서버 필터 업데이트
              if (typeof updateContentsServerFilters === 'function') {
                updateContentsServerFilters(race);
              }
              
              // 서버 필터 버튼 활성화
              setTimeout(() => {
                const serverFilterContainer = document.getElementById('contents-ranking-server-filters');
                if (serverFilterContainer) {
                  const serverBtn = serverFilterContainer.querySelector(`[data-value="${server}"]`);
                  if (serverBtn) {
                    serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
                    serverBtn.classList.add('active');
                  }
                }
              }, 100);
              
              // 이벤트 리스너 설정 및 데이터 로드
              if (typeof setupContentsRankingEventListeners === 'function') {
                setupContentsRankingEventListeners();
              }
              
              if (typeof loadContentsRanking === 'function') {
                loadContentsRanking(page);
              }
            }, 100);
          }
        }, 300);
      }
      return;
    }
    
    // 레기온은 별도 메인 탭(/region)으로 분리됨 → 레기온 탭 활성화
    if (params.length > 0 && params[0] === 'region') {
      const regionTab = document.getElementById('tab-region');
      if (regionTab) {
        regionTab.checked = true;
        regionTab.dispatchEvent(new Event('change'));
      }
      return;
    }
    
    const job = params[0] && params[0] !== '천족' && params[0] !== '마족' ? params[0] : 'all';
    let race = 'all';
    let server = 'all';
    
    if (params.length > 0) {
      if (params[0] === '천족' || params[0] === '마족' || params[0] === '天族' || params[0] === '魔族') {
        race = (params[0] === '천족' || params[0] === '天族') ? 'elyos' : 'asmodian';
        server = params[1] || 'all';
      } else if (params[1] === '천족' || params[1] === '마족' || params[1] === '天族' || params[1] === '魔族') {
        race = (params[1] === '천족' || params[1] === '天族') ? 'elyos' : 'asmodian';
        server = params[2] || 'all';
      } else if (params[1]) {
        server = params[1];
      }
    }
    
    // 랭킹 탭 활성화 및 필터 적용
    const rankingTab = document.getElementById('tab-ranking');
    if (rankingTab) {
      rankingTab.checked = true;
      rankingTab.dispatchEvent(new Event('change'));
      
      // 필터 적용 (약간의 지연 필요)
      setTimeout(() => {
        if (job !== 'all') {
          const jobBtn = document.querySelector(`#ranking-job-filters .ranking-filter-btn[data-value="${job}"]`);
          if (jobBtn) jobBtn.click();
        }
        if (race !== 'all') {
          const raceBtn = document.querySelector(`.ranking-server-tab-btn[data-race="${race}"]`);
          if (raceBtn) raceBtn.click();
        }
        if (server !== 'all') {
          setTimeout(() => {
            const serverBtn = document.querySelector(`#ranking-server-filters .ranking-filter-btn[data-value="${server}"]`);
            if (serverBtn) serverBtn.click();
          }, 100);
        }
      }, 200);
    }
  }
  
  // 통계 탭
  if (tab === 'statistics') {
    const subtab = params[0] || 'jobstats';
    const statisticsTab = document.getElementById('tab-statistics');
    if (statisticsTab) {
      statisticsTab.checked = true;
      statisticsTab.dispatchEvent(new Event('change'));
      
      setTimeout(() => {
        let targetSelector;
        if (subtab === 'skillstat') {
          targetSelector = 'skill-statistics';
        } else if (subtab === 'itemstats') {
          targetSelector = 'item-statistics';
        } else {
          targetSelector = 'job-statistics';
        }
        const targetBtn = document.querySelector(`.statistics-sub-tab-btn[data-target="${targetSelector}"]`);
        if (targetBtn) targetBtn.click();
      }, 200);
    }
  }
  
  // 티어 탭
  if (tab === 'tier') {
    // 티어 탭은 별도 페이지이므로 여기서는 처리하지 않음
  }
  
  // 서버 비교 탭
  if (tab === 'server-comparison') {
    // 서버 비교 탭은 별도 페이지이므로 여기서는 처리하지 않음
  }
  
  // 캐릭터 검색
  if (tab === 'char') {
    // 캐릭터 검색은 별도 라우트로 처리
  }
}

// 서버 목록 데이터
const serverDataEl = document.getElementById('server-data');
const servers = serverDataEl ? JSON.parse(serverDataEl.textContent) : { elyos: [], asmodian: [] };

function findServerByName(arr, name) {
  if (!arr || !name) return null;
  return arr.find(s => s.name === name || s.ko_name === name) || null;
}

/** href가 /?nickname=… 또는 /zh-tw/?nickname=… 같이 locale prefix를 가질 수 있음 */
function parseNicknameQueryFromHref(href) {
  if (!href) return null;
  try {
    const u = new URL(href, window.location.origin);
    const nickname = u.searchParams.get('nickname');
    const race = u.searchParams.get('race');
    const serverId = u.searchParams.get('server');
    if (nickname && race && serverId) return { nickname, race, serverId };
  } catch (e) { /* ignore */ }
  return null;
}
const ncApiConfigEl = document.getElementById('nc-api-config');
const ncApiConfig = ncApiConfigEl ? JSON.parse(ncApiConfigEl.textContent) : {};
const NC_API_DISABLED = Boolean(ncApiConfig.disabled);
const TA = (k, d) => { const x = (window.__I18N || {})[k]; return (x !== undefined && x !== '') ? x : d; };
const JOB_LABEL_I18N = {
  '검성': 'job.gladiator',
  '수호성': 'job.templar',
  '궁성': 'job.ranger',
  '살성': 'job.assassin',
  '마도성': 'job.sorcerer',
  '정령성': 'job.spiritmaster',
  '치유성': 'job.cleric',
  '호법성': 'job.chanter',
  '권성': 'job.fighter'
};
function displayJobLabel(ko) {
  const key = JOB_LABEL_I18N[ko];
  return key ? TA(key, ko) : ko;
}
function displayRaceLabel(name) {
  if (name === '천족' || name === '天族') return TA('race.elyos', '천족');
  if (name === '마족' || name === '魔族') return TA('race.asmodian', '마족');
  return name;
}
/** API 직업명이 zh-tw 등으로 올 때 스킬 통계 data-job(한글)과 맞추기 */
function canonicalKoJobFromApiJob(job) {
  if (!job) return '';
  if (JOB_LABEL_I18N[job]) return job;
  for (const ko of Object.keys(JOB_LABEL_I18N)) {
    const tid = JOB_LABEL_I18N[ko];
    if (TA(tid, ko) === job) return ko;
  }
  return job;
}
function displayBreakthroughStatLabel(name) {
  if (!name) return name;
  const m = {
    '공격력': 'stat.breakthrough.atk',
    '방어력': 'stat.breakthrough.def',
    '생명력': 'stat.breakthrough.hp',
    '공격력 %': 'stat.breakthrough.atk_pct'
  };
  const key = m[name];
  return key ? TA(key, name) : name;
}
/** 장비·마석·API 스탯명 표시용 (내부 식별/저장은 한글 유지) */
function localizeEquipStatName(name) {
  if (!name || typeof name !== 'string') return name || '';
  const t = name.trim();
  const map = {
    '공격력': 'stat.breakthrough.atk',
    '방어력': 'stat.breakthrough.def',
    '생명력': 'stat.breakthrough.hp',
    '공격력 %': 'stat.breakthrough.atk_pct',
    '치명타': 'stat.modal.critical',
    '무기 피해 증폭': 'stat.modal.weapon_damage_amp',
    '피해 증폭': 'stat.modal.damage_amp',
    '치명타 피해 증폭': 'stat.modal.crit_damage_amp',
    '전투 속도': 'stat.modal.combat_speed',
    '다단 히트 적중': 'stat.modal.multi_hit',
    '명중': 'stat.modal.accuracy_stat',
    '추가 명중': 'stat.modal.bonus_accuracy',
    '위력': 'stat.str',
    '정확': 'stat.agi',
    '강타': 'stat.modal.stun_hit',
    '상태이상 적중': 'stat.modal.abnormal_hit',
    '충격계 적중': 'stat.modal.shock_hit',
    '공격력 증가': 'stat.equip.atk_increase',
    '방어력 %': 'stat.breakthrough.def_pct',
    '추가 공격력': 'stat.modal.bonus_atk',
    '추가 방어력': 'stat.modal.bonus_def',
    'PVE 피해 증폭': 'stat.modal.pve_damage_amp',
    '보스 피해 증폭': 'stat.modal.boss_damage_amp',
    '후방 피해 증폭': 'stat.modal.rear_damage_amp',
    '이동 속도': 'stat.modal.move_speed',
    '재시전 시간 감소': 'stat.modal.cooldown_reduction',
    '정신력': 'stat.modal.mental',
    '완벽': 'stat.modal.perfect',
    '철벽': 'stat.modal.fortress',
    'PVE 공격력': 'stat.modal.pve_atk',
    'PVE 명중': 'stat.modal.pve_acc',
    '보스 공격력': 'stat.modal.boss_atk'
  };
  const key = map[t];
  if (key) return TA(key, t);
  return displayBreakthroughStatLabel(t);
}
function formatRankPlace(n) {
  return TA('rank.place_format', '{n}위').replace(/\{n\}/g, String(n));
}
function formatPointsNum(n) {
  return TA('rank.points_format', '{n}점').replace(/\{n\}/g, Number(n).toLocaleString());
}
const NC_API_DISABLED_MESSAGE = ncApiConfig.message || TA('search.api_delayed', '검색이 지연되고 있습니다, 잠시 후 다시 시도해주세요');
const NC_API_DISABLED_DELAY_MS = Number(ncApiConfig.delay_ms) || 2000;
const NORMAL_STAT_CAP = Infinity; // 일반 스탯(위력/민첩/지식/체력/정확/의지) 최대 제한 해제 (구 250 캡 삭제)
const siteLocaleEl = document.getElementById('site-locale-data');
const siteLocaleData = siteLocaleEl ? JSON.parse(siteLocaleEl.textContent) : {};
const SITE_LOCALE = siteLocaleData.locale || 'ko';
const SITE_URL_PREFIX = siteLocaleData.url_prefix || '';
const IS_TW = SITE_LOCALE === 'zh-tw';
const IS_GLOBAL = !!siteLocaleData.is_global;   // 글로벌(/global) — KR 결과 화면 재사용, 표시는 partials/global_ui.html 이 영어화
// localStorage 데이터 캐시 키 리전 접미사 (같은 도메인이라 KR/TW/글로벌이 키를 공유하면 다른 리전 데이터가 뜬다). KR 은 기존 키 그대로.
const SITE_STORE_SUFFIX = IS_GLOBAL ? '_gl' : (IS_TW ? '_tw' : '');

function pathWithoutSitePrefix(pathname) {
  const p = SITE_URL_PREFIX || '';
  if (p && pathname.startsWith(p)) {
    const rest = pathname.slice(p.length);
    return rest || '/';
  }
  return pathname;
}
const SKILL_ICON_PLACEHOLDER = 'https://via.placeholder.com/40x40/1f2335/ffffff?text=%20';

function _t(ko, zhTw) {
  return IS_TW ? zhTw : ko;
}

function showNcApiDelayedPopup(options = {}) {
  const {
    keyword = '',
    serverId = '',
    race = '',
    activateCharacterTab = false
  } = options;

  if (activateCharacterTab) {
    const characterTab = document.getElementById('tab-character');
    if (characterTab) {
      characterTab.checked = true;
      characterTab.dispatchEvent(new Event('change'));
      if (typeof updateSidebarVisibility === 'function') {
        updateSidebarVisibility();
      }
    }
  }

  if (race && typeof updateRaceSelection === 'function') {
    updateRaceSelection(String(race), true);
  }

  const serverSelect = document.getElementById('server-select');
  const keywordInput = document.getElementById('character-keyword');
  if (serverSelect && serverId) serverSelect.value = String(serverId);
  if (keywordInput && keyword) keywordInput.value = keyword;

  const characterResult = document.getElementById('character-result');
  const allServersResult = document.getElementById('character-all-servers-result');
  const characterError = document.getElementById('character-error');
  const characterLoading = document.getElementById('character-loading');
  const searchButton = document.getElementById('search-button');

  if (characterResult) characterResult.style.display = 'none';
  if (allServersResult) allServersResult.style.display = 'none';
  if (characterError) characterError.style.display = 'none';
  if (characterLoading) characterLoading.style.display = 'block';
  if (searchButton) searchButton.disabled = true;
  lockLoadingOverlay();

  if (window.ncApiDisabledPopupTimer) {
    clearTimeout(window.ncApiDisabledPopupTimer);
  }

  window.ncApiDisabledPopupTimer = setTimeout(() => {
    if (characterLoading) characterLoading.style.display = 'none';
    if (searchButton) searchButton.disabled = false;
    unlockLoadingOverlay();
    alert(NC_API_DISABLED_MESSAGE);
    window.ncApiDisabledPopupTimer = null;
  }, NC_API_DISABLED_DELAY_MS);
}

// NEW META 제외 스킬 리스트 (PVP 전용 등)
const NEW_META_EXCLUDE_SKILLS = [
  '그림자 보행', '은신', '빙설의 갑주'
];

// NEW META 판정 함수: 4순위 밖 (index >= 4) + usage_rates[2] (15렙 이상 채용률) > 10% + 제외 리스트에 없음
// usageRate15 파라미터: usage_rates[2] 값 (0~1 사이 값, 0.1 = 10%)
function isNewMetaSkill(skillName, rankIndex, usageRate15) {
  if (NEW_META_EXCLUDE_SKILLS.includes(skillName)) return false;
  if (rankIndex < 4) return false;  // 1~4순위는 이미 메타
  if ((usageRate15 || 0) < 0.1) return false;  // 15렙 이상 채용률 10% 미만은 제외
  return true;
}
const STAT_SUBTAB_DESCRIPTIONS = {
  'job-statistics': document.getElementById('job-stat-desc'),
  'skill-statistics': document.getElementById('skill-stat-desc'),
  'arcana-statistics': document.getElementById('arcana-stat-desc'),
  'server-statistics': document.getElementById('server-stat-desc'),
  'combat-power-statistics': document.getElementById('cp-stat-desc'),
  'item-statistics': null // 아이템 통계는 설명이 없음
};

const STAT_MIN_GAP = 1;
// 아이템 레벨 구간 스냅 포인트 (캐시 효율성을 위해 특정 구간으로만 제한)
const POWER_SNAP_POINTS = [0, 3000, 3200, 3400, 3600, 3800, 4000, 5000, 6000];
const POWER_SNAP_LABELS = ['0', '3000', '3200', '3400', '3600', '3800', '4000', '5000', '6000'];

// 전투력(combat_power2) 구간 스냅 포인트
const CP2_SNAP_POINTS = [0, 200000, 300000, 400000, 500000, 600000, 700000, 800000];
const CP2_SNAP_LABELS = ['0', '200k', '300k', '400k', '500k', '600k', '700k', '800k'];

function snapIndexToValue(idx) {
  idx = Math.max(0, Math.min(idx, POWER_SNAP_POINTS.length - 1));
  return POWER_SNAP_POINTS[idx];
}

function cp2SnapIndexToValue(idx) {
  idx = Math.max(0, Math.min(idx, CP2_SNAP_POINTS.length - 1));
  return CP2_SNAP_POINTS[idx];
}

function valueToSnapIndex(value) {
  let bestIdx = 0;
  let bestDiff = Math.abs(value - POWER_SNAP_POINTS[0]);
  for (let i = 1; i < POWER_SNAP_POINTS.length; i++) {
    const diff = Math.abs(value - POWER_SNAP_POINTS[i]);
    if (diff < bestDiff) {
      bestDiff = diff;
      bestIdx = i;
    }
  }
  return bestIdx;
}

function cp2ValueToSnapIndex(value) {
  let bestIdx = 0;
  let bestDiff = Math.abs(value - CP2_SNAP_POINTS[0]);
  for (let i = 1; i < CP2_SNAP_POINTS.length; i++) {
    const diff = Math.abs(value - CP2_SNAP_POINTS[i]);
    if (diff < bestDiff) {
      bestDiff = diff;
      bestIdx = i;
    }
  }
  return bestIdx;
}

function snapToPowerPoint(value) {
  return snapIndexToValue(valueToSnapIndex(value));
}

