    <script>window.__I18N = {"arcana.effect.frenzy_2": "PVE \uacf5\uaca9\ub825 50 \uc99d\uac00", "arcana.effect.frenzy_4": "\ubcf4\uc2a4 \ud53c\ud574 \uc99d\ud3ed 5%, \uc0dd\uba85\ub825\uc774 70% \uc774\ud558\uc77c \ub54c \ubcf4\uc2a4 \ud53c\ud574 \ub0b4\uc131 10% \uc99d\uac00", "arcana.effect.guardian_2": "\uc7ac\uc0dd 5% \uc99d\uac00", "arcana.effect.guardian_4": "\ubb34\uae30 \ud53c\ud574 \uc99d\ud3ed 5% \uc99d\uac00, \uc0dd\uba85\ub825\uc774 30% \uc774\ud558\uc77c \ub54c 5\ucd08 \ub3d9\uc548 10000\ub9cc\ud07c\uc758 \ud53c\ud574\ub97c \ub9c9\uc544\ub0b4\ub294 \ubcf4\ud638\ub9c9 \uc0dd\uc131 [\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04 2\ubd84]", "arcana.effect.indomitable_2": "\ubb34\uae30 \ud53c\ud574 \ub0b4\uc131 5% \uc99d\uac00", "arcana.effect.indomitable_4": "\uce58\uba85\ud0c0 \ud53c\ud574 \ub0b4\uc131 5% \uc99d\uac00, \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 PVP \ud53c\ud574 \ub0b4\uc131 50% \uc99d\uac00 [\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04 2\ubd84 30\ucd08]", "arcana.effect.magic_2": "\uc815\uc2e0\ub825\uc774 20% \uc774\ud558\ub85c \uac10\uc18c\ud560 \uacbd\uc6b0, 1500\uc758 \uc815\uc2e0\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5 [\uc7ac\uc0ac\uc6a9 \uc2dc\uac04 30\ucd08]", "arcana.effect.magic_4": "\uc815\uc2e0\ub825\uc774 50%\uc774\uc0c1\uc77c \ub54c, PVE \ubc29\uc5b4\ub825 1000 \uc99d\uac00", "arcana.effect.punishment_2": "\ubcf4\uc2a4 \ud53c\ud574 \ub0b4\uc131 5% \uc99d\uac00", "arcana.effect.punishment_4": "PVE \uacf5\uaca9\ub825 60 \uc99d\uac00, \uc0dd\uba85\ub825\uc774 70% \uc774\uc0c1\uc77c \ub54c PVE \ud53c\ud574 \uc99d\ud3ed 10% \uc99d\uac00", "arcana.effect.purity_2": "PVE \ubc29\uc5b4\ub825 500 \uc99d\uac00", "arcana.effect.purity_4": "\uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed 5%, \uc0dd\uba85\ub825\uc774 70% \uc774\ud558\uc77c \ub54c \ubc29\uc5b4\ub825 1000 \uc99d\uac00", "arcana.effect.vitality_2": "\uc0dd\uba85\ub825\uc774 70%\uc774\uc0c1\uc77c \ub54c, PVE \uacf5\uaca9\ub825 60\ub9cc\ud07c \uc99d\uac00", "arcana.effect.vitality_4": "\uc0dd\uba85\ub825\uc774 70%\uc774\uc0c1\uc77c \ub54c, PVE \uacf5\uaca9\ub825 150\ub9cc\ud07c \uc99d\uac00", "arcana.item.bell": "\uc885", "arcana.item.chalice": "\uc131\ubc30", "arcana.item.compass": "\ub098\uce68\ubc18", "arcana.item.mirror": "\uac70\uc6b8", "arcana.item.scale": "\ucc9c\uce6d", "arcana.item.scroll": "\uc591\ud53c\uc9c0", "arcana.set.frenzy": "\uad11\ubd84", "arcana.set.guardian": "\uc218\ud638", "arcana.set.indomitable": "\ubd88\uad74", "arcana.set.magic": "\ub9c8\ub825", "arcana.set.punishment": "\uc9d5\ubc8c", "arcana.set.purity": "\uc21c\uc218", "arcana.set.vitality": "\ud65c\ub825", "arcana.set_effect_title": "{count} \uc138\ud2b8 \ud6a8\uacfc [{name}]", "atool_update.43.desc": "\uc804\ud22c\ub825 \uc0c1\uc704n%\uc5d0 \ub530\ub978 \ud2f0\uc5b4 \uc2dc\uc2a4\ud15c\uc774 \ucd94\uac00 \ub418\uc5c8\uc2b5\ub2c8\ub2e4", "atool_update.43.title": "\uc804\ud22c\ub825 \ud2f0\uc5b4 \uc2dc\uc2a4\ud15c \ucd94\uac00", "atool_update.44.desc1": "\uc2dc\uc98c3 2\ucc28 \uc11c\ubc84 \ub9e4\uce6d\uc774 \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4 (\ud648 \ud654\uba74 \uc11c\ubc84 \uc815\ubcf4, \uc544\ud2f0\ud329\ud2b8 \uc810\ub839\uc804, \uc11c\ubc84 \uc6b0\uc138 \ud604\ud669). \uc810\ub839\uc804 \uc2dc\uac04\uc774 \ub9e4\uc8fc \uc218/\ud1a0 \uc624\ud6c4 10\uc2dc\ub85c \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.44.desc2": "\uacf5\uaca9\ub825 % \ucea1\uc774 100% \u2192 120%\ub85c \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4", "atool_update.44.title": "\uc2dc\uc98c3 \uc11c\ubc84 \ub9e4\uce6d \u0026 \uacf5%\ucea1 \uc5c5\ub370\uc774\ud2b8", "atool_update.45.desc1": "\uacf5\uaca9\ub825 % \ucea1 \ubaa8\ub2ec\uc5d0 \ub370\ubc14\ub2c8\uc628 - \uc720\uc2a4\ud2f0\uc5d8 \ubcf4\ub4dc\uc758 \uacf5\uaca9\ub825 \uc99d\uac00 % \ud569\uc0b0\uc774 \ud45c\uc2dc\ub418\ub3c4\ub85d \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.45.title": "\uc2dc\uc98c3 2\ucc28 \ub9e4\uce6d \ucd94\uac00 \ubc0f \uac80\uc0c9 \uac1c\uc120", "atool_update.46.desc1": "\uc2dc\uc98c3 3\ucc28 \uc11c\ubc84 \ub9e4\uce6d\uc774 \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.46.desc2": "\uc219\uc81c\ud0ed \uad00\ub828 \uc0ac\uc18c\ud55c \ubc84\uadf8\uac00 \uc218\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.46.title": "\uc2dc\uc98c3 3\ucc28 \uc11c\ubc84 \ub9e4\uce6d \uc5c5\ub370\uc774\ud2b8", "atool_update.47.desc1": "\uc77c\ubc18 \uc2a4\ud0ef(\uc704\ub825/\ubbfc\ucca9/\uc9c0\uc2dd/\uccb4\ub825/\uc815\ud655/\uc758\uc9c0) \ucd5c\ub300 \ud68d\ub4dd\uac12\uc774 200 \u2192 250\uc73c\ub85c \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.47.desc2": "\uacf5\uaca9\ub825 % \ucea1(\uacf5%\ucea1) \ucd5c\ub300\uac12\uc774 120% \u2192 130%\ub85c \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.47.desc3": "\uc2e0\uaddc \ubd80\uc704 \"\ube0c\ub85c\uce58\"\uac00 \uce90\ub9ad\ud130 \uac80\uc0c9 \uacb0\uacfc \uc7a5\uc2e0\uad6c \uc601\uc5ed\uc5d0 \ud45c\uc2dc\ub418\ub3c4\ub85d \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.47.title": "\uc2a4\ud0ef\u00b7\uacf5%\ucea1 \uc0c1\ud5a5 \u0026 \ube0c\ub85c\uce58 \ud45c\uc2dc \ubc18\uc601", "atool_update.48.desc1": "\ud1b5\uacc4 \ud398\uc774\uc9c0\uc5d0 \u300c\uc11c\ubc84 \ud1b5\uacc4\u300d \ud0ed\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \ucd5c\uadfc 30\uc77c \ub0b4 \uac80\uc0c9\ub41c \uce90\ub9ad\ud130 \uc911 \uc11c\ubc84\ubcc4 \uc804\ud22c\ub825 \uc0c1\uc704 20% \uae30\uc900 boxplot\uc73c\ub85c \uc11c\ubc84\ub97c \ube44\uad50\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "atool_update.48.desc2": "\uc9c1\uc5c5 \ud1b5\uacc4 \uc544\uc774\ud15c \ub808\ubca8\u00b7\uc804\ud22c\ub825 \uc2ac\ub77c\uc774\ub354 \ucd5c\ub300\uac12\uc744 6,000 / 800k\ub85c \ud655\uc7a5\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.48.title": "\ud1b5\uacc4 - \uc11c\ubc84 \ud1b5\uacc4 \ucd94\uac00", "atool_update.49.desc1": "\ud1b5\uacc4 \ud398\uc774\uc9c0\uc5d0 \u300c\uc804\ud22c\ub825 \ud1b5\uacc4\u300d \ud0ed\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \ucd5c\uadfc 30\uc77c \ud65c\uc131 \uce90\ub9ad\ud130 \uc911 \uac01 \uc9c1\uc5c5\uc758 \uc804\ud22c\ub825 \uc0c1\uc704 20%\ub97c \uae30\uc900\uc73c\ub85c, \uc544\uc774\ud15c \ub808\ubca8 \uad6c\uac04\ubcc4 \uc804\ud22c\ub825 \ubd84\ud3ec(\uc911\uc559\uac12\u00b7\uc911\uac04 \ubc94\uc704\u00b7\uc804\uccb4 \ubc94\uc704)\ub97c \ub77c\uc778 \ucc28\ud2b8\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "atool_update.49.desc2": "\ud1b5\uacc4 \ud0ed\uc5d0 \ub4e4\uc5b4\uc624\uba74 \u300c\uc804\ud22c\ub825 \ud1b5\uacc4\u300d\uac00 \uae30\ubcf8\uc73c\ub85c \ud45c\uc2dc\ub418\ub3c4\ub85d \ubcc0\uacbd\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.49.title": "\ud1b5\uacc4 - \uc804\ud22c\ub825 \ud1b5\uacc4 \ucd94\uac00", "atool_update.50.desc1": "\uc2dc\uc98c3 4\ucc28 \uc11c\ubc84 \ub9e4\uce6d\uc774 \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4 (\ud648 \ud654\uba74 \uc11c\ubc84 \uc815\ubcf4, \uc544\ud2f0\ud329\ud2b8 \uc810\ub839\uc804, \uc11c\ubc84 \uc6b0\uc138 \ud604\ud669).", "atool_update.50.title": "\uc2dc\uc98c3 4\ucc28 \uc11c\ubc84 \ub9e4\uce6d \uc5c5\ub370\uc774\ud2b8", "atool_update.51.desc1": "\uc2dc\uc98c3 5\ucc28 \uc5b4\ube44\uc2a4 \uc11c\ubc84 \ub9e4\uce6d\uc774 \ubc18\uc601\ub418\uc5c8\uc2b5\ub2c8\ub2e4 (\ud648 \uc11c\ubc84 \uc815\ubcf4, \uc544\ud2f0\ud329\ud2b8 \uc810\ub839\uc804, \uc11c\ubc84 \uc6b0\uc138 \ud604\ud669).", "atool_update.51.title": "\uc2dc\uc98c3 5\ucc28 \uc5b4\ube44\uc2a4 \ub9e4\uce6d \uc5c5\ub370\uc774\ud2b8", "atool_update.52.desc1": "\u300c\ub808\uae30\uc628\u300d\uc744 \ubcc4\ub3c4 \uba54\uc778 \ud0ed\uc73c\ub85c \ubd84\ub9ac\ud558\uace0, \uae38\ub4dc \uc0c1\uc138\uc5d0 \u300c\ud0c0\uc784\ub77c\uc778\u300d(\uac80\uc0c9 \uae30\ubc18 \uac00\uc785/\ud0c8\ud1f4 \ub0b4\uc5ed, \uc778\uc6d0\u00b7\uc804\ud22c\ub825 \ubcc0\ud654 \ucd94\uc774)\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.52.desc2": "\ud1b5\uacc4 \ud0ed\uc5d0 \ub4e4\uc5b4\uc624\uba74 \u300c\uc778\uad6c\uc218 \ud1b5\uacc4\u300d\uac00 \uae30\ubcf8\uc73c\ub85c \ud45c\uc2dc\ub418\ub3c4\ub85d \ubcc0\uacbd\ud588\uc2b5\ub2c8\ub2e4.", "atool_update.52.title": "\ub808\uae30\uc628 \ud0ed \uc2e0\uc124 \u0026 \ud0c0\uc784\ub77c\uc778 \ucd94\uac00", "atool_update.53.desc1": "\u300c\uc9c1\uc5c5 \ubd84\uc11d/\ud1b5\uacc4\u300d\ub97c \uc804\ud22c\ub825 \uad6c\uac04\ubcc4\ub85c \uac1c\ud3b8\ud558\uace0, \uc9c1\uc5c5\uc744 \ud074\ub9ad\ud558\uba74 \ud074\ub798\uc2a4 \uc0c1\uc138(\uc885\ud569\u00b7\uc2a4\ud0ac\u00b7\uc7a5\ube44)\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd94\ucc9c \ub0a0\uac1c/\uc544\ub974\uce74\ub098 \uc14b\uc635/\uc804\ud22c\ub825 TOP5, \uc2a4\ud0ac\u00b7\uc7a5\ube44(\ubd80\uc704\ubcc4 \uc138\ud2b8) \ud1b5\uacc4\ub97c \ud55c \uacf3\uc5d0\uc11c \ud655\uc778\ud558\uc138\uc694.", "atool_update.53.desc2": "\ud1b5\uacc4 \ud0ed \uc9c4\uc785 \uc2dc \u300c\uc9c1\uc5c5 \ubd84\uc11d/\ud1b5\uacc4\u300d\uac00 \uae30\ubcf8\uc73c\ub85c \ud45c\uc2dc\ub418\uba70, \uae30\uc874 \uc2a4\ud0ac/\uc544\ub974\uce74\ub098 \ud1b5\uacc4\ub294 \ud074\ub798\uc2a4 \uc0c1\uc138\ub85c \ud1b5\ud569\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "atool_update.53.title": "\uc9c1\uc5c5 \ubd84\uc11d/\ud1b5\uacc4 \uac1c\ud3b8 \u0026 \ud074\ub798\uc2a4 \uc0c1\uc138 \ucd94\uac00", "atool_update.54.desc1": "\u300c\ube44\uad50\ud558\uae30\u300d \ud0ed\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \ub450 \uce90\ub9ad\ud130\uc758 \uae30\ubcf8 \uc815\ubcf4\u00b7\uc804\ud22c\uc2a4\ud0ef\u00b7\uc7a5\ube44/\uc7a5\uc2e0\uad6c\u00b7\ub370\ubc14\ub2c8\uc628\u00b7\uc544\ud234 \uc804\ud22c \uc810\uc218\ub97c \ub098\ub780\ud788 \ube44\uad50\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "atool_update.54.desc2": "\uc804\ud22c\uc2a4\ud0ef\u00b7\uc7a5\ube44 row\uc758 i \ubc84\ud2bc\uc73c\ub85c breakdown \ubc0f \uc601\ud63c\uac01\uc778/\ubd80\uc2a4\ud0ac \uc0c1\uc138 \ube44\uad50\ub3c4 \uac00\ub2a5\ud569\ub2c8\ub2e4.", "atool_update.54.title": "\ube44\uad50\ud558\uae30 \ud0ed \ucd94\uac00", "atool_update.55.desc1": "\u300c\uc9c1\uc5c5 \ubd84\uc11d/\ud1b5\uacc4\u300d \ud074\ub798\uc2a4 \uc0c1\uc138\uc5d0 PVP \uc138\ud305 \ud0ed\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. PVP \uc138\ud305 \uc0c1\uc704 \ub7ad\ucee4 \uae30\uc900 \uc601\ud63c/\ub9c8\uc11d \uac01\uc778 \ubd80\uc704\ubcc4 \uc0ac\uc6a9\ub960\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "atool_update.55.title": "\uc9c1\uc5c5 \uc0c1\uc138 PVP \uc138\ud305 \ucd94\uac00", "char.accessories_col": "\uc7a5\uc2e0\uad6c", "char.active_skill": "\uc561\ud2f0\ube0c \uc2a4\ud0ac", "char.arcana": "\uc544\ub974\uce74\ub098", "char.attack_power": "\uacf5\uaca9\ub825", "char.combat_power_top": "\uc804\ud22c\ub825 \uc0c1\uc704", "char.combat_score": "\uc544\ud234 \uc804\ud22c \uc810\uc218", "char.combat_score_desc": "PVE \ub51c \uc138\ud305 \uc810\uc218", "char.compare_with_mine": "\ub0b4 \uce90\ub9ad\ud130\ub791 \ube44\uad50 \u003e", "char.content_rankings_header": "\ucee8\ud150\uce20 \ub7ad\ud0b9 (\uc11c\ubc84)", "char.critical": "\uce58\uba85\ud0c0", "char.daevanion": "\ub370\ubc14\ub2c8\uc628", "char.daevanion_select": "\uc11c\ube0c\ud0ed\uc744 \uc120\ud0dd\ud558\uc5ec \ub370\ubc14\ub2c8\uc628 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc138\uc694.", "char.daevanion_summary": "\ub370\ubc14\ub2c8\uc628", "char.equipment": "\uc7a5\ube44/\uc7a5\uc2e0\uad6c", "char.equipment_col": "\uc7a5\ube44", "char.equipment_summary_title": "\uc7a5\ube44/\uc7a5\uc2e0\uad6c \uc694\uc57d", "char.equipment_view": "\uc7a5\ube44 \ud55c\ub208\uc5d0 \ubcf4\uae30", "char.god_stats": "\uc8fc\uc2e0 \uc2a4\ud0ef", "char.god_stats_total": "\ucd1d\ud569", "char.grade_a": "A \ub4f1\uae09", "char.grade_a_desc": "S\ub9cc\ud07c \ud06c\uc9c4 \uc54a\uc9c0\ub9cc \ub51c\uc5d0 \ub9ce\uc740 \uc601\ud5a5\uc744 \uc8fc\ub294 \uc635\uc158\ub4e4", "char.grade_b": "B \ub4f1\uae09", "char.grade_b_desc": "PVE\uc5d0\uc11c \ub51c\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uac70\ub098, \uc904 \uc218\ub3c4 \uc788\uc9c0\ub9cc A\ub9cc\ud07c\uc740 \ud06c\uc9c0 \uc54a\uc740 \uc635\uc158\ub4e4", "char.grade_s": "S 