                    <div style="text-align: center; min-width: 120px;">
                      <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.5px;">현재 전투력</div>
                      <div id="sim-original-combat-score" style="font-size: 1.75rem; font-weight: 700; color: var(--accent); text-shadow: 0 0 20px rgba(157, 140, 255, 0.3);">-</div>
                    </div>
                    <div style="font-size: 1.25rem; color: rgba(157, 140, 255, 0.5);">→</div>
                    <div style="text-align: center; min-width: 120px;">
                      <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.5px;">시뮬레이션 전투력</div>
                      <div id="sim-new-combat-score" style="font-size: 1.75rem; font-weight: 700; color: #4ade80; text-shadow: 0 0 20px rgba(74, 222, 128, 0.3);">-</div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                      <button id="sim-recalculate-btn" onclick="recalculateSimulationCombatScore()" style="padding: 0.6rem 1.25rem; background: rgba(124, 108, 224, 0.15); color: #9d8cff; border: 1.5px solid rgba(157, 140, 255, 0.4); border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.4rem;" onmouseover="this.style.background='rgba(124, 108, 224, 0.25)'; this.style.borderColor='rgba(157, 140, 255, 0.6)';" onmouseout="this.style.background='rgba(124, 108, 224, 0.15)'; this.style.borderColor='rgba(157, 140, 255, 0.4)';">
                        <span style="font-size: 0.9rem;">⚡</span> 계산
                      </button>
                      <button id="sim-reset-btn" onclick="resetSimulationToOriginal()" style="padding: 0.6rem 1.25rem; background: rgba(248, 113, 113, 0.1); color: #f87171; border: 1.5px solid rgba(248, 113, 113, 0.3); border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.4rem;" onmouseover="this.style.background='rgba(248, 113, 113, 0.2)'; this.style.borderColor='rgba(248, 113, 113, 0.5)';" onmouseout="this.style.background='rgba(248, 113, 113, 0.1)'; this.style.borderColor='rgba(248, 113, 113, 0.3)';">
                        <span style="font-size: 0.9rem;">↩️</span> 원래대로
                      </button>
                    </div>
                  </div>
                  <div id="sim-score-diff" style="text-align: center; margin-top: 0.75rem; font-size: 0.9rem; color: var(--text-muted); font-weight: 500;"></div>
                </div>
                
                <!-- 변경 사항 요약 (재계산 후 표시) -->
                <div id="sim-changes-summary" style="display: none; margin-bottom: 1.5rem; padding: 1rem; background: rgba(30, 30, 50, 0.6); border: 1px solid var(--border); border-radius: 12px; max-height: 300px; overflow-y: auto;"></div>
                
                <!-- 계산 과정 로그 -->
                <div id="sim-calc-log" style="display: none; margin-top: 1.5rem; padding: 1rem 1.25rem; background: rgba(30, 30, 50, 0.6); border: 1px solid var(--border); border-radius: 12px; max-height: 400px; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace;"></div>
                
                <!-- 무기 시뮬레이션 섹션 -->
                <div class="simulation-weapon-section" style="margin-bottom: 1.5rem;">
                  <div class="skill-category-card">
                    <div class="skill-category-header">무기 시뮬레이션</div>
                    <div id="sim-weapon-container" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 0.75rem;"></div>
                  </div>
                </div>
                
                <!-- 장비/장신구 시뮬레이션 섹션 -->
                <div class="simulation-equipment-section" style="margin-bottom: 1.5rem;">
                  <div class="skill-category-card">
                    <div class="skill-category-header" style="display: flex; align-items: center; gap: 0.5rem;">
                      방어구/장신구 시뮬레이션
                      <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">클릭하여 각인/돌파 변경</span>
                    </div>
                    <!-- 2컬럼 레이아웃 -->
                    <div id="sim-equipment-two-column" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 0.75rem;">
                      <!-- 왼쪽 컬럼: 장비 (무기 제외) -->
                      <div id="sim-equipment-column">
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 500;">장비</div>
                        <div id="sim-equipment-container" style="display: flex; flex-direction: column; gap: 0.25rem;">
                          <!-- 장비 아이템들이 여기에 동적으로 추가됨 -->
                        </div>
                      </div>
                      
                      <!-- 오른쪽 컬럼: 장신구 -->
                      <div id="sim-accessories-column">
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 500;">장신구</div>
                        <div id="sim-accessories-container" style="display: flex; flex-direction: column; gap: 0.25rem;">
                          <!-- 장신구 아이템들이 여기에 동적으로 추가됨 -->
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <!-- 주신 스탯 / 일반 스탯 시뮬레이션 비활성화 (CP 효율 값 미확정) -->
                <div id="sim-stats-container" style="display:none;"></div>
                <div id="sim-normal-stats-container" style="display:none;"></div>
                
                <!-- ================================================
                     스킬 시뮬레이션 섹션 (일시적으로 비활성화)
                     나중에 활성화하려면 이 주석 블록을 제거하세요
                     ================================================ -->
