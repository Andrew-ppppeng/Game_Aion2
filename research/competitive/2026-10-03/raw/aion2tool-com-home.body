// 무기 시뮬레이션 카드 새로고침
function refreshSimWeaponCards() {
  const container = document.getElementById('sim-weapon-container');
  if (!container) return;
  container.innerHTML = '';
  
  const equipment = window.currentEquipment || [];
  const mainWeapon = equipment[0];
  let subWeapon = equipment.find(item => item && isGuarderItem(item));
  if (!subWeapon && equipment.length > 1 && equipment[1]) {
    subWeapon = equipment[1];
  }
  
  // 메인 무기 카드
  if (mainWeapon) {
    const mainCard = createSimulationWeaponCard('main', mainWeapon);
    container.appendChild(mainCard);
  }
  
  // 서브 무기(가더) 카드
  if (subWeapon) {
    const subCard = createSimulationWeaponCard('sub', subWeapon);
    container.appendChild(subCard);
  }
}

// ================================================
// 장비/장신구 시뮬레이션 함수들
// ================================================

// 장비/장신구별 영혼 각인 옵션 데이터
// 부위별 특수 옵션:
// - 흉갑: 피해 증폭 (S급, 기본 10.5%, 최대 15%)
// - 견갑: 치명타 피해 증폭 (S급, 기본 12.4%, 최대 16%)
// - 장갑: 전투 속도 (S급, 기본 7%, 최대 14%)
// - 부위별 공격력/치명타: A등급, 기본값과 최대값은 부위마다 다름
// 시뮬레이션 default max 최대값값
const SIM_EQUIPMENT_SOUL_OPTIONS = {
  // 부위별 공격력/치명타 최대값 (기본값은 최대값의 약 60-70%)
  statsByPart: {
    // 방어구
