<script>
// 내실 랭킹 관련 변수 (전역 스코프)
// 중복 선언 방지: 이미 선언되었는지 확인
if (typeof currentInternalRankingType === 'undefined') {
  var currentInternalRankingType = 'title'; // 'title', 'stigma', 'total_stat'
}
if (typeof currentInternalJobFilter === 'undefined') {
  var currentInternalJobFilter = 'all';
}
if (typeof currentInternalServerFilter === 'undefined') {
  var currentInternalServerFilter = 'all';
}
if (typeof currentInternalServerRaceFilter === 'undefined') {
  var currentInternalServerRaceFilter = 'all';
}
if (typeof currentInternalPage === 'undefined') {
  var currentInternalPage = 1;
}

// 내실 랭킹 무한 스크롤 상태
var internalRankingInfiniteScroll = {
  currentPage: 1,
  isLoading: false,
  hasMore: true,
  totalCount: 0,
  loadedCount: 0
};
var internalRankingDataCache = {};
var INTERNAL_RANKING_CACHE_DURATION = 5 * 60 * 1000; // 5분

// 내실 랭킹 필터 초기화
function initializeInternalRankingFilters() {
  // 중복 호출 방지
  if (window.internalRankingFiltersInitializing) {
    return;
  }
  window.internalRankingFiltersInitializing = true;
  
  // active_farming_type이 설정되어 있으면 그 값을 사용, 없으면 'title' 기본값
  
  currentInternalRankingType = 'title';
  
  currentInternalJobFilter = 'all';
  currentInternalServerFilter = 'all';
  currentInternalServerRaceFilter = 'all';
  currentInternalPage = 1;

  // 내실 랭킹 서브 탭 초기화 (현재 타입에 맞게 활성화)
  const internalSubTabs = document.querySelectorAll('.internal-sub-tab');
  internalSubTabs.forEach(tab => {
    tab.classList.remove('active');
    if (tab.dataset.internalType === currentInternalRankingType) {
      tab.classList.add('active');
    }
  });
  
  window.internalRankingFiltersInitializing = false;

  // 직업 필터 초기화
  const jobFilterButtons = document.querySelectorAll('#internal-ranking-job-filters .ranking-filter-btn');
  jobFilterButtons.forEach(btn => {
    btn.classList.remove('active');
    if (btn.getAttribute('data-value') === 'all') {
      btn.classList.add('active');
    }
  });

  // 서버 필터 탭 초기화
  const serverTabButtons = document.querySelectorAll('.internal-server-tab');
  serverTabButtons.forEach(btn => {
    btn.classList.remove('active');
    btn.style.background = 'rgba(255, 255, 255, 0.05)';
    btn.style.borderColor = 'var(--card-border)';
    btn.style.color = 'var(--text-primary)';
    if (btn.getAttribute('data-race') === 'all') {
      btn.classList.add('active');
      btn.style.background = 'rgba(157, 140, 255, 0.16)';
      btn.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      btn.style.color = 'var(--accent)';
    }
  });

  // 서버 필터 초기화
  if (typeof updateInternalServerFilters === 'function') {
    updateInternalServerFilters('all');
  }
  
  // 무한 스크롤 상태 초기화
  internalRankingInfiniteScroll.currentPage = 1;
  internalRankingInfiniteScroll.isLoading = false;
  internalRankingInfiniteScroll.hasMore = true;
  internalRankingInfiniteScroll.totalCount = 0;
  internalRankingInfiniteScroll.loadedCount = 0;
  internalRankingDataCache = {};
}

// 내실 랭킹 서버 필터 업데이트
function updateInternalServerFilters(race) {
  const serverFilterContainer = document.getElementById('internal-ranking-server-filters');
  if (!serverFilterContainer || !servers) return;
  
  const existingButtons = serverFilterContainer.querySelectorAll('.ranking-filter-btn:not([data-value="all"])');
  existingButtons.forEach(btn => btn.remove());
  
  if (race === 'all') {
    serverFilterContainer.style.display = 'none';
    return;
  }
  
  serverFilterContainer.style.display = 'flex';
  
  let serversToShow = [];
  if (race === 'elyos' && servers.elyos) {
    servers.elyos.forEach(s => {
      serversToShow.push(s.name);
    });
  } else if (race === 'asmodian' && servers.asmodian) {
    servers.asmodian.forEach(s => {
      serversToShow.push(s.name);
    });
  }
  
  serversToShow.forEach(serverName => {
    const btn = document.createElement('button');
    btn.className = 'ranking-filter-btn';
    btn.setAttribute('data-filter-type', 'server');
    btn.setAttribute('data-value', serverName);
    btn.textContent = serverName;
    btn.addEventListener('click', () => {
      currentInternalServerFilter = serverName;
      serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      // URL 업데이트 (replace로 변경하여 히스토리 스택 쌓이지 않도록)
      const internalRankingURL = buildInternalRankingURL(
        currentInternalRankingType,
        currentInternalJobFilter,
        currentInternalServerRaceFilter,
        currentInternalServerFilter
      );
      updateURL(internalRankingURL, true); // replace=true로 변경
      
      // 데이터 다시 로드
      loadInternalRanking(1);
    });
    serverFilterContainer.appendChild(btn);
  });
}

// 내실 랭킹 로드 (무한 스크롤 지원)
function loadInternalRanking(page = 1, isAppend = false) {
  // 무한 스크롤 상태 확인
  if (isAppend && (internalRankingInfiniteScroll.isLoading || !internalRankingInfiniteScroll.hasMore)) {
    return;
  }
  
  if (isAppend) {
    internalRankingInfiniteScroll.isLoading = true;
  } else {
    // 초기 로드시 상태 리셋
    internalRankingInfiniteScroll.currentPage = 1;
    internalRankingInfiniteScroll.isLoading = false;
    internalRankingInfiniteScroll.hasMore = true;
    internalRankingInfiniteScroll.totalCount = 0;
    internalRankingInfiniteScroll.loadedCount = 0;
  }
  
  currentInternalPage = page;
  const params = new URLSearchParams();
  params.append('type', currentInternalRankingType);
  
  if (currentInternalJobFilter && currentInternalJobFilter !== 'all') {
    params.append('job', currentInternalJobFilter);
  } else {
    params.append('job', 'all');
  }
  
  if (currentInternalServerFilter && currentInternalServerFilter !== 'all') {
    params.append('server', currentInternalServerFilter);
  } else {
    params.append('server', 'all');
  }
  
  if (currentInternalServerRaceFilter && currentInternalServerRaceFilter !== 'all') {
    params.append('race', currentInternalServerRaceFilter);
  } else {
    params.append('race', 'all');
  }
  
  params.append('page', page);
  params.append('per_page', 100);
  
  const internalRankingBody = document.getElementById('internal-ranking-body');
  const internalRankingPagination = document.getElementById('internal-ranking-pagination');
  
  if (!internalRankingBody) return;
  
  // 로딩 메시지는 초기 로드시에만 표시
  if (!isAppend) {
    internalRankingBody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:1rem;">' + TA('ranking.loading_internal', '내실 랭킹 데이터를 불러오는 중...') + '</td></tr>';
  }
  
  const apiUrl = `${SITE_URL_PREFIX}/api/farming-rankings?${params.toString()}`;
  
  fetch(apiUrl)
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      if (!data.success) {
        internalRankingBody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:1rem;">' + (data.error || TA('ranking.internal_load_failed', '내실 랭킹 데이터를 불러오지 못했습니다.')) + '</td></tr>';
        if (internalRankingPagination) {
          internalRankingPagination.style.display = 'none';
        }
        return;
      }

      // 마지막 업데이트 시간 표시 (데이터 받은 직후)
      const lastUpdateEl = document.getElementById('internal-ranking-last-update');
      if (lastUpdateEl) {
        if (data.last_update) {
          lastUpdateEl.textContent = ``;
        } else {
          lastUpdateEl.textContent = '';
        }
      } else {
      }
      
      const rows = data.data || [];
      if (!rows.length) {
        internalRankingBody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:1rem;">' + TA('ranking.internal_empty', '내실 랭킹 데이터가 없습니다.') + '</td></tr>';
        if (internalRankingPagination) {
          internalRankingPagination.style.display = 'none';
        }
        internalRankingInfiniteScroll.hasMore = false;
        internalRankingInfiniteScroll.isLoading = false;
        return;
      }
      
      // 무한 스크롤 상태 업데이트
      const currentLoadedCount = internalRankingInfiniteScroll.loadedCount;
      internalRankingInfiniteScroll.totalCount = data.pagination.total_count;
      internalRankingInfiniteScroll.loadedCount += rows.length;
      internalRankingInfiniteScroll.hasMore = rows.length === 100;
      
      // 테이블 헤더 업데이트
      const headerCell = document.getElementById('internal-ranking-value-header');
      if (headerCell) {
        if (currentInternalRankingType === 'title') {
          headerCell.textContent = TA('ranking.farming_sub_tab_title', '타이틀');
        } else if (currentInternalRankingType === 'stigma') {
          headerCell.textContent = TA('ranking.farming_sub_stigma_shard', '스티그마 샤드');
        } else if (currentInternalRankingType === 'total_stat') {
          headerCell.textContent = TA('ranking.farming_sub_total_stat', '주신스탯합');
        }
      }
      
      // 테이블 행 생성
      let html = '';
      rows.forEach((row, index) => {
        const rank = currentLoadedCount + index + 1;
        const jobLabel = row.job || '';
        const jobImageUrl = row.job_image_url || '';
        const guild = row.guild || '-';
        const nickname = row.nickname || '';
        const serverName = row.server || '';
        const raceName = row.race || '';
        
        let raceValue = '';
        let serverId = '';
        
        if ((raceName === '천족' || raceName === '天族')) {
          raceValue = '1';
          if (servers && servers.elyos) {
            const serverInfo = findServerByName(servers.elyos, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceValue = '2';
          if (servers && servers.asmodian) {
            const serverInfo = findServerByName(servers.asmodian, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        }
        
        const jobDisplayInt = displayJobLabel(jobLabel);
        let jobCell = '';
        if (jobImageUrl) {
          jobCell = `<img src="${jobImageUrl}" alt="${jobDisplayInt}" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">${jobDisplayInt}`;
        } else {
          jobCell = jobDisplayInt;
        }
        
        const nicknameCell = serverId && raceValue 
          ? `<a href="${SITE_URL_PREFIX}/?nickname=${encodeURIComponent(nickname)}&race=${raceValue}&server=${serverId}" class="nickname-link" style="color: var(--accent); text-decoration: none; cursor: pointer;">${nickname}</a>`
          : nickname;
        
        let raceCell = raceName;
        if ((raceName === '천족' || raceName === '天族')) {
          raceCell = `<span style="color: #4a90e2;">${displayRaceLabel(raceName)}</span>`;
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceCell = `<span style="color: #e24a4a;">${displayRaceLabel(raceName)}</span>`;
        }
        
        const rankingValue = row.ranking_value || 0;
        const combatPower = row.combat_power || 0;
        
        html += `
          <tr>
            <td class="ranking-position col-rank">${rank}</td>
            <td class="col-nickname">${nicknameCell}</td>
            <td class="col-job">${jobCell}</td>
            <td class="col-race">${raceCell}</td>
            <td class="col-server">${serverName}</td>
            <td class="col-guild">${guild}</td>
            <td class="col-power">${parseInt(combatPower).toLocaleString()}</td>
            <td class="col-power">${parseInt(rankingValue).toLocaleString()}</td>
          </tr>
        `;
      });
      
      // isAppend면 추가, 아니면 덮어쓰기
      if (isAppend) {
        internalRankingBody.insertAdjacentHTML('beforeend', html);
      } else {
        internalRankingBody.innerHTML = html;
      }
      
      // 무한 스크롤 상태 업데이트
      internalRankingInfiniteScroll.isLoading = false;
      updateInternalRankingScrollStatus();
      
      // 페이지네이션 숨기기 (무한 스크롤 사용)
      if (internalRankingPagination) {
        internalRankingPagination.style.display = 'none';
      }
      
      // 닉네임 클릭 이벤트 추가 (window.location.href 방식으로 통일 - 애드센스 PV 증대)
      internalRankingBody.querySelectorAll('.nickname-link').forEach(link => {
        link.addEventListener('click', function(e) {
          // 마우스 휠 클릭(중간 클릭)이나 Ctrl+클릭, Shift+클릭(새 탭/새 창)은 기본 동작 허용
          if (e.button === 1 || e.ctrlKey || e.metaKey || e.shiftKey) {
            return; // 기본 동작 허용 (새 탭으로 열기)
          }
          
          // 일반 클릭은 실제 페이지 이동 (애드센스 수익 증대)
          e.preventDefault();
          
          const parsed = parseNicknameQueryFromHref(this.getAttribute('href'));
          if (parsed) {
            const { nickname, race, serverId } = parsed;
              // ★ 클릭 즉시 로딩 표시 (UX 개선)
              const characterLoading = document.getElementById('character-loading');
              const loadingOverlay = document.getElementById('fullscreen-loading-overlay');
              const characterResult = document.getElementById('character-result');
              const allServersResult = document.getElementById('character-all-servers-result');
              
              if (characterResult) characterResult.style.display = 'none';
              if (allServersResult) allServersResult.style.display = 'none';
              if (characterLoading) characterLoading.style.display = 'block';
              if (loadingOverlay) loadingOverlay.style.display = 'flex';
              
              // 로딩 표시가 렌더링될 시간을 주고 페이지 이동
              requestAnimationFrame(() => {
                window.location.href = `${SITE_URL_PREFIX}/char/serverid=${serverId}/${encodeURIComponent(nickname)}`;
              });
          }
        });
      });
      
      // 무한 스크롤 설정 (초기 로드 후)
      if (!isAppend) {
        setupInternalRankingInfiniteScroll();
      }
    })
    .catch(err => {
      if (!isAppend) {
        internalRankingBody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:1rem;">' + TA('ranking.load_error', '랭킹 데이터를 불러오는 중 오류가 발생했습니다.') + ' ' + err.message + '</td></tr>';
      }
      if (internalRankingPagination) {
        internalRankingPagination.style.display = 'none';
      }
      internalRankingInfiniteScroll.isLoading = false;
    });
}

// 내실 랭킹 스크롤 상태 업데이트
function updateInternalRankingScrollStatus() {
  let statusEl = document.getElementById('internal-ranking-scroll-status');
  if (!statusEl) {
    const container = document.getElementById('internal-ranking-container');
    if (container) {
      statusEl = document.createElement('div');
      statusEl.id = 'internal-ranking-scroll-status';
      statusEl.style.textAlign = 'center';
      statusEl.style.padding = '1rem';
      statusEl.style.color = '#999';
      statusEl.style.fontSize = '0.85rem';
      container.appendChild(statusEl);
    }
  }
  
  if (statusEl) {
    const n = internalRankingInfiniteScroll.loadedCount;
    if (internalRankingInfiniteScroll.hasMore) {
      statusEl.innerHTML = TA('ranking.loaded_count_scroll', '{n}명 로드됨 (스크롤하여 더 보기)').replace(/\{n\}/g, String(n));
    } else {
      statusEl.innerHTML = TA('ranking.all_loaded_count', '모든 데이터를 로드했습니다. (총 {n}명)').replace(/\{n\}/g, String(n));
    }
  }
}

// 내실 랭킹 무한 스크롤 설정
function setupInternalRankingInfiniteScroll() {
  const internalRankingPagination = document.getElementById('internal-ranking-pagination');
  let sentinel = document.getElementById('internal-ranking-scroll-sentinel');
  
  if (!sentinel) {
    sentinel = document.createElement('div');
    sentinel.id = 'internal-ranking-scroll-sentinel';
    sentinel.style.height = '1px';
    sentinel.style.width = '100%';
    sentinel.style.opacity = '0';
    sentinel.style.pointerEvents = 'none';
    
    const container = document.getElementById('internal-ranking-container');
    if (container) {
      container.appendChild(sentinel);
    }
  }
  
  // 기존 observer 해제
  if (window.internalRankingObserver) {
    window.internalRankingObserver.disconnect();
  }
  
  // 새로운 observer 생성
  window.internalRankingObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && 
          !internalRankingInfiniteScroll.isLoading && 
          internalRankingInfiniteScroll.hasMore &&
          internalRankingInfiniteScroll.loadedCount > 0) {
        internalRankingInfiniteScroll.currentPage++;
        loadInternalRanking(internalRankingInfiniteScroll.currentPage, true);
      }
    });
  }, {
    root: null,
    rootMargin: '300px',
    threshold: 0
  });
  
  window.internalRankingObserver.observe(sentinel);
}

// 내실 랭킹 페이지네이션 렌더링
function renderInternalRankingPagination(pagination) {
  const internalRankingPagination = document.getElementById('internal-ranking-pagination');
  if (!internalRankingPagination) return;
  
  const { page, total_pages, total_count } = pagination;
  internalRankingPagination.style.display = 'flex';
  internalRankingPagination.innerHTML = '';
  
  const prevBtn = document.createElement('button');
  prevBtn.className = 'pagination-btn';
  prevBtn.textContent = TA('common.previous', '이전');
  prevBtn.disabled = page === 1;
  prevBtn.addEventListener('click', () => {
    if (page > 1) {
      loadInternalRanking(page - 1);
    }
  });
  internalRankingPagination.appendChild(prevBtn);
  
  const startPage = Math.max(1, page - 2);
  const endPage = Math.min(total_pages, page + 2);
  
  if (startPage > 1) {
    const firstBtn = document.createElement('button');
    firstBtn.className = 'pagination-btn';
    firstBtn.textContent = '1';
    firstBtn.addEventListener('click', () => loadInternalRanking(1));
    internalRankingPagination.appendChild(firstBtn);
    
    if (startPage > 2) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      internalRankingPagination.appendChild(ellipsis);
    }
  }
  
  for (let i = startPage; i <= endPage; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.className = 'pagination-btn';
    if (i === page) {
      pageBtn.classList.add('active');
    }
    pageBtn.textContent = i;
    pageBtn.addEventListener('click', () => loadInternalRanking(i));
    internalRankingPagination.appendChild(pageBtn);
  }
  
  if (endPage < total_pages) {
    if (endPage < total_pages - 1) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      internalRankingPagination.appendChild(ellipsis);
    }
    
    const lastBtn = document.createElement('button');
    lastBtn.className = 'pagination-btn';
    lastBtn.textContent = total_pages;
    lastBtn.addEventListener('click', () => loadInternalRanking(total_pages));
    internalRankingPagination.appendChild(lastBtn);
  }
  
  const nextBtn = document.createElement('button');
  nextBtn.className = 'pagination-btn';
  nextBtn.textContent = TA('common.next', '다음');
  nextBtn.disabled = page === total_pages;
  nextBtn.addEventListener('click', () => {
    if (page < total_pages) {
      loadInternalRanking(page + 1);
    }
  });
  internalRankingPagination.appendChild(nextBtn);
  
  const info = document.createElement('span');
  info.className = 'pagination-info';
  info.textContent = `${total_count}명 중 ${(page - 1) * 10 + 1}-${Math.min(page * 10, total_count)}명`;
  internalRankingPagination.appendChild(info);
}

// 레기온 랭킹 로드
// 레기온 랭킹 로딩 중 요청 취소를 위한 AbortController
// 중복 선언 방지
if (typeof regionRankingsAbortController === 'undefined') {
  var regionRankingsAbortController = null;
}

// 레기온 랭킹 무한 스크롤 상태
var regionRankingInfiniteScroll = {
  currentPage: 1,
  isLoading: false,
  hasMore: true,
  totalCount: 0,
  loadedCount: 0
};
var regionRankingDataCache = {};
var REGION_RANKING_CACHE_DURATION = 5 * 60 * 1000; // 5분

// 길드원 목록 무한 스크롤 상태
var regionMembersInfiniteScroll = {
  currentPage: 1,
  isLoading: false,
  hasMore: true,
  totalCount: 0,
  loadedCount: 0,
  currentServer: null,
  currentGuild: null
};

// 길드원 목록 정렬 상태
var regionMembersSortState = {
  currentSort: 'atrium', // 'atrium' 또는 'combat'
  atriumOrder: 'desc', // 'asc' 또는 'desc'
  combatOrder: 'desc',
  allMembers: [], // 모든 멤버 데이터 저장
  classFilter: null // 현재 선택된 클래스 필터 (null = 전체)
};

function loadRegionRankings(page = 1, isAppend = false) {
  // 무한 스크롤 상태 확인
  if (isAppend && (regionRankingInfiniteScroll.isLoading || !regionRankingInfiniteScroll.hasMore)) {
    return;
  }
  
  if (isAppend) {
    regionRankingInfiniteScroll.isLoading = true;
  } else {
    // 초기 로드시 상태 리셋
    regionRankingInfiniteScroll.currentPage = 1;
    regionRankingInfiniteScroll.isLoading = false;
    regionRankingInfiniteScroll.hasMore = true;
    regionRankingInfiniteScroll.totalCount = 0;
    regionRankingInfiniteScroll.loadedCount = 0;
  }
  
  // 이전 요청이 있으면 취소
  if (regionRankingsAbortController) {
    regionRankingsAbortController.abort();
  }
  
  // 새로운 AbortController 생성
  regionRankingsAbortController = new AbortController();
  const signal = regionRankingsAbortController.signal;
  
  currentRegionPage = page;
  
  // 뷰 전환: 리스트 뷰 표시, 상세 뷰 숨김
  const listView = document.getElementById('region-ranking-list-view');
  const detailView = document.getElementById('region-ranking-detail-view');
  if (listView) listView.style.display = 'block';
  if (detailView) detailView.style.display = 'none';
  
  const params = new URLSearchParams();
  
  if (currentRegionRaceFilter && currentRegionRaceFilter !== 'all') {
    params.append('race', currentRegionRaceFilter);
  }
  if (currentRegionServerFilter && currentRegionServerFilter !== 'all') {
    params.append('server', currentRegionServerFilter);
  }
  if (regionSearchQuery) {
    params.append('search', regionSearchQuery);
  }
  params.append('page', page);
  params.append('per_page', 100);

  const regionBody = document.getElementById('region-ranking-body');
  const regionPagination = document.getElementById('region-ranking-pagination');
  
  // 로딩 메시지는 초기 로드시에만 표시
  if (regionBody && !isAppend) {
    regionBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:2rem; color: var(--text-muted);">레기온 랭킹을 불러오는 중...</td></tr>';
  }
  if (regionPagination) {
    regionPagination.style.display = 'none';
  }

  const apiUrl = SITE_URL_PREFIX + '/api/region-rankings?' + params.toString();
  
  fetch(apiUrl, { signal })
    .then(res => {
      if (!res.ok) {
        throw new Error(`HTTP error! status: ${res.status}`);
      }
      return res.json();
    })
    .then(data => {
      // 요청이 취소되었으면 처리하지 않음
      if (signal.aborted) {
        return;
      }
      
      if (!data.success) {
        if (regionBody) {
          regionBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">레기온 랭킹 데이터를 불러오지 못했습니다. ' + (data.error || '') + '</td></tr>';
        }
        return;
      }

      // 마지막 업데이트 시간 표시
      const updateTimeEl = document.getElementById('region-ranking-update-time');
      if (updateTimeEl && data.last_update) {
        updateTimeEl.textContent = `마지막 업데이트 시간: ${data.last_update}`;
      } else if (updateTimeEl) {
        updateTimeEl.textContent = '';
      }

      if (!data.data || data.data.length === 0) {
        if (regionBody) {
          regionBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">레기온 랭킹 데이터가 없습니다.</td></tr>';
        }
        if (regionPagination) {
          regionPagination.style.display = 'none';
        }
        regionRankingInfiniteScroll.hasMore = false;
        regionRankingInfiniteScroll.isLoading = false;
        return;
      }

      // 무한 스크롤 상태 업데이트
      const currentLoadedCount = regionRankingInfiniteScroll.loadedCount;
      regionRankingInfiniteScroll.totalCount = data.pagination.total_count;
      regionRankingInfiniteScroll.loadedCount += data.data.length;
      regionRankingInfiniteScroll.hasMore = data.data.length === 100;

      // 테이블 렌더링
      if (regionBody) {
        // 초기 로드시에만 비우기
        if (!isAppend) {
          regionBody.innerHTML = '';
        }
        data.data.forEach((item, index) => {
          const rank = currentLoadedCount + index + 1;
          const tr = document.createElement('tr');
          tr.style.cursor = 'pointer';
          tr.addEventListener('click', () => {
            const server = encodeURIComponent(item.server);
            const guild = encodeURIComponent(item.guild);
            window.location.href = `${SITE_URL_PREFIX}/region/${server}/${guild}`;
          });
          const guildName = item.guild && item.guild.trim() ? item.guild.trim() : '-';
          const serverName = item.server && item.server.trim() ? item.server.trim() : '-';
          const memberCount = item.member_count ? parseInt(item.member_count) : 0;
          const totalPower2 = item.total_combat_power2 ? parseInt(item.total_combat_power2) : 0;
          
          // 서버명 색상 결정 (천족=파랑, 마족=빨강)
          let serverColor = 'var(--text-primary)';
          const serverDataEl = document.getElementById('server-data');
          if (serverDataEl && serverDataEl.textContent) {
            try {
              const servers = JSON.parse(serverDataEl.textContent);
              // 천족 서버 확인
              const isElyos = servers.elyos.some(s => s.name === serverName);
              if (isElyos) {
                serverColor = '#3b82f6'; // 파랑
              } else {
                // 마족 서버 확인
                const isAsmodian = servers.asmodian.some(s => s.name === serverName);
                if (isAsmodian) {
                  serverColor = '#ef4444'; // 빨강
                }
              }
            } catch (e) {
            }
          }
          
          tr.innerHTML = `
            <td class="ranking-position col-rank">${rank}</td>
            <td class="col-nickname">${guildName}</td>
            <td class="col-server" style="color: ${serverColor};">${serverName}</td>
            <td class="col-power col-member-count">${memberCount.toLocaleString()}</td>
            <td class="col-power">${totalPower2.toLocaleString()}</td>
          `;
          regionBody.appendChild(tr);
        });
      }

      // 마지막 업데이트 시간 표시
      const lastUpdateEl = document.getElementById('region-ranking-update-time');
      if (lastUpdateEl) {
        if (data.last_update) {
          lastUpdateEl.textContent = `마지막 업데이트: ${data.last_update}`;
        } else {
          lastUpdateEl.textContent = '업데이트 시간 확인 중...';
        }
      }

      // 무한 스크롤 상태 업데이트
      regionRankingInfiniteScroll.isLoading = false;
      updateRegionRankingScrollStatus();
      
      // 페이지네이션 숨기기 (무한 스크롤 사용)
      if (regionPagination) {
        regionPagination.style.display = 'none';
      }
      
      // 무한 스크롤 설정 (초기 로드 후)
      if (!isAppend) {
        setupRegionRankingInfiniteScroll();
      }
    })
    .catch(err => {
      // AbortError는 정상적인 취소이므로 무시
      if (err.name === 'AbortError') {
        return;
      }
      if (regionBody && !signal.aborted && !isAppend) {
        regionBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">' + TA('ranking.region_load_error', '레기온 랭킹 데이터를 불러오는 중 오류가 발생했습니다: ') + err.message + '</td></tr>';
      }
      regionRankingInfiniteScroll.isLoading = false;
    });
}

// 레기온 랭킹 스크롤 상태 업데이트
function updateRegionRankingScrollStatus() {
  let statusEl = document.getElementById('region-ranking-scroll-status');
  if (!statusEl) {
    const container = document.getElementById('region-ranking-list-view');
    if (container) {
      statusEl = document.createElement('div');
      statusEl.id = 'region-ranking-scroll-status';
      statusEl.style.textAlign = 'center';
      statusEl.style.padding = '1rem';
      statusEl.style.color = '#999';
      statusEl.style.fontSize = '0.85rem';
      container.appendChild(statusEl);
    }
  }
  
  if (statusEl) {
    const n = regionRankingInfiniteScroll.loadedCount;
    if (regionRankingInfiniteScroll.hasMore) {
      statusEl.innerHTML = TA('ranking.region_loaded_more', '{n}개 레기온 로드됨 (더 로딩 중...)').replace(/\{n\}/g, String(n));
    } else {
      statusEl.innerHTML = TA('ranking.all_loaded_legion', '모든 데이터를 로드했습니다. (총 {n}개 레기온)').replace(/\{n\}/g, String(n));
    }
  }
}

// 레기온 랭킹 무한 스크롤 설정
function setupRegionRankingInfiniteScroll() {
  const regionPagination = document.getElementById('region-ranking-pagination');
  let sentinel = document.getElementById('region-ranking-scroll-sentinel');
  
  if (!sentinel) {
    sentinel = document.createElement('div');
    sentinel.id = 'region-ranking-scroll-sentinel';
    sentinel.style.height = '1px';
    sentinel.style.width = '100%';
    sentinel.style.opacity = '0';
    sentinel.style.pointerEvents = 'none';
    
    const container = document.getElementById('region-ranking-list-view');
    if (container) {
      container.appendChild(sentinel);
    }
  }
  
  // 기존 observer 해제
  if (window.regionRankingObserver) {
    window.regionRankingObserver.disconnect();
  }
  
  // 새로운 observer 생성
  window.regionRankingObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && 
          !regionRankingInfiniteScroll.isLoading && 
          regionRankingInfiniteScroll.hasMore &&
          regionRankingInfiniteScroll.loadedCount > 0) {
        regionRankingInfiniteScroll.currentPage++;
        loadRegionRankings(regionRankingInfiniteScroll.currentPage, true);
      }
    });
  }, {
    root: null,
    rootMargin: '300px',
    threshold: 0
  });
  
  window.regionRankingObserver.observe(sentinel);
}

// 레기온 랭킹 페이지네이션
function renderRegionPagination(pagination) {
  const regionPagination = document.getElementById('region-ranking-pagination');
  if (!regionPagination) return;
  
  const { page, total_pages, total_count } = pagination;
  regionPagination.style.display = 'flex';
  regionPagination.innerHTML = '';
  
  // 이전 버튼
  const prevBtn = document.createElement('button');
  prevBtn.className = 'pagination-btn';
  prevBtn.textContent = TA('common.previous', '이전');
  prevBtn.disabled = page === 1;
  prevBtn.addEventListener('click', () => {
    if (page > 1) {
      loadRegionRankings(page - 1);
    }
  });
  regionPagination.appendChild(prevBtn);
  
  // 페이지 번호 버튼들
  const startPage = Math.max(1, page - 2);
  const endPage = Math.min(total_pages, page + 2);
  
  if (startPage > 1) {
    const firstBtn = document.createElement('button');
    firstBtn.className = 'pagination-btn';
    firstBtn.textContent = '1';
    firstBtn.addEventListener('click', () => loadRegionRankings(1));
    regionPagination.appendChild(firstBtn);
    
    if (startPage > 2) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      regionPagination.appendChild(ellipsis);
    }
  }
  
  for (let i = startPage; i <= endPage; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.className = 'pagination-btn';
    if (i === page) {
      pageBtn.classList.add('active');
    }
    pageBtn.textContent = i;
    pageBtn.addEventListener('click', () => loadRegionRankings(i));
    regionPagination.appendChild(pageBtn);
  }
  
  if (endPage < total_pages) {
    if (endPage < total_pages - 1) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      regionPagination.appendChild(ellipsis);
    }
    
    const lastBtn = document.createElement('button');
    lastBtn.className = 'pagination-btn';
    lastBtn.textContent = total_pages;
    lastBtn.addEventListener('click', () => loadRegionRankings(total_pages));
    regionPagination.appendChild(lastBtn);
  }
  
  // 다음 버튼
  const nextBtn = document.createElement('button');
  nextBtn.className = 'pagination-btn';
  nextBtn.textContent = TA('common.next', '다음');
  nextBtn.disabled = page === total_pages;
  nextBtn.addEventListener('click', () => {
    if (page < total_pages) {
      loadRegionRankings(page + 1);
    }
  });
  regionPagination.appendChild(nextBtn);
  
  // 정보 표시
  const info = document.createElement('span');
  info.className = 'pagination-info';
  info.textContent = `${total_count}개 중 ${(page - 1) * 10 + 1}-${Math.min(page * 10, total_count)}개`;
  regionPagination.appendChild(info);
}

// 레기온 상세 화면
function loadRegionDetail(server, guild) {
  // 뷰 전환: 리스트 뷰 숨김, 상세 뷰 표시
  const listView = document.getElementById('region-ranking-list-view');
  const detailView = document.getElementById('region-ranking-detail-view');
  if (!listView || !detailView) return;
  
  if (listView) listView.style.display = 'none';
  if (detailView) detailView.style.display = 'block';
  
  // 서버 색상 결정 (천족=파랑, 마족=빨강)
  let serverColor = 'var(--text-primary)';
  const serverDataEl = document.getElementById('server-data');
  if (serverDataEl && serverDataEl.textContent) {
    try {
      const servers = JSON.parse(serverDataEl.textContent);
      const isElyos = servers.elyos.some(s => s.name === server);
      if (isElyos) {
        serverColor = '#3b82f6'; // 파랑
      } else {
        const isAsmodian = servers.asmodian.some(s => s.name === server);
        if (isAsmodian) {
          serverColor = '#ef4444'; // 빨강
        }
      }
    } catch (e) {
    }
  }
  
  // 상세 화면 HTML 생성
  const isMobile = window.innerWidth <= 768;
  const detailHTML = `
    <div style="margin-bottom: 2rem;">
      <button id="region-back-btn" style="padding: 0.5rem 1rem; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--card-border); border-radius: 8px; color: var(--text-primary); cursor: pointer; font-size: 0.95rem; margin-bottom: 1.5rem;">← 뒤로가기</button>
      
      <!-- 길드명/서버명 배너 -->
      <div style="
        background: linear-gradient(180deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.98) 100%);
        border-top: 2px solid rgba(100, 116, 139, 0.5);
        border-bottom: 2px solid rgba(100, 116, 139, 0.5);
        padding: ${isMobile ? '1.2rem 0' : '1.8rem 0'};
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      ">
        <!-- 길드명 -->
        <div style="
          font-size: ${isMobile ? '1.8rem' : '2.5rem'};
          font-weight: 800;
          color: #fff;
          letter-spacing: 0.02em;
          line-height: 1.2;
          margin-bottom: ${isMobile ? '0.5rem' : '0.6rem'};
          text-align: center;
          width: 100%;
        " id="region-detail-guild">
          ${guild}
        </div>
        
        <!-- 서버명 -->
        <div style="
          font-size: ${isMobile ? '0.9rem' : '1.1rem'};
          font-weight: 600;
          color: ${serverColor};
          letter-spacing: 0.05em;
          text-align: center;
          width: 100%;
        " id="region-detail-server">
          ${server}
        </div>
      </div>
      
      <!-- 4개 통계 카드 -->
      <div class="region-detail-stats" style="display: grid; grid-template-columns: ${isMobile ? 'repeat(2, 1fr)' : 'repeat(4, 1fr)'}; gap: ${isMobile ? '0.75rem' : '1.5rem'}; margin-bottom: 2rem; max-width: ${isMobile ? '100%' : '900px'}; margin-left: auto; margin-right: auto;">
        <div class="hero-card region-stat-card" style="padding: ${isMobile ? '0.6rem' : '0.75rem'}; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%); border: 1px solid rgba(139, 92, 246, 0.2); border-radius: 10px; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); text-align: center;">
          <div style="font-size: ${isMobile ? '0.65rem' : '0.75rem'}; color: var(--text-muted); margin-bottom: ${isMobile ? '0.25rem' : '0.3rem'}; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">총 등록 인원 수</div>
          <div style="font-size: ${isMobile ? '1.1rem' : '1.4rem'}; font-weight: 700; color: var(--accent);" id="region-total-members">-</div>
        </div>
        <div class="hero-card region-stat-card" style="padding: ${isMobile ? '0.6rem' : '0.75rem'}; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 10px; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); text-align: center;">
          <div style="font-size: ${isMobile ? '0.65rem' : '0.75rem'}; color: var(--text-muted); margin-bottom: ${isMobile ? '0.25rem' : '0.3rem'}; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">평균 전투력</div>
          <div style="font-size: ${isMobile ? '1.1rem' : '1.4rem'}; font-weight: 700; color: #10b981;" id="region-avg-atrium">-</div>
        </div>
        <div class="hero-card region-stat-card" style="padding: ${isMobile ? '0.6rem' : '0.75rem'}; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: 10px; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); text-align: center;">
          <div style="font-size: ${isMobile ? '0.65rem' : '0.75rem'}; color: var(--text-muted); margin-bottom: ${isMobile ? '0.25rem' : '0.3rem'}; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">평균 아이템 레벨</div>
          <div style="font-size: ${isMobile ? '1.1rem' : '1.4rem'}; font-weight: 700; color: #fb923c;" id="region-avg-power">-</div>
        </div>
        <div class="hero-card region-stat-card" style="padding: ${isMobile ? '0.6rem' : '0.75rem'}; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%); border: 1px solid rgba(96, 165, 250, 0.2); border-radius: 10px; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); text-align: center;">
          <div style="font-size: ${isMobile ? '0.65rem' : '0.75rem'}; color: var(--text-muted); margin-bottom: ${isMobile ? '0.25rem' : '0.3rem'}; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">서버 내 랭킹</div>
          <div style="font-size: ${isMobile ? '1.1rem' : '1.4rem'}; font-weight: 700; color: #60a5fa; line-height: 1.3;" id="region-server-rank">-</div>
        </div>
      </div>
    </div>
    <div>
      <!-- 서브탭: 길드원 목록 / 타임라인 (세그먼트형) -->
      <div class="region-detail-tabs-outer" style="display: flex; justify-content: center; margin-bottom: 1.25rem;">
        <div id="region-detail-tabs" class="region-detail-tabs">
          <button type="button" class="region-detail-tab-btn active" data-rtab="members">
            <svg class="region-tab-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91zM4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29zM20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm4 3.43c0-.81-.48-1.53-1.22-1.85-.85-.37-1.79-.58-2.78-.58-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24v-1.57zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3z"/></svg>
            <span>${_t('길드원 목록', '公會成員')}</span>
          </button>
          <button type="button" class="region-detail-tab-btn" data-rtab="timeline">
            <svg class="region-tab-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>
            <span>${_t('타임라인', '時間軸')}</span>
          </button>
        </div>
      </div>

      <!-- 길드원 목록 탭 -->
      <div id="region-detail-members">
        <!-- 클래스 필터 -->
        <div id="region-class-filters" style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; align-items: center;">
          <span style="font-size: 0.75rem; color: var(--text-muted); padding: 0.2rem 0.4rem;">${_t('클래스 필터', '職業篩選')}:</span>
          <span style="font-size: 0.8rem; color: var(--text-muted); padding: 0.4rem 0;">${_t('로딩 중...', '載入中...')}</span>
        </div>
        <table class="ranking-list" id="region-members-table">
          <thead>
            <tr>
              <th class="col-rank">순번</th>
              <th class="col-nickname">닉네임</th>
              <th class="col-server">서버</th>
              <th class="col-job">직업</th>
              <th class="col-power sortable" id="sort-atrium" style="cursor: pointer; user-select: none;">
                전투력 <span id="sort-atrium-icon">▼</span>
              </th>
              <th class="col-power sortable" id="sort-combat" style="cursor: pointer; user-select: none;">
                아이템 레벨 <span id="sort-combat-icon">▽</span>
              </th>
            </tr>
          </thead>
          <tbody id="region-members-body">
            <tr>
              <td colspan="6" style="text-align:center; padding:1rem;">로딩 중...</td>
            </tr>
          </tbody>
        </table>
        <div id="region-members-scroll-status" style="text-align: center; padding: 1rem; color: #999; font-size: 0.85rem;"></div>
      </div>

      <!-- 타임라인 탭 -->
      <div id="region-detail-timeline" style="display: none;">
        <div class="region-timeline-layout" style="display: grid; grid-template-columns: ${isMobile ? '1fr' : 'minmax(0, 340px) 1fr'}; gap: 1.25rem; align-items: start;">
          <!-- 좌측: 날짜별 가입/탈퇴 -->
          <div>
            <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.6rem;">${_t('가입 / 탈퇴 내역', '加入 / 退出紀錄')}</div>
            <div id="region-timeline-events" style="max-height: 460px; overflow-y: auto; border: 1px solid var(--card-border); border-radius: 10px; padding: 0.5rem;">
              <div style="text-align:center; padding:1.5rem; color: var(--text-muted); font-size: 0.85rem;">${_t('불러오는 중...', '載入中...')}</div>
            </div>
          </div>
          <!-- 우측: 인원/전투력 추이 차트 -->
          <div style="display: flex; flex-direction: column; gap: 1.5rem; min-width: 0;">
            <div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">${_t('레기온 인원 변화 추이', '軍團人數變化趨勢')}</div>
              <div id="region-member-chart-wrap" style="position: relative; height: 220px;"></div>
            </div>
            <div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">${_t('전투력 총합 추이', '總戰力變化趨勢')}</div>
              <div id="region-power-chart-wrap" style="position: relative; height: 220px;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- disclaimer -->
      <div style="margin-top: 1.25rem; padding: 0.75rem 1rem; background: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.25); border-radius: 8px; color: var(--text-muted); font-size: 0.82rem; line-height: 1.55;">
        ${_t('※ 가입/탈퇴 및 인원·전투력 추이 정보는 아툴에 검색된 데이터를 기반으로 추정한 것으로, 실제 가입/탈퇴 일자 및 수치와 다를 수 있습니다.', '※ 加入/退出與人數・戰力趨勢資訊是基於 Atool 上被搜尋過的資料推估，可能與實際加入/退出日期及數值不同。')}
      </div>
    </div>
  `;
  
  detailView.innerHTML = detailHTML;
  
  // 뒤로가기 버튼 이벤트 - 레기온 페이지로 이동
  const backBtn = document.getElementById('region-back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      // 레기온 페이지로 이동
      window.location.href = SITE_URL_PREFIX + '/region';
    });
  }

  // 상세 탭(길드원 목록 / 타임라인) 전환
  window.regionTimelineLoaded = false;
  const rDetailTabBtns = document.querySelectorAll('#region-detail-tabs .region-detail-tab-btn');
  const rMembersPanel = document.getElementById('region-detail-members');
  const rTimelinePanel = document.getElementById('region-detail-timeline');
  rDetailTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rDetailTabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.rtab;
      if (tab === 'timeline') {
        if (rMembersPanel) rMembersPanel.style.display = 'none';
        if (rTimelinePanel) rTimelinePanel.style.display = 'block';
        if (!window.regionTimelineLoaded) {
          window.regionTimelineLoaded = true;
          loadRegionTimeline(server, guild);
        }
      } else {
        if (rTimelinePanel) rTimelinePanel.style.display = 'none';
        if (rMembersPanel) rMembersPanel.style.display = 'block';
      }
    });
  });
  
  // 무한 스크롤 상태 초기화
  regionMembersInfiniteScroll.currentPage = 1;
  regionMembersInfiniteScroll.isLoading = false;
  regionMembersInfiniteScroll.hasMore = true;
  regionMembersInfiniteScroll.totalCount = 0;
  regionMembersInfiniteScroll.loadedCount = 0;
  regionMembersInfiniteScroll.currentServer = server;
  regionMembersInfiniteScroll.currentGuild = guild;
  
  // 정렬 상태 초기화
  regionMembersSortState.currentSort = 'atrium';
  regionMembersSortState.atriumOrder = 'desc';
  regionMembersSortState.combatOrder = 'desc';
  regionMembersSortState.allMembers = [];
  regionMembersSortState.classFilter = null;
  
  // 정렬 아이콘 초기화
  const atriumIcon = document.getElementById('sort-atrium-icon');
  const combatIcon = document.getElementById('sort-combat-icon');
  if (atriumIcon) atriumIcon.textContent = '▼';
  if (combatIcon) combatIcon.textContent = '▽';
  
  // 통계 정보 먼저 로드 (per_page=1로 빠르게 가져오기)
  const serverEncoded = encodeURIComponent(server);
  const guildEncoded = encodeURIComponent(guild);
  fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}?page=1&per_page=1`)
    .then(res => res.json())
    .then(data => {
      if (!data.success) {
        const membersBody = document.getElementById('region-members-body');
        if (membersBody) {
          membersBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">레기온 정보를 불러오지 못했습니다.</td></tr>';
        }
        return;
      }
      
      // 통계 업데이트
      const totalMembersEl = document.getElementById('region-total-members');
      const avgAtriumEl = document.getElementById('region-avg-atrium');
      const avgPowerEl = document.getElementById('region-avg-power');
      const serverRankEl = document.getElementById('region-server-rank');
      if (totalMembersEl) totalMembersEl.textContent = `${data.total_members}${_t('명', '人')}`;
      if (avgAtriumEl) avgAtriumEl.textContent = `${Math.round(data.avg_combat_power2 || 0).toLocaleString()}`;
      if (avgPowerEl) avgPowerEl.textContent = `${Math.round(data.avg_combat_power || 0).toLocaleString()}`;
      if (serverRankEl) {
        if (data.server_rank !== null && data.server_rank !== undefined && data.server_rank_percent !== null && data.server_rank_percent !== undefined) {
          serverRankEl.innerHTML = `${data.server_rank}${_t('위', '名')}<br><span style="font-size: 0.7em; opacity: 0.85;">(${_t('상위', '前')} ${data.server_rank_percent}%)</span>`;
        } else {
          serverRankEl.textContent = '-';
        }
      }
      
      // 무한 스크롤 상태 업데이트
      regionMembersInfiniteScroll.totalCount = data.total_members;

      // 모든 멤버를 한 번에 병렬 로드 후 클래스 필터/정렬 셋업
      // (max 128명이라 사전 일괄 로드가 무한 스크롤보다 UX/필터 정확도 면에서 우수)
      loadAllRegionMembersAndSetup(server, guild, data.total_members);
    })
    .catch(err => {
      const membersBody = document.getElementById('region-members-body');
      if (membersBody) {
        membersBody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:1rem;">레기온 정보를 불러오는 중 오류가 발생했습니다.</td></tr>';
      }
    });
}

// ============================================================
// 레기온 타임라인 (가입/탈퇴 내역 + 인원/전투력 추이 차트)
// ============================================================
window.regionTimelineCharts = { member: null, power: null };

function loadRegionTimeline(server, guild) {
  const eventsEl = document.getElementById('region-timeline-events');
  const serverEncoded = encodeURIComponent(server);
  const guildEncoded = encodeURIComponent(guild);
  fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}/timeline`)
    .then(res => res.json())
    .then(data => {
      if (!data || !data.success) {
        if (eventsEl) eventsEl.innerHTML = `<div style="text-align:center; padding:1.5rem; color: var(--text-muted); font-size:0.85rem;">${_t('타임라인 정보를 불러오지 못했습니다.', '無法載入時間軸資訊。')}</div>`;
        return;
      }
      renderRegionTimelineEvents(data.events || [], server);
      renderRegionTimelineCharts(data.series || []);
    })
    .catch(() => {
      if (eventsEl) eventsEl.innerHTML = `<div style="text-align:center; padding:1.5rem; color: var(--text-muted); font-size:0.85rem;">${_t('타임라인 정보를 불러오는 중 오류가 발생했습니다.', '載入時間軸時發生錯誤。')}</div>`;
    });
}

function _resolveServerIdAndRace(serverName) {
  const serverDataEl = document.getElementById('server-data');
  let servers = { elyos: [], asmodian: [] };
  if (serverDataEl && serverDataEl.textContent) {
    try { servers = JSON.parse(serverDataEl.textContent); } catch (e) {}
  }
  for (const s of servers.elyos || []) {
    if (s.name === serverName) return { serverId: s.id, raceValue: '1' };
  }
  for (const s of servers.asmodian || []) {
    if (s.name === serverName) return { serverId: s.id, raceValue: '2' };
  }
  return { serverId: null, raceValue: null };
}

function _attachRegionNicknameSearchHandler(linkEl) {
  if (!linkEl || linkEl.dataset.searchBound === '1') return;
  linkEl.dataset.searchBound = '1';
  linkEl.addEventListener('click', function(e) {
    if (e.ctrlKey || e.metaKey || e.button === 1 || (e.button === 0 && e.shiftKey)) return;
    e.preventDefault();
    const nickname = this.getAttribute('data-nickname');
    const race = this.getAttribute('data-race');
    const sId = this.getAttribute('data-server');
    if (!(nickname && race && sId)) return;

    document.getElementById('character-result').style.display = 'none';
    document.getElementById('character-all-servers-result').style.display = 'none';
    document.getElementById('character-loading').style.display = 'block';
    const overlay = document.getElementById('fullscreen-loading-overlay');
    if (overlay) overlay.style.display = 'flex';

    const characterTab = document.getElementById('tab-character');
    if (characterTab) {
      characterTab.checked = true;
      characterTab.dispatchEvent(new Event('change'));
      updateSidebarVisibility();
      if (race) updateRaceSelection(race, true);

      const serverSelect = document.getElementById('server-select');
      const keywordInput = document.getElementById('character-keyword');
      setTimeout(() => {
        if (serverSelect) {
          serverSelect.value = sId;
          if (keywordInput) keywordInput.value = nickname;
          document.getElementById('character-loading').style.display = 'block';
          const overlay2 = document.getElementById('fullscreen-loading-overlay');
          if (overlay2) overlay2.style.display = 'flex';
          performSearch();
        }
      }, 300);
    }
  });
  linkEl.addEventListener('mouseenter', function() { this.style.opacity = '0.7'; });
  linkEl.addEventListener('mouseleave', function() { this.style.opacity = '1'; });
}

function renderRegionTimelineEvents(events, serverName) {
  const el = document.getElementById('region-timeline-events');
  if (!el) return;
  if (!events.length) {
    el.innerHTML = `<div style="text-align:center; padding:1.5rem; color: var(--text-muted); font-size:0.85rem;">${_t('아직 감지된 가입/탈퇴 내역이 없습니다.', '尚無偵測到的加入/退出紀錄。')}</div>`;
    return;
  }
  const { serverId, raceValue } = _resolveServerIdAndRace(serverName || '');
  // 날짜별 그룹화 (events는 최신순 정렬되어 옴)
  const groups = [];
  const map = {};
  events.forEach(ev => {
    if (!map[ev.date]) {
      map[ev.date] = [];
      groups.push(ev.date);
    }
    map[ev.date].push(ev);
  });
  const fmtDate = (iso) => {
    const parts = (iso || '').split('-');
    if (parts.length !== 3) return iso || '';
    return `${parts[0]}년 ${parseInt(parts[1])}월 ${parseInt(parts[2])}일`;
  };
  const fmtDateTw = (iso) => {
    const parts = (iso || '').split('-');
    if (parts.length !== 3) return iso || '';
    return `${parts[0]}/${parts[1]}/${parts[2]}`;
  };
  let html = '';
  groups.forEach(date => {
    const label = (SITE_LOCALE === 'zh-tw' || IS_GLOBAL) ? fmtDateTw(date) : fmtDate(date);
    html += `<div style="font-size:0.82rem; font-weight:700; color: var(--text-secondary); padding:0.5rem 0.4rem 0.35rem; border-bottom:1px solid var(--card-border); margin-top:0.3rem;">${label}</div>`;
    map[date].forEach(ev => {
      const isJoin = ev.type === 'join';
      const badgeColor = isJoin ? '#22d3ee' : '#f87171';
      const badgeBg = isJoin ? 'rgba(34,211,238,0.12)' : 'rgba(248,113,113,0.12)';
      const badgeText = isJoin ? _t('가입', '加入') : _t('탈퇴', '退出');
      const rawNick = ev.nickname || '';
      const nick = rawNick.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const nickHtml = (serverId && raceValue && rawNick)
        ? `<a href="${IS_GLOBAL ? SITE_URL_PREFIX : ''}/?nickname=${encodeURIComponent(rawNick)}&race=${raceValue}&server=${serverId}" class="nickname-link region-timeline-nickname-link" data-nickname="${rawNick.replace(/"/g, '&quot;')}" data-race="${raceValue}" data-server="${serverId}" style="font-size:0.88rem; color: var(--accent); text-decoration:none; cursor:pointer; transition:opacity 0.2s;">${nick}</a>`
        : `<span style="font-size:0.88rem; color: var(--text-primary);">${nick}</span>`;
      html += `<div style="display:flex; align-items:center; gap:0.5rem; padding:0.45rem 0.4rem;">
        <span style="flex-shrink:0; font-size:0.72rem; font-weight:700; color:${badgeColor}; background:${badgeBg}; border:1px solid ${badgeColor}55; border-radius:999px; padding:0.12rem 0.55rem;">${badgeText}</span>
        ${nickHtml}
      </div>`;
    });
  });
  el.innerHTML = html;
  el.querySelectorAll('.region-timeline-nickname-link').forEach(_attachRegionNicknameSearchHandler);
}

function _regionDestroyChart(key) {
  try {
    if (window.regionTimelineCharts[key]) {
      window.regionTimelineCharts[key].destroy();
      window.regionTimelineCharts[key] = null;
    }
  } catch (e) {}
}

function renderRegionTimelineCharts(series) {
  // Chart.js 로드 대기 후 렌더
  if (typeof Chart === 'undefined') {
    let tries = 0;
    const waiter = setInterval(() => {
      tries++;
      if (typeof Chart !== 'undefined') {
        clearInterval(waiter);
        _renderRegionTimelineChartsNow(series);
      } else if (tries > 100) {
        clearInterval(waiter);
      }
    }, 100);
    return;
  }
  _renderRegionTimelineChartsNow(series);
}

function _renderRegionTimelineChartsNow(series) {
  const labels = series.map(s => s.date);
  const memberValues = series.map(s => s.member_count);
  const powerValues = series.map(s => s.total_combat_power);
  const isMobile = window.innerWidth <= 768;

  const emptyMsg = `<div style="display:flex; align-items:center; justify-content:center; height:100%; color: var(--text-muted); font-size:0.85rem;">${_t('표시할 추이 데이터가 아직 없습니다.', '尚無可顯示的趨勢資料。')}</div>`;

  const buildChart = (wrapId, canvasId, chartKey, values, color, rgba, unit, labelText) => {
    const wrap = document.getElementById(wrapId);
    if (!wrap) return;
    _regionDestroyChart(chartKey);
    if (!series.length) { wrap.innerHTML = emptyMsg; return; }
    wrap.innerHTML = `<canvas id="${canvasId}"></canvas>`;
    const ctx = document.getElementById(canvasId).getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 220);
    grad.addColorStop(0, rgba(0.35));
    grad.addColorStop(1, rgba(0.02));
    window.regionTimelineCharts[chartKey] = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: labelText,
          data: values,
          borderColor: color,
          backgroundColor: grad,
          borderWidth: 2, fill: true, tension: 0.35,
          pointRadius: 0, pointHoverRadius: 5,
          pointBackgroundColor: color,
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(9, 16, 37, 0.98)',
            titleColor: '#f5f7ff', bodyColor: color,
            borderColor: color + '88', borderWidth: 1.5,
            padding: 12, displayColors: false,
            callbacks: {
              title: (items) => items.length ? items[0].label : '',
              label: (c) => `${labelText}: ${Number(c.parsed.y).toLocaleString()}${unit}`,
            }
          }
        },
        scales: {
          x: {
            grid: { color: 'rgba(255,255,255,0.05)' },
            ticks: { color: 'rgba(226,232,240,0.65)', maxRotation: 0, autoSkip: true, maxTicksLimit: isMobile ? 4 : 8, font: { size: isMobile ? 9 : 11 } }
          },
          y: {
            beginAtZero: false,
            grid: { color: 'rgba(255,255,255,0.05)' },
            ticks: {
              color: 'rgba(226,232,240,0.65)', font: { size: isMobile ? 9 : 11 },
              callback: (v) => {
                if (IS_GLOBAL) {   // 글로벌: 만 단위 대신 K/M
                  if (v >= 1e6) return (v / 1e6).toFixed(v % 1e6 === 0 ? 0 : 1) + 'M';
                  if (v >= 1e4) return (v / 1e3).toFixed(0) + 'K';
                  return Number(v).toLocaleString();
                }
                return v >= 10000 ? (v / 10000).toFixed(v % 10000 === 0 ? 0 : 1) + (SITE_LOCALE === 'zh-tw' ? '萬' : '만') : Number(v).toLocaleString();
              }
            }
          }
        }
      }
    });
  };

  buildChart('region-member-chart-wrap', 'region-member-chart', 'member', memberValues,
    'rgba(96, 165, 250, 1)', (a) => `rgba(96, 165, 250, ${a})`, IS_GLOBAL ? '' : _t('명', '人'), IS_GLOBAL ? 'Members' : _t('인원', '人數'));
  buildChart('region-power-chart-wrap', 'region-power-chart', 'power', powerValues,
    'rgba(45, 212, 191, 1)', (a) => `rgba(45, 212, 191, ${a})`, '', _t('전투력 총합', '總戰力'));
}

// ============================================================
// 길드원 목록 - 클래스 필터 / 정렬 / 일괄 로드 헬퍼
// (max 128명이라 사전 일괄 로드 후 클라이언트에서 정렬/필터)
// ============================================================

// 길드원 한 행을 DOM으로 렌더링 (재사용 헬퍼)
function renderRegionMemberRow(member, rowNumber) {
  const tr = document.createElement('tr');
  const raceColor = (member.race === '천족' || member.race === '天族') ? '#3b82f6' : '#ef4444';

  // 서버 정보 찾기
  const serverDataEl = document.getElementById('server-data');
  let servers = { elyos: [], asmodian: [] };
  if (serverDataEl && serverDataEl.textContent) {
    try { servers = JSON.parse(serverDataEl.textContent); } catch (e) {}
  }

  let serverId = null;
  let raceValue = null;
  for (const s of servers.elyos) {
    if (s.name === member.server) { serverId = s.id; raceValue = '1'; break; }
  }
  if (!serverId) {
    for (const s of servers.asmodian) {
      if (s.name === member.server) { serverId = s.id; raceValue = '2'; break; }
    }
  }

  const nicknameCell = serverId && raceValue
    ? `<a href="${IS_GLOBAL ? SITE_URL_PREFIX : ''}/?nickname=${encodeURIComponent(member.nickname)}&race=${raceValue}&server=${serverId}" class="nickname-link" data-nickname="${member.nickname}" data-race="${raceValue}" data-server="${serverId}" style="color: var(--accent); text-decoration: none; cursor: pointer; transition: opacity 0.2s;">${member.nickname}</a>`
    : member.nickname;

  const combatPower2 = member.combat_power2 ? Math.round(parseFloat(member.combat_power2)).toLocaleString() : '0';

  tr.innerHTML = `
    <td class="ranking-position col-rank">${rowNumber}</td>
    <td class="col-nickname">${nicknameCell}</td>
    <td class="col-server" style="color: ${raceColor};">${member.server}</td>
    <td class="col-job">${member.job}</td>
    <td class="col-power">${combatPower2}</td>
    <td class="col-power">${member.combat_power.toLocaleString()}</td>
  `;

  // 닉네임 클릭 → 캐릭터 검색
  const nicknameLink = tr.querySelector('.nickname-link');
  if (nicknameLink) {
    nicknameLink.addEventListener('click', function(e) {
      if (e.ctrlKey || e.metaKey || e.button === 1 || (e.button === 0 && e.shiftKey)) return;
      e.preventDefault();
      const nickname = this.getAttribute('data-nickname');
      const race = this.getAttribute('data-race');
      const sId = this.getAttribute('data-server');
      if (!(nickname && race && sId)) return;

      document.getElementById('character-result').style.display = 'none';
      document.getElementById('character-all-servers-result').style.display = 'none';
      document.getElementById('character-loading').style.display = 'block';
      const overlay = document.getElementById('fullscreen-loading-overlay');
      if (overlay) overlay.style.display = 'flex';

      const characterTab = document.getElementById('tab-character');
      if (characterTab) {
        characterTab.checked = true;
        characterTab.dispatchEvent(new Event('change'));
        updateSidebarVisibility();
        if (race) updateRaceSelection(race, true);

        const serverSelect = document.getElementById('server-select');
        const keywordInput = document.getElementById('character-keyword');
        setTimeout(() => {
          if (serverSelect) {
            serverSelect.value = sId;
            if (keywordInput) keywordInput.value = nickname;
            document.getElementById('character-loading').style.display = 'block';
            const overlay2 = document.getElementById('fullscreen-loading-overlay');
            if (overlay2) overlay2.style.display = 'flex';
            performSearch();
          }
        }, 300);
      }
    });
    nicknameLink.addEventListener('mouseenter', function() { this.style.opacity = '0.7'; });
    nicknameLink.addEventListener('mouseleave', function() { this.style.opacity = '1'; });
  }

  return tr;
}

// 정렬 + 필터 적용 후 테이블 렌더링
function renderRegionMembersTableWithSortAndFilter() {
  const membersBody = document.getElementById('region-members-body');
  if (!membersBody) return;

  // 1) 필터 적용
  let members = regionMembersSortState.allMembers.slice();
  if (regionMembersSortState.classFilter) {
    members = members.filter(m => (m.job || '') === regionMembersSortState.classFilter);
  }

  // 2) 정렬 적용
  const order = regionMembersSortState.currentSort === 'atrium'
    ? regionMembersSortState.atriumOrder
    : regionMembersSortState.combatOrder;
  members.sort((a, b) => {
    let valA, valB;
    if (regionMembersSortState.currentSort === 'atrium') {
      valA = a.combat_power2 || 0;
      valB = b.combat_power2 || 0;
    } else {
      valA = a.combat_power || 0;
      valB = b.combat_power || 0;
    }
    return order === 'desc' ? valB - valA : valA - valB;
  });

  // 3) 렌더링
  membersBody.innerHTML = '';
  if (members.length === 0) {
    membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color: var(--text-muted);">' + _t('해당 클래스의 멤버가 없습니다.', '沒有此職業的成員。') + '</td></tr>';
    return;
  }
  members.forEach((member, index) => {
    membersBody.appendChild(renderRegionMemberRow(member, index + 1));
  });
}

// 클래스 필터 버튼 렌더링
function renderRegionClassFilters() {
  const container = document.getElementById('region-class-filters');
  if (!container) return;

  const counts = {};
  regionMembersSortState.allMembers.forEach(m => {
    const job = m.job || '-';
    counts[job] = (counts[job] || 0) + 1;
  });

  const total = regionMembersSortState.allMembers.length;
  // 인원수 내림차순으로 정렬, 같으면 클래스명 가나다순
  const sortedClasses = Object.entries(counts).sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0]);
  });

  container.innerHTML = '';

  // 라벨
  const label = document.createElement('span');
  label.style.cssText = 'font-size: 0.75rem; color: var(--text-muted); padding: 0.2rem 0.4rem 0.2rem 0;';
  label.textContent = _t('클래스 필터', '職業篩選') + ':';
  container.appendChild(label);

  // 전체 버튼
  container.appendChild(
    createRegionFilterBtn(_t('전체', '全部'), total, regionMembersSortState.classFilter === null, () => applyRegionClassFilter(null))
  );

  sortedClasses.forEach(([cls, cnt]) => {
    container.appendChild(
      createRegionFilterBtn(cls, cnt, regionMembersSortState.classFilter === cls, () => applyRegionClassFilter(cls))
    );
  });
}

function createRegionFilterBtn(label, count, active, onClick) {
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.style.cssText = `
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid ${active ? 'var(--accent)' : 'var(--card-border)'};
    background: ${active ? 'var(--accent)' : 'rgba(255, 255, 255, 0.04)'};
    color: ${active ? '#fff' : 'var(--text-primary)'};
    cursor: pointer;
    font-size: 0.82rem;
    line-height: 1.2;
    transition: all 0.15s ease;
    white-space: nowrap;
  `;
  btn.innerHTML = `${label} <span style="opacity:0.85; font-weight:600;">(${count.toLocaleString()})</span>`;
  btn.addEventListener('click', onClick);
  if (!active) {
    btn.addEventListener('mouseenter', function() {
      this.style.background = 'rgba(255, 255, 255, 0.1)';
      this.style.borderColor = 'var(--accent)';
    });
    btn.addEventListener('mouseleave', function() {
      this.style.background = 'rgba(255, 255, 255, 0.04)';
      this.style.borderColor = 'var(--card-border)';
    });
  }
  return btn;
}

function applyRegionClassFilter(className) {
  regionMembersSortState.classFilter = className;
  renderRegionClassFilters();
  renderRegionMembersTableWithSortAndFilter();
  updateRegionMembersScrollStatus();
}

// 길드원 전체를 한 번에 병렬 로드 (max 128명이라 부담 없음)
async function loadAllRegionMembersAndSetup(server, guild, totalCount) {
  const membersBody = document.getElementById('region-members-body');
  if (membersBody) {
    membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color: var(--text-muted);">' + _t('길드원 목록을 불러오는 중...', '載入工會成員...') + '</td></tr>';
  }

  try {
    const serverEncoded = encodeURIComponent(server);
    const guildEncoded = encodeURIComponent(guild);
    const totalPages = Math.max(1, Math.ceil((totalCount || 0) / 100));

    // 모든 페이지 병렬 fetch
    const promises = [];
    for (let page = 1; page <= totalPages; page++) {
      promises.push(
        fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}?page=${page}&per_page=100`)
          .then(res => res.json())
          .catch(() => null)
      );
    }
    const results = await Promise.all(promises);

    // 멤버 병합
    regionMembersSortState.allMembers = [];
    results.forEach(data => {
      if (data && data.success && Array.isArray(data.members)) {
        regionMembersSortState.allMembers.push(...data.members);
      }
    });

    // 무한 스크롤 상태 갱신 (모두 로드 완료)
    regionMembersInfiniteScroll.isLoading = false;
    regionMembersInfiniteScroll.hasMore = false;
    regionMembersInfiniteScroll.loadedCount = regionMembersSortState.allMembers.length;
    regionMembersInfiniteScroll.totalCount = totalCount || regionMembersSortState.allMembers.length;

    // 정렬 아이콘 초기화
    const atriumIcon = document.getElementById('sort-atrium-icon');
    const combatIcon = document.getElementById('sort-combat-icon');
    if (atriumIcon) atriumIcon.textContent = regionMembersSortState.atriumOrder === 'desc' ? '▼' : '▲';
    if (combatIcon) combatIcon.textContent = '▽';

    renderRegionClassFilters();
    renderRegionMembersTableWithSortAndFilter();
    setupRegionMembersSortButtons();
    updateRegionMembersScrollStatus();
  } catch (err) {
    if (membersBody) {
      membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">' + _t('길드원 목록을 불러오는 중 오류가 발생했습니다: ', '載入工會成員時發生錯誤：') + (err && err.message ? err.message : '') + '</td></tr>';
    }
  }
}

// 길드원 목록 로드 (무한 스크롤) - 레거시: 사전 일괄 로드를 사용하므로 더 이상 호출되지 않음
function loadRegionMembers(server, guild, page = 1, isAppend = false) {
  // 무한 스크롤 상태 확인
  if (isAppend && (regionMembersInfiniteScroll.isLoading || !regionMembersInfiniteScroll.hasMore)) {
    return;
  }
  
  if (isAppend) {
    regionMembersInfiniteScroll.isLoading = true;
    updateRegionMembersScrollStatus(); // 로딩 상태 표시
  } else {
    // 초기 로드시 상태 리셋
    regionMembersInfiniteScroll.currentPage = 1;
    regionMembersInfiniteScroll.isLoading = false;
    regionMembersInfiniteScroll.hasMore = true;
    regionMembersInfiniteScroll.loadedCount = 0;
  }
  
  const membersBody = document.getElementById('region-members-body');
  
  // 로딩 메시지는 초기 로드시에만 표시
  if (membersBody && !isAppend) {
    membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color: var(--text-muted);">길드원 목록을 불러오는 중...</td></tr>';
  }
  
  const serverEncoded = encodeURIComponent(server);
  const guildEncoded = encodeURIComponent(guild);
  fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}?page=${page}&per_page=100`)
    .then(res => res.json())
    .then(data => {
      if (!data.success) {
        if (membersBody && !isAppend) {
          membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">길드원 목록을 불러오지 못했습니다.</td></tr>';
        }
        regionMembersInfiniteScroll.isLoading = false;
        return;
      }
      
      if (!data.members || data.members.length === 0) {
        if (!isAppend && membersBody) {
          membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">등록된 멤버가 없습니다.</td></tr>';
        }
        regionMembersInfiniteScroll.hasMore = false;
        regionMembersInfiniteScroll.isLoading = false;
        return;
      }
      
      // 무한 스크롤 상태 업데이트
      const currentLoadedCount = regionMembersInfiniteScroll.loadedCount;
      regionMembersInfiniteScroll.loadedCount += data.members.length;
      regionMembersInfiniteScroll.hasMore = data.members.length === 100;
      
      // 모든 멤버 데이터 저장
      if (!isAppend) {
        regionMembersSortState.allMembers = [];
      }
      data.members.forEach(member => {
        regionMembersSortState.allMembers.push(member);
      });
      
      // 멤버 목록 렌더링
      if (membersBody) {
        // 초기 로드시에만 비우기
        if (!isAppend) {
          membersBody.innerHTML = '';
        }
        
        data.members.forEach((member, index) => {
            const rowNumber = currentLoadedCount + index + 1;
            const tr = document.createElement('tr');
            const raceColor = (member.race === '천족' || member.race === '天族') ? '#3b82f6' : '#ef4444';
            
            // 서버 정보 찾기
            const serverDataEl = document.getElementById('server-data');
            let servers = { elyos: [], asmodian: [] };
            
            if (serverDataEl && serverDataEl.textContent) {
              try {
                servers = JSON.parse(serverDataEl.textContent);
              } catch (e) {
              }
            }
            
            let serverId = null;
            let raceValue = null;
            
            // 서버 ID 찾기
            for (const s of servers.elyos) {
              if (s.name === member.server) {
                serverId = s.id;
                raceValue = '1';
                break;
              }
            }
            if (!serverId) {
              for (const s of servers.asmodian) {
                if (s.name === member.server) {
                  serverId = s.id;
                  raceValue = '2';
                  break;
                }
              }
            }
            
            // 닉네임을 클릭 가능한 링크로 만들기 (전투력 랭킹과 동일한 방식)
            const nicknameCell = serverId && raceValue
              ? `<a href="${IS_GLOBAL ? SITE_URL_PREFIX : ''}/?nickname=${encodeURIComponent(member.nickname)}&race=${raceValue}&server=${serverId}" class="nickname-link" data-nickname="${member.nickname}" data-race="${raceValue}" data-server="${serverId}" style="color: var(--accent); text-decoration: none; cursor: pointer; transition: opacity 0.2s;">${member.nickname}</a>`
              : member.nickname;
            
            const combatPower2 = member.combat_power2 ? Math.round(parseFloat(member.combat_power2)).toLocaleString() : '0';
            
            tr.innerHTML = `
              <td class="ranking-position col-rank">${rowNumber}</td>
              <td class="col-nickname">${nicknameCell}</td>
              <td class="col-server" style="color: ${raceColor};">${member.server}</td>
              <td class="col-job">${member.job}</td>
              <td class="col-power">${combatPower2}</td>
              <td class="col-power">${member.combat_power.toLocaleString()}</td>
            `;
            
            // 닉네임 클릭 이벤트 추가 (전투력 랭킹과 동일한 방식)
            const nicknameLink = tr.querySelector('.nickname-link');
            if (nicknameLink) {
              nicknameLink.addEventListener('click', function(e) {
                // 새 탭에서 열 때는 기본 동작 허용
                if (e.ctrlKey || e.metaKey || e.button === 1 || (e.button === 0 && e.shiftKey)) {
                  return;
                }
                
                // 같은 탭에서 클릭할 때만 preventDefault
                e.preventDefault();
                const nickname = this.getAttribute('data-nickname');
                const race = this.getAttribute('data-race');
                const serverId = this.getAttribute('data-server');
                
                if (nickname && race && serverId) {
                  // 로딩 표시를 먼저 설정
                  document.getElementById('character-result').style.display = 'none';
                  document.getElementById('character-all-servers-result').style.display = 'none';
                  document.getElementById('character-loading').style.display = 'block';
                  const legionLoadingOverlay = document.getElementById('fullscreen-loading-overlay');
                  if (legionLoadingOverlay) {
                    legionLoadingOverlay.style.display = 'flex';
                  }
                  
                  // 캐릭터 검색 탭으로 이동
                  const characterTab = document.getElementById('tab-character');
                  if (characterTab) {
                    characterTab.checked = true;
                    characterTab.dispatchEvent(new Event('change'));
                    updateSidebarVisibility();
                    
                    // 종족 버튼 업데이트
                    if (race) {
                      updateRaceSelection(race, true);
                    }
                    
                    // 검색 폼에 값 설정
                    const serverSelect = document.getElementById('server-select');
                    const keywordInput = document.getElementById('character-keyword');
                    
                    // 서버 선택이 활성화될 때까지 대기
                    setTimeout(() => {
                      if (serverSelect) {
                        serverSelect.value = serverId;
                        if (keywordInput) keywordInput.value = nickname;
                        
                        // 로딩 표시 유지
                        document.getElementById('character-loading').style.display = 'block';
                        const legionLoadingOverlay2 = document.getElementById('fullscreen-loading-overlay');
                        if (legionLoadingOverlay2) {
                          legionLoadingOverlay2.style.display = 'flex';
                        }
                        
                        // 검색 실행
                        performSearch();
                      }
                    }, 300);
                  }
                }
              });
              
              // 호버 효과
              nicknameLink.addEventListener('mouseenter', function() {
                this.style.opacity = '0.7';
              });
              nicknameLink.addEventListener('mouseleave', function() {
                this.style.opacity = '1';
              });
            }
            
            membersBody.appendChild(tr);
          });
      }
      
      // 무한 스크롤 상태 업데이트
      regionMembersInfiniteScroll.isLoading = false;
      regionMembersInfiniteScroll.currentPage = page;
      updateRegionMembersScrollStatus();
      
      // 무한 스크롤 설정 (초기 로드 후)
      if (!isAppend) {
        setupRegionMembersInfiniteScroll();
        setupRegionMembersSortButtons();
      }
    })
    .catch(err => {
      if (!isAppend && membersBody) {
        membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">길드원 목록을 불러오는 중 오류가 발생했습니다: ' + err.message + '</td></tr>';
      }
      regionMembersInfiniteScroll.isLoading = false;
    });
}

// 길드원 목록 정렬 (사전 일괄 로드된 데이터를 기준으로 정렬 + 필터 재적용)
function sortRegionMembers(sortBy) {
  const membersBody = document.getElementById('region-members-body');
  if (!membersBody || regionMembersSortState.allMembers.length === 0) return;

  // 안전장치: 혹시 아직 모두 로드되지 않았다면 먼저 모두 로드
  if (regionMembersInfiniteScroll.hasMore) {
    membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:2rem; color: var(--text-muted);">전체 데이터를 불러오는 중...</td></tr>';
    loadAllMembersForSorting(sortBy);
    return;
  }

  // 정렬 순서 토글
  let order = 'desc';
  if (sortBy === 'atrium') {
    regionMembersSortState.atriumOrder = regionMembersSortState.atriumOrder === 'desc' ? 'asc' : 'desc';
    order = regionMembersSortState.atriumOrder;
    regionMembersSortState.currentSort = 'atrium';
  } else if (sortBy === 'combat') {
    regionMembersSortState.combatOrder = regionMembersSortState.combatOrder === 'desc' ? 'asc' : 'desc';
    order = regionMembersSortState.combatOrder;
    regionMembersSortState.currentSort = 'combat';
  }

  // 정렬 아이콘 업데이트
  const atriumIcon = document.getElementById('sort-atrium-icon');
  const combatIcon = document.getElementById('sort-combat-icon');
  if (sortBy === 'atrium') {
    if (atriumIcon) atriumIcon.textContent = order === 'desc' ? '▼' : '▲';
    if (combatIcon) combatIcon.textContent = '▽';
  } else {
    if (combatIcon) combatIcon.textContent = order === 'desc' ? '▼' : '▲';
    if (atriumIcon) atriumIcon.textContent = '▽';
  }

  // 정렬 + 필터 적용된 테이블 다시 렌더링
  renderRegionMembersTableWithSortAndFilter();

  // 스크롤 상태 업데이트 (모든 데이터 표시됨)
  regionMembersInfiniteScroll.loadedCount = regionMembersSortState.allMembers.length;
  regionMembersInfiniteScroll.hasMore = false;
  updateRegionMembersScrollStatus();
}

// 정렬을 위해 모든 멤버 로드
async function loadAllMembersForSorting(sortBy) {
  const server = regionMembersInfiniteScroll.currentServer;
  const guild = regionMembersInfiniteScroll.currentGuild;
  const totalCount = regionMembersInfiniteScroll.totalCount;
  
  try {
    // 모든 데이터를 한 번에 로드 (최대 1000명까지 안전하게 처리)
    const serverEncoded = encodeURIComponent(server);
    const guildEncoded = encodeURIComponent(guild);
    const response = await fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}?page=1&per_page=100`);
    const firstPageData = await response.json();
    
    if (!firstPageData.success || !firstPageData.members) {
      throw new Error('데이터 로드 실패');
    }
    
    // 모든 페이지 수 계산
    const totalPages = Math.ceil(totalCount / 100);
    
    // 첫 페이지는 이미 있으므로 나머지 페이지 로드
    const remainingPages = [];
    for (let page = 2; page <= totalPages; page++) {
      remainingPages.push(
        fetch(`${SITE_URL_PREFIX}/api/region/${serverEncoded}/${guildEncoded}?page=${page}&per_page=100`)
          .then(res => res.json())
      );
    }
    
    // 모든 페이지 동시에 로드
    const remainingData = await Promise.all(remainingPages);
    
    // 모든 멤버 데이터 병합
    regionMembersSortState.allMembers = [...firstPageData.members];
    remainingData.forEach(data => {
      if (data.success && data.members) {
        regionMembersSortState.allMembers.push(...data.members);
      }
    });
    
    // 무한 스크롤 상태 업데이트
    regionMembersInfiniteScroll.loadedCount = regionMembersSortState.allMembers.length;
    regionMembersInfiniteScroll.hasMore = false;
    
    // 정렬 실행
    sortRegionMembers(sortBy);
  } catch (err) {
    const membersBody = document.getElementById('region-members-body');
    if (membersBody) {
      membersBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:1rem;">전체 데이터를 불러오는 중 오류가 발생했습니다: ' + err.message + '</td></tr>';
    }
  }
}

// 길드원 목록 정렬 버튼 설정
function setupRegionMembersSortButtons() {
  const atriumBtn = document.getElementById('sort-atrium');
  const combatBtn = document.getElementById('sort-combat');
  
  if (atriumBtn) {
    atriumBtn.addEventListener('click', () => {
      sortRegionMembers('atrium');
    });
  }
  
  if (combatBtn) {
    combatBtn.addEventListener('click', () => {
      sortRegionMembers('combat');
    });
  }
}

// 길드원 목록 스크롤 상태 업데이트
function updateRegionMembersScrollStatus() {
  let statusEl = document.getElementById('region-members-scroll-status');
  if (!statusEl) {
    return;
  }
  
  const { loadedCount, totalCount, hasMore, isLoading } = regionMembersInfiniteScroll;
  
  if (isLoading) {
    statusEl.textContent = '로딩 중...';
    statusEl.style.color = '#999';
  } else if (!hasMore && loadedCount >= totalCount) {
    statusEl.textContent = `전체 ${totalCount.toLocaleString()}명의 길드원을 모두 불러왔습니다.`;
    statusEl.style.color = '#999';
  } else if (!hasMore) {
    statusEl.textContent = `${loadedCount.toLocaleString()}명 불러옴`;
    statusEl.style.color = '#999';
  } else {
    statusEl.textContent = `${loadedCount.toLocaleString()}명 / ${totalCount.toLocaleString()}명`;
    statusEl.style.color = '#999';
  }
}

// 길드원 목록 무한 스크롤 설정
function setupRegionMembersInfiniteScroll() {
  const detailView = document.getElementById('region-ranking-detail-view');
  if (!detailView) return;
  
  // 기존 리스너 제거를 위한 표시
  if (detailView._membersScrollHandler) {
    window.removeEventListener('scroll', detailView._membersScrollHandler);
  }
  
  // 새로운 스크롤 핸들러
  const scrollHandler = () => {
    // 페이지 하단 근처인지 확인 (하단 500px 이내)
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const scrollHeight = document.documentElement.scrollHeight;
    const clientHeight = document.documentElement.clientHeight;
    
    if (scrollTop + clientHeight >= scrollHeight - 500) {
      if (!regionMembersInfiniteScroll.isLoading && regionMembersInfiniteScroll.hasMore) {
        const nextPage = regionMembersInfiniteScroll.currentPage + 1;
        loadRegionMembers(
          regionMembersInfiniteScroll.currentServer,
          regionMembersInfiniteScroll.currentGuild,
          nextPage,
          true
        );
      }
    }
  };
  
  // 리스너 등록
  detailView._membersScrollHandler = scrollHandler;
  window.addEventListener('scroll', scrollHandler);
}

// 레기온 랭킹 필터 복원
function restoreRegionFilters() {
  // 종족 필터 복원
  const raceBtns = document.querySelectorAll('#region-race-all, #region-race-elyos, #region-race-asmodian');
  raceBtns.forEach(btn => {
    btn.classList.remove('active');
    if (btn.dataset.race === currentRegionRaceFilter) {
      btn.classList.add('active');
    }
  });
  
  // 서버 필터 복원
  if (currentRegionRaceFilter && currentRegionRaceFilter !== 'all') {
    updateRegionServerFilters(currentRegionRaceFilter);
    // 서버 필터 버튼 활성화
    setTimeout(() => {
      const serverBtns = document.querySelectorAll('#region-server-filters .ranking-filter-btn');
      serverBtns.forEach(btn => {
        btn.classList.remove('active');
        if (btn.dataset.value === currentRegionServerFilter) {
          btn.classList.add('active');
        }
      });
    }, 100);
  } else {
    // "전체"를 선택한 경우 서버 필터 숨김 및 리셋
    updateRegionServerFilters('all');
    currentRegionServerFilter = 'all';
  }
  
  // 검색어 복원
  const searchInput = document.getElementById('region-search-input');
  if (searchInput) {
    searchInput.value = regionSearchQuery;
  }
}

// 레기온 랭킹 필터 초기화
function initializeRegionRankingFilters() {
  // 이미 초기화되었는지 확인
  if (window.regionRankingFiltersInitialized) {
    // 이미 초기화되었으면 서버 필터만 업데이트
    const activeRaceBtn = document.querySelector('#region-race-all.active, #region-race-elyos.active, #region-race-asmodian.active') || document.querySelector('#region-race-all');
    if (activeRaceBtn) {
      currentRegionRaceFilter = activeRaceBtn.dataset.race || 'all';
      updateRegionServerFilters(currentRegionRaceFilter);
    }
    return;
  }
  window.regionRankingFiltersInitialized = true;
  
  // 서버 필터 (종족별) - 이벤트 위임 사용
  const raceFilterContainer = document.querySelector('#region-ranking-content');
  if (raceFilterContainer) {
    raceFilterContainer.addEventListener('click', (e) => {
      const btn = e.target.closest('#region-race-all, #region-race-elyos, #region-race-asmodian');
      if (btn) {
        const raceBtns = document.querySelectorAll('#region-race-all, #region-race-elyos, #region-race-asmodian');
        raceBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const newRaceFilter = btn.dataset.race || 'all';
        
        // 종족 필터가 변경되면 서버 필터도 "전체"로 리셋
        if (currentRegionRaceFilter !== newRaceFilter) {
          currentRegionServerFilter = 'all';
        }
        currentRegionRaceFilter = newRaceFilter;
        
        // "전체" 버튼을 클릭한 경우 서버 필터도 "전체"로 리셋
        if (currentRegionRaceFilter === 'all') {
          currentRegionServerFilter = 'all';
          const serverFiltersContainer = document.getElementById('region-server-filters');
          if (serverFiltersContainer) {
            serverFiltersContainer.style.display = 'none';
          }
        } else {
          // "천족" 또는 "마족"을 선택한 경우 서버 필터 표시
          const serverFiltersContainer = document.getElementById('region-server-filters');
          if (serverFiltersContainer) {
            serverFiltersContainer.style.display = 'flex';
          }
        }
        
        // 서버 목록 업데이트
        updateRegionServerFilters(currentRegionRaceFilter);
        loadRegionRankings(1);
      }
    });
  }
  
  // 레기온 검색
  const searchInput = document.getElementById('region-search-input');
  const searchButton = document.getElementById('region-search-button');
  if (searchInput && searchButton) {
    const performSearch = () => {
      regionSearchQuery = searchInput.value.trim();
      loadRegionRankings(1);
    };
    searchButton.addEventListener('click', performSearch);
    searchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        performSearch();
      }
    });
  }
  
  // URL 파라미터에서 필터 상태 읽기
  const urlParams = new URLSearchParams(window.location.search);
  const urlRace = urlParams.get('race');
  const urlServer = urlParams.get('server');
  const urlSearch = urlParams.get('search');
  
  if (urlRace) {
    currentRegionRaceFilter = urlRace;
  }
  if (urlServer) {
    currentRegionServerFilter = urlServer;
  }
  if (urlSearch) {
    regionSearchQuery = urlSearch;
    if (searchInput) {
      searchInput.value = urlSearch;
    }
  }
  
  // 초기 서버 필터 설정
  const activeRaceBtn = document.querySelector('#region-race-all.active, #region-race-elyos.active, #region-race-asmodian.active') || document.querySelector('#region-race-all');
  
  // URL 파라미터가 있으면 그것을 우선 사용
  if (urlRace) {
    const raceBtns = document.querySelectorAll('#region-race-all, #region-race-elyos, #region-race-asmodian');
    raceBtns.forEach(btn => {
      btn.classList.remove('active');
      if (btn.dataset.race === urlRace) {
        btn.classList.add('active');
      }
    });
    updateRegionServerFilters(urlRace);
  } else if (activeRaceBtn) {
    currentRegionRaceFilter = activeRaceBtn.dataset.race || 'all';
    updateRegionServerFilters(currentRegionRaceFilter);
  } else {
    updateRegionServerFilters('all');
  }
  
  // 서버 필터 버튼 활성화 (약간의 지연 필요)
  if (urlServer) {
    setTimeout(() => {
      const serverBtns = document.querySelectorAll('#region-server-filters .ranking-filter-btn');
      serverBtns.forEach(btn => {
        btn.classList.remove('active');
        if (btn.dataset.value === urlServer) {
          btn.classList.add('active');
        }
      });
    }, 200);
  }
  
  // 무한 스크롤 상태 초기화
  regionRankingInfiniteScroll.currentPage = 1;
  regionRankingInfiniteScroll.isLoading = false;
  regionRankingInfiniteScroll.hasMore = true;
  regionRankingInfiniteScroll.totalCount = 0;
  regionRankingInfiniteScroll.loadedCount = 0;
  regionRankingDataCache = {};
}

// 레기온 랭킹 서버 필터 업데이트
function updateRegionServerFilters(race) {
  const serverFiltersContainer = document.getElementById('region-server-filters');
  if (!serverFiltersContainer) {
    return;
  }
  
  // "전체"를 선택한 경우 서버 필터를 숨김
  if (race === 'all') {
    serverFiltersContainer.style.display = 'none';
    // 서버 필터도 "전체"로 리셋
    currentRegionServerFilter = 'all';
    return;
  }
  
  // "천족" 또는 "마족"을 선택한 경우 서버 필터 표시
  serverFiltersContainer.style.display = 'flex';
  
  const serverDataEl = document.getElementById('server-data');
  if (!serverDataEl) {
    return;
  }
  
  try {
    const servers = JSON.parse(serverDataEl.textContent);
    serverFiltersContainer.innerHTML = '<button class="ranking-filter-btn active" data-filter-type="server" data-value="all">전체</button>';
    
    // 전체 버튼 클릭 이벤트
    const allBtn = serverFiltersContainer.querySelector('.ranking-filter-btn[data-value="all"]');
    if (allBtn) {
      allBtn.addEventListener('click', () => {
        serverFiltersContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
        allBtn.classList.add('active');
        currentRegionServerFilter = 'all';
        loadRegionRankings(1);
      });
    }
    
    let serverList = [];
    if (race === 'elyos') {
      serverList = servers.elyos || [];
    } else if (race === 'asmodian') {
      serverList = servers.asmodian || [];
    } else {
      serverList = [...(servers.elyos || []), ...(servers.asmodian || [])];
    }
    
    serverList.forEach(server => {
      const btn = document.createElement('button');
      btn.className = 'ranking-filter-btn';
      btn.dataset.filterType = 'server';
      btn.dataset.value = server.name;
      btn.textContent = server.name;
      btn.addEventListener('click', () => {
        serverFiltersContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentRegionServerFilter = server.name;
        loadRegionRankings(1);
      });
      serverFiltersContainer.appendChild(btn);
    });
  } catch (error) {
  }
}

// 내실 랭킹 이벤트 리스너 초기화 함수 (전역 함수)
function setupInternalRankingEventListeners() {
  // 이미 설정되었으면 중복 실행 방지
  if (window.internalRankingListenersSetup) {
    return;
  }
  
  // 이벤트 위임을 사용하여 내실 랭킹 컨텐츠 영역에서 서브탭 클릭 처리
  const internalRankingContent = document.getElementById('internal-ranking-content');
  if (!internalRankingContent) {
    return;
  }
  
  // 내실 랭킹 서브탭은 이제 <a> 태그로 페이지 이동 처리
  // 클릭 이벤트 등록 불필요
  
  // 내실 랭킹 직업 필터 버튼 클릭 이벤트 (중복 등록 방지)
  const internalJobFilterButtons = document.querySelectorAll('#internal-ranking-job-filters .ranking-filter-btn');
  internalJobFilterButtons.forEach(btn => {
    if (btn.dataset.listenerAttached === 'true') {
      return;
    }
    btn.dataset.listenerAttached = 'true';
    btn.addEventListener('click', function() {
      const job = this.getAttribute('data-value') || 'all';
      currentInternalJobFilter = job;
      
      // active 클래스 토글
      internalJobFilterButtons.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      // URL 업데이트 (replace로 변경하여 히스토리 스택 쌓이지 않도록)
      const internalRankingURL = buildInternalRankingURL(
        currentInternalRankingType,
        currentInternalJobFilter,
        currentInternalServerRaceFilter,
        currentInternalServerFilter
      );
      updateURL(internalRankingURL, true); // replace=true로 변경
      
      // 데이터 다시 로드
      loadInternalRanking(1);
    });
  });
  
  // 내실 랭킹 서버 필터 탭 버튼 (전체/천족/마족) - 중복 등록 방지
  const internalServerTabButtons = document.querySelectorAll('.internal-server-tab');
  internalServerTabButtons.forEach(tabBtn => {
    if (tabBtn.dataset.listenerAttached === 'true') {
      return;
    }
    tabBtn.dataset.listenerAttached = 'true';
    tabBtn.addEventListener('click', function() {
      const race = this.getAttribute('data-race');
      currentInternalServerRaceFilter = race;
      currentInternalServerFilter = 'all';
      
      // 탭 버튼 active 토글
      internalServerTabButtons.forEach(b => {
        b.classList.remove('active');
        b.style.background = 'rgba(255, 255, 255, 0.05)';
        b.style.borderColor = 'var(--card-border)';
        b.style.color = 'var(--text-primary)';
      });
      this.classList.add('active');
      this.style.background = 'rgba(157, 140, 255, 0.16)';
      this.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      this.style.color = 'var(--accent)';
      
      // 서버 버튼 업데이트
      updateInternalServerFilters(race);
      
      // 전체 탭이면 전체 서버 버튼 활성화
      if (race === 'all') {
        const serverFilterContainer = document.getElementById('internal-ranking-server-filters');
        if (serverFilterContainer) {
          const allServerBtn = serverFilterContainer.querySelector('[data-value="all"]');
          if (allServerBtn) {
            serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
            allServerBtn.classList.add('active');
          }
        }
      }
      
      // URL 업데이트 (replace로 변경하여 히스토리 스택 쌓이지 않도록)
      const internalRankingURL = buildInternalRankingURL(
        currentInternalRankingType,
        currentInternalJobFilter,
        currentInternalServerRaceFilter,
        currentInternalServerFilter
      );
      updateURL(internalRankingURL, true); // replace=true로 변경
      
      // 데이터 다시 로드
      loadInternalRanking(1);
    });
  });

  // 플래그 설정 (이벤트 리스너 등록 완료)
  window.internalRankingListenersSetup = true;
}

// 아툴 전투 점수 랭킹 관련 변수 (전역 스코프)
// 중복 선언 방지
if (typeof currentCombatScoreJobFilter === 'undefined') {
  var currentCombatScoreJobFilter = 'all';
}
if (typeof currentCombatScoreServerFilter === 'undefined') {
  var currentCombatScoreServerFilter = 'all';
}
if (typeof currentCombatScoreServerRaceFilter === 'undefined') {
  var currentCombatScoreServerRaceFilter = 'all';
}
if (typeof currentCombatScoreMaxScoreFilter === 'undefined') {
  var currentCombatScoreMaxScoreFilter = 'all';
}
if (typeof currentCombatScoreSortFilter === 'undefined') {
  var currentCombatScoreSortFilter = 'combat_power2';
}
if (typeof currentCombatScorePage === 'undefined') {
  var currentCombatScorePage = 1;
}

// 전투점수 랭킹 무한 스크롤 상태
var combatScoreInfiniteScroll = {
  currentPage: 1,
  isLoading: false,
  hasMore: true,
  totalCount: 0,
  loadedCount: 0
};
var combatScoreDataCache = {};
var COMBAT_SCORE_CACHE_DURATION = 5 * 60 * 1000; // 5분

// 아툴 전투 점수 랭킹 로드 함수 (무한 스크롤 지원)
function loadCombatScoreRanking(page = 1, isAppend = false) {
  // 무한 스크롤 상태 확인
  if (isAppend && (combatScoreInfiniteScroll.isLoading || !combatScoreInfiniteScroll.hasMore)) {
    return;
  }
  
  if (isAppend) {
    combatScoreInfiniteScroll.isLoading = true;
  } else {
    // 초기 로드시 상태 리셋
    combatScoreInfiniteScroll.currentPage = 1;
    combatScoreInfiniteScroll.isLoading = false;
    combatScoreInfiniteScroll.hasMore = true;
    combatScoreInfiniteScroll.totalCount = 0;
    combatScoreInfiniteScroll.loadedCount = 0;
  }
  currentCombatScorePage = page;
  const params = new URLSearchParams();
  
  if (currentCombatScoreJobFilter && currentCombatScoreJobFilter !== 'all') {
    params.append('job', currentCombatScoreJobFilter);
  } else {
    params.append('job', 'all');
  }
  
  if (currentCombatScoreServerFilter && currentCombatScoreServerFilter !== 'all') {
    params.append('server', currentCombatScoreServerFilter);
  } else {
    params.append('server', 'all');
  }
  
  if (currentCombatScoreServerRaceFilter && currentCombatScoreServerRaceFilter !== 'all') {
    params.append('race', currentCombatScoreServerRaceFilter);
  } else {
    params.append('race', 'all');
  }
  
  // 전투 점수 필터 추가
  if (currentCombatScoreMaxScoreFilter && currentCombatScoreMaxScoreFilter !== 'all') {
    params.append('max_score', currentCombatScoreMaxScoreFilter);
  } else {
    params.append('max_score', 'all');
  }
  
  // 전투력(combat_power2) 기준 정렬 고정
  params.append('sort_by', 'combat_power2');
  
  params.append('page', page);
  params.append('per_page', 100);
  
  const combatScoreRankingBody = document.getElementById('combat-score-ranking-body');
  const combatScoreRankingPagination = document.getElementById('combat-score-ranking-pagination');
  
  if (!combatScoreRankingBody) return;
  
  // 로딩 메시지는 초기 로드시에만 표시
  if (!isAppend) {
    combatScoreRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.combat_score_loading', '아툴 전투 점수 랭킹 데이터를 불러오는 중...') + '</td></tr>';
  }
  
  const apiUrl = `${SITE_URL_PREFIX}/api/combat-score-rankings?${params.toString()}`;
  
  fetch(apiUrl)
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      if (!data.success) {
        combatScoreRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + (data.error || TA('ranking.combat_score_load_failed', '아툴 전투 점수 랭킹 데이터를 불러오지 못했습니다.')) + '</td></tr>';
        if (combatScoreRankingPagination) {
          combatScoreRankingPagination.style.display = 'none';
        }
        return;
      }

      // 마지막 업데이트 시간 표시
      const lastUpdateEl = document.getElementById('combat-score-ranking-last-update');
      if (lastUpdateEl) {
        lastUpdateEl.textContent = TA('ranking.refresh_hourly', '1시간마다 갱신');
      }
      
      const rows = data.data || [];
      if (!rows.length) {
        combatScoreRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.combat_score_empty', '아툴 전투 점수 랭킹 데이터가 없습니다.') + '</td></tr>';
        if (combatScoreRankingPagination) {
          combatScoreRankingPagination.style.display = 'none';
        }
        combatScoreInfiniteScroll.hasMore = false;
        combatScoreInfiniteScroll.isLoading = false;
        combatScoreInfiniteScroll.totalCount = (data.pagination && data.pagination.total_count) ? data.pagination.total_count : 0;
        combatScoreInfiniteScroll.loadedCount = 0;
        updateCombatScoreScrollStatus();
        return;
      }
      
      // 무한 스크롤 상태 업데이트
      const currentLoadedCount = combatScoreInfiniteScroll.loadedCount;
      combatScoreInfiniteScroll.totalCount = data.pagination.total_count;
      combatScoreInfiniteScroll.loadedCount += rows.length;
      combatScoreInfiniteScroll.hasMore = rows.length === 100;
      
      // 테이블 행 생성
      let html = '';
      rows.forEach((row, index) => {
        const rank = currentLoadedCount + index + 1;
        const jobLabel = row.job || '';
        const jobImageUrl = row.job_image_url || '';
        const guild = row.guild || '-';
        const nickname = row.nickname || '';
        const serverName = row.server || '';
        const raceName = row.race || '';
        
        let raceValue = '';
        let serverId = '';
        
        if ((raceName === '천족' || raceName === '天族')) {
          raceValue = '1';
          if (servers && servers.elyos) {
            const serverInfo = findServerByName(servers.elyos, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceValue = '2';
          if (servers && servers.asmodian) {
            const serverInfo = findServerByName(servers.asmodian, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        }
        
        const jobDisplayCs = displayJobLabel(jobLabel);
        let jobCell = '';
        if (jobImageUrl) {
          jobCell = `<img src="${jobImageUrl}" alt="${jobDisplayCs}" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">${jobDisplayCs}`;
        } else {
          jobCell = jobDisplayCs;
        }
        
        const nicknameCell = serverId && raceValue 
          ? `<a href="${SITE_URL_PREFIX}/?nickname=${encodeURIComponent(nickname)}&race=${raceValue}&server=${serverId}" class="nickname-link" style="color: var(--accent); text-decoration: none; cursor: pointer;">${nickname}</a>`
          : nickname;
        
        let raceCell = raceName;
        if ((raceName === '천족' || raceName === '天族')) {
          raceCell = `<span style="color: #4a90e2;">${displayRaceLabel(raceName)}</span>`;
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceCell = `<span style="color: #e24a4a;">${displayRaceLabel(raceName)}</span>`;
        }
        
        const rankingValue = row.ranking_value || 0;
        const combatPower2 = row.combat_power2 || 0;
        const combatPowerCell = combatPower2 > 0
          ? `<strong style="color:#3b82f6;">${parseInt(combatPower2).toLocaleString()}</strong>`
          : '-';
        
        html += `
          <tr>
            <td class="ranking-position col-rank">${rank}</td>
            <td class="col-nickname">${nicknameCell}</td>
            <td class="col-job">${jobCell}</td>
            <td class="col-race">${raceCell}</td>
            <td class="col-server">${serverName}</td>
            <td class="col-guild">${guild}</td>
            <td class="col-power">${combatPowerCell}</td>
          </tr>
        `;
      });
      
      // isAppend면 추가, 아니면 덮어쓰기
      if (isAppend) {
        combatScoreRankingBody.insertAdjacentHTML('beforeend', html);
      } else {
        combatScoreRankingBody.innerHTML = html;
      }
      
      // 무한 스크롤 상태 업데이트
      combatScoreInfiniteScroll.isLoading = false;
      updateCombatScoreScrollStatus();
      
      // 페이지네이션 숨기기 (무한 스크롤 사용)
      if (combatScoreRankingPagination) {
        combatScoreRankingPagination.style.display = 'none';
      }
      
      // 닉네임 클릭 이벤트 추가 (window.location.href 방식으로 통일 - 애드센스 PV 증대)
      combatScoreRankingBody.querySelectorAll('.nickname-link').forEach(link => {
        link.addEventListener('click', function(e) {
          // 마우스 휠 클릭(중간 클릭)이나 Ctrl+클릭, Shift+클릭(새 탭/새 창)은 기본 동작 허용
          if (e.button === 1 || e.ctrlKey || e.metaKey || e.shiftKey) {
            return; // 기본 동작 허용 (새 탭으로 열기)
          }
          
          // 일반 클릭은 실제 페이지 이동 (애드센스 수익 증대)
          e.preventDefault();
          
          const parsed = parseNicknameQueryFromHref(this.getAttribute('href'));
          if (parsed) {
            const { nickname, race, serverId } = parsed;
              // ★ 클릭 즉시 로딩 표시 (UX 개선)
              const characterLoading = document.getElementById('character-loading');
              const loadingOverlay = document.getElementById('fullscreen-loading-overlay');
              const characterResult = document.getElementById('character-result');
              const allServersResult = document.getElementById('character-all-servers-result');
              
              if (characterResult) characterResult.style.display = 'none';
              if (allServersResult) allServersResult.style.display = 'none';
              if (characterLoading) characterLoading.style.display = 'block';
              if (loadingOverlay) loadingOverlay.style.display = 'flex';
              
              // 로딩 표시가 렌더링될 시간을 주고 페이지 이동
              requestAnimationFrame(() => {
                window.location.href = `${SITE_URL_PREFIX}/char/serverid=${serverId}/${encodeURIComponent(nickname)}`;
              });
          }
        });
      });
      
      // 무한 스크롤 설정 (초기 로드 후)
      if (!isAppend) {
        setupCombatScoreInfiniteScroll();
      }
    })
    .catch(err => {
      if (!isAppend) {
        combatScoreRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.combat_score_load_error', '아툴 전투 점수 랭킹 데이터를 불러오는 중 오류가 발생했습니다: ') + err.message + '</td></tr>';
      }
      if (combatScoreRankingPagination) {
        combatScoreRankingPagination.style.display = 'none';
      combatScoreInfiniteScroll.isLoading = false;
      }
    });
}

// 전투점수 랭킹 스크롤 상태 업데이트
function updateCombatScoreScrollStatus() {
  let statusEl = document.getElementById('combat-score-ranking-scroll-status');
  if (!statusEl) {
    const container = document.getElementById('combat-score-ranking-container');
    if (container) {
      statusEl = document.createElement('div');
      statusEl.id = 'combat-score-ranking-scroll-status';
      statusEl.style.textAlign = 'center';
      statusEl.style.padding = '1rem';
      statusEl.style.color = '#999';
      statusEl.style.fontSize = '0.85rem';
      container.appendChild(statusEl);
    }
  }
  
  if (statusEl) {
    const n = combatScoreInfiniteScroll.loadedCount;
    if (combatScoreInfiniteScroll.hasMore) {
      statusEl.innerHTML = TA('ranking.loaded_count_scroll', '{n}명 로드됨 (스크롤하여 더 보기)').replace(/\{n\}/g, String(n));
    } else {
      statusEl.innerHTML = TA('ranking.all_loaded_count', '모든 데이터를 로드했습니다. (총 {n}명)').replace(/\{n\}/g, String(n));
    }
  }
}

// 전투점수 랭킹 무한 스크롤 설정
function setupCombatScoreInfiniteScroll() {
  const combatScoreRankingPagination = document.getElementById('combat-score-ranking-pagination');
  let sentinel = document.getElementById('combat-score-ranking-scroll-sentinel');
  
  if (!sentinel) {
    sentinel = document.createElement('div');
    sentinel.id = 'combat-score-ranking-scroll-sentinel';
    sentinel.style.height = '1px';
    sentinel.style.width = '100%';
    sentinel.style.opacity = '0';
    sentinel.style.pointerEvents = 'none';
    
    const container = document.getElementById('combat-score-ranking-container');
    if (container) {
      container.appendChild(sentinel);
    }
  }
  
  // 기존 observer 해제
  if (window.combatScoreObserver) {
    window.combatScoreObserver.disconnect();
  }
  
  // 새로운 observer 생성
  window.combatScoreObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && 
          !combatScoreInfiniteScroll.isLoading && 
          combatScoreInfiniteScroll.hasMore &&
          combatScoreInfiniteScroll.loadedCount > 0) {
        combatScoreInfiniteScroll.currentPage++;
        loadCombatScoreRanking(combatScoreInfiniteScroll.currentPage, true);
      }
    });
  }, {
    root: null,
    rootMargin: '300px',
    threshold: 0
  });
  
  window.combatScoreObserver.observe(sentinel);
}

// 아툴 전투 점수 랭킹 페이지네이션 렌더링
function renderCombatScoreRankingPagination(pagination) {
  const combatScoreRankingPagination = document.getElementById('combat-score-ranking-pagination');
  if (!combatScoreRankingPagination) return;
  
  const { page, total_pages, total_count } = pagination;
  combatScoreRankingPagination.style.display = 'flex';
  combatScoreRankingPagination.innerHTML = '';
  
  const prevBtn = document.createElement('button');
  prevBtn.className = 'pagination-btn';
  prevBtn.textContent = TA('common.previous', '이전');
  prevBtn.disabled = page === 1;
  prevBtn.addEventListener('click', () => {
    if (page > 1) {
      loadCombatScoreRanking(page - 1);
    }
  });
  combatScoreRankingPagination.appendChild(prevBtn);
  
  const startPage = Math.max(1, page - 2);
  const endPage = Math.min(total_pages, page + 2);
  
  if (startPage > 1) {
    const firstBtn = document.createElement('button');
    firstBtn.className = 'pagination-btn';
    firstBtn.textContent = '1';
    firstBtn.addEventListener('click', () => loadCombatScoreRanking(1));
    combatScoreRankingPagination.appendChild(firstBtn);
    
    if (startPage > 2) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      combatScoreRankingPagination.appendChild(ellipsis);
    }
  }
  
  for (let i = startPage; i <= endPage; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.className = 'pagination-btn';
    pageBtn.textContent = i.toString();
    if (i === page) {
      pageBtn.classList.add('active');
    }
    pageBtn.addEventListener('click', () => loadCombatScoreRanking(i));
    combatScoreRankingPagination.appendChild(pageBtn);
  }
  
  if (endPage < total_pages) {
    if (endPage < total_pages - 1) {
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pagination-info';
      ellipsis.textContent = '...';
      combatScoreRankingPagination.appendChild(ellipsis);
    }
    
    const lastBtn = document.createElement('button');
    lastBtn.className = 'pagination-btn';
    lastBtn.textContent = total_pages.toString();
    lastBtn.addEventListener('click', () => loadCombatScoreRanking(total_pages));
    combatScoreRankingPagination.appendChild(lastBtn);
  }
  
  const nextBtn = document.createElement('button');
  nextBtn.className = 'pagination-btn';
  nextBtn.textContent = TA('common.next', '다음');
  nextBtn.disabled = page === total_pages;
  nextBtn.addEventListener('click', () => {
    if (page < total_pages) {
      loadCombatScoreRanking(page + 1);
    }
  });
  combatScoreRankingPagination.appendChild(nextBtn);
  
  const infoSpan = document.createElement('span');
  infoSpan.className = 'pagination-info';
  infoSpan.textContent = `${total_count.toLocaleString()}명 중 ${((page - 1) * 10 + 1).toLocaleString()}-${Math.min(page * 10, total_count).toLocaleString()}명`;
  combatScoreRankingPagination.appendChild(infoSpan);
}

// 아툴 전투 점수 랭킹 서버 필터 업데이트
function updateCombatScoreServerFilters(race) {
  const serverFilterContainer = document.getElementById('combat-score-ranking-server-filters');
  if (!serverFilterContainer || !servers) return;
  
  const existingButtons = serverFilterContainer.querySelectorAll('.ranking-filter-btn:not([data-value="all"])');
  existingButtons.forEach(btn => btn.remove());
  
  if (race === 'all') {
    serverFilterContainer.style.display = 'none';
    return;
  }
  
  serverFilterContainer.style.display = 'flex';
  
  let serversToShow = [];
  if (race === 'elyos' && servers.elyos) {
    servers.elyos.forEach(s => {
      serversToShow.push(s.name);
    });
  } else if (race === 'asmodian' && servers.asmodian) {
    servers.asmodian.forEach(s => {
      serversToShow.push(s.name);
    });
  }
  
  serversToShow.forEach(serverName => {
    const btn = document.createElement('button');
    btn.className = 'ranking-filter-btn';
    btn.setAttribute('data-filter-type', 'server');
    btn.setAttribute('data-value', serverName);
    btn.textContent = serverName;
    btn.addEventListener('click', function() {
      const server = this.getAttribute('data-value') || 'all';
      currentCombatScoreServerFilter = server;
      
      serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      loadCombatScoreRanking(1);
    });
    serverFilterContainer.appendChild(btn);
  });
}

// 아툴 전투 점수 랭킹 이벤트 리스너 설정
function setupCombatScoreRankingEventListeners() {
  const combatScoreRankingContent = document.getElementById('combat-score-ranking-content');
  if (!combatScoreRankingContent) {
    return;
  }
  
  // 직업 필터 버튼 클릭 이벤트
  const combatScoreJobFilterButtons = document.querySelectorAll('#combat-score-ranking-job-filters .ranking-filter-btn');
  combatScoreJobFilterButtons.forEach(btn => {
    btn.addEventListener('click', function() {
      const job = this.getAttribute('data-value') || 'all';
      currentCombatScoreJobFilter = job;
      
      combatScoreJobFilterButtons.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      loadCombatScoreRanking(1);
    });
  });
  
  // 서버 필터 탭 버튼 (전체/천족/마족)
  const combatScoreServerTabButtons = document.querySelectorAll('.combat-score-server-tab');
  combatScoreServerTabButtons.forEach(tabBtn => {
    tabBtn.addEventListener('click', function() {
      const race = this.getAttribute('data-race');
      currentCombatScoreServerRaceFilter = race;
      currentCombatScoreServerFilter = 'all';
      
      combatScoreServerTabButtons.forEach(b => {
        b.classList.remove('active');
        b.style.background = 'rgba(255, 255, 255, 0.05)';
        b.style.borderColor = 'var(--card-border)';
        b.style.color = 'var(--text-primary)';
      });
      this.classList.add('active');
      this.style.background = 'rgba(157, 140, 255, 0.16)';
      this.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      this.style.color = 'var(--accent)';
      
      updateCombatScoreServerFilters(race);
      
      if (race === 'all') {
        const serverFilterContainer = document.getElementById('combat-score-ranking-server-filters');
        if (serverFilterContainer) {
          const allServerBtn = serverFilterContainer.querySelector('[data-value="all"]');
          if (allServerBtn) {
            serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
            allServerBtn.classList.add('active');
          }
        }
      }
      
      loadCombatScoreRanking(1);
    });
  });
  
  // 전투 점수 필터 버튼 클릭 이벤트
  const combatScoreMaxFilterButtons = document.querySelectorAll('#combat-score-max-filters .ranking-filter-btn');
  combatScoreMaxFilterButtons.forEach(btn => {
    btn.addEventListener('click', function() {
      const value = this.getAttribute('data-value') || 'all';
      currentCombatScoreMaxScoreFilter = value;
      
      combatScoreMaxFilterButtons.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      loadCombatScoreRanking(1);
    });
  });
}

// 컨텐츠 랭킹 관련 변수 (전역 스코프)
// 중복 선언 방지
if (typeof currentContentsRankingType === 'undefined') {
  var currentContentsRankingType = 'abyss'; // 'abyss', 'solo_arena', 'coop_arena', 'nightmare', 'transcendence', 'awakening', 'subjugation'
}
if (typeof currentContentsJobFilter === 'undefined') {
  var currentContentsJobFilter = 'all';
}
if (typeof currentContentsServerFilter === 'undefined') {
  var currentContentsServerFilter = 'all';
}
if (typeof currentContentsServerRaceFilter === 'undefined') {
  var currentContentsServerRaceFilter = 'all';
}
if (typeof currentContentsPage === 'undefined') {
  var currentContentsPage = 1;
}

// 콘텐츠 랭킹 무한 스크롤 상태
var contentsRankingInfiniteScroll = {
  currentPage: 1,
  isLoading: false,
  hasMore: true,
  totalCount: 0,
  loadedCount: 0
};
var contentsRankingDataCache = {};
var CONTENTS_RANKING_CACHE_DURATION = 5 * 60 * 1000; // 5분

// 컨텐츠 랭킹 필터 초기화
function initializeContentsRankingFilters() {
  // 중복 호출 방지
  if (window.contentsRankingFiltersInitializing) {
    return;
  }
  window.contentsRankingFiltersInitializing = true;
  
  // active_contents_type이 설정되어 있으면 그 값을 사용, 없으면 'abyss' 기본값
  
  currentContentsRankingType = 'abyss';
  
  currentContentsJobFilter = 'all';
  currentContentsServerFilter = 'all';
  currentContentsServerRaceFilter = 'all';
  currentContentsPage = 1;

  // 컨텐츠 랭킹 서브 탭 초기화 (현재 타입에 맞게 활성화)
  const contentsSubTabs = document.querySelectorAll('.contents-sub-tab');
  contentsSubTabs.forEach(tab => {
    tab.classList.remove('active');
    if (tab.dataset.contentType === currentContentsRankingType) {
      tab.classList.add('active');
    }
  });
  
  window.contentsRankingFiltersInitializing = false;

  // 직업 필터 초기화
  const jobFilterButtons = document.querySelectorAll('#contents-ranking-job-filters .ranking-filter-btn');
  jobFilterButtons.forEach(btn => {
    btn.classList.remove('active');
    if (btn.getAttribute('data-value') === 'all') {
      btn.classList.add('active');
    }
  });

  // 서버 필터 탭 초기화
  const serverTabButtons = document.querySelectorAll('.contents-server-tab');
  serverTabButtons.forEach(btn => {
    btn.classList.remove('active');
    btn.style.background = 'rgba(255, 255, 255, 0.05)';
    btn.style.borderColor = 'var(--card-border)';
    btn.style.color = 'var(--text-primary)';
    if (btn.getAttribute('data-race') === 'all') {
      btn.classList.add('active');
      btn.style.background = 'rgba(157, 140, 255, 0.16)';
      btn.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      btn.style.color = 'var(--accent)';
    }
  });

  // 서버 필터 초기화
  if (typeof updateContentsServerFilters === 'function') {
    updateContentsServerFilters('all');
  }
  
  // 무한 스크롤 상태 초기화
  contentsRankingInfiniteScroll.currentPage = 1;
  contentsRankingInfiniteScroll.isLoading = false;
  contentsRankingInfiniteScroll.hasMore = true;
  contentsRankingInfiniteScroll.totalCount = 0;
  contentsRankingInfiniteScroll.loadedCount = 0;
  contentsRankingDataCache = {};
}

// 컨텐츠 랭킹 서버 필터 업데이트
function updateContentsServerFilters(race) {
  const serverFilterContainer = document.getElementById('contents-ranking-server-filters');
  if (!serverFilterContainer || !servers) return;
  
  const existingButtons = serverFilterContainer.querySelectorAll('.ranking-filter-btn:not([data-value="all"])');
  existingButtons.forEach(btn => btn.remove());
  
  if (race === 'all') {
    serverFilterContainer.style.display = 'none';
    return;
  }
  
  serverFilterContainer.style.display = 'flex';
  
  let serversToShow = [];
  if (race === 'elyos' && servers.elyos) {
    servers.elyos.forEach(s => {
      serversToShow.push(s.name);
    });
  } else if (race === 'asmodian' && servers.asmodian) {
    servers.asmodian.forEach(s => {
      serversToShow.push(s.name);
    });
  }
  
  serversToShow.forEach(serverName => {
    const btn = document.createElement('button');
    btn.className = 'ranking-filter-btn';
    btn.setAttribute('data-filter-type', 'server');
    btn.setAttribute('data-value', serverName);
    btn.textContent = serverName;
    btn.addEventListener('click', () => {
      currentContentsServerFilter = serverName;
      serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      // URL 업데이트
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter
      );
      updateURL(contentsRankingURL);
      
      loadContentsRanking();
    });
    serverFilterContainer.appendChild(btn);
  });
}

// 컨텐츠 랭킹 로드
function loadContentsRanking(page = 1, isAppend = false) {
  // 무한 스크롤 상태 확인
  if (isAppend && (contentsRankingInfiniteScroll.isLoading || !contentsRankingInfiniteScroll.hasMore)) {
    return;
  }
  
  if (isAppend) {
    contentsRankingInfiniteScroll.isLoading = true;
  } else {
    // 초기 로드시 상태 리셋
    contentsRankingInfiniteScroll.currentPage = 1;
    contentsRankingInfiniteScroll.isLoading = false;
    contentsRankingInfiniteScroll.hasMore = true;
    contentsRankingInfiniteScroll.totalCount = 0;
    contentsRankingInfiniteScroll.loadedCount = 0;
  }
  
  currentContentsPage = page;
  const params = new URLSearchParams();
  params.append('type', currentContentsRankingType);
  
  if (currentContentsJobFilter && currentContentsJobFilter !== 'all') {
    params.append('job', currentContentsJobFilter);
  } else {
    params.append('job', 'all');
  }
  
  if (currentContentsServerFilter && currentContentsServerFilter !== 'all') {
    params.append('server', currentContentsServerFilter);
  } else {
    params.append('server', 'all');
  }
  
  if (currentContentsServerRaceFilter && currentContentsServerRaceFilter !== 'all') {
    params.append('race', currentContentsServerRaceFilter);
  } else {
    params.append('race', 'all');
  }
  
  params.append('page', page);
  params.append('per_page', 100);
  
  const contentsRankingBody = document.getElementById('contents-ranking-body');
  const contentsRankingPagination = document.getElementById('contents-ranking-pagination');
  
  if (!contentsRankingBody) return;
  
  // 로딩 메시지는 초기 로드시에만 표시
  if (!isAppend) {
    contentsRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.contents_loading_row', '컨텐츠 랭킹 데이터를 불러오는 중...') + '</td></tr>';
  }
  
  const apiUrl = `${SITE_URL_PREFIX}/api/contents-rankings?${params.toString()}`;
  
  fetch(apiUrl)
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      if (!data.success) {
        contentsRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + (data.error || TA('ranking.contents_load_failed', '컨텐츠 랭킹 데이터를 불러오지 못했습니다.')) + '</td></tr>';
        if (contentsRankingPagination) {
          contentsRankingPagination.style.display = 'none';
        }
        return;
      }

      // 마지막 업데이트 시간 표시
      const lastUpdateEl = document.getElementById('contents-ranking-last-update');
      if (lastUpdateEl) {
        if (data.last_update) {
          lastUpdateEl.textContent = ``;
        } else {
          lastUpdateEl.textContent = '';
        }
      }
      
      const rows = data.data || [];
      if (!rows.length) {
        contentsRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.contents_empty', '컨텐츠 랭킹 데이터가 없습니다.') + '</td></tr>';
        if (contentsRankingPagination) {
          contentsRankingPagination.style.display = 'none';
        }
        contentsRankingInfiniteScroll.hasMore = false;
        contentsRankingInfiniteScroll.isLoading = false;
        return;
      }
      
      // 무한 스크롤 상태 업데이트
      const currentLoadedCount = contentsRankingInfiniteScroll.loadedCount;
      contentsRankingInfiniteScroll.totalCount = data.pagination.total_count;
      contentsRankingInfiniteScroll.loadedCount += rows.length;
      contentsRankingInfiniteScroll.hasMore = rows.length === 100;
      
      // 테이블 헤더는 항상 "점수"로 고정 (HTML에서 이미 설정됨)
      
      // 모바일 여부 확인
      const isMobile = window.innerWidth <= 768;
      
      // 테이블 행 생성 (초기 로드시에만 비우기)
      if (!isAppend) {
        contentsRankingBody.innerHTML = '';
      }
      
      // 모바일에서 테이블 헤더 스타일 적용
      if (isMobile) {
        const contentsRankingTable = document.getElementById('contents-ranking-table');
        if (contentsRankingTable) {
          contentsRankingTable.style.tableLayout = 'fixed';
          contentsRankingTable.style.width = '100%';
          contentsRankingTable.style.maxWidth = '100%';
          
          const headerCells = contentsRankingTable.querySelectorAll('thead th');
          headerCells.forEach(headerCell => {
            if (headerCell.classList.contains('col-rank')) {
              headerCell.style.width = '15%';
              headerCell.style.minWidth = '15%';
              headerCell.style.maxWidth = '15%';
              headerCell.style.display = 'table-cell';
            } else if (headerCell.classList.contains('col-nickname')) {
              headerCell.style.width = '40%';
              headerCell.style.minWidth = '40%';
              headerCell.style.maxWidth = '40%';
              headerCell.style.display = 'table-cell';
            } else if (headerCell.classList.contains('col-server')) {
              headerCell.style.width = '25%';
              headerCell.style.minWidth = '25%';
              headerCell.style.maxWidth = '25%';
              headerCell.style.display = 'table-cell';
            } else if (headerCell.classList.contains('col-power')) {
              headerCell.style.width = '20%';
              headerCell.style.minWidth = '20%';
              headerCell.style.maxWidth = '20%';
              headerCell.style.display = 'table-cell';
            } else {
              // 직업, 종족, 레기온 헤더는 숨김
              headerCell.style.display = 'none';
            }
          });
        }
      }
      
      rows.forEach((row, index) => {
        const rank = currentLoadedCount + index + 1;
        const jobLabel = row.job || '';
        const jobImageUrl = row.job_image_url || '';
        const guild = row.guild || '-';
        const nickname = row.nickname || '';
        const serverName = row.server || '';
        const raceName = row.race || '';
        const rankingValue = row.ranking_value || 0;
        
        let raceValue = '';
        let serverId = '';
        
        if ((raceName === '천족' || raceName === '天族')) {
          raceValue = '1';
          if (servers && servers.elyos) {
            const serverInfo = findServerByName(servers.elyos, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceValue = '2';
          if (servers && servers.asmodian) {
            const serverInfo = findServerByName(servers.asmodian, serverName);
            if (serverInfo) serverId = serverInfo.id;
          }
        }
        
        const jobDisplayCt = displayJobLabel(jobLabel);
        let jobCell = '';
        if (jobImageUrl) {
          jobCell = `<img src="${jobImageUrl}" alt="${jobDisplayCt}" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">${jobDisplayCt}`;
        } else {
          jobCell = jobDisplayCt;
        }
        
        const nicknameCell = serverId && raceValue 
          ? `<a href="${SITE_URL_PREFIX}/?nickname=${encodeURIComponent(nickname)}&race=${raceValue}&server=${serverId}" class="nickname-link" style="color: var(--accent); text-decoration: none; cursor: pointer;">${nickname}</a>`
          : nickname;
        
        let raceCell = raceName;
        if ((raceName === '천족' || raceName === '天族')) {
          raceCell = `<span style="color: #4a90e2;">${displayRaceLabel(raceName)}</span>`;
        } else if ((raceName === '마족' || raceName === '魔族')) {
          raceCell = `<span style="color: #e24a4a;">${displayRaceLabel(raceName)}</span>`;
        }
        
        // DOM 요소로 행 생성
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="col-rank">${rank}</td>
          <td class="col-nickname">${nicknameCell}</td>
          <td class="col-job">${jobCell}</td>
          <td class="col-race">${raceCell}</td>
          <td class="col-server">${serverName}</td>
          <td class="col-guild">${guild}</td>
          <td class="col-power" style="text-align: right;">${rankingValue ? rankingValue.toLocaleString() : '-'}</td>
        `;
        
        // 모바일에서 각 셀에 스타일 직접 적용 (내실 랭킹과 동일한 방식)
        if (isMobile) {
          tr.style.width = '100%';
          tr.style.maxWidth = '100%';
          tr.style.boxSizing = 'border-box';
          
          const cells = tr.querySelectorAll('td');
          cells.forEach(cell => {
            cell.style.boxSizing = 'border-box';
            
            if (cell.classList.contains('col-rank')) {
              cell.style.width = '15%';
              cell.style.minWidth = '15%';
              cell.style.maxWidth = '15%';
              cell.style.display = 'table-cell';
            } else if (cell.classList.contains('col-nickname')) {
              cell.style.width = '40%';
              cell.style.minWidth = '40%';
              cell.style.maxWidth = '40%';
              cell.style.display = 'table-cell';
            } else if (cell.classList.contains('col-server')) {
              cell.style.width = '25%';
              cell.style.minWidth = '25%';
              cell.style.maxWidth = '25%';
              cell.style.display = 'table-cell';
            } else if (cell.classList.contains('col-power')) {
              cell.style.width = '20%';
              cell.style.minWidth = '20%';
              cell.style.maxWidth = '20%';
              cell.style.display = 'table-cell';
              cell.style.textAlign = 'right';
              cell.style.fontWeight = '600';
              cell.style.color = 'var(--accent)';
            } else {
              // 직업, 종족, 레기온은 숨김
              cell.style.display = 'none';
            }
          });
        }
        
        contentsRankingBody.appendChild(tr);
      });
      
      // 닉네임 클릭 이벤트 추가 (window.location.href 방식으로 통일 - 애드센스 PV 증대)
      contentsRankingBody.querySelectorAll('.nickname-link').forEach(link => {
        link.addEventListener('click', function(e) {
          // 마우스 휠 클릭(중간 클릭)이나 Ctrl+클릭, Shift+클릭(새 탭/새 창)은 기본 동작 허용
          if (e.button === 1 || e.ctrlKey || e.metaKey || e.shiftKey) {
            return; // 기본 동작 허용 (새 탭으로 열기)
          }
          
          // 일반 클릭은 실제 페이지 이동 (애드센스 수익 증대)
          e.preventDefault();
          
          const parsed = parseNicknameQueryFromHref(this.getAttribute('href'));
          if (parsed) {
            const { nickname, race, serverId } = parsed;
              // ★ 클릭 즉시 로딩 표시 (UX 개선)
              const characterLoading = document.getElementById('character-loading');
              const loadingOverlay = document.getElementById('fullscreen-loading-overlay');
              const characterResult = document.getElementById('character-result');
              const allServersResult = document.getElementById('character-all-servers-result');
              
              if (characterResult) characterResult.style.display = 'none';
              if (allServersResult) allServersResult.style.display = 'none';
              if (characterLoading) characterLoading.style.display = 'block';
              if (loadingOverlay) loadingOverlay.style.display = 'flex';
              
              // 로딩 표시가 렌더링될 시간을 주고 페이지 이동
              requestAnimationFrame(() => {
                window.location.href = `${SITE_URL_PREFIX}/char/serverid=${serverId}/${encodeURIComponent(nickname)}`;
              });
          }
        });
      });
      
      // 무한 스크롤 상태 업데이트
      contentsRankingInfiniteScroll.isLoading = false;
      updateContentsRankingScrollStatus();
      
      // 페이지네이션 숨기기 (무한 스크롤 사용)
      if (contentsRankingPagination) {
        contentsRankingPagination.style.display = 'none';
      }
      
      // 무한 스크롤 설정 (초기 로드 후)
      if (!isAppend) {
        setupContentsRankingInfiniteScroll();
      }
    })
    .catch(err => {
      if (!isAppend) {
        contentsRankingBody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:1rem;">' + TA('ranking.load_error', '랭킹 데이터를 불러오는 중 오류가 발생했습니다.') + ' ' + err.message + '</td></tr>';
      }
      if (contentsRankingPagination) {
        contentsRankingPagination.style.display = 'none';
      }
      contentsRankingInfiniteScroll.isLoading = false;
    });
}

// 콘텐츠 랭킹 스크롤 상태 업데이트
function updateContentsRankingScrollStatus() {
  let statusEl = document.getElementById('contents-ranking-scroll-status');
  if (!statusEl) {
    const container = document.getElementById('contents-ranking-container');
    if (container) {
      statusEl = document.createElement('div');
      statusEl.id = 'contents-ranking-scroll-status';
      statusEl.style.textAlign = 'center';
      statusEl.style.padding = '1rem';
      statusEl.style.color = '#999';
      statusEl.style.fontSize = '0.85rem';
      container.appendChild(statusEl);
    }
  }
  
  if (statusEl) {
    const n = contentsRankingInfiniteScroll.loadedCount;
    if (contentsRankingInfiniteScroll.hasMore) {
      statusEl.innerHTML = TA('ranking.loaded_count_scroll', '{n}명 로드됨 (스크롤하여 더 보기)').replace(/\{n\}/g, String(n));
    } else {
      statusEl.innerHTML = TA('ranking.all_loaded_count', '모든 데이터를 로드했습니다. (총 {n}명)').replace(/\{n\}/g, String(n));
    }
  }
}

// 콘텐츠 랭킹 무한 스크롤 설정
function setupContentsRankingInfiniteScroll() {
  const contentsRankingPagination = document.getElementById('contents-ranking-pagination');
  let sentinel = document.getElementById('contents-ranking-scroll-sentinel');
  
  if (!sentinel) {
    sentinel = document.createElement('div');
    sentinel.id = 'contents-ranking-scroll-sentinel';
    sentinel.style.height = '1px';
    sentinel.style.width = '100%';
    sentinel.style.opacity = '0';
    sentinel.style.pointerEvents = 'none';
    
    const container = document.getElementById('contents-ranking-container');
    if (container) {
      container.appendChild(sentinel);
    }
  }
  
  // 기존 observer 해제
  if (window.contentsRankingObserver) {
    window.contentsRankingObserver.disconnect();
  }
  
  // 새로운 observer 생성
  window.contentsRankingObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && 
          !contentsRankingInfiniteScroll.isLoading && 
          contentsRankingInfiniteScroll.hasMore &&
          contentsRankingInfiniteScroll.loadedCount > 0) {
        contentsRankingInfiniteScroll.currentPage++;
        loadContentsRanking(contentsRankingInfiniteScroll.currentPage, true);
      }
    });
  }, {
    root: null,
    rootMargin: '300px',
    threshold: 0
  });
  
  window.contentsRankingObserver.observe(sentinel);
}

// 컨텐츠 랭킹 페이지네이션 렌더링
function renderContentsRankingPagination(pagination) {
  const paginationEl = document.getElementById('contents-ranking-pagination');
  if (!paginationEl) return;
  
  const { page, total_pages, total_count } = pagination;
  
  paginationEl.style.display = 'flex';
  paginationEl.innerHTML = '';
  
  // 이전 버튼
  const prevBtn = document.createElement('button');
  prevBtn.textContent = TA('common.previous', '이전');
  prevBtn.disabled = page <= 1;
  prevBtn.style.padding = '0.5rem 1rem';
  prevBtn.style.border = '1px solid var(--card-border)';
  prevBtn.style.borderRadius = '8px';
  prevBtn.style.background = page <= 1 ? 'rgba(255, 255, 255, 0.05)' : 'rgba(255, 255, 255, 0.1)';
  prevBtn.style.color = page <= 1 ? 'var(--text-muted)' : 'var(--text-primary)';
  prevBtn.style.cursor = page <= 1 ? 'not-allowed' : 'pointer';
  if (page > 1) {
    prevBtn.addEventListener('click', () => {
      loadContentsRanking(page - 1);
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter,
        page - 1
      );
      updateURL(contentsRankingURL);
    });
  }
  paginationEl.appendChild(prevBtn);
  
  // 페이지 번호
  const maxVisible = 5;
  let startPage = Math.max(1, page - Math.floor(maxVisible / 2));
  let endPage = Math.min(total_pages, startPage + maxVisible - 1);
  
  if (endPage - startPage < maxVisible - 1) {
    startPage = Math.max(1, endPage - maxVisible + 1);
  }
  
  if (startPage > 1) {
    const firstBtn = document.createElement('button');
    firstBtn.textContent = '1';
    firstBtn.style.padding = '0.5rem 1rem';
    firstBtn.style.border = '1px solid var(--card-border)';
    firstBtn.style.borderRadius = '8px';
    firstBtn.style.background = 'rgba(255, 255, 255, 0.1)';
    firstBtn.style.color = 'var(--text-primary)';
    firstBtn.addEventListener('click', () => {
      loadContentsRanking(1);
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter,
        1
      );
      updateURL(contentsRankingURL);
    });
    paginationEl.appendChild(firstBtn);
    
    if (startPage > 2) {
      const ellipsis = document.createElement('span');
      ellipsis.textContent = '...';
      ellipsis.style.padding = '0.5rem';
      ellipsis.style.color = 'var(--text-muted)';
      paginationEl.appendChild(ellipsis);
    }
  }
  
  for (let i = startPage; i <= endPage; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.textContent = i;
    pageBtn.style.padding = '0.5rem 1rem';
    pageBtn.style.border = '1px solid var(--card-border)';
    pageBtn.style.borderRadius = '8px';
    if (i === page) {
      pageBtn.style.background = 'rgba(157, 140, 255, 0.16)';
      pageBtn.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      pageBtn.style.color = 'var(--accent)';
    } else {
      pageBtn.style.background = 'rgba(255, 255, 255, 0.1)';
      pageBtn.style.color = 'var(--text-primary)';
    }
    pageBtn.addEventListener('click', () => {
      loadContentsRanking(i);
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter,
        i
      );
      updateURL(contentsRankingURL);
    });
    paginationEl.appendChild(pageBtn);
  }
  
  if (endPage < total_pages) {
    if (endPage < total_pages - 1) {
      const ellipsis = document.createElement('span');
      ellipsis.textContent = '...';
      ellipsis.style.padding = '0.5rem';
      ellipsis.style.color = 'var(--text-muted)';
      paginationEl.appendChild(ellipsis);
    }
    
    const lastBtn = document.createElement('button');
    lastBtn.textContent = total_pages;
    lastBtn.style.padding = '0.5rem 1rem';
    lastBtn.style.border = '1px solid var(--card-border)';
    lastBtn.style.borderRadius = '8px';
    lastBtn.style.background = 'rgba(255, 255, 255, 0.1)';
    lastBtn.style.color = 'var(--text-primary)';
    lastBtn.addEventListener('click', () => {
      loadContentsRanking(total_pages);
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter,
        total_pages
      );
      updateURL(contentsRankingURL);
    });
    paginationEl.appendChild(lastBtn);
  }
  
  // 다음 버튼
  const nextBtn = document.createElement('button');
  nextBtn.textContent = TA('common.next', '다음');
  nextBtn.disabled = page >= total_pages;
  nextBtn.style.padding = '0.5rem 1rem';
  nextBtn.style.border = '1px solid var(--card-border)';
  nextBtn.style.borderRadius = '8px';
  nextBtn.style.background = page >= total_pages ? 'rgba(255, 255, 255, 0.05)' : 'rgba(255, 255, 255, 0.1)';
  nextBtn.style.color = page >= total_pages ? 'var(--text-muted)' : 'var(--text-primary)';
  nextBtn.style.cursor = page >= total_pages ? 'not-allowed' : 'pointer';
  if (page < total_pages) {
    nextBtn.addEventListener('click', () => {
      loadContentsRanking(page + 1);
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter,
        page + 1
      );
      updateURL(contentsRankingURL);
    });
  }
  paginationEl.appendChild(nextBtn);
  
  // 페이지 정보 표시
  const infoText = document.createElement('span');
  infoText.textContent = `${total_count}명 중 ${(page - 1) * 10 + 1}-${Math.min(page * 10, total_count)}명`;
  infoText.style.marginLeft = '1rem';
  infoText.style.color = 'var(--text-muted)';
  infoText.style.fontSize = '0.9rem';
  paginationEl.appendChild(infoText);
}

// 컨텐츠 랭킹 URL 생성
function buildContentsRankingURL(type, job, race, server, page = 1) {
  const parts = ['ranking', 'contents'];
  
  // 컨텐츠 타입 매핑
  const typeMap = {
    'abyss': 'abyss',
    'solo_arena': 'solo_arena',
    'coop_arena': 'coop_arena',
    'nightmare': 'nightmare',
    'transcendence': 'transcendence',
    'awakening': 'awakening',
    'subjugation': 'subjugation'
  };
  const typeValue = typeMap[type] || 'abyss';
  parts.push(typeValue);
  
  if (job && job !== 'all') parts.push(job);
  if (race && race !== 'all') {
    parts.push(race === 'elyos' ? '천족' : race === 'asmodian' ? '마족' : race);
  }
  if (server && server !== 'all') parts.push(server);
  
  return parts.join('/');
}

// 컨텐츠 랭킹 이벤트 리스너 초기화 함수 (전역 함수)
function setupContentsRankingEventListeners() {
  
  // 이벤트 위임을 사용하여 컨텐츠 랭킹 컨텐츠 영역에서 서브탭 클릭 처리
  const contentsRankingContent = document.getElementById('contents-ranking-content');
  if (!contentsRankingContent) {
    return;
  }
  
  // 컨텐츠 랭킹 서브탭은 이제 <a> 태그로 페이지 이동 처리
  // 클릭 이벤트 등록 불필요
  
  // 컨텐츠 랭킹 직업 필터 버튼 클릭 이벤트
  const contentsJobFilterButtons = document.querySelectorAll('#contents-ranking-job-filters .ranking-filter-btn');
  contentsJobFilterButtons.forEach(btn => {
    btn.addEventListener('click', function() {
      const job = this.getAttribute('data-value') || 'all';
      currentContentsJobFilter = job;
      
      // active 클래스 토글
      contentsJobFilterButtons.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      // URL 업데이트
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter
      );
      updateURL(contentsRankingURL);
      
      // 데이터 다시 로드
      loadContentsRanking(1);
    });
  });
  
  // 컨텐츠 랭킹 서버 필터 탭 버튼 (전체/천족/마족)
  const contentsServerTabButtons = document.querySelectorAll('.contents-server-tab');
  contentsServerTabButtons.forEach(tabBtn => {
    tabBtn.addEventListener('click', function() {
      const race = this.getAttribute('data-race');
      currentContentsServerRaceFilter = race;
      currentContentsServerFilter = 'all';
      
      // 탭 버튼 active 토글
      contentsServerTabButtons.forEach(b => {
        b.classList.remove('active');
        b.style.background = 'rgba(255, 255, 255, 0.05)';
        b.style.borderColor = 'var(--card-border)';
        b.style.color = 'var(--text-primary)';
      });
      this.classList.add('active');
      this.style.background = 'rgba(157, 140, 255, 0.16)';
      this.style.borderColor = 'rgba(157, 140, 255, 0.9)';
      this.style.color = 'var(--accent)';
      
      // 서버 버튼 업데이트
      updateContentsServerFilters(race);
      
      // 전체 탭이면 전체 서버 버튼 활성화
      if (race === 'all') {
        const serverFilterContainer = document.getElementById('contents-ranking-server-filters');
        if (serverFilterContainer) {
          const allServerBtn = serverFilterContainer.querySelector('[data-value="all"]');
          if (allServerBtn) {
            serverFilterContainer.querySelectorAll('.ranking-filter-btn').forEach(b => b.classList.remove('active'));
            allServerBtn.classList.add('active');
          }
        }
      }
      
      // URL 업데이트
      const contentsRankingURL = buildContentsRankingURL(
        currentContentsRankingType,
        currentContentsJobFilter,
        currentContentsServerRaceFilter,
        currentContentsServerFilter
      );
      updateURL(contentsRankingURL);
      
      // 데이터 다시 로드
      loadContentsRanking(1);
    });
  });
  
}

// 스탯 정보 모달 관련 함수들
let currentStatModal = null;

function openStatModal(statType, statValue, breakdownData, description) {
  const modal = document.getElementById('stat-info-modal');
  if (!modal) return;
  
  const modalContent = modal.querySelector('.stat-info-modal-content');
  const modalTitle = modal.querySelector('.stat-info-modal-title');
  const breakdownSection = modal.querySelector('.stat-info-breakdown-section');
  const descriptionSection = modal.querySelector('.stat-info-description-section');
  const conclusionDiv = modal.querySelector('.stat-info-conclusion');
  const damageIncreaseDiv = modal.querySelector('.stat-info-damage-increase');
  
  // 제목 설정
  const statNames = {
    'attack-power': TA('stat.modal.attack_power', '공격력'),
    'combat-speed': TA('stat.modal.combat_speed', '전투 속도'),
    'weapon-damage-amplification': TA('stat.modal.weapon_damage_amp', '무기 피해 증폭'),
    'pve-damage-amplification': TA('stat.modal.pve_damage_amp', 'PVE/보스 피해 증폭'),
    'damage-amplification': TA('stat.modal.damage_amp', '피해 증폭'),
    'critical-damage-amplification': TA('stat.modal.crit_damage_amp', '치명타 피해 증폭'),
    'skill-damage': TA('stat.modal.skill', '스킬'),
    'cooldown-reduction': TA('stat.modal.cdr', '재사용 대기 시간 감소'),
    'critical-hit': TA('stat.modal.critical', '치명타'),
    'stun-hit': TA('stat.modal.stun_hit', '강타'),
    'perfect': TA('stat.modal.perfect', '완벽'),
    'multi-hit': TA('stat.modal.multi_hit', '다단 히트 적중'),
    'accuracy': TA('stat.modal.accuracy_stat', '명중')
  };
  
  modalTitle.textContent = statNames[statType] || statType;
  
  // Breakdown 표시
  let breakdownHTML = '<div class="stat-info-breakdown-title">' + TA('stat.modal.breakdown', 'Breakdown') + '</div><div style="display: flex; flex-direction: column; gap: 0.4rem;">';
  let totalInteger = 0;
  let totalPercent = 0;
  let hasInteger = false;
  let hasPercent = false;
  
  if (breakdownData && breakdownData.length > 0) {
    breakdownData.forEach(item => {
      const valueStyle = item.color ? ` style="color: ${item.color}; font-weight: 500;"` : '';
      const noteHTML = item.note ? `<span style="font-size: 0.7rem; color: #fbbf24; margin-left: 0.5rem;">(${item.note})</span>` : '';
      breakdownHTML += `
        <div class="stat-info-breakdown-item">
          <span>${item.label}${noteHTML}</span>
          <span class="stat-info-breakdown-value"${valueStyle}>${item.value}</span>
        </div>
      `;
      
      // 값에서 숫자 추출 (phase: pre=곱연산 전 정数, percent=곱연산%, cap=캡 전용%, post=곱연산 후 정수)
      if (item.phase === 'cap' || item.phase === 'post') {
        // 합계 fallback 계산에서 제외 (실제 finalAttack은 statValue 사용)
      } else {
        let valueStr = item.value;

        if (item.isHtml && valueStr.includes('→')) {
          const arrowParts = valueStr.split('→');
          if (arrowParts.length > 1) {
            valueStr = arrowParts[1].trim();
          }
        }

        const hasPercentSign = valueStr.includes('%');
        const parenMatch = valueStr.match(/\(([0-9.]+)%?\)/);
        const mainValueStr = valueStr.split('(')[0].trim();
        const mainNumericValue = parseFloat(mainValueStr.replace(/[^0-9.-]/g, '')) || 0;

        if (parenMatch) {
          const percentInParen = parseFloat(parenMatch[1]) || 0;
          totalInteger += mainNumericValue;
          totalPercent += percentInParen;
          hasInteger = true;
          hasPercent = true;
        } else if (hasPercentSign || item.phase === 'percent') {
          totalPercent += mainNumericValue;
          hasPercent = true;
        } else {
          totalInteger += mainNumericValue;
          hasInteger = true;
        }
      }
    });
    
    // 합계 표시 (breakdown 항목이 있을 때만)
    if (breakdownData.length > 0) {
      let totalDisplay = '';
      
      // 공격력: 실제 표시된 공격력 값 사용 (statValue에 전달된 값)
      if (statType === 'attack-power') {
        if (statValue && statValue > 0) {
          // 실제 표시된 공격력 값 사용
          totalDisplay = `+${Math.round(statValue).toLocaleString()}`;
        } else if (hasInteger && hasPercent) {
          // fallback: 정수 합계에 퍼센트 증가량을 적용한 최종 공격력
          const finalAttackPower = Math.round(totalInteger * (1 + totalPercent / 100));
          totalDisplay = `+${finalAttackPower.toLocaleString()}`;
        } else if (hasInteger) {
          totalDisplay = `+${Math.round(totalInteger).toLocaleString()}`;
        } else if (hasPercent) {
          totalDisplay = `+${totalPercent.toFixed(1)}%`;
        }
      }
      // 치명타: statValue가 범위 문자열로 전달됨 (예: "929 ~ 1022")
      else if (statType === 'critical-hit') {
        // statValue가 문자열 범위인 경우 그대로 사용
        if (statValue && typeof statValue === 'string') {
          totalDisplay = `+${statValue}`;
        } else if (statValue && statValue > 0) {
          // 이미 계산된 최종 치명타 스탯 사용
          totalDisplay = `+${Math.round(statValue).toLocaleString()}`;
        } else if (hasInteger && hasPercent) {
          // fallback: breakdown의 정수 합계에 퍼센트 합계를 적용 (합연산)
          const finalCriticalHit = Math.round(totalInteger * (1 + totalPercent / 100));
          totalDisplay = `+${finalCriticalHit.toLocaleString()}`;
        } else if (hasInteger) {
          totalDisplay = `+${Math.round(totalInteger).toLocaleString()}`;
        }
      }
      // 명중: statValue가 범위 문자열로 전달됨 (예: "498 ~ 560")
      else if (statType === 'accuracy') {
        // statValue가 문자열 범위인 경우 그대로 사용
        if (statValue && typeof statValue === 'string') {
          totalDisplay = statValue;
        } else if (statValue && statValue > 0) {
          totalDisplay = `${Math.round(statValue).toLocaleString()}`;
        }
      }
      // 무기 피해 증폭, 피해 증폭, 치명타 피해 증폭: 퍼센트만 표시
      else if (statType === 'weapon-damage-amplification' || statType === 'damage-amplification' || statType === 'critical-damage-amplification') {
        if (hasPercent) {
          totalDisplay = `+${totalPercent.toFixed(1)}%`;
        }
      }
      // 기타: 정수와 퍼센티지 둘 다 있는 경우 둘 다 표시
      else if (hasInteger && hasPercent) {
        totalDisplay = `+${Math.round(totalInteger).toLocaleString()} (+${totalPercent.toFixed(1)}%)`;
      } else if (hasInteger) {
        totalDisplay = `+${Math.round(totalInteger).toLocaleString()}`;
      } else if (hasPercent) {
        totalDisplay = `+${totalPercent.toFixed(1)}%`;
      }
      
      if (totalDisplay) {
        breakdownHTML += `
          <div class="stat-info-breakdown-item" style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
            <span style="font-weight: 600;">합계</span>
            <span style="color: #4ade80; font-weight: 600; font-size: 0.95rem;">${totalDisplay}</span>
          </div>
        `;
      }
    }
  }
  breakdownHTML += '</div>';
  
  // 공격력 breakdown 밑에 메시지 추가
  if (statType === 'attack-power') {
    breakdownHTML += `
      <div style="margin-top: 1rem; padding: 0.75rem; background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 6px; font-size: 0.8rem; color: #ffc107; line-height: 1.5;">
        일부 클래스의 패시브 스킬로 인한 공격력 증가는 표기에 포함되지 않으며, 패시브 스킬로 인한 전투 점수 향상은 '스킬'에 포함됩니다. 날개의 장착/보유 효과, 타이틀 보유 효과 등 일부 내실로 인한 추가 공격력 증가는 계산이 불가합니다, 이에 따라 실제 인게임 공격력/치명타보다 낮을 수 있습니다.
      </div>
      <div style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--text-muted); line-height: 1.4;">
        전투 점수 계산에 베이스가 되는 공격력입니다.
      </div>
    `;
  }
  
  breakdownSection.innerHTML = breakdownHTML;
  
  // 설명 및 딜증 계산
  if (description) {
    let descriptionHTML = `<div class="stat-info-description-title">${statNames[statType]}</div>`;
    // 수학 공식이 포함된 텍스트를 처리
    let descriptionText = description.text;
    // LaTeX 스타일 수식을 HTML로 변환
    descriptionText = descriptionText.replace(/\$\$([^$]+)\$\$/g, '<div style="margin: 0.75rem 0; padding: 0.75rem; background: rgba(157, 140, 255, 0.1); border-left: 3px solid rgba(157, 140, 255, 0.5); font-family: monospace; font-size: 0.9rem; line-height: 1.6;">$1</div>');
    descriptionText = descriptionText.replace(/\$([^$]+)\$/g, '<span style="font-family: monospace; background: rgba(157, 140, 255, 0.15); padding: 0.1rem 0.3rem; border-radius: 3px;">$1</span>');
    descriptionHTML += '<div class="stat-info-description-text">' + descriptionText + '</div>';
    
    if (description.damageIncrease) {
      // 공격력과 치명타는 damageIncrease 표시 안함 (null이 아닐 경우만)
      if (statType !== 'attack-power' && statType !== 'critical-hit') {
        descriptionHTML += `<div class="stat-info-damage-increase">전투 점수 +${description.damageIncrease}</div>`;
      }
    }
    
    descriptionSection.innerHTML = descriptionHTML;
  } else {
    descriptionSection.innerHTML = '';
  }
  
  // 모달을 body에 직접 append하여 viewport 중앙에 표시되도록 함
  if (modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }
  
  modal.classList.add('active');
  currentStatModal = statType;
  document.body.style.overflow = 'hidden';
  
  // 스크롤 위치를 viewport 최상단으로 이동
  modal.scrollTop = 0;
}

// 영혼각인 등급 설명 모달 열기 함수 (openStatModal과 동일한 방식)
