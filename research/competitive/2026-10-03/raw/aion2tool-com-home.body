 \u00b7 Q3 {q3} \u00b7 \ucd5c\uace0 {max}", "statistics.server.xaxis_label": "\uc804\ud22c\ub825", "statistics.skill.cat_active": "\uc561\ud2f0\ube0c \uc2a4\ud0ac", "statistics.skill.cat_passive": "\ud328\uc2dc\ube0c \uc2a4\ud0ac", "statistics.skill.cat_stigma": "\uc2a4\ud2f0\uadf8\ub9c8", "statistics.skill.count_suffix": "{n}\uac1c", "statistics.skill.desc_long": "\uc544\ud234 \uc804\ud22c \uc810\uc218 \uae30\uc900 (PVE \uc138\ud305, PVP \ud0c0\uc774\ud2c0 \uc801\uc6a9 \uc911 \uce90\ub9ad\uc740 \uc9d1\uacc4 \uc81c\uc678) 1~100\uc704 \ub7ad\ucee4\ub4e4\uc758 \uace0\ud22c\uc790 \uc2a4\ud0ac \ucc44\uc6a9\ub960\uc744 \ud655\uc778\ud558\uc138\uc694.", "statistics.skill.error_generic": "\uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "statistics.skill.invest_rate": " \uace0\ud22c\uc790\uc728: ", "statistics.skill.last_update_loading": "\ub9c8\uc9c0\ub9c9 \uc5c5\ub370\uc774\ud2b8: \ub85c\ub529 \uc911...", "statistics.skill.last_update_prefix": "\ub9c8\uc9c0\ub9c9 \uc5c5\ub370\uc774\ud2b8", "statistics.skill.legend_high": "\uace0\ud22c\uc790 (20+/Stigma 21+)", "statistics.skill.legend_low": "\uc800\ud22c\uc790 (\ubbf8\ub9cc)", "statistics.skill.legend_mid": "\uc911\ud22c\uc790 (16~19/Stigma 15~20)", "statistics.skill.load_failed": "\ub370\uc774\ud130 \ub85c\ub4dc \uc2e4\ud328", "statistics.skill.loading": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911...", "statistics.skill.people_suffix": "\uba85", "statistics.skill.refresh_note": "30\ubd84\ub9c8\ub2e4 \uac31\uc2e0", "statistics.skill.tier_high": "\uace0", "statistics.skill.tier_low": "\uc800", "statistics.skill.tier_mid": "\uc911", "statistics.subtab.arcana": "\uc544\ub974\uce74\ub098 \ud1b5\uacc4", "statistics.subtab.combat_power": "\uc804\ud22c\ub825 \ud1b5\uacc4", "statistics.subtab.job": "\uc9c1\uc5c5\ubcc4 \ubd84\uc11d \ubc0f \ud1b5\uacc4 (\uc2a4\ud0ac/\uc7a5\ube44)", "statistics.subtab.population": "\uc778\uad6c\uc218 \ud1b5\uacc4", "statistics.subtab.server": "\uc11c\ubc84 \ud1b5\uacc4", "statistics.subtab.skill": "\uc2a4\ud0ac \ud1b5\uacc4", "tier.apply": "\uc801\uc6a9", "tier.boxplot_error_loading": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "tier.boxplot_footer_outlier_only": "(\uc77c\ubd80 \uc544\uc6c3\ub77c\uc774\uc5b4 \uc81c\uc678)", "tier.boxplot_footer_with_date": "\ucd5c\uc2e0 \uc5c5\ub370\uc774\ud2b8: {date}. (\uc77c\ubd80 \uc544\uc6c3\ub77c\uc774\uc5b4 \uc81c\uc678)", "tier.chart_score_label": "\uc810\uc218", "tier.combat_power_range": "\uc804\ud22c\ub825 \uad6c\uac04", "tier.combat_power_range_default": "5,000 ~ 6,000 \uc804\ud22c\ub825 \uae30\uc900", "tier.combat_power_range_tier": "\uc804\ud22c\ub825 \uad6c\uac04\ubcc4 \ud2f0\uc5b4\ud45c", "tier.content_score_title": "\uc9c1\uc5c5\ubcc4 \ucee8\ud150\uce20 \uc810\uc218 (\uc804\ud22c\ub825 \uace0\ub824 x)", "tier.count_person_suffix": "\uba85", "tier.cp_ratio_axis_label": "\uc804\ud22c\ub825 \ub300\ube44 \ud3ec\uc778\ud2b8 \ube44\uc728", "tier.data_load_fail": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc62c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.", "tier.data_loading": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911...", "tier.date_ymd": "{y}\ub144 {m}\uc6d4 {d}\uc77c", "tier.db_refresh_24h": "\uc544\ud234 db \uae30\ubc18 24\uc2dc\uac04\uc5d0 \ud55c\ubc88 \uc790\ub3d9\uac31\uc2e0", "tier.db_refresh_with_datetime": "\uc544\ud234 db \uae30\ubc18 24\uc2dc\uac04\uc5d0 \ud55c\ubc88 \uc790\ub3d9\uac31\uc2e0\n\ucd5c\uadfc \uc5c5\ub370\uc774\ud2b8: {date} {time}", "tier.desc_content_top100_cp_ratio": "\uac01 \ucee8\ud150\uce20 \uc0c1\uc704 100\uc704 \uce90\ub9ad\ud130\uc758 \uc804\ud22c\ub825 \ub300\ube44 \ud3ec\uc778\ud2b8 \ube44\uc728 \uae30\uc900", "tier.desc_power_ratio_in_range": "\uc124\uc815\ud55c \uc804\ud22c\ub825 \uad6c\uac04 \ub0b4 \uce90\ub9ad\ud130\ub4e4\uc758 \uc804\ud22c\ub825 \ub300\ube44 \ud3ec\uc778\ud2b8 \ube44\uc728 \uae30\uc900", "tier.latest_update_datetime": "\ucd5c\uadfc \uc5c5\ub370\uc774\ud2b8:", "tier.latest_update_full": "\ucd5c\uc2e0 \uc5c5\ub370\uc774\ud2b8: {date}", "tier.latest_update_prefix": "\ucd5c\uc2e0 \uc5c5\ub370\uc774\ud2b8:", "tier.load_error_generic": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "tier.loading_data": "\ub370\uc774\ud130 \uc870\ud68c \uc911", "tier.no_data": "\ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.", "tier.outlier_excluded": "(\uc77c\ubd80 \uc544\uc6c3\ub77c\uc774\uc5b4 \uc81c\uc678)", "tier.power_range_summary_fmt": "{min} ~ {max} \uc804\ud22c\ub825 \uae30\uc900", "tier.prompt_apply_range": "\uc804\ud22c\ub825 \uad6c\uac04\uc744 \uc124\uc815\ud558\uace0 \uc801\uc6a9 \ubc84\ud2bc\uc744 \ub20c\ub7ec\uc8fc\uc138\uc694.", "tier.radar_error_loading": "\ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\ub294 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4.", "tier.radar_title_cp_performance": "\uc804\ud22c\ub825 \ub300\ube44 \uc131\ub2a5", "tier.radar_title_same_cp_performance": "\ub3d9\uc77c \uc804\ud22c\ub825 \ub300\ube44 \uc131\ub2a5", "tier.range_query_notice": "\uc804\ud22c\ub825 \uad6c\uac04\ubcc4 \uc870\ud68c\ub294 10\ucd08 \uc774\uc0c1 \uc18c\uc694\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "tier.range_radar_title": "{min}~{max} \uc804\ud22c\ub825 \uad6c\uac04 \uc804\ud22c\ub825 \ub300\ube44 \uc131\ub2a5", "tier.season_title": "\uc2dc\uc98c2 - \uc9c1\uc5c5\ubcc4 \ud2f0\uc5b4", "tier.short_labels": "\uc5b4\ube44\uc2a4|\uace0\ub3c5|\ud611\ub825|\uc545\ubabd|\ucd08\uc6d4|\uac01\uc131|\ud1a0\ubc8c", "tier.title": "\ud2f0\uc5b4", "tier.top_server_desc": "\uc0c1\uc704 8\uac1c \uc11c\ubc84 \ucee8\ud150\uce20\ubcc4 1~100\uc704 \uc720\uc800 \uae30\uc900"};</script>
    <script type="application/json" id="skill-descriptions-data">{"\uac80\uc131": {"active": {"\uac80\uae30 \ub09c\ubb34": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uacf5\uc911 \uacb0\ubc15": {"description": "\ub118\uc5b4\uc9d0 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uacf5\uc911\uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uacf5\uc911\uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\ub0b4\ub824\ucc0d\uae30": {"description": "\ub118\uc5b4\uc9d0 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\ud589\ub3d9\ubd88\uac00 \uba74\uc5ed \ub300\uc0c1 \uacf5\uaca9 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ud65c\uc131\ud654\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub3c4\uc57d \ucc0d\uae30": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3c4\uc57d\ud558\uc5ec \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub3cc\uc9c4 \uc77c\uaca9": {"description": "\uae34\uae09 \ud68c\ud53c \uc0ac\uc6a9 \ud6c4 \ub300\uc0c1\uc5d0\uac8c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubc1c\ubaa9 \ubca0\uae30": {"description": "\ub9c9\uae30 \uc131\uacf5 \uc2dc \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100% \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubd84\uc1c4 \ud30c\ub3d9": {"description": "\uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\uc608\ub9ac\ud55c \uc77c\uaca9": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc720\ub9b0\uc758 \uac80": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ud589\ub3d9\ubd88\uac00 \uba74\uc5ed \ub300\uc0c1\uc77c \uacbd\uc6b0 \ubaa8\uc158\uc774 \ubcc0\uacbd\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc808\ub2e8\uc758 \ub9f9\ud0c0": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\uac15\uc778\ud568: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\ud30c\uba78\uc758 \ub9f9\ud0c0": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc790\uc2e0\uc740 [\uc804\ud22c \uc900\ube44] \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uc804\ud22c \uc900\ube44]: PVE \ubc0f PVE \ud53c\ud574 \uc99d\ud3ed, \uce58\uba85\ud0c0 \uc99d\uac00, \uc0c1\ud0dc\uc774\uc0c1 \uc801\uc911 \uc99d\uac00\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}, "passive": {"\uacf5\uaca9 \uc900\ube44": {"description": "\uc790\uc2e0\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed, \ubc29\uc5b4\ub825, \uba85\uc911\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ub178\ub828\ud55c \ubc18\uaca9": {"description": "\uc790\uc2e0\uc758 \uc804\ubc29 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\ub9c9\uae30 \uc131\uacf5 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0 \ubc0f \ud30c\ud2f0\uc6d0\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed \ud6a8\uacfc\ub294 \uc218\ud638\uc131\uc758 [\uaca9\uc559] \ud6a8\uacfc\uc640 \uc911\ubcf5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ubcf4\ud638\uc758 \uac11\uc637": {"description": "\uc790\uc2e0\uc758 \ub9c9\uae30\uac00 \uc99d\uac00\ud558\uace0, \ub9c9\uae30 \uc131\uacf5 \uc2dc \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0b4\uae30 \ud30c\uc5f4": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c \ub9c8\ub2e4 \uc0b4\uae30\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4. 5\ud68c \uc911\ucca9 \uc2dc \uc0b4\uae30\ub97c \uc0ad\uc81c\ud558\uace0 \uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0dd\uc874 \uc758\uc9c0": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)", "notes": ""}, "\uc0dd\uc874 \uc790\uc138": {"description": "\uc790\uc2e0\uc758 \ucd5c\ub300 \uc0dd\uba85\ub825 \ubc0f \uc790\uc5f0 \uc0dd\uba85\ub825 \ud68c\ubcf5\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc57d\uc810 \ud30c\uc545": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ubc0f \uc644\ubcbd\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \uc801\uc911": {"description": "\ucda9\uaca9\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud30c\uad34 \ucda9\ub3d9": {"description": "\ub300\uc0c1\uc774 \ucda9\uaca9\uacc4 \ub610\ub294 \uadf8\ub85c\uae30 \uc0c1\ud0dc\uc77c \ub54c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ud53c\uc758 \ud761\uc218": {"description": "\uacf5\uaca9 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc790\uc2e0\uc758 \uc0dd\uba85\ub825\uacfc \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\ubd80\ubd84\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uc0dd\uba85\ub825\uc774 50% \uc774\ud558\uc77c \ub54c \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\ubd80\ubd84\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \uc77c\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uac15\uc81c \uacb0\ubc15": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uaca9\ub178 \ud3ed\ubc1c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc801\uc911 \uc2dc \ub300\uc0c1\uc758 \uacf5\uaca9\ub825\uc744 \uac10\uc18c\uc2dc\ud0a4\ub294 \ud0c0\ubc15\uc0c1 \ud6a8\uacfc\ub97c \ubd80\uc5ec\ud558\uace0, \uc790\uc2e0\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc801\uc911 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 [\ub0b4\ub824\ucc0d\uae30]\uac00 \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.\ud0c0\ubc15\uc0c1 \ud6a8\uacfc\ub294 \uc218\ud638\uc131 [\ub3c4\ubc1c]\uc758 \uc704\ucd95 \ud6a8\uacfc\uc640 \uc911\ucca9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uade0\ud615\uc758 \uac11\uc637": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ucda9\uaca9\uacc4 \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uadfc\uc131": {"description": "3\ucd08 \ub3d9\uc548 \ud53c\ud574\ub97c \ubc1b\uc9c0 \uc54a\uc73c\uba70, \uc0c1\ud0dc\uc774\uc0c1\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud6a8\uacfc \uc885\ub8cc \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uc77c\ubd80 \uac15\ub825\ud55c \uacf5\uaca9\uc740 \ubc29\uc5b4\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\n\ubb34\uc801 \uc911\ubcf5 \ubd88\uac00 \ud6a8\uacfc\ub97c \ubcf4\uc720\ud55c \uacbd\uc6b0, 30\ucd08 \ub3d9\uc548 \uadfc\uc131, \uad6c\uc6d0, \uacb0\uacc4\uc758 \uc8fc\ubb38 \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ub3cc\uaca9 \uc790\uc138": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc804\ud22c \uc18d\ub3c4\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ubd84\ub178\uc758 \ud30c\ub3d9": {"description": "\uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uacf5\uaca9\ub825\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574\ub7c9 \uac10\uc18c", "notes": "\ub17c\ud0c0\uac9f"}, "\ubd84\uc1c4 \ub3cc\uc9c4": {"description": "\uc804\ubc29\uc744 \ud5a5\ud574 \ub3cc\uc9c4\ud558\uc5ec \uacbd\ub85c \ub0b4 \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\n\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9c0\ucf08\uc758 \ucd95\ubcf5": {"description": "\uc77c\uc815 \uc2dc\uac04\ub3d9\uc548 \uc790\uc2e0\uc758 \uacf5\uaca9\ub825\uacfc \uba85\uc911\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\uc9d1\uc911 \ub9c9\uae30": {"description": "\uc7a0\uc2dc \ub3d9\uc548 \uc804\ubc29 \uacf5\uaca9\uc5d0 \ub300\ud55c \ub9c9\uae30 \ud53c\ud574 \uac10\uc18c\uac00 \uc99d\uac00\ud558\uace0 \ud655\uc815 \ubb34\uae30\ub9c9\uae30\ub97c \ud569\ub2c8\ub2e4. \ub9c9\uae30 \uc131\uacf5 \uc2dc \uc815\uc2e0\ub825\uacfc \ud589\ub3d9\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc720\uc9c0\ud615 \uc2a4\ud0ac"}, "\uce7c\ub0a0 \ub0a0\ub9ac\uae30": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ubc29\uc5b4\ub825\uacfc \ubc1b\ub294 \uce58\uc720\ub7c9\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud30c\ub3d9\uc758 \uac11\uc8fc": {"description": "\uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \uc9c0\uc18d\uc801\uc778 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ud761\ud608\uc758 \uac80": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc0dd\uba85\ub825\uc744 \ud761\uc218\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}}, "\uad81\uc131": {"active": {"\uad11\ud48d \ud654\uc0b4": {"description": "\uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc790\uc2e0\uc740 [\uad11\ud48d] \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uad11\ud48d]: \uc804\ud22c \uc18d\ub3c4, PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed \uc99d\uac00\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ucc28\uc9c0 \uc2a4\ud0ac"}, "\uc18d\uc0ac": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc1a1\uacf3 \ud654\uc0b4": {"description": "\uce58\uba85\ud0c0 \uc131\uacf5 \uc2dc \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubd88 \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\ub300\uc0c1\uc740 1\ucd08 \uac04\uaca9\uc73c\ub85c \ud53c\ud574\ub97c \ubc1b\uace0, \ubc1b\ub294 \uce58\uc720\ub7c9\uc774 \uac10\uc18c\ud558\ub294 \ucd9c\ud608 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uc1a1\uacf3 \ud654\uc0b4], [\uc1e0\uc57d\uc758 \ub9f9\ud0c0], [\ubd88\uaf43 \uc791\uc0b4] \uc911 \ud558\ub098\uc758 \ubc1b\ub294 \uce58\uc720\ub7c9 \uac10\uc18c \ud6a8\uacfc\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc62c\uac00\ubbf8 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ub545 \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc774\ub3d9 \uc18d\ub3c4\uac00 \uac10\uc18c\ub418\ub294 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc800\uaca9": {"description": "\uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc81c\uc555 \ud654\uc0b4": {"description": "\uc790\uc2e0\uc774 [\uc815\ubc00] \uc0c1\ud0dc\uc77c \uacbd\uc6b0, \ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc870\uc900 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc790\uc2e0\uc774 [\uc815\ubc00] \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\n\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ucc28\uc9c0 \uc2a4\ud0ac"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ud30c\uc5f4 \ud654\uc0b4": {"description": "\ub454\ud654, \uc18d\ubc15 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud3ed\ubc1c\uc758 \ub36b": {"description": "\uc790\uc2e0 \uadfc\ucc98\uc5d0 \ubc94\uc704\ud615 \ud568\uc815\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \uc801\uc774 \ub2e4\uac00\uc624\uba74 \uc801\ub4e4\uc5d0\uac8c \ub545 \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud45c\uc801 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc790\uc2e0\uc740 \uc785\ub825 \ubc29\ud5a5\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 [\uc815\ubc00] \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uc815\ubc00]: \uce58\uba85\ud0c0 \uc99d\uac00\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud654\uc0b4 \ub09c\uc0ac": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}}, "passive": {"\uacbd\uacc4\uc758 \ub208": {"description": "\uc790\uc2e0\uc758 \ud68c\ud53c, \ucd5c\ub300 \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud558\uace0, \ud68c\ud53c \uc131\uacf5 \uc2dc \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uadfc\uc811 \uc0ac\uaca9": {"description": "\uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ubc14\ub78c \uc18d\uc131 \ucd94\uac00 \ud53c\ud574\ub97c \uc8fc\uace0, \uadfc\uc811 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911 \uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ubc00\ub824\ub0a8 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}, "\ubc14\ub78c\uc758 \ud65c\ub825": {"description": "\ucd5c\ub300 \ud589\ub3d9\ub825\uc774 \uc99d\uac00\ud558\uace0, \uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc774\ub3d9 \uc18d\ub3c4\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0ac\ub0e5\uafbc\uc758 \uacb0\uc758": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0ac\ub0e5\uafbc\uc758 \ud63c": {"description": "\uce58\uba85\ud0c0 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc18d\ubc15\uc758 \ub208": {"description": "\ub454\ud654, \uc18d\ubc15 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc800\ud56d\uc758 \uacb0\uc758": {"description": "\uc790\uc2e0\uc758 \uc721\uccb4\uacc4 \uc800\ud56d\uacfc \ucda9\uaca9\uacc4 \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc9d1\uc911 \ud3ec\ud654": {"description": "\uc9c0\uc18d \ud53c\ud574\ub97c \uc785\ub294 \ub300\uc0c1\uc5d0\uac8c \uc77c\uc815 \ud655\ub960\ub85c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc9d1\uc911\uc758 \ub208": {"description": "\uc790\uc2e0\uc758 \uba85\uc911, PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed, \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc0dd\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc\uc5d0\uc11c \ud53c\uaca9 \uc2dc \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5) \uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \uac15\ud0c0": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uacb0\ubc15\uc758 \ub36b": {"description": "\uc790\uc2e0 \uadfc\ucc98\uc5d0 \ubc94\uc704\ud615 \ud568\uc815\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \ud568\uc815\uc740 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc791\ub3d9\ud558\uba70 \uc801\uc774 \ub2e4\uac00\uc624\uba74 \uc801\ub4e4\uc5d0\uac8c \ub545 \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uacf5\uc911 \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\uadf8\ub9ac\ud3f0 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubd88 \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ud64d\uc5fc \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ud64d\uc5fc: \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \ubd88 \uc18d\uc131 \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub300\uc0c1\uc774 \uc774\ub3d9 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \uc9c0\uc18d \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uae30\uc2b5 \ucc28\uae30": {"description": "\ub300\uc0c1\uc758 \ub4a4\ub85c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0 \ubc00\ub824\ub09c \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \uc790\uc2e0\uc740 \ud6c4\ubc29\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.", "notes": ""}, "\ub300\uc790\uc5f0\uc758 \uc228\uacb0": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131 \ubc0f \uce58\uba85\ud0c0 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, [\ub300\uc790\uc5f0] \ud6a8\uacfc\ub97c \uc5bb\uc2b5\ub2c8\ub2e4.[\ub300\uc790\uc5f0]: \uc77c\uc815 \ud655\ub960\ub85c \uc790\uc2e0\uc758 \ubc1b\ub294 \ud53c\ud574\ub7c9\uc758 \uc77c\ubd80\ub97c \uc0dd\uba85\ub825\uc73c\ub85c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uc99d\uac00 \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubc14\uc774\uc824\uc758 \uad8c\ub2a5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uacf5\uaca9\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubd09\uc778 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc218\uba74 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc744 \uc218\uba74 \uc0c1\ud0dc\ub85c \ub9cc\ub4e4\uace0 \ubc29\uc5b4\ub825\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4. \uacf5\uaca9\uc744 \ubc1b\uc73c\uba74 \uc218\uba74\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4.", "notes": ""}, "\uc740\uc2e0": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc740\uc2e0 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\uc804\ud22c \uc0c1\ud0dc\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc73c\uba70, \uc740\uc2e0 \ud6c4 \uc804\ud22c \uc0c1\ud0dc\uac00 \ub418\uba74 \ud6a8\uacfc\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc9c0\uc6d0 \uc0ac\uaca9": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc8fc\ubcc0\uc5d0 \uc9c0\uc6d0 \uc0ac\uaca9\uc744 \ud558\ub294 \uad6c\uccb4\ub97c \uc18c\ud658\ud569\ub2c8\ub2e4. \uad6c\uccb4\ub294 \uc77c\uc815 \ud655\ub960\ub85c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc0dd\uba85\ub825\uc744 \ud761\uc218\ud558\ub294 \uc9c0\uc6d0 \uc0ac\uaca9\uc744 \ud569\ub2c8\ub2e4.\n\uc0ac\uaca9 \uc7ac\uc2dc\uc804 \uc2dc\uac04: 0.5\ucd08", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ucd95\ubcf5\uc758 \ud65c": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uba85\uc911 \ubc0f \uce58\uba85\ud0c0\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud3ed\ubc1c \ud654\uc0b4": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubd88 \uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\ub300\uc0c1\uc774 \ub454\ud654 \ubc0f \uc18d\ubc15 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud654\uc0b4 \ud3ed\ud48d": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud658\uc601 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c \uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}}, "\uad8c\uc131": {"active": {"\ube44\uac01": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.[\ud3ed\uc8fc \uc0c1\ud0dc]: \uc801\uc911 \uc2dc [\uc5f0\ud658\uad8c]\uc758 \uc7ac\uc2dc\uc804 \uc2dc\uac04\uc774 \uac10\uc18c\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc2b9\ucc9c\ud0c0": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \ucd5c\ub300 \ucc28\uc9c0 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \uacf5\uc911\uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ucd5c\ub300 3\ub2e8\uacc4 \ucc28\uc9c0 \uc2a4\ud0ac[\ud3ed\uc8fc \uc0c1\ud0dc]: \ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc989\uc2dc \uc2dc\uc804 \uc2a4\ud0ac\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc5f0\uaca9": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \ubd84\ub178\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.[\ud3ed\uc8fc \uc0c1\ud0dc]: \ubd84\ub178 \ud68c\ubcf5 \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc5f0\ud658\uad8c": {"description": "\uce58\uba85\ud0c0 \uc801\uc911 \uc2dc \ud65c\uc131\ud654\ub418\uba70, \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.[\ud3ed\uc8fc \uc0c1\ud0dc]: \uce58\uba85\ud0c0 \uc801\uc911 \uc870\uac74\uc774 \uc81c\uac70\ub429\ub2c8\ub2e4. \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc9c0\uba74 \uac15\ud0c0": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9c8\ud48d\uaca9": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.[\ud3ed\uc8fc \uc0c1\ud0dc]: \ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4 \uc0ac\uc774\ub97c \uc774\ub3d9\ud558\uba70 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\ub300\uc0c1\uc5d0\uac8c \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc5f0\uc18d\uae30 [\ud658\uc601\uac01]\uc774 \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.[\ud658\uc601\uac01]: \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc9c8\ud48d\uaca9 \ud53c\ud574\ub97c \uc785\uc740 \ub300\uc0c1\uc740 \uc790\uc2e0 \uadfc\ucc98\ub85c \ub04c\uc5b4\ub2f9\uae41\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ucca0\uc0b0\uace0": {"description": "[\uae34\uae09 \ud68c\ud53c] \uc0ac\uc6a9 \ub610\ub294 \ube44\ud589 \uc0c1\ud0dc\uc778 \uacbd\uc6b0 \ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ubd84\ub178\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ud0dc\ud48d \uc5f0\ud0c0": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ud3ed\ub82c\uad8c": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ubd84\ub178\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\ucd5c\ub300 3\ub2e8\uacc4 \ucc28\uc9c0 \uc2a4\ud0ac[\ud3ed\uc8fc \uc0c1\ud0dc]: \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ubd84\ub178\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uc989\uc2dc \uc2dc\uc804 \uc2a4\ud0ac\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\ucc28\uc9c0 \uc2a4\ud0ac/\uc774\ub3d9 \uac00\ub2a5"}, "\ud3ed\uc8fc": {"description": "\ud3ed\uc8fc \uc0c1\ud0dc\ub85c \ub3cc\uc785\ud569\ub2c8\ub2e4. \uc77c\uc815 \uc2dc\uac04\ub9c8\ub2e4 \ubd84\ub178\ub97c \uc18c\ubaa8\ud558\uba70 \ubd84\ub178\uac00 0\uc774 \ub418\uba74 \ud3ed\uc8fc \uc0c1\ud0dc\uac00 \uc885\ub8cc\ub429\ub2c8\ub2e4.[\ud3ed\uc8fc \uc0c1\ud0dc]: \uc804\ud22c \uc18d\ub3c4, PVE\u0026PVP \ud53c\ud574 \uc99d\ud3ed \uc99d\uac00, \ubaa8\ub4e0 \uc2a4\ud0ac\uc758 \ud3ed\uc8fc \uc0c1\ud0dc \uc801\uc6a9", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud68c\uc804\uac01": {"description": "\ub9c9\uae30 \uc131\uacf5 \uc2dc, \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}, "passive": {"\uac70\ub300\ud55c \ubd84\ub178": {"description": "\uc790\uc2e0\uc758 \ucd5c\ub300 \ubd84\ub178\uac00 \uc99d\uac00\ud558\uace0, [\ud3ed\uc8fc \uc0c1\ud0dc] \uc911 \ucd08\ub2f9 \ubd84\ub178 \uc18c\ubaa8\uac00 \uac10\uc18c\ud569\ub2c8\ub2e4.\uc801 \ucc98\uce58 \uc2dc \uc77c\uc815\ub7c9\uc758 \ubd84\ub178\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\ubd84\ub178 \ud68c\ubcf5 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 0.5\ucd08", "notes": ""}, "\uacbd\ub7c9\ud654": {"description": "\uc0dd\uba85\ub825\uc774 50% \uc774\uc0c1\uc778 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}, "\uc704\uc138": {"description": "\uc790\uc2e0\uc758 \uc804\ubc29 \ud53c\ud574 \uc99d\ud3ed, PVE \ud53c\ud574 \uc99d\ud3ed, PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc804\uc120 \uc720\uc9c0": {"description": "\uc790\uc2e0\uc758 \ub9c9\uae30\uac00 \uc99d\uac00\ud558\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubc1b\ub294 \ud53c\ud574\ub7c9\uc758 \uc77c\ubd80\ub97c \uc0dd\uba85\ub825\uc73c\ub85c \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\uba74 \ub3cc\ud30c": {"description": "\uc790\uc2e0\uc758 \uba85\uc911\uacfc \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud558\uace0 \uc804\ubc29 \uacf5\uaca9 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}, "\uc815\uc2e0 \uc804\ud658": {"description": "\ucd5c\ub300 \uc815\uc2e0\ub825\uc758 \uc77c\ubd80\ub97c \ucd5c\ub300 \uc0dd\uba85\ub825\uc73c\ub85c \uc804\ud658\ud558\uace0, \uc815\uc2e0\ub825 \uc790\uc5f0 \ud68c\ubcf5\ub7c9\uc758 \uc77c\ubd80\ub97c \uc0dd\uba85\ub825 \uc790\uc5f0\ud68c\ubcf5\uc73c\ub85c \uc804\ud658\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \uc801\uc911": {"description": "\uc790\uc2e0\uc758 \ucda9\uaca9\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9\ud0c0": {"description": "\ub300\uc0c1\uc774 \ucda9\uaca9\uacc4 \ub610\ub294 \uadf8\ub85c\uae30 \uc0c1\ud0dc\uc77c \ub54c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}, "\ud3ed\uc8fc \uc99d\ud3ed": {"description": "[\uc77c\ubc18 \uc0c1\ud0dc] \uc911 \uacf5\uaca9\ub825, \ubc29\uc5b4\ub825\uacfc [\ud3ed\uc8fc \uc0c1\ud0dc] \uc911 \uacf5\uaca9\ub825, \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc0dd\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)\uc0dd\uba85\ub825\uc774 10% \uc774\ud558\uc77c \ub54c \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\ubd80\ub97c \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.\ud68c\ubcf5 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ubd84\uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d \uc99d\uac00 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}}, "stigma": {"\uac15\uc2b5 \ud0c0\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uaca9\ub178": {"description": "\uc790\uc2e0\uc758 \ubd84\ub178\ub97c \ud68c\ubcf5\ud558\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 PVE \ud53c\ud574 \uc99d\ud3ed \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uacf5\ud30c\ucc38": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uba70 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uad8c\uae30 \ubc29\ucd9c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubd84\uc2e0": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uacf5\uaca9\uc744 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ubd84\uc2e0\uc744 \uc18c\ud658\ud574 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc21c\ubcf4": {"description": "\ub300\uc0c1\uc758 \ubc18\ub300\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574[\uc120\ud48d\uac01]: \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \ubc00\uc5b4\ub0c5\ub2c8\ub2e4.", "notes": ""}, "\uc601\uc5ed \uc18c\ud658": {"description": "\uc790\uc2e0\uc758 \uc704\uce58\uc5d0 \uc601\uc5ed\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\n8\ucd08 \ub0b4 [\uc5ed\ud589] \uc0ac\uc6a9 \ub610\ub294 8\ucd08 \uc774\ud6c4 \uc601\uc5ed\uc73c\ub85c \ub418\ub3cc\uc544\uc624\uba70 \uc601\uc5ed\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\n\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\uc800\uc9c0 \ubd88\uac00": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc0dd\uba85\ub825\uc774 \uc77c\uc815 \uc218\uce58 \uc774\ud558\ub85c \uac10\uc18c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\uc77c\ubd80 \uac15\ub825\ud55c \uacf5\uaca9\uc744 \ubc29\uc5b4\ud560 \uc218 \uc5c6\uc73c\uba70 \uc7ac\uc2dc\uc804 \uc2dc\uac04 \uc99d\uac00 \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\ubb34\uc801 \uc911\ubcf5 \ubd88\uac00 \ud6a8\uacfc\ub97c \ubcf4\uc720\ud55c \uacbd\uc6b0 30\ucd08 \ub3d9\uc548 \uad6c\uc6d0, \uacb0\uacc4\uc758 \uc8fc\ubb38, \uc800\uc9c0 \ubd88\uac00 \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\uc804\ub825": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9 \uc2dc \ubd84\ub178\ub97c \ubaa8\ub450 \uc18c\ubaa8\ud558\uba70, \ucd5c\ub300 \ubd84\ub178 \ub300\ube44 \uc18c\ubaa8\ub7c9\uc774 \uc99d\uac00\ud560 \ub54c \ub9c8\ub2e4 PVE \ubc0f PVP \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9c4\uac01": {"description": "\ub300\uc0c1\uc5d0\uac8c \uc774\ub3d9\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc801\ub4e4\uc740 \uc77c\uc815 \ud655\ub960\ub85c \uc774\ub3d9 \uc18d\ub3c4 \ubc0f \uc804\ud22c \uc18d\ub3c4\uac00 \uac10\uc18c\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9d1\uc911 \ub9c9\uae30": {"description": "\uc7a0\uc2dc \ub3d9\uc548 \ub9c9\uae30 \ud53c\ud574 \uac10\uc18c\uac00 \uc99d\uac00\ud558\uace0, \ud655\uc815 \ubb34\uae30\ub9c9\uae30\ub97c \ud569\ub2c8\ub2e4.\ub9c9\uae30 \uc131\uacf5 \uc2dc \ubd84\ub178\uc640 \ud589\ub3d9\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc720\uc9c0\ud615"}, "\ud30c\uc1c4": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ud0c0\uaca9\uc744 8\ud68c \uc801\uc911\uc2dc\ud0ac \ub54c \ub9c8\ub2e4 \uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c 2\ud68c \uc90d\ub2c8\ub2e4.\ud0c0\uaca9 \uc911\ucca9 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 0.5\ucd08", "notes": ""}, "\ud608\ub958 \ucc28\ub2e8": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ubc1b\ub294 \uce58\uc720\ub7c9\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\uc0dd\uba85\ub825 \uc77c\uc815\ub7c9\uc744 \ud761\uc218\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}}, "\ub9c8\ub3c4\uc131": {"active": {"\uaca8\uc6b8\uc758 \uc18d\ubc15": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\ubd88\uaf43 \uc791\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubd88\uaf43 \ud3ed\ubc1c": {"description": "\ubd88\uc758 \ud45c\uc2dd\uc778 \ub300\uc0c1\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubd88\uaf43 \ud654\uc0b4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ube59\uacb0": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ube59\uacb0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ube59\uacb0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ube59\uacb0 \ud3ed\ubc1c": {"description": "\ube59\uacb0 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\ud589\ub3d9\ubd88\uac00 \uba74\uc5ed \ub300\uc0c1 \uacf5\uaca9 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc5bc\uc74c \uc0ac\uc2ac": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc9c0\uc625\uc758 \ud654\uc5fc": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ucc28\uc9c0 \uc2a4\ud0ac"}, "\uc9d1\uc911\uc758 \uae30\uc6d0": {"description": "\uc790\uc2e0\uc758 \uacf5\uaca9\ub825 \ubc0f \uba85\uc911\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ud639\ud55c\uc758 \ubc14\ub78c": {"description": "\ub300\uc0c1\uc758 \uc704\uce58\uc5d0 \ud639\ud55c\uc758 \ubc14\ub78c\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4. \ud639\ud55c\uc758 \ubc14\ub78c \uc8fc\ubcc0 \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud654\uc5fc \ub09c\uc0ac": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}}, "passive": {"\uac15\ud654\uc758 \uc740\ud61c": {"description": "\uc790\uc2e0\uc758 \uc815\uc2e0\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\uc0c1\uc77c \ub54c PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud558\uba70, \uacf5\uaca9 \uc801\uc911 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ub0c9\uae30 \uc18c\ud658": {"description": "\ub454\ud654 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ub0c9\uae30\uc758 \ub85c\ube0c": {"description": "\uc790\uc2e0\uc758 \ubc29\uc5b4\ub825\uacfc \uce58\uba85\ud0c0 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \uc801\uc774 \uc790\uc2e0\uc744 \uacf5\uaca9\ud560 \ub54c\ub9c8\ub2e4 \uc774\ub3d9 \uc18d\ub3c4\ub97c \uac10\uc18c\uc2dc\ud0a4\ub294 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\ub300\uc9c0\uc758 \ub85c\ube0c": {"description": "\ucd5c\ub300 \uc815\uc2e0\ub825\uacfc \uc815\uc2e0\ub825 \uc790\uc5f0 \ud68c\ubcf5\uc774 \uc99d\uac00\ud558\uace0, \uc815\uc2e0\ub825\uc774 50% \uc774\uc0c1\uc77c \ub54c \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ubd88\uaf43\uc758 \ub85c\ube0c": {"description": "\uc790\uc2e0\uc758 \uba85\uc911, PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed, \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ubd88\uc758 \ud45c\uc2dd": {"description": "\ubd88\uc18d\uc131 \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \uc2dc\uac04\ub3d9\uc548 \ubd88\uc758 \ud45c\uc2dd \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.[\ubd88\uc758 \ud45c\uc2dd]: \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \ubc1b\uc744 \uacbd\uc6b0 \uc77c\uc815 \ud655\ub960\ub85c \ucd94\uac00 \ud53c\ud574", "notes": ""}, "\uc0dd\uae30 \uc99d\ubc1c": {"description": "\uc801\uc911 \uc2dc \ub300\uc0c1\uc758 \uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \ucd08\uacfc\uc77c \uacbd\uc6b0, \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc800\ud56d\uc758 \uc740\ud61c": {"description": "\uc790\uc2e0\uc758 \uc815\uc2e0\uacc4 \ubc0f \ucda9\uaca9\uacc4 \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\uae30 \ud761\uc218": {"description": "\uc721\uccb4\uacc4 \ubc0f \uc815\uc2e0\uacc4 \uc801\uc911\uc774 \uc99d\uac00\ud558\uace0, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc0dd\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc\uc5d0\uc11c \ud53c\uaca9 \uc2dc \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)\uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4", "notes": ""}}, "stigma": {"\uac15\uc2b5 \ud3ed\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \ube59\uacb0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ube59\uacb0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uac15\ucca0 \ubcf4\ud638\ub9c9": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c\uc758 \ud53c\ud574\ub97c \ub9c9\uc544\uc8fc\ub294 \ubcf4\ud638\ub9c9\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\uadf8 \ub3d9\uc548 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\ud6a8\uacfc\uac00 \ud574\uc81c\ub418\uba74 \ud589\ub3d9\ub825\uc744 300\ub9cc\ud07c \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ub0c9\uae30 \ud3ed\ud48d": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc758 \uc704\uce58\uc5d0\uc11c \uc9c0\uc18d\uc801\uc73c\ub85c \ub3d9\uc0c1 \uc0c1\ud0dc\ub85c \ub9cc\ub4dc\ub294 \ub0c9\uae30 \ud3ed\ud48d\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.[\ub3d9\uc0c1]: \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \ubb3c\uc18d\uc131 \uc9c0\uc18d \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \ub300\uc0c1\uc774 \uc774\ub3d9 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \uc9c0\uc18d \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub3d9\uba74": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0 \uc2a4\uc2a4\ub85c \ub3d9\uba74 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4. \ub3d9\uba74 \uc0c1\ud0dc\uc5d0\uc11c\ub294 \ud53c\ud574\ub97c \ubc1b\uc9c0 \uc54a\uc73c\uba70, \uc0c1\ud0dc\uc774\uc0c1\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\ub3d9\uba74 \uc0c1\ud0dc \uc911 [\ub3d9\uba74 \ud574\uc81c]\ub97c \uc0ac\uc6a9\ud558\uba74 \ub3d9\uba74\uc774 \uc989\uc2dc \ud574\uc81c\ub418\uace0, \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9\uc744 \ud68c\ubcf5\ud558\uba70 \ud6c4\ubc29\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.\n\uc77c\ubd80 \uac15\ub825\ud55c \uacf5\uaca9\uc740 \ubc29\uc5b4\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ub8e8\ubbf8\uc5d8\uc758 \uacf5\uac04": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uacf5\uc911 \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uacf5\uc911 \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\ubd88\uc758 \uc7a5\ubcbd": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ub300\uc0c1\uc758 \uc704\uce58\uc5d0 \ubd88\uc758 \uc7a5\ubcbd\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4. \ubc94\uc704 \ub0b4 \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc794\ubd88 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.[\uc794\ubd88]: \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \ubd88\uc18d\uc131 \uc9c0\uc18d \ud53c\ud574, \ub300\uc0c1\uc774 \uc774\ub3d9 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \uc9c0\uc18d \ud53c\ud574\ub7c9 \uc99d\uac00", "notes": ""}, "\ube59\uc124\uc758 \uac11\uc8fc": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud558\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uc790\uc2e0\uc744 \uacf5\uaca9\ud558\ub294 \uc801\ub4e4\uc744 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ube59\uacb0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \uc720\uc9c0 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc815\uc2e0\ub825\uc774 50% \uc774\uc0c1\uc77c \ub54c, [\ub9c8\ub825 \uce58\ud658] \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.[\ub9c8\ub825 \uce58\ud658]: \uc790\uc2e0\uc774 \ubc1b\ub294 \ud53c\ud574\uc758 50%\ub9cc\ud07c\uc744 \uc0dd\uba85\ub825\uc774, 10%\ub9cc\ud07c\uc744 \uc815\uc2e0\ub825\uc774 \ub098\ub204\uc5b4 \ubc1b\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ube59\ud558 \uac15\ud0c0": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc2e0\uc131 \ud3ed\ubc1c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc601\ud63c \ub3d9\uacb0": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc6d0\uc18c \uac15\ud654": {"description": "\uc790\uc2e0\uc758 \ubd88\uc18d\uc131 \ubc0f \ubb3c\uc18d\uc131 \uacf5\uaca9\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc800\uc8fc: \ub098\ubb34": {"description": "\ub300\uc0c1\uc758 \ubd88\uc18d\uc131 \ub0b4\uc131\uc744 \uac10\uc18c\uc2dc\ud0a4\ub294 \ub098\ubb34 \uc0c1\ud0dc\ub85c \ub9cc\ub4e4\uace0, \uc790\uc2e0\uc744 \ud6c4\ubc29\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.\uacf5\uaca9\uc744 \ubc1b\uc73c\uba74 \ubcc0\uc774 \ud6a8\uacfc\uac00 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9c0\uc5f0 \ud3ed\ubc1c": {"description": "\ub300\uc0c1\uc5d0\uac8c \uc77c\uc815 \uc2dc\uac04 \ub4a4\uc5d0 \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc9c0\uc5f0 \uc2dc\uac04 \ub3d9\uc548 \ub300\uc0c1\uc774 \ubd80\uc5ec\uc790\uc5d0\uac8c \ubc1b\ub294 \ud53c\ud574\ub791\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}}}, "\uc0b4\uc131": {"active": {"\uadf8\ub9bc\uc790 \ub099\ud558": {"description": "\uae30\uc808 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\uae30\uc2b5": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \ub300\uc0c1\uc758 \ud6c4\ubc29\uc5d0\uc11c \uacf5\uaca9\ud560 \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub9f9\uc218\uc758 \ud3ec\ud6a8": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, [\ubb38\uc591] 1\uac1c\ub97c \uac01\uc778\ud569\ub2c8\ub2e4.[\ubb38\uc591]: \uc804\ud22c \uc18d\ub3c4 \uac10\uc18c \ud6a8\uacfc*\ubb38\uc591\uc740 \ub514\ubc84\ud504 \ud574\uc81c \ud6a8\uacfc\uc5d0 \uc758\ud574 \uc81c\uac70\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ubb38\uc591 \ud3ed\ubc1c": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ubb38\uc591 \uc911\ucca9 \uc2dc \ud53c\ud574\ub7c9\uacfc \uae30\uc808 \ud655\ub960\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\n\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ube60\ub978 \ubca0\uae30": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc12c\uad11 \ubca0\uae30": {"description": "\ub300\uc0c1\uc758 \ubc18\ub300\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc2e4\uba85\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\uc12c\uad11\ubca0\uae30": {"description": "\ub300\uc0c1\uc758 \ubc18\ub300\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc2e4\uba85\uc774 \uc801\uc911\ub429\ub2c8\ub2e4. \uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574\ub7c9 7", "notes": "\ub17c\ud0c0\uac9f"}, "\uc2ec\uc7a5 \ucc0c\ub974\uae30": {"description": "\uce58\uba85\ud0c0 \uc801\uc911 \uc2dc \ud65c\uc131\ud654\ub418\uba70, \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc554\uc2b5": {"description": "\ub300\uc0c1\uc758 \ub4a4\ud3b8\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \ud68c\uc804\uc2dc\ud0a4\uba70, \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\uce68\ud22c": {"description": "\uae34\uae09 \ud68c\ud53c \uc0ac\uc6a9 \ud6c4 \ub300\uc0c1\uc758 \ub4a4\ud3b8\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc2e4\uba85\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud3ed\ud48d \ub09c\ubb34": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc624\ub9ac \ubca0\uae30": {"description": "\ud68c\ud53c \uc131\uacf5 \uc2dc \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ud68c\uc804\uc2dc\ud0a4\uba70 \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}, "passive": {"\uac01\uc624": {"description": "\uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc778 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uac15\uc2b5 \uc790\uc138": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uae30\uc2b5 \uc790\uc138": {"description": "\ub3cc\uc9c4 \ubc0f \uc774\ub3d9 \uad00\ub828 \uc2a4\ud0ac \uc0ac\uc6a9 \uc2dc [\uae30\uc2b5 \uc790\uc138] \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.[\uae30\uc2b5 \uc790\uc138]: \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c \ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ub3c5 \ubc14\ub974\uae30": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ub300\uc0c1\uc758 \ubc1b\ub294 \ud68c\ubcf5\ub7c9\uc744 \uac10\uc18c\uc2dc\ud0a4\uace0, \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\ub294 \uc911\ub3c5 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\ub3c5\ubc14\ub974\uae30": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ub300\uc0c1\uc758 \ubc1b\ub294 \ud68c\ubcf5\ub7c9\uc744 \uac10\uc18c\uc2dc\ud0a4\uace0, \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\ub294 \uc911\ub3c5 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\ubc29\uc5b4 \uade0\uc5f4": {"description": "\ucda9\uaca9\uacc4 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \ub300\uc0c1\uc758 \ubc29\uc5b4\ub825 \ubc0f \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": ""}, "\ubc30\ud6c4 \uac15\ud0c0": {"description": "\uc790\uc2e0\uc758 \ud6c4\ubc29 \ud53c\ud574 \uc99d\ud3ed\uacfc PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ube48\ud2c8 \ub178\ub9ac\uae30": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud558\uace0, \uce58\uba85\ud0c0 \uc801\uc911 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ubd84\uc2e0\uc744 \uc18c\ud658\ud574 \ud53c\ud574\ub97c \uc8fc\uace0 \ubb38\uc591\uc744 \ubd80\uc5ec\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc721\uac10 \uadf9\ub300\ud654": {"description": "\uc790\uc2e0\uc758 \ud68c\ud53c, \ucd5c\ub300 \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud558\uace0, \ud68c\ud53c \uc131\uacf5 \uc2dc \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \uc801\uc911": {"description": "\ucda9\uaca9\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc0dd\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc\uc5d0\uc11c \ud53c\uaca9 \uc2dc \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)\uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \uc2b5\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc2e4\uba85\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uacf5\uc911 \ud3ec\ubc15": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uacf5\uc911 \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ubb38\uc591 5\uc911\ucca9 \ub300\uc0c1\uc5d0\uac8c\ub294 100%\uc758 \ud655\ub960\ub85c \uacf5\uc911 \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uacf5\uc911 \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uadf8\ub9bc\uc790 \ubcf4\ud589": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc740\uc2e0 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\uc804\ud22c \uc0c1\ud0dc\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uace0, \uc0ac\uc6a9 \uc911 \uc804\ud22c \uc0c1\ud0dc\uac00 \ub418\uba74 \ud6a8\uacfc\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub098\uc120 \ubca0\uae30": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uba70 \ud53c\ud574\ub97c \uc8fc\uace0, \uac15\ud654 \ub9c8\ubc95\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4.\uac15\ud654 \ub9c8\ubc95 \uc81c\uac70 \uac1c\uc218\uc5d0 \ub530\ub77c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub9f9\uc218\uc758 \uc1a1\uacf3\ub2c8": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ubb38\uc591\uc744 \uac01\uc778\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\uc2e0\uc18d\uc758 \uacc4\uc57d": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc804\ud22c \uc18d\ub3c4\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc554\uac80 \ud22c\ucc99": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc774\ub3d9 \uc18d\ub3c4\uac00 \uac10\uc18c\ub418\ub294 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc554\uc601\ubcf4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc790\uc2e0\uc740 \ud6c4\ubc29\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc5f0\ub9c9\ud0c4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc2e4\uba85 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud2b8\ub9ac\ub2c8\uc5d8\uc758 \ube44\uc218": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \ubaa8\ub4e0 \uc2a4\ud0ac\uc758 \uc7ac\uc2dc\uc804 \uc2dc\uac04\uc744 5%\ub9cc\ud07c \ubc1c\uc0dd\uc2dc\ud0b5\ub2c8\ub2e4.\ub300\uc0c1\uc758 \ud6c4\ubc29\uc5d0\uc11c \uacf5\uaca9\ud560 \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud658\uc601 \ubd84\uc2e0": {"description": "\uc77c\uc815 \uc2dc\uac04\ub3d9\uc548 [\uc2ec\uc7a5 \ucc0c\ub974\uae30] \uc2a4\ud0ac\uc758 \uc7ac\uc2dc\uc804 \uc2dc\uac04\uc774 \uc81c\uac70\ub418\uace0, \ubaa8\ub4e0 \uacf5\uaca9\uc758 \uc77c\uc815\ub7c9\ub9cc\ud07c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud68c\ud53c \uc790\uc138": {"description": "\uc7a0\uc2dc \ub3d9\uc548 \ubaa8\ub4e0 \ud53c\ud574\ub97c \ud655\uc815 \ud68c\ud53c\ud569\ub2c8\ub2e4. \ud68c\ud53c \uc131\uacf5 \uc2dc \uc815\uc2e0\ub825\uacfc \ud589\ub3d9\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc720\uc9c0\ud615 \uc2a4\ud0ac"}, "\ud68c\ud53c\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc5d0\uac8c \uac78\ub9b0 \ub454\ud654, \uc18d\ubc15 \ud6a8\uacfc\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4.\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \ud68c\ud53c\uac00 \uc99d\uac00\ud558\uba70 \ub454\ud654, \uc18d\ubc15 \uba74\uc5ed \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}}}, "\uc218\ud638\uc131": {"active": {"\ub9f9\ub82c\ud55c \uc77c\uaca9": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ubc29\ud328 \uac15\ud0c0": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \ub300\uc0c1\uc740 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100% \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubc29\ud328 \ub3cc\uaca9": {"description": "\uae34\uae09 \ud68c\ud53c \uc0ac\uc6a9 \ud6c4 \ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ube44\ud638\uc758 \uc77c\uaca9": {"description": "\uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc790\uc2e0\uc740 \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud558\uace0, [\ube44\ud638] \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\uc2dc\uc804 \uc2dc [\uc2ec\ud310]\uc774 \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.[\ube44\ud638]: PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131 \uc99d\uac00\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc12c\uad11 \ub09c\ubb34": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4..", "notes": ""}, "\uc12c\uba78": {"description": "\uae30\uc808, \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\uc1e0\uc57d\uc758 \ub9f9\ud0c0": {"description": "\ub9c9\uae30 \uc131\uacf5 \uc2dc \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc1e0\uc57d \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.[\uc1e0\uc57d]: \ubc29\uc5b4\ub825 \uac10\uc18c\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc2ec\ud310": {"description": "\ubc29\ud328 \uc2a4\ud0ac \uc2dc\uc804 \uc2dc \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc5f0\uc18d \ub09c\ud0c0": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc9d5\ubc8c": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc790\uc2e0\uc740 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 [\uc9d1\ud589\uc790] \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.[\uc9d1\ud589\uc790]: \uba85\uc911, PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed \uc99d\uac00\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ucc28\uc9c0 \uc2a4\ud0ac"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ud3ec\ud68d": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc790\uc2e0\uc758 \uc55e\uc73c\ub85c \ub04c\uc5b4\ub2f9\uae30\uba70 \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100% \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}, "passive": {"\uaca9\uc559": {"description": "\uc790\uc2e0\uc758 \uc804\ubc29 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\ub9c9\uae30 \uc131\uacf5 \uc2dc \uc790\uc2e0 \ubc0f \ud30c\ud2f0\uc6d0\uc758 PVE \ubc0f PVP\ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ucd08", "notes": ""}, "\uace0\ud1b5 \ucc28\ub2e8": {"description": "\uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 \uc720\uc9c0\ub418\ub294 \uace0\ud1b5 \ucc28\ub2e8 \ud6a8\uacfc\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4.10\ud68c \uc911\ucca9\uc774 \ub418\uba74 \uace0\ud1b5 \ucc28\ub2e8 \ud6a8\uacfc\ub97c \uc0ad\uc81c\ud558\uace0 [\uc778] \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.[\uc778\ub0b4]: PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131 \uc99d\uac00", "notes": ""}, "\ub2e8\uc8c4\uc758 \uac00\ud638": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud558\uace0, \uacf5\uaca9 \uc801\uc911 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ub2e8\uc8c4\uc758 \uac00\ud638 \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.[\ub2e8\uc8c4\uc758 \uac00\ud638]: \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c \ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ubaa8\uc695\uc758 \ud3ec\ud6a8": {"description": "\uc790\uc2e0\uc758 \uc801\ub300\uce58 \uc99d\ud3ed\uc774 \uc99d\uac00\ud558\uace0, \uc804\ubc29 \uacf5\uaca9 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uacf5\uaca9\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 5\ucd08", "notes": ""}, "\ube44\ud638\uc758 \ubc29\ud328": {"description": "\uc790\uc2e0\uc758 \ub9c9\uae30\uac00 \uc99d\uac00\ud558\uace0, \ub9c9\uae30 \uc131\uacf5 \uc2dc \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0dd\uc874 \uc758\uc9c0": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc \ud53c\uaca9 \uc2dc PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)", "notes": ""}, "\uc218\ud638\uc758 \uc778\uc7a5": {"description": "\uc0dd\uba85\ub825\uc774 50% \uc774\ud558\uc77c \ub54c, \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c\uc758 \ubcf4\ud638\ub9c9\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ubd84", "notes": ""}, "\ucca0\ubcbd \ubc29\uc5b4": {"description": "\uc790\uc2e0\uc758 \ubc29\uc5b4\ub825\uacfc \ucca0\ubcbd \uc218\uce58\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uccb4\ub825 \uac15\ud654": {"description": "\uc790\uc2e0\uc758 \ucd5c\ub300 \uc0dd\uba85\ub825 \ubc0f \ubc1b\ub294 \ud68c\ubcf5\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \uc801\uc911": {"description": "\ucda9\uaca9\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \ub9f9\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uace0\uacb0\uc758 \uac11\uc8fc": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ucd5c\ub300 \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud558\uace0, \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uac15\ud654 \ub9c8\ubc95 \ud574\uc81c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uade0\ud615\uc758 \uac11\uc637": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ucda9\uaca9\uacc4 \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub098\ud3ec": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc790\uc2e0\uc758 \uc55e\uc73c\ub85c \ub04c\uc5b4\ub2f9\uae41\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc18d\ubc15 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub124\uc790\uce78\uc758 \ubc29\ud328": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc5d0\uac8c \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c\uc758 \ud53c\ud574\ub97c \ub9c9\uc544\ub0b4\ub294 \ubcf4\ud638\ub9c9\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.", "notes": ""}, "\ub3c4\ubc1c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.\uc801\uc911 \uc2dc \ub300\uc0c1\uc744 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 [\uc704\ucd95] \uc0c1\ud0dc\ub85c \ub9cc\ub4e4\uace0, \ub300\uc0c1\uc774 PC\uc778 \uacbd\uc6b0 \uc77c\uc815 \ud655\ub960\ub85c [\ub3c4\ubc1c] \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.[\uc704\ucd95]: \uba85\uc911, \uacf5\uaca9\ub825, PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131 \uac10\uc18c\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9\uac00\ub2a5"}, "\ubcf4\ud638\uc758 \ubc29\ud328": {"description": "\uc7a0\uc2dc \ub3d9\uc548 \uc804\ubc29 \uacf5\uaca9\uc5d0 \ub300\ud55c \ub9c9\uae30 \ud53c\ud574 \uac10\uc18c\uac00 \uc99d\uac00\ud558\uace0 \ud655\uc815 \ubc29\ud328\ub9c9\uae30\ub97c \ud569\ub2c8\ub2e4. \ub9c9\uae30 \uc131\uacf5 \uc2dc \uc815\uc2e0\ub825\uacfc \ud589\ub3d9\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc720\uc9c0\ud615 \uc2a4\ud0ac"}, "\uc774\uc911 \uac11\uc637": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9\uac00\ub2a5"}, "\uc804\uc6b0 \ubcf4\ud638": {"description": "\ud30c\ud2f0\uc6d0\uc774 \uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 \ud53c\ud574\uc758 \uc77c\ubd80\ub97c \uc790\uc2e0\uacfc \ud53c\uaca9\ubc1b\uc740 \ud30c\ud2f0\uc6d0\uc774 \ub098\ub204\uc5b4 \ubc1b\uc2b5\ub2c8\ub2e4.\uc5b4\ube44\uc2a4, \uc804\uc7a5, \ud22c\uae30\uc7a5\uc5d0\uc11c\ub294 10% \ub354 \ub9ce\uc740 \ud53c\ud574\ub7c9\uc744 \ub098\ub204\uc5b4 \ubc1b\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\uc804\uc7a5\uc758 \uae43\ubc1c": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ubc29\uc5b4\ub825\uc5d0 \ube44\ub840\ud558\uc5ec \uacf5\uaca9\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc8fc\uc2e0\uc758 \uc9d5\ubc8c": {"description": "\ub300\uc0c1\uc744 \uc90c\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ucc98\ud615\uc758 \uac80": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ubc29\uc5b4\ub825\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\ub300\uc0c1\uc774 \ucda9\uaca9\uacc4 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud30c\uba78\uc758 \ubc29\ud328": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uba70 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \uc801\uc911 \uc2dc \uc790\uc2e0\uc740 \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\ubd80\ub9cc\ud07c \ubcf4\ud638\ub9c9 \ud6a8\uacfc\ub97c \ubc1b\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 [\uc2ec\ud310]\uc774 \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}}}, "\uc815\ub839\uc131": {"active": {"\uacf5\uac04 \uc9c0\ubc30": {"description": "\uc815\ub839 \uc18c\ud658 \uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc9e7\uc740 \uc2dc\uac04 \ud65c\uc131\ud654\ub418\ub294 \uc2a4\ud0ac\uc785\ub2c8\ub2e4.\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc774\ub3d9 \uc18d\ub3c4\ub97c \uac10\uc18c\uc2dc\ud0a4\ub294 \ub454\ud654 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub0c9\uae30 \ucda9\uaca9": {"description": "\ub300\uc0c1\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.(\uc5f0\uacc4\uae30) \uc9c4\uacf5 \ud3ed\ubc1c: \ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.(\uc5f0\uacc4\uae30) \ub300\uc9c0 \uc9c4\ub3d9: \ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub9c8\ubc95 \uac15\ud0c8": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uac15\ud654 \ub9c8\ubc95\uc744 \ucd5c\ub300 2\uac1c \uc81c\uac70\ud569\ub2c8\ub2e4. \uac15\ud654 \ub9c8\ubc95\uc758 \uc0ad\uc81c \uac1c\uc218\uc5d0 \ub530\ub77c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574\ub7c9 20", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub9c8\ubc95 \ucc28\ub2e8": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574\ub7c9 20", "notes": ""}, "\uc18c\ud658: \ub545\uc758 \uc815\ub839": {"description": "\ub545\uc758 \uc815\ub839\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\ub545\uc758 \uc815\ub839\uc740 \ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0a4\ub294 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub300\uc0c1\uc774 PC\uc778 \uacbd\uc6b0 \uc77c\uc815 \ud655\ub960\ub85c \ub3c4\ubc1c \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc77c\ubc18 \uacf5\uaca9\uc73c\ub85c \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uba70, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud558\uace0 \uc801\ub300\uce58\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc18c\ud658 \uc544\uc774\ucf58\uc744 \uc120\ud0dd\ud558\uba74 \uc18c\ud658\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc2a4\ud0ac \ub808\ubca8\uc774 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 \ub545\uc758 \uc815\ub839\uc758 \ubc29\uc5b4\ub825\uacfc \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc18c\ud658: \ubb3c\uc758 \uc815\ub839": {"description": "\ubb3c\uc758 \uc815\ub839\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\ubb3c\uc758 \uc815\ub839\uc740 \ub300\uc0c1\uc5d0\uac8c \ubb3c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\ub294 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc77c\ubc18 \uacf5\uaca9\uc73c\ub85c \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uba70, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud558\uace0 \uc815\ub839\uc131\uc758 \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4.\uc18c\ud658 \uc544\uc774\ucf58\uc744 \uc120\ud0dd\ud558\uba74 \uc18c\ud658\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4.\uc2a4\ud0ac \ub808\ubca8\uc774 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 \ubd88\uc758 \uc815\ub839\uc758 \uacf5\uaca9\ub825\uacfc \uce58\uba85\ud0c0 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc18c\ud658: \ubc14\ub78c\uc758 \uc815\ub839": {"description": "\ubc14\ub78c\uc758 \uc815\ub839\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\ubc14\ub78c\uc758 \uc815\ub839\uc740 \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0 \uc815\ub839\uc131\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0a4\ub294 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc77c\ubc18 \uacf5\uaca9\uc73c\ub85c \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uba70, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud558\uace0 \uc815\ub839\uc131\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4. \uc18c\ud658 \uc544\uc774\ucf58\uc744 \uc120\ud0dd\ud558\uba74 \uc18c\ud658\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4.\uc2a4\ud0ac \ub808\ubca8\uc774 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 \ubc14\ub78c\uc758 \uc815\ub839\uc758 \uba85\uc911\uacfc \uce58\uba85\ud0c0 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc18c\ud658: \ubd88\uc758 \uc815\ub839": {"description": "\ubd88\uc758 \uc815\ub839\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\ubd88\uc758 \uc815\ub839\uc740 \ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\ub294 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc77c\ubc18 \uacf5\uaca9\uc73c\ub85c \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uba70, \uacf5\uaca9\uc774 \uc801\uc911\ub420 \ub54c \ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\uc18c\ud658 \uc544\uc774\ucf58\uc744 \uc120\ud0dd\ud558\uba74 \uc18c\ud658\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4.\uc2a4\ud0ac \ub808\ubca8\uc774 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 \ubd88\uc758 \uc815\ub839\uc758 \uacf5\uaca9\ub825\uacfc \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc5f0\uc18d \ub09c\uc0ac": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc601\ud63c\uc758 \uc808\uaddc": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uacf5\ud3ec \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uacf5\ud3ec\uac00 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc6d0\uc18c \uc735\ud569": {"description": "\uc815\ub839\uc744 \uc18c\ud658\ud560 \ub54c\ub9c8\ub2e4 \uc815\ub839\uc131\uc740 \uc6d0\uc18c\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4. \uc6d0\uc18c\uac00 4\uc911\ucca9\uc774 \ub418\uba74 4\uc6d0\uc18c \uc0c1\ud0dc\uac00 \ub418\uba70, [\uc6d0\uc18c \uc735\ud569] \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 4\uc6d0\uc18c \ud6a8\uacfc\ub97c \ud68d\ub4dd\ud55c \uc0c1\ud0dc\uc5d0\uc11c\ub9cc [\uc6d0\uc18c \uc735\ud569]\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \uc0ac\uc6a9 \uc2dc \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc6d0\uc18c \uc735\ud569\uc744 \uc0ac\uc6a9\ud558\uba74 4\uc6d0\uc18c\ub294 \uc989\uc2dc \uc0ad\uc81c\ub429\ub2c8\ub2e4. 4\uc6d0\uc18c \uc0c1\ud0dc\uac00 \ub418\uba74 \ucd94\uac00\ub85c \uc6d0\uc18c\ub97c \ud68d\ub4dd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ud611\uacf5: \uc800\uc8fc": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\ub294 \uc800\uc8fc \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.[\uc800\uc8fc]: \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc9c0\uc18d\ud53c\ud574, \uc815\ub839\uc131\uc5d0\uac8c \uc8fc\ub294 \ud53c\ud574 \uac10\uc18c\uc815\ub839\uacfc \ud568\uaed8 \ud611\uacf5\uc744 \ud569\ub2c8\ub2e4.\ubd88: \uad11\uc5ed \ud53c\ud574\ubb3c: \ub2e8\uc77c \ud53c\ud574\ub545: \ub2e8\uc77c \ud53c\ud574 \ubc0f \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d \uac10\uc18c\ubc14\ub78c: \uad11\uc5ed \ud53c\ud574 \ubc0f \uc9c0\uc18d \ud53c\ud574\uace0\ub300: \uad11\uc5ed \ud53c\ud574\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud654\uc5fc \uc804\uc18c": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubd88\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}}, "passive": {"\uc5f0\uc18d \uc5ed\ub958": {"description": "\uc9c0\uc18d \ud53c\ud574\ub97c \uc785\ub294 \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc6d0\uc18c \uacb0\uc9d1": {"description": "\uc815\ub839\uc758 \uc2a4\ud0ac \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc815\ub839\uacfc \uc815\ub839\uc131\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 5\ud68c \uc911\ucca9 \uac00\ub2a5)", "notes": ""}, "\uc815\ub839 \uac15\ub9bc": {"description": "\uc815\ub839 \uc18c\ud658 \ud6c4 \uc815\ub839\uc131\uc758 \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc815\ub839 \uad50\uac10": {"description": "\uc790\uc2e0\uc758 \uba85\uc911\uc774 \uc99d\uac00\ud558\uba70, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc790\uc2e0\uacfc \uc815\ub839\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\ub839 \ubcf4\ud638": {"description": "\uc790\uc2e0\uc758 \ubc29\uc5b4\ub825\uacfc \uc815\ub839\uc758 \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\ub839 \ud0c0\uaca9": {"description": "\uc790\uc2e0\uacfc \uc815\ub839\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed, \uc644\ubcbd\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\ub839 \ud68c\uc0dd": {"description": "\uacf5\uaca9 \uc801\uc911 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \uc815\ub839 \uc18c\ud658 \uc2a4\ud0ac\uc758 \uc7ac\uc2dc\uc804 \uc2dc\uac04\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\uc18c\ud658\ub41c \uc815\ub839\uc758 \uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \ucd5c\ub300 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc815\uc2e0 \uc9d1\uc911": {"description": "\uc790\uc2e0\uc758 \uc815\uc2e0\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uce68\uc2dd": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud558\uace0, \uce58\uba85\ud0c0 \uc801\uc911 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \uc9c0\uc18d \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc0dd\uc758 \uacc4\uc57d": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc\uc5d0\uc11c \ud53c\uaca9 \uc2dc \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)\uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \uacf5\ud3ec": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uacf5\ud3ec \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uacf5\ud3ec\uac00 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uac15\ud654: \uc815\ub839\uc758 \uac00\ud638": {"description": "\uc790\uc2e0\uacfc \uc18c\ud658\ub41c \uc815\ub839\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uacfc \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud558\uace0, \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc0dd\uba85\ub825\uc744 \uc9c0\uc18d \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uacf5\ud3ec\uc758 \uc808\uaddc": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uacf5\ud3ec \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc778 \uacbd\uc6b0, 100% \ud655\ub960\ub85c \uacf5\ud3ec\uac00 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\ub9c8\ubc95 \uac15\ud0c8": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uac15\ud654 \ub9c8\ubc95\uc744 \ucd5c\ub300 2\uac1c \uc81c\uac70\ud569\ub2c8\ub2e4.\uac15\ud654 \ub9c8\ubc95\uc758 \uc0ad\uc81c \uac1c\uc218\uc5d0 \ub530\ub77c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub9c8\ubc95 \ucc28\ub2e8": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uba85\ub839: \ub300\uc5ed": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc815\ub839\uc758 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud558\uace0, \uc815\ub839\uc131\uc774 \uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 \ud53c\ud574\uc758 \uc77c\uc815 \ubd80\ubd84\uc744 \uc815\ub839\uacfc \ub098\ub204\uc5b4 \ubc1b\uc2b5\ub2c8\ub2e4.\n\uba85\ub839: \ub300\uc5ed\uc740 \uc18c\ud658\ub41c \uc815\ub839 \uc911 \uc0dd\uba85\ub825\uc774 \ub354 \ub192\uc740 \uc815\ub839\uc5d0\uac8c \uc801\uc6a9\ub418\uba70, \uc0dd\uba85\ub825\uc774 \ub3d9\uc77c\ud55c \uacbd\uc6b0 \uac00\uae4c\uc6b4 \ub300\uc0c1\uc5d0\uac8c \uc801\uc6a9\ub418\uace0, \uc815\ub839\uc774 25m \uc774\ub0b4\uc5d0 \uc788\ub294 \uacbd\uc6b0\uc5d0\ub9cc \ud53c\ud574\ub97c \ub098\ub204\uc5b4 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubd88\uae38\uc758 \ucd95\ubcf5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uacf5\uaca9\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc801\uc5d0\uac8c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc18c\ud658: \uace0\ub300\uc758 \uc815\ub839": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc720\uc9c0\ub418\ub294 \uace0\ub300\uc758 \uc815\ub839\uc744 \uc18c\ud658\ud558\uace0, \uace0\ub300\uc758 \uc815\ub839\uc774 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud560 \ub54c \ub9c8\ub2e4 4\uc6d0\uc18c \ud6a8\uacfc\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4.\uace0\ub300\uc758 \uc815\ub839\uc740 \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\ub294 \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\uc2a4\ud0ac \uc0ac\uc6a9 \ud6c4 \uc77c\ubc18 \uacf5\uaca9\uc73c\ub85c \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uace0, \uc77c\uc815 \uc77c\ubc18 \uacf5\uaca9 \ud69f\uc218\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ub2e4\uc2dc \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\uc18c\ud658 \uc544\uc774\ucf58\uc744 \uc120\ud0dd\ud558\uba74 \uc18c\ud658\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4.\uc2a4\ud0ac \ub808\ubca8\uc774 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 \uace0\ub300\uc758 \uc815\ub839\uc758 \uacf5\uaca9\ub825, \ubc29\uc5b4\ub825, \uba85\uc911, \uce58\uba85\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc800\uc8fc\uc758 \uad6c\ub984": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uce74\uc774\uc2dc\ub12c\uc758 \uad8c\ub2a5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc801\uc911 \ubc0f \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ud611\uacf5: \ubd80\uc2dd": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc801\ub4e4\uc740 \ubd80\uc2dd \ud6a8\uacfc\ub97c \uc90d\ub2c8\ub2e4.[\ubd80\uc2dd]: \uc815\ub839\uc5d0\uac8c \ubc1b\ub294 \ud53c\ud574 \uc99d\uac00, \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d \ud53c\ud574\uc815\ub839\uacfc \ud568\uaed8 \ud611\uacf5\uc744 \ud569\ub2c8\ub2e4.\ubd88: \uad11\uc5ed \ud53c\ud574 \ubc0f \ub118\uc5b4\uc9d0\ubb3c: \ub2e8\uc77c \ud53c\ud574 \ubc0f \ub454\ud654\ub545: \ub2e8\uc77c \ud53c\ud574 \ubc0f \ubd09\uc778\ubc14\ub78c: \uad11\uc5ed \ud53c\ud574 \ubc0f \uae30\uc808\uace0\ub300: \uad11\uc5ed \ud53c\ud574 \ubc0f \ub118\uc5b4\uc9d0\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud611\uacf5: \ud30c\uba78\uc758 \uacf5\uc138": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc815\ub839\uacfc \ud568\uaed8 \ud611\uacf5\uc744 \ud569\ub2c8\ub2e4.\ubd88: \uad11\uc5ed \ud53c\ud574\ubb3c: \ub2e8\uc77c \ud53c\ud574\ub545: \ub2e8\uc77c \ud53c\ud574\ubc14\ub78c: \uad11\uc5ed \ud53c\ud574\uace0\ub300: \uad11\uc5ed \ud53c\ud574\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud761\uc778": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \uc77c\uc815 \uc0dd\uba85\ub825\uc744 \ud761\uc218\ud558\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}}}, "\uce58\uc720\uc131": {"active": {"\uace0\ud1b5\uc758 \uc5f0\uc1c4": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc801\ub4e4\uc740 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uac10\uc18c\ud558\uace0, \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub2e8\uc8c4": {"description": "\uace0\ud1b5\uc758 \uc5f0\uc1c4 \ud6a8\uacfc\ub97c \ubc1b\ub294 \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ub300\uc9c0\uc758 \uc751\ubcf4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.(\uc5f0\uacc4\uae30) \ub1cc\uc804: \ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.(\uc5f0\uacc4\uae30) \ubc29\uc804: \uc77c\uc815\ud655\ub960\ub85c \ubc1c\ub3d9\ud558\uba70, \ub300\uc0c1\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\ubcbc\ub77d \ub09c\uc0ac": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ubcbd\ub825": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ucc28\uc9c0 \uc2a4\ud0ac"}, "\uc2e0\uc131\ud55c \uae30\uc6b4": {"description": "\uc790\uc2e0 \uadfc\ucc98\uc5d0 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc720\uc9c0\ub418\ub294 \uc2e0\uc131\ud55c \uae30\uc6b4\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\uae30\uc6b4\uc740 \uc6c0\uc9c1\uc774\uc9c0 \ubabb\ud558\uba70 \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc2dc\uc804\uc790\uac00 \uc9c0\uc815\ud55c \ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc2ec\ud310\uc758 \ubc88\uac1c": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc57d\ud654\uc758 \ub099\uc778": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ubc14\ub78c\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc801\ub4e4\uc740 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uc774 \uac10\uc18c\ud558\uace0, \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc7ac\uc0dd\uc758 \ube5b": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\uc758 \uc0dd\uba85\ub825\uc744 \uc77c\uc815 \uc2dc\uac04\ub3d9\uc548 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uce58\uc720\uc758 \ube5b": {"description": "\uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4 \uc911 \uc0dd\uba85\ub825\uc774 \uac00\uc7a5 \ub0ae\uc740 \ub300\uc0c1\uacfc \uc790\uc2e0\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ucf8c\uc720\uc758 \uad11\ud718": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0a4\uace0, \uc57d\ud654 \ub9c8\ubc95\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5/\uc815\ud654"}}, "passive": {"\ub300\uc9c0\uc758 \uc740\ucd1d": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uacfc \uba85\uc911\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ub530\ub73b\ud55c \uac00\ud638": {"description": "\uc790\uc2e0\uc758 \ucd5c\ub300 \uc0dd\uba85\ub825 \ubc0f \uc815\uc2e0\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ubd88\uc0ac\uc758 \uc7a5\ub9c9": {"description": "\uc790\uc2e0\uc758 \ubc29\uc5b4\ub825 \ubc0f \uce58\uba85\ud0c0 \uc800\ud56d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0dd\uc874 \uc758\uc9c0": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc \ud53c\uaca9 \uc2dc PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)", "notes": ""}, "\uc8fc\uc2e0\uc758 \uac00\ud638": {"description": "\uc790\uc2e0\uc758 \ub9c9\uae30\uac00 \uc99d\uac00\ud558\uace0, \ub9c9\uae30 \uc131\uacf5 \ud6c4 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc8fc\uc2e0\uc758 \uc740\ucd1d": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud558\uace0, \ub300\uc0c1\uc5d0\uac8c \uacf5\uaca9\uc744 \uc801\uc911\uc2dc\ud0ac \ub54c\ub9c8\ub2e4 \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uc9d1\uc911\uc758 \uae30\ub3c4": {"description": "\uc790\uc2e0\uc758 \uc0dd\uba85\ub825\uc774 \uc77c\uc815\ub7c9 \uc774\ud558\uc77c \ub54c \ubcf4\ud638\ub9c9\uc744 \uc0dd\uc131\ud558\uace0 \uce58\uc720 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucc2c\ub780\ud55c \uac00\ud638": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": ""}, "\uce58\uc720\ub825 \uac15\ud654": {"description": "\uc790\uc2e0\uc758 \uce58\uc720 \uc99d\ud3ed\uc774 \uacf5\uaca9\ub825\uc758 \uc77c\uc815 \uc218\uce58\ub9cc\ud07c \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ud68c\ubcf5 \ucc28\ub2e8": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \ub300\uc0c1\uc758 \ubc1b\ub294 \uce58\uc720\ub7c9\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \ub099\uc778": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uace0\uacb0\ud55c \uae30\uc6b4": {"description": "\uc790\uc2e0 \uadfc\ucc98\uc5d0 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc720\uc9c0\ub418\ub294 \uace0\uacb0\ud55c \uae30\uc6b4\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4.\n\uae30\uc6b4\uc740 \uc2dc\uc804\uc790\uc640 \ub3d9\ud589\ud558\uba70 \ub300\uc0c1\uc744 \ud568\uaed8 \uacf5\uaca9\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uad6c\uc6d0": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ubaa8\ub4e0 \ud53c\ud574\ub97c \ubb34\ud6a8\ud654\ud558\uace0, \uc0c1\ud0dc\uc774\uc0c1\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\uc77c\ubd80 \uac15\ub825\ud55c \uacf5\uaca9\uc740 \ubc29\uc5b4\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uad8c\ub2a5 \ud3ed\ubc1c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ub300\uc9c0\uc758 \uc9d5\ubc8c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uba74\uc8c4": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc57d\ud654 \ub9c8\ubc95\uc744 \ucd5c\ub300 2\uac1c \uc81c\uac70\ud558\uace0, \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\ubcf4\ud638\uc758 \ube5b": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed\uacfc \ud53c\ud574 \ub0b4\uc131\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4\ud638\ubc95\uc131 \uc2a4\ud0ac [\ubd88\ud328\uc758 \uc9c4\uc5b8]\uacfc \uc911\ubcf5 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc73c\uba70 \uc2a4\ud0ac \ub808\ubca8\uc774 \ub354 \ub192\uc740 1\uac1c\uc758 \ud6a8\uacfc\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4. \uc2a4\ud0ac \ub808\ubca8\uc774 \ub3d9\uc77c\ud560 \uacbd\uc6b0 \ubd88\ud328\uc758 \uc9c4\uc5b8 \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.", "notes": "\ud1a0\uae00\ud615"}, "\uc0dd\uba85\uc758 \uad8c\ub2a5": {"description": "\uc790\uc2e0\uc5d0\uac8c \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc9c0\uc18d\ub418\ub294 \uc0dd\uba85\uc758 \uad8c\ub2a5\uc744 \ubd80\uc5ec\ud569\ub2c8\ub2e4.\uc0dd\uba85\uc758 \uad8c\ub2a5\uc774 \uc9c0\uc18d\ub418\ub294 \ub3d9\uc548 \uc790\uc2e0\uacfc \uc8fc\ubcc0\uc5d0 \uc788\ub294 \ud30c\ud2f0\uc6d0\uc758 \uc0dd\uba85\ub825\uc744 \uc9c0\uc18d \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc18c\ud658 \ubd80\ud65c": {"description": "\uc790\uc2e0\uc744 \uc911\uc2ec\uc73c\ub85c \uc77c\uc815 \uac70\ub9ac \ub0b4 \uc0ac\ub9dd\ud55c \ud30c\ud2f0\uc6d0\uc744 \uc790\uc2e0 \uadfc\ucc98\uc5d0\uc11c \ubd80\ud65c\uc2dc\ud0b5\ub2c8\ub2e4..", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc18d\ubc15": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uc18d\ubc15 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uc18d\ubc15\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc720\uc2a4\ud2f0\uc5d8\uc758 \uad8c\ub2a5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\uc99d\ud3ed\uc758 \uae30\ub3c4": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uacf5\uaca9\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uce58\uc720\uc758 \uae30\uc6b4": {"description": "\uc790\uc2e0 \uadfc\ucc98\uc5d0 \uce58\uc720\uc758 \uae30\uc6b4\uc744 \uc18c\ud658\ud569\ub2c8\ub2e4. \uae30\uc6b4\uc740 \uc774\ub3d9\ud560 \uc218 \uc5c6\uc73c\uba70, \uc2dc\uc804\uc790\uc640 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc744 \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\ud30c\uba78\uc758 \ubaa9\uc18c\ub9ac": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ub545\uc18d\uc131 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc801\ub4e4\uc740 \uc77c\uc815 \uac04\uaca9\uc73c\ub85c \uc9c0\uc18d\uc801\uc73c\ub85c \ud53c\ud574\ub97c \ubc1b\uace0, \ubc1b\ub294 \uce58\uc720\ub7c9\uc774 \uac10\uc18c\ud569\ub2c8\ub2e4.", "notes": ""}}}, "\ud638\ubc95\uc131": {"active": {"\uaca9\ud30c\uc1c4": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\ub3cc\uc9c4 \uaca9\ud30c": {"description": "\ub300\uc0c1\uc5d0\uac8c \ub3cc\uc9c4\ud558\uc5ec \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc815\uc2e0\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubc31\uc5f4\uaca9": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc554\uaca9\uc1c4": {"description": "\ub300\uc0c1\uc5d0\uac8c \uc6d0\uac70\ub9ac \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc6d0\uac70\ub9ac \uc2a4\ud0ac \uc0ac\uc6a9 \uc2dc [\uc554\uaca9\uc1c4]\uac00 \ud65c\uc131\ud654\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}, "\uc5f4\ud30c\uaca9": {"description": "\ub9c9\uae30 \uc131\uacf5 \uc2dc, \ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\uc9c4\ub3d9\uc1c4": {"description": "\uae34\uae09 \ud68c\ud53c \uc0ac\uc6a9 \ud6c4 \ub300\uc0c1\uc5d0\uac8c \uc774\ub3d9\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\uc9c8\ud48d \ub09c\ud0c0": {"description": "\uadf8\ub85c\uae30 \uc0c1\ud0dc\uc778 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \ud574\uc81c": {"description": "\uc790\uc2e0\uc758 \uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \uc7a1\uae30, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\ub97c \ud574\uc81c\ud558\uace0 \uac15\uc778\ud568 \uc0c1\ud0dc\uac00 \ub429\ub2c8\ub2e4.[\uac15\uc778\ud568]: \uc0c1\ud0dc\uc774\uc0c1 \uba74\uc5ed\uc7ac\uc2dc\uc804 \uc2dc\uac04 \uac10\uc18c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": ""}, "\ucf8c\uc720\uc758 \uc8fc\ubb38": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud558\uace0 \uc57d\ud654 \ub9c8\ubc95\uc744 1\uac1c \ud574\uc81c\ud569\ub2c8\ub2e4.\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc0dd\uba85\ub825\uc744 \uc9c0\uc18d \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\ud0c0\uaca9\uc1c4": {"description": "\ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ud30c\ub3d9\uaca9": {"description": "\uae30\uc808 \uc0c1\ud0dc\uc758 \ub300\uc0c1\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0 \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": ""}, "\ud68c\uc804\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc801\uc911 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. \ucd5c\ub300 2\ud68c\uae4c\uc9c0 \uc911\ucca9\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\uc774\ub3d9 \uac00\ub2a5"}}, "passive": {"\uaca9\ub178\uc758 \uc8fc\ubb38": {"description": "\ub300\uc0c1\uc774 \ucda9\uaca9\uacc4 \ub610\ub294 \uadf8\ub85c\uae30 \uc0c1\ud0dc\uc77c \ub54c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\uace0\ucde8\uc758 \uc8fc\ubb38": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ubc0f \uc644\ubcbd\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uacf5\uaca9 \uc900\ube44": {"description": "\uc790\uc2e0\uc758 PVE \ubc0f PVE \ud53c\ud574 \uc99d\ud3ed, \ubc29\uc5b4\ub825, \uba85\uc911 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\ub300\uc9c0\uc758 \uc57d\uc18d": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ub300\uc0c1\uc758 PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\uce58\uc720\uc131 [\uace0\ud1b5\uc758 \uc5f0\uc1c4] \ud6a8\uacfc\uc640 \ub3d9\uc2dc\uc5d0 \uc801\uc6a9\ub420 \uacbd\uc6b0 [\ub300\uc9c0\uc758 \uc57d\uc18d]\uc758 PVE, PVP \ud53c\ud574 \ub0b4\uc131 \uac10\uc18c \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 10\ucd08", "notes": ""}, "\ubc14\ub78c\uc758 \uc57d\uc18d": {"description": "\uc790\uc2e0\uc758 \uce58\uba85\ud0c0 \ud53c\ud574 \uc99d\ud3ed\uc774 \uc99d\uac00\ud558\uba70, \uce58\uba85\ud0c0 \uc801\uc911 \uc2dc \uc77c\uc815 \ud655\ub960\ub85c \ub300\uc0c1\uc5d0\uac8c \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.", "notes": ""}, "\ubcf4\ud638\uc9c4": {"description": "\uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 5\ucd08 \ub3d9\uc548 \uc720\uc9c0\ub418\ub294 \ubcf4\ud638\uc9c4\uc744 \ud68d\ub4dd\ud569\ub2c8\ub2e4.10\ud68c \uc911\ucca9\uc774 \ub418\uba74 \ubcf4\ud638\uc9c4\uc744 \uc0ad\uc81c\ud558\uace0, \uc790\uc2e0 \ubc0f \ud30c\ud2f0\uc6d0\ub4e4\uc5d0\uac8c 10\ucd08 \ub3d9\uc548 \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c\uc758 \ud53c\ud574\ub97c \ub9c9\uc744 \uc218 \uc788\ub294 \uc2e0\uc131\ud55c \ubcf4\ud638\ub9c9\uc744 \ubd80\uc5ec\ud569\ub2c8\ub2e4.\uc2e0\uc131\ud55c \ubcf4\ud638\ub9c9\uc774 \ubd80\uc5ec\ub41c \uc0c1\ud0dc\uc5d0\uc11c \ubcf4\ud638\uc9c4\uc774 10\ud68c \uc911\ucca9\ub418\uba74 \uc2e0\uc131\ud55c \ubcf4\ud638\ub9c9\uc774 \uac31\uc2e0\ub429\ub2c8\ub2e4.\uc790\uc2e0\uc758 \uc0dd\uba85\ub825\uc774 50% \uc774\ud558\uc77c \ub54c \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ud53c\ud574\ub97c \ub9c9\uc744 \uc218 \uc788\ub294 \uace0\uacb0\ud55c \ubcf4\ud638\ub9c9\uc744 \uc790\uc2e0\uc5d0\uac8c \ubd80\uc5ec\ud569\ub2c8\ub2e4.\ubcf4\ud638\uc9c4 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 0.5\ucd08\uace0\uacb0\ud55c \ubcf4\ud638\ub9c9 \uc7ac\ubc1c\ub3d9 \uc81c\ud55c \uc2dc\uac04: 1\ubd84", "notes": ""}, "\uc0dd\uba85\uc758 \ucd95\ubcf5": {"description": "\uc790\uc2e0\uc758 \ucd5c\ub300 \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud558\uba70, \uce58\uc720 \uc99d\ud3ed\uc774 \uacf5\uaca9\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uc0dd\uc874 \uc758\uc9c0": {"description": "\uc790\uc2e0\uc758 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 \uc99d\uac00\ud558\uace0, \ucda9\uaca9\uacc4, \ube59\uacb0, \uacf5\ud3ec \ud6a8\uacfc \ud53c\uaca9 \uc2dc PVE \ubc0f PVP \ud53c\ud574 \ub0b4\uc131\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.\uae30\uc808, \ub118\uc5b4\uc9d0, \uacf5\uc911 \uc18d\ubc15, \ube59\uacb0, \uacf5\ud3ec \uc0c1\ud0dc\uc5d0\uc11c \ud53c\uaca9 \uc2dc 5\ucd08 \ub3d9\uc548 \uc0c1\ud0dc\uc774\uc0c1 \uc800\ud56d\uc774 10%\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. (\ucd5c\ub300 10\ud68c \uc911\ucca9 \uac00\ub2a5)", "notes": ""}, "\uc2ed\uc790 \ubc29\uc5b4": {"description": "\uc790\uc2e0\uc758 \ub9c9\uae30\uac00 \uc99d\uac00\ud558\uace0, \ub9c9\uae30 \uc131\uacf5 \ud6c4 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": ""}, "\ucda9\uaca9 \uc801\uc911": {"description": "\uc790\uc2e0\uc758 \ucda9\uaca9\uacc4 \uc801\uc911 \ubc0f \uac15\ud0c0\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}}, "stigma": {"\uac15\uc2b5 \ucda9\uaca9": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574 \ubc0f \uc815\uc2e0\ub825 \ud53c\ud574\ub97c \uc8fc\uace0 \uc77c\uc815 \ud655\ub960\ub85c \uae30\uc808 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \uae30\uc808\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uc801\uc911 \uc778\uc6d0 \uc218\uc5d0 \ube44\ub840\ud558\uc5ec \ubc29\uc5b4\ub825\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4.", "notes": ""}, "\uacb0\uacc4\uc758 \uc8fc\ubb38": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc774 \uc77c\uc815 \uc218\uce58 \uc774\ud558\ub85c \uac10\uc18c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\uc77c\ubd80 \uac15\ub825\ud55c \uacf5\uaca9\uc740 \ubc29\uc5b4\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\n\ubb34\uc801 \uc911\ubcf5 \ubd88\uac00 \ud6a8\uacfc\ub97c \ubcf4\uc720\ud55c \uacbd\uc6b0, 30\ucd08 \ub3d9\uc548 \uadfc\uc131, \uad6c\uc6d0, \uacb0\uacc4\uc758 \uc8fc\ubb38 \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uacb0\ubc15\uc758 \ub099\uc778": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ubd09\uc778 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ubd09\uc778\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.", "notes": ""}, "\ub9c8\ub974\ucfe0\ud0c4\uc758 \ubd84\ub178": {"description": "\ub300\uc0c1\uc744 \uc911\uc2ec\uc73c\ub85c \uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.\uc2a4\ud0ac \uc0ac\uc6a9 \uc2dc \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc554\uaca9\uc1c4\uac00 \ud65c\uc131\ud654 \ub429\ub2c8\ub2e4.", "notes": ""}, "\uba78\ud654": {"description": "\uc801\ub4e4\uc5d0\uac8c \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0 \uc0c1\ud0dc\ub85c \ub9cc\ub4ed\ub2c8\ub2e4.\ub300\uc0c1\uc774 NPC\uc77c \uacbd\uc6b0 100%\uc758 \ud655\ub960\ub85c \ub118\uc5b4\uc9d0\uc774 \uc801\uc911\ub429\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": "\ub17c\ud0c0\uac9f"}, "\ubd84\uc1c4\uaca9": {"description": "\ub300\uc0c1\uc5d0\uac8c \ube60\ub974\uac8c \ub3cc\uc9c4\ud558\uc5ec \ud53c\ud574\ub97c \uc8fc\uace0, \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \ubc29\uc5b4\ub825\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.\ub300\uc0c1\uc774 \ucda9\uaca9\uacc4 \uc0c1\ud0dc\uc77c \uacbd\uc6b0 \ud53c\ud574\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\uadf8\ub85c\uae30 \uac8c\uc774\uc9c0 \ud53c\ud574", "notes": ""}, "\ubd88\ud328\uc758 \uc9c4\uc5b8": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 PVE \ubc0f PVP \ud53c\ud574 \uc99d\ud3ed, \ud53c\ud574 \ub0b4\uc131\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.*\uce58\uc720\uc131 \uc2a4\ud0ac [\ubcf4\ud638\uc758 \ube5b]\uacfc \ub3d9\uc2dc\uc801\uc6a9\ub418\uc9c0 \uc54a\uc73c\uba70 \uc2a4\ud0ac \ub808\ubca8\uc774 \ub354 \ub192\uc740 1\uac1c\uc758 \ud6a8\uacfc\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4. \uc2a4\ud0ac \ub808\ubca8\uc774 \ub3d9\uc77c\ud560 \uacbd\uc6b0 \ubd88\ud328\uc758 \uc9c4\uc5b8 \ud6a8\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.", "notes": "\ud1a0\uae00\ud615"}, "\uc218\ud638\uc758 \ucd95\ubcf5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uc758 \ucd5c\ub300 \uc0dd\uba85\ub825\uc774 \uc99d\uac00\ud558\uace0, \uc0dd\uba85\ub825\uc744 \uc989\uc2dc \ud68c\ubcf5\ud569\ub2c8\ub2e4.\uac15\ud654 \ub9c8\ubc95 \ud574\uc81c \ud6a8\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00\ub2a5"}, "\uc9c8\uc8fc\uc758 \uc9c4\uc5b8": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc774\ub3d9\uc18d\ub3c4\ub97c \uc99d\uac00\uc2dc\ud0a4\uace0, \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ud1a0\uae00\ud615"}, "\uc9c8\ud48d\uc758 \uad8c\ub2a5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc804\ud22c\uc18d\ub3c4\ub97c \uc99d\uac00\uc2dc\ud0a4\uace0, \uc2a4\ud0ac \uc7ac\uc2dc\uc804 \uc2dc\uac04\uc744 \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4.[\uc9c8\ud48d\uc758 \uad8c\ub2a5] \ud6a8\uacfc\ub97c \ubcf4\uc720\ud55c \uacbd\uc6b0 1\ubd84\ub3d9\uc548 \uce58\uc720\uc131 \uc2a4\ud0ac [\ub300\uc9c0\uc758 \ucd95\ubcf5] \ud6a8\uacfc\uac00 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\uc9d1\uc911 \ubc29\uc5b4": {"description": "\uc7a0\uc2dc \ub3d9\uc548 \uc804\ubc29 \uacf5\uaca9\uc5d0 \ub300\ud55c \ub9c9\uae30 \ud53c\ud574 \uac10\uc18c\uac00 \uc99d\uac00\ud558\uace0, \ud655\uc815 \ubb34\uae30\ub9c9\uae30\ub97c \ud569\ub2c8\ub2e4.\ub9c9\uae30 \uc131\uacf5 \uc2dc \uc815\uc2e0\ub825\uacfc \ud589\ub3d9\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\uc720\uc9c0\ud615"}, "\ucc28\ub2e8\uc758 \uad8c\ub2a5": {"description": "\uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc774 \uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 \ucd5c\ub300 \uc0dd\uba85\ub825\uc758 \uc77c\uc815\ub7c9 \ub9cc\ud07c \ud53c\ud574\ub97c \ub9c9\uc744 \uc218 \uc788\ub294 \ubcf4\ud638\ub9c9\uc744 \ub9cc\ub4ed\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f"}, "\ucf8c\uc720\uc758 \uc190\uae38": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0b5\ub2c8\ub2e4.", "notes": "\ub17c\ud0c0\uac9f/\uc774\ub3d9 \uac00"}, "\ucf8c\uc720\uc758 \uc9c4\uc5b8": {"description": "\uc790\uc2e0\uacfc \uc8fc\ubcc0 \ud30c\ud2f0\uc6d0\ub4e4\uc758 \uacf5\uaca9\uc774 \uc801\uc911\ud560 \ub54c\ub9c8\ub2e4 \uc77c\uc815 \ud655\ub960\ub85c \uc0dd\uba85\ub825\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4.", "notes": "\ud1a0\uae00\ud615"}}}}</script>
    <script>
      try {
        var _elSkillDesc = document.getElementById('skill-descriptions-data');
        window.__SKILL_DESCRIPTIONS__ = _elSkillDesc ? JSON.parse(_elSkillDesc.textContent) : {};
      } catch (e) {
        window.__SKILL_DESCRIPTIONS__ = {};
      }
    </script>

