      </div>

      <!-- 개인정보 처리방침 모달 -->
      <div id="privacy-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
          <div class="modal-header">
            <h2>개인정보 처리방침</h2>
            <button class="modal-close" id="privacy-close">&times;</button>
          </div>
