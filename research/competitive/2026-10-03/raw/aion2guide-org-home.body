  /* ES2018 only — untranspiled inline script, parsed by old webviews. */
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.classList.contains('black')
        ? 'black'
        : html.classList.contains('dark')
          ? 'dark'
          : 'light';
      const next = current === 'light' ? 'dark' : current === 'dark' ? 'black' : 'light';
      html.classList.toggle('dark', next !== 'light');
      html.classList.toggle('black', next === 'black');
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage unavailable — session-only theme */
      }
    });
  })();
