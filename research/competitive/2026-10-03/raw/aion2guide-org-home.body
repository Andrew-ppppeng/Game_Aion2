</span> </footer> </div> </dialog> <script>
  /* Deliberately ES2018-only syntax (no optional chaining, no nullish
     coalescing): this runs untranspiled in the HTML, and old in-app webviews
     (WeChat X5, pre-15.4 iOS) would throw a SyntaxError and leave search
     completely dead — "tapping search does nothing". Also binds
     [data-open-search] buttons DIRECTLY (mobile search bar / menu entries)
     instead of proxying through a click on the hidden #search-trigger. */
  (() => {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    const trigger = document.getElementById('search-trigger');

    let pagefindLoaded = false;

    const setBodyLock = (lock) => {
      document.body.style.overflow = lock ? 'hidden' : '';
    };
    const closeModal = () => {
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
      setBodyLock(false);
    };
    /* Autofocus only where a fine pointer exists: on phones the programmatic
       focus pops the soft keyboard and old iOS WebKit shoves the fixed
       dialog off-screen — the user taps the field themselves instead. */
    const focusInput = () => {
      const fine =
        window.matchMedia &&
        window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!fine) return;
      setTimeout(() => {
        const input = modal.querySelector('input');
        if (input) input.focus();
      }, 60);
    };

    const openModal = async () => {
      /* showModal() throws InvalidStateError on an already-open dialog, and
         multiple entry points (trigger, [data-open-search]) can fire for one
         tap — stay idempotent instead of relying on every caller binding once. */
      if (modal.open) return;
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        /* No <dialog> support — the fixed-position CSS keeps the open
           dialog a usable overlay even without showModal(). */
        modal.setAttribute('open', '');
        setBodyLock(true);
      }
      if (!pagefindLoaded) {
        pagefindLoaded = true;
        try {
          await import('/pagefind/pagefind-ui.js?v=e96f9a271a');
          const PFUI = window.PagefindUI;
          const target = document.getElementById('search-modal-inner');
          const noResults = target
            ? target.getAttribute('data-no-results')
            : 'No matches found';
          const placeholder = target ? target.getAttribute('data-placeholder') : 'Search';
          if (target && typeof PFUI === 'function') {
            new PFUI({
              element: '#' + target.id,
              showSubResults: true,
              showImages: false,
              showEmptyFilters: false,
              // Pagefind maps dist/<dir>/index.html → "/<dir>/" — which is
              // exactly the site's URL shape (trailingSlash:'always'). Keep a
              // defensive normalizer; skip URLs with a #fragment (sub-result
              // anchors — appending "/" after the hash breaks the jump).
              processResult: (result) => {
                const url = result && result.url;
                if (
                  url &&
                  url !== '/' &&
                  !url.endsWith('/') &&
                  url.indexOf('#') === -1
                ) {
                  result.url = url + '/';
                }
                const meta = result && result.meta;
                const metaUrl = meta && meta.url;
                if (
                  metaUrl &&
                  metaUrl !== '/' &&
                  !metaUrl.endsWith('/') &&
                  metaUrl.indexOf('#') === -1
                ) {
                  result.meta.url = metaUrl + '/';
                }
                return result;
              },
              translations: {
                placeholder: placeholder || 'Search',
                zero_results: noResults || 'No matches found',
              },
            });
            setTimeout(() => {
              focusInput();
            }, 60);
          } else {
            console.warn('[search] PagefindUI not found on window after loading pagefind-ui.js');
          }
        } catch (err) {
          console.warn('[search] Pagefind failed to load — run `pnpm build` first.', err);
          /* Never leave a silently empty dialog: surface the failure. */
          const inner = document.getElementById('search-modal-inner');
          const msg = (inner && inner.getAttribute('data-load-error')) || 'Search failed to load — refresh and try again.';
          if (inner) {
            inner.innerHTML = '';
            const p = document.createElement('p');
            p.className = 'pagefind-load-error';
            p.textContent = msg;
            inner.appendChild(p);
          }
        }
      } else {
        setTimeout(() => {
          focusInput();
        }, 50);
      }
    };

    const bindTrigger = (el) => {
      el.addEventListener('click', () => {
        openModal();
        // If the trigger lives inside a <details> menu, fold the menu back up.
        const menu = el.closest('details');
        if (menu) menu.open = false;
      });
    };
    if (trigger) bindTrigger(trigger);
    /* This inline script executes mid-parse (before the landing header's
       second-row search bar exists in the DOM), so [data-open-search]
       binding must wait for the full document. */
    const bindOpenSearchButtons = () => {
      const extra = document.querySelectorAll('[data-open-search]');
      for (let i = 0; i < extra.length; i++) bindTrigger(extra[i]);
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindOpenSearchButtons);
    } else {
      bindOpenSearchButtons();
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openModal();
      }
    });

    // Click outside the inner shell closes the modal (native dialog backdrop click).
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Lock body scroll while the dialog is open (backup for the CSS
    // :has() rule, for older browsers). Also prevent wheel events from
    // scrolling the background page when the results list reaches its
    // scroll boundary.
    modal.addEventListener('toggle', (e) => {
      setBodyLock(e.newState === 'open');
    });
    // showModal/close don't always fire 'toggle' in every browser, so
    // also hook the open/close calls directly.
    const origShow = typeof modal.showModal === 'function' ? modal.showModal.bind(modal) : null;
    const origClose = typeof modal.close === 'function' ? modal.close.bind(modal) : null;
    if (origShow) modal.showModal = () => { origShow(); setBodyLock(true); };
    if (origClose) modal.close = (rv) => { origClose(rv); setBodyLock(false); };

    // Prevent scroll-through: when wheeling inside the results area and
    // hitting the top/bottom boundary, stop the event so the background
    // page doesn't start scrolling.
    modal.addEventListener('wheel', (e) => {
      const scroller = modal.querySelector('.pagefind-ui__results-area');
      if (!scroller) return;
      const atTop = scroller.scrollTop === 0;
      const atBottom = scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight;
      const goingUp = e.deltaY < 0;
      const goingDown = e.deltaY > 0;
      if ((atTop && goingUp) || (atBottom && goingDown)) {
        e.preventDefault();
      }
    }, { passive: false });
  })();
