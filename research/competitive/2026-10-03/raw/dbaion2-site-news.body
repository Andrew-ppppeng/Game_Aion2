 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg><span>Guides</span></a></div><div class="navdd"><a href="/en/players/" class="navitem"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg><span>Player ranking</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/en/armory/">Characters: gear and stats</a></li><li><a href="/en/ranking/">Player ranking</a></li><li><a href="/en/tierlist/">Class tier list</a></li></ul></div><div class="navdd"><a href="/en/builder/" class="navitem"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3.5 17.5a1.4 1.4 0 0 0 0 2l1 1a1.4 1.4 0 0 0 2 0l5.8-5.8a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.3-.6-.6-2.3z"/></svg><span>Builder</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/en/builder/">Player builds</a></li><li><a href="/en/builder/b/?new=1">Create a build</a></li></ul></div><div class="navdd"><a href="/en/equip/" class="navitem"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg><span>Calculators</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/en/equip/">Gear and stats</a></li><li><a href="/en/daevanion/">Daevanion</a></li><li><a href="/en/skills/">Skills and stigmas</a></li><li><a href="/en/craft/">Crafting: material cost</a></li></ul></div><div class="navdd"><a href="/en/titles/" class="navitem" aria-current="page"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg><span>More</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a><ul class="navpop"><li><a href="/en/titles/">Titles</a></li><li><a href="/en/tracker/">Farm tracker and DPS meter</a></li><li><a href="/en/timeline/">Event schedule</a></li><li><a href="/en/promo/">Promo codes</a></li><li><a href="/en/checklist/">Checklist</a></li><li><a href="/en/guilds/">Legions</a></li><li><a href="/en/servers/">Servers and maintenance</a></li><li><a href="/en/site-news/">Site news</a></li><li><a href="/en/contacts/">Contacts</a></li><li><a href="/en/support/">Support the project</a></li></ul></div><a class="navlang" href="/site-news/" hreflang="ru" title="Русская версия">RU</a><div class="navlive" id="navlive" hidden data-on="is live" data-more="For streamers: partner program →" data-more-href="/en/streamers/"><button type="button" class="navlive-btn" aria-haspopup="true"><img class="navlive-ava" alt="" width="22" height="22" referrerpolicy="no-referrer"><span class="navlive-name"></span><span class="navlive-on">Live</span><svg class="icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div class="navlive-pop" role="menu"></div></div></nav></header><script>
// Live streamers (like questlog.gg): /api/live is our own cached list from the Twitch API (tools/live-server.mjs).
// Hidden when nobody is live; streams in the page language come first; refresh every 5 min while the tab is visible.
(() => {
  const box = document.getElementById('navlive');
  if (!box) return;
  const en = document.documentElement.lang === 'en';
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const sample = new URLSearchParams(location.search).has('livetest') ? { streams: [
    { login: 'maresco', name: 'Maresco', title: 'AION 2 Global — stream', lang: 'ru', viewers: 100, avatar: 'https://static-cdn.jtvnw.net/jtv_user_pictures/d1a14a9c-6255-4d83-869f-87464f156483-profile_image-300x300.png' } ] } : null;
  async function load() {
    if (document.hidden) return;
    let data = sample;
    if (!data) try { const r = await fetch('/api/live'); data = r.ok ? await r.json() : null; } catch { data = null; }
    const all = data?.streams ?? [];
    if (!all.length) { box.hidden = true; return; }
    const lang = en ? 'en' : 'ru';
    const list = [...all.filter((s) => s.lang === lang), ...all.filter((s) => s.lang !== lang)].slice(0, 12);
    const top = list[0];
    box.querySelector('.navlive-ava').src = top.avatar || '/favicon.svg';
    box.querySelector('.navlive-name').textContent = top.name;
    box.querySelector('.navlive-pop').innerHTML = list.map((s) => `<a class="navlive-item" role="menuitem" href="https://www.twitch.tv/${encodeURIComponent(s.login)}" target="_blank" rel="noopener nofollow" title="${esc(s.title)}">
      <img src="${esc(s.avatar || '/favicon.svg')}" alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer">
      <span><b>${esc(s.name)} ${esc(box.dataset.on)}<i></i></b><em>${esc(s.title)}</em><small>Aion 2 · ${esc(String(s.lang || '').toUpperCase())}</small></span></a>`).join('') + `<a class="navlive-more" href="${esc(box.dataset.moreHref)}">${esc(box.dataset.more)}</a>`;
    box.hidden = false;
  }
  load();
  setInterval(load, 300000);
  // a page opened in a background tab loads the list when it is first shown, not 5 min later
  document.addEventListener('visibilitychange', () => { if (!document.hidden && box.hidden) load(); });
})();
</script></div><section class="hero shell-native" style="--hero:url(/media/art/a11.webp);--heropos:center 30%"><div class="hero-in"><p class="eyebrow" data-edit="eyebrow">AION 2 · database</p><p class="h1" data-edit="h1">Site news</p><p class="hlead" data-edit="lead">What is new on the AION 2 Global database: updates, new sections and fixes.</p><form class="hero-search" action="/en/search/" role="search"><svg class="mi" aria-hidden="true"><use href="#i-search"></use></svg><input type="search" name="q" id="hq3" placeholder="Item, NPC, quest or skill name…" aria-label="Search the database" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hsug3" aria-autocomplete="list"><button type="submit">Search</button><ul class="hsug" id="hsug3" role="listbox" hidden></ul></form></div></section><main class="wrap page-body"><h1>Site news</h1><img class="mascot" src="/media/shugo/magic.webp" alt="A Shugo casting a spell" loading="lazy" width="960" height="1200" decoding="async"><div class="snews"><article class="glass"><time datetime="2026-10-02">October 2, 2026</time><h2>10 new guides, promo codes and an event schedule with in-game art</h2><ul><li>10 new guides on the most asked questions: launch errors, monetization and membership, the Abyss, Elyos or Asmodians, auto combat and bots, world bosses, making Kinah, picking a server, account and Twitch Drops, leveling 1–45.</li><li>New «Promo codes» page: active Global codes with rewards and expiry. Codes from the official news appear there automatically.</li><li>The event schedule now shows in-game art and icons: Shugo minigames, raids, rifts, arenas and boss portraits.</li><li>Fixed «Characters» for Global: NCSoft moved character search and pages to new addresses — search and gear work again.</li><li>The Global ranking is connected to the new API and refreshes hourly. As soon as NCSoft opens the ranking on the web, it appears here automatically.</li><li>Guide comments now sit right under the article.</li></ul></article><article class="glass"><time datetime="2026-10-01">October 1, 2026</time><h2>Global is live: the tracker for Global, quests and a streamer program</h2><ul><li>AION 2 Global launched with some trouble (queues, servers added on the fly, maintenance), yet it keeps breaking player records.</li><li>DBAion2 Tracker is optimised for Global: damage, kills, souls and drops are counted, cross-server and the cube finder work.</li><li>New in the tracker: the quest helper, a 1–45 leveling route with hints, Asmodians for now.</li><li>On the site: every Global server in the armory and ranking, news times in Moscow time.</li><li>We are launching a partner program for streamers: see the «For streamers» page.</li></ul></article><article class="glass"><time datetime="2026-09-29">September 29, 2026</time><h2>DBAion2 Tracker, dungeon Battle Power and new guides</h2><ul><li>DBAion2 Tracker — our app for AION 2 Global: farm tracker, goals, hidden cube search, overlay and a free DPS meter. The app is in development; PvP and duels are in beta. Details are on the tracker page.</li><li>PRO plans with a launch discount for the Global release: 7, 30, 90 and 365 days. Pay with a Russian card or SBP; the DPS meter stays free.</li><li>Dungeons: required Battle Power for Conquest, Transcendence and Nightmare from the Global client — as tables and per step on dungeon pages.</li><li>Skills calculator: how many stigma shards you can buy in the Shugo Fiesta, Nightmare and Abyss shops.</li><li>Progression guide: shop limits and Battle Power tables; class guides and general guides updated.</li><li>Item, NPC and quest pages get a short «how to get» summary and similar items; a new vendors page; the About page is redone.</li></ul></article><article class="glass"><time datetime="2026-09-27">September 27, 2026</time><h2>Living characters in the builder and item cards for your sites</h2><ul><li>Build planner: characters made from the game’s own presets — faces, hairstyles and the weapon in hand; hover a card to zoom in and watch the character breathe. Every class has its own colour and emblem.</li><li>The catalogue now holds dozens of popular Global builds by players, credited to their authors.</li><li>«Copy for embedding» on item, NPC and quest pages: link, forum BBCode, HTML and Markdown. Item links in Discord and Telegram now show a card with the icon and stats.</li><li>Item tooltips for your sites and guides: one line of code and links to dbaion2 show a pop-up card. See the «Tooltips for websites» page.</li><li>Coming soon: DBAion2 Tracker — farm, AP and PvP tracking and duels, plus a DPS meter. See the «DBAion2 Tracker and DPS meter» page.</li><li>The home page loads faster; the site rules were updated.</li></ul></article><article class="glass"><time datetime="2026-09-25">September 25, 2026</time><h2>New home page, a Player rankings section and better filters</h2><ul><li>Home page: the eight main sections — items, interactive map, character builder, skill calculator, craft calculator, Daevanion, player rankings and guides.</li><li>New Player rankings section: characters with their gear, leaderboards by mode and the class tier list on one page.</li><li>NPC and quest filters now work like the item filters. Quests got the in-game type icons, a level filter and sorting, and every catalog can be searched by ID.</li><li>The skill calculator shows what a specialization does: its effect appears in the skill description and next to the cooldown.</li><li>Two themes remain: Nebula and Nebula Light.</li><li>And lots of small fixes.</li></ul></article><article class="glass"><time datetime="2026-09-24">September 24, 2026</time><h2>Character builder, mobile version and beginner guides</h2><ul><li>Character builder with player builds: gear, skills and stigmas, Daevanion, looks, pets, wings and the rest. Final stats update live, variants can be compared, and a build can be shared by link.</li><li>Mobile version of the site: bottom and side menus, catalogs and calculators that work on phones.</li><li>Four new beginner guides based on the game client data.</li><li>And lots of small fixes.</li></ul></article><article class="glass"><time datetime="2026-09-23">September 23, 2026</time><h2>Big update: English version, new themes, filters and formulas</h2><ul><li>New Nebula and Nebula Light themes. Nebula is now the default, Native stays in the style switcher. The same header and menu on every page.</li><li>English version of the site and 63 news posts in English, including translated Korean patch notes.</li><li>Items: filters by grade, race, item level and required level, a “Show more” button, a separate Pets group.</li><li>Gear calculator: total attack, PvE, boss and PvP attack, crit chance and damage using formulas players derived. Wings, wardrobe and arcana enchanting added.</li><li>Skill calculator: stigmas start at level 0, stigma points are counted correctly.</li><li>Characters: hover an equipped item to see its actual stats, mana stones and god stone.</li><li>Map: new place icons. Dungeons: pictures are no longer stretched. News: every card has its own picture.</li><li>Mirror dbaion2.online for those who cannot open the main site. The address is in the footer.</li></ul></article><article class="glass"><time datetime="2026-09-22">September 22, 2026</time><h2>The AION 2 database is live</h2><ul><li>dbaion2.ru is open: 9,450 items, 13,494 NPCs and monsters with drops and spawn places, 1,429 quests, 315 skills, 737 recipes, 35 dungeons, 734 titles, pets — all from the game client.</li><li>Interactive map of the world and the Abyss with found marks, favourites and notes.</li><li>Calculators for gear, skills and stigmas with a skill bar, Daevanion and crafting. Share a build with a link.</li><li>Characters, rankings and a class tier list from official NCSoft data.</li><li>Search across the whole database, game news, guides and comments.</li></ul></article></div></main><div class="vctl"><div class="dd style-dd"><a class="icon-btn styleorb"