<script>if(document.body.dataset.focus==='classes'){ const s=document.createElement('script'); s.src="/js/classcompare.js?v=8296825254"; s.defer=true; document.body.appendChild(s); }</script>
<script>if(document.body.dataset.focus==='classes'){ const s=document.createElement('script'); s.src="/js/classquiz.js?v=5939564447"; s.defer=true; document.body.appendChild(s); }</script>
