  if(rj.status!=='fulfilled'||!rj.value||!Array.isArray(rj.value.events)){ await langP; document.querySelector('#riftSub').textContent=t('Could not load schedule.json. Refresh the page.'); return; }
  EVENTS=rj.value.events; LAUNCH=rj.value.launch||[]; SCHED_VERIFIED=typeof rj.value.verified==='string'?rj.value.verified:'';
