    window.openCard=(label,title,html)=>{ body.innerHTML=`<h2 class="tp-title">${title}</h2><p>${html}</p>`; open.classList.add('hidden'); dlg.querySelector('.tp-head .eyebrow').textContent=label; dlg.showModal(); body.scrollTop=0; };
    document.addEventListener('click',e=>{ const c=e.target.closest('.dcard'); if(!c) return; openCard(c.dataset.label||'Info',c.querySelector('.dcard-t').textContent,c.querySelector('.dcard-body').innerHTML); });
    $$('a[data-topic]').forEach(a=>a.addEventListener('click',e=>{ if(e.metaKey||e.ctrlKey||e.shiftKey||e.button===1) return; const t=document.querySelector(`template[data-topic-content="${a.dataset.topic}"]`); if(!t) return; e.preventDefault(); body.innerHTML=''; body.appendChild(t.content.cloneNode(true)); open.classList.remove('hidden'); open.onclick=null; open.href=a.dataset.open||a.href; const _ol=a.dataset.openlabel||'Open full page'; open.textContent=_ol; open.classList.toggle('no-caps',/\.[a-z]{2,}(?![a-z])/i.test(_ol)); dlg.querySelector('.tp-head .eyebrow').textContent=a.dataset.label||'Guide'; dlg.showModal(); body.scrollTop=0; }));
    // Change Log (2026-09-25): fetched fresh on every open (a unique query string, so no CDN copy is served), re-fetched every
    // 60 s while the dialog is open, and grouped by day in the viewer's zone: today expanded, earlier days collapsed.
    const clBtn=$('#changelogBtn'); let clTimer=null, clLast='';
    const clFetch=async()=>{ try{ const r=await fetch('/changelog.json?t='+Date.now(),{cache:'no-store'}); const j=await r.json(); const en=(j.entries||[]).slice().sort((a,b)=>new Date(b.ts)-new Date(a.ts)); return en; }catch(err){ return null; } };
    const clRender=(entries,keepOpen)=>{ const esc=x=>String(x).replace(/[&<>]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[ch])); const tz=displayTz();
      const dayKey=d=>new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).format(d); const today=dayKey(new Date());
      const dayFmt=new Intl.DateTimeFormat(LOCALE(),{timeZone:tz,weekday:'short',year:'numeric',month:'short',day:'numeric'}); const timeFmt=new Intl.DateTimeFormat(LOCALE(),{timeZone:tz,hour:'numeric',minute:'2-digit',hour12:S.fmt==='12'});
      const groups=[]; for(const en of entries){ const d=new Date(en.ts); const k=dayKey(d); let g=groups[groups.length-1]; if(!g||g.key!==k){ g={key:k,label:dayFmt.format(d),rows:[]}; groups.push(g); }
        g.rows.push(`<li class="cl-row"><span class="cl-ts">${esc(timeFmt.format(d))}</span><span class="cl-txt">${esc(en.text)}</span></li>`); }
      const days=groups.map(g=>{ const isToday=g.key===today; const isOpen=keepOpen?keepOpen.has(g.key):isToday; const n=g.rows.length; const count=n===1?t('1 change'):t('{n} changes',{n});
        return `<details class="cl-day" data-day="${g.key}"${isOpen?' open':''}><summary><span class="cl-dl">${isToday?esc(t('Today'))+' &middot; ':''}${esc(g.label)}</span><span class="cl-n">${esc(count)}</span></summary><ul class="cl-list">${g.rows.join('')}</ul></details>`; }).join('');
      const noneToday=groups.length&&groups[0].key!==today?`<p class="subtle cl-none">${t('No changes yet today.')}</p>`:'';
      return `<h2 class="tp-title">${t('Change Log')}</h2><p class="subtle">${t('Most recent first. Times shown in {tz}.',{tz})} ${t('Updates live while open.')}</p>${noneToday}${days||'<p class="subtle">'+t('No entries yet.')+'</p>'}`; };
    const clRefresh=async(first)=>{ const en=await clFetch(); if(!en) return; const sig=JSON.stringify(en); if(!first&&sig===clLast) return; clLast=sig;
      const keep=first?null:new Set([...body.querySelectorAll('.cl-day[open]')].map(d=>d.dataset.day)); const top=body.scrollTop; body.innerHTML=clRender(en,keep); body.scrollTop=first?0:top; };
    if(clBtn) clBtn.addEventListener('click',async e=>{ e.preventDefault(); open.classList.add('hidden'); dlg.querySelector('.tp-head .eyebrow').textContent=t('Change Log'); body.innerHTML=`<h2 class="tp-title">${t('Change Log')}</h2><p class="subtle">${t('Loading...')}</p>`; dlg.showModal(); await clRefresh(true);
      if(clTimer) clearInterval(clTimer); clTimer=setInterval(()=>{ if(dlg.open) clRefresh(false); else { clearInterval(clTimer); clTimer=null; } },60000); });
    dlg.addEventListener('close',()=>{ if(clTimer){ clearInterval(clTimer); clTimer=null; } });
    // Every other page has a gear linking to /#site-settings (one header site-wide, 2026-09-27): open Settings on arrival.
    // setTimeout 0 runs after the click handler below is attached.
    setTimeout(()=>{ if(location.hash!=='#site-settings') return; try{ history.replaceState(history.state,'',location.pathname+location.search); }catch(e){} const g=$('#homeSettingsBtn'); if(g) g.click(); },0);
    const hsBtn=$('#homeSettingsBtn'); if(hsBtn) hsBtn.addEventListener('click',e=>{ e.preventDefault(); applyPanels();
      body.innerHTML='<h2 class="tp-title">'+t('Settings')+'</h2>'
        +'<div class="st-row st-personal"><div><div class="lbl">'+t('Personal settings')+'</div><div class="note">'+t('Region, time zone, server, faction and main class. Shared field boss kills and party posts use your server.')+'</div></div></div>'
        +'<div id="stPersonalSlot"></div>'
        +'<div id="stProfileSlot"></div>'
        +'<div class="st-row st-lang"><div><div class="lbl">'+t('Language')+'</div><div class="note">'+t('Picked from your browser; override it here.')+'</div></div><span id="stLangSlot"></span></div>'
        +'<div class="st-row st-menupos"><div><div class="lbl">'+t('Menu position')+'</div><div class="note">'+t('Top, or docked left or right so it follows you down the page.')+'</div></div><span id="stMenuSlot"></span></div>'
        +'<div class="st-row st-clock"><div><div class="lbl">'+t('Clock')+'</div><div class="note">'+t('12-hour or 24-hour times across the site and your stream overlays.')+'</div></div><select id="hsFmt"><option value="12">'+t('12-hour')+'</option><option value="24">'+t('24-hour')+'</option></select></div>'
        +'<div class="st-row"><div><div class="lbl">'+t('Home page')+'</div><div class="note">'+t('Pick what shows on the home page. Everything stays reachable from the menu either way.')+'</div></div></div>'
        +'<div class="panel-toggles" id="panelTogglesDlg"></div>'
        +'<div class="st-row"><div><div class="lbl">'+t('Alerts')+'</div><div class="note">'+t('Browser alerts per timer, and the Discord webhook setup.')+'</div></div><span class="st-btns"><button type="button" class="btn small" data-jump="settings">'+t('Alert Settings')+'</button><button type="button" class="btn small" data-jump="discord">'+t('Discord Alerts')+'</button></span></div>'
        +'<div class="st-row st-sub"><div><div class="lbl">'+t('Play sound')+'</div><div class="note">'+t('A short tone with every alert. Tone and volume are under Alert Settings.')+'</div></div><label class="toggle"><input type="checkbox" id="hsSound"'+(S.sound?' checked':'')+'> '+t('On')+'</label></div>'
        +'<div class="st-row st-sub st-leads"><div><div class="lbl">'+t('Default lead times')+'</div><div class="note">'+t('How long before an event the alert fires. Each event card can override this.')+'</div></div><div id="stLeads"></div></div>'
        +'<div class="st-row st-tab"><div><div class="lbl">'+t('Browser tab')+'</div><div class="note">'+t('Turn this off to keep the tab and any new bookmark named Aion 2 Timers.')+'</div></div><label class="toggle"><input type="checkbox" id="hsTitle"'+(S.title?' checked':'')+'> '+t('Show the rift countdown in the tab title')+'</label></div>';
      // The real selects move in (ids and listeners intact: the language onchange navigates, nav.js listens for the
      // menu select on document) and go back to #settingsSlots on close, before any other topic overwrites the body.
      const slots=$('#settingsSlots'); const ls=$('#langSelect'), ms=document.querySelector('.a2navsel:not(#a2LangSel)'), ps=$('#controls');
      if(window.A2Profile) A2Profile.render($('#stProfileSlot')); else { const x=$('#stProfileSlot'); if(x) x.remove(); }   // Your Platforms (nav.js, 2026-09-29)
      if(ls) $('#stLangSlot').appendChild(ls); if(ms) $('#stMenuSlot').appendChild(ms); else $('.st-menupos').remove();
      if(ps){ $('#stPersonalSlot').appendChild(ps); if(!(FB.server||'').trim()){ const w=document.createElement('div'); w.className='note st-need'; w.textContent=t('Pick your server so field boss kills and party posts match your server.'); $('#stPersonalSlot').prepend(w); } }
      // Chrome 153 fired toggle but not close on this dialog in testing, so both are listened for.
      const putBack=()=>{ if(dlg.open||!slots) return; if(ls&&!slots.contains(ls)) slots.appendChild(ls); if(ms&&!slots.contains(ms)) slots.appendChild(ms); if(ps&&!slots.contains(ps)) slots.appendChild(ps); dlg.removeEventListener('close',putBack); dlg.removeEventListener('toggle',putBack); };
      dlg.addEventListener('close',putBack); dlg.addEventListener('toggle',putBack);
      renderPanelToggles('#panelTogglesDlg');
      // Alert Settings / Discord Alerts (owner 2026-09-26): switch the panel on if it was hidden, close, jump to it.
      body.querySelectorAll('[data-jump]').forEach(b=>{ b.onclick=()=>{ const id=b.dataset.jump; { const tg=document.getElementById(id); if(document.body.classList.contains('focus')&&!(tg&&tg.dataset.keep)){ location.href='/#'+id; return; } }   // topic pages do not carry Alert settings / Discord alerts
      S.panels=Object.assign({},S.panels||{}); S.panels[id]=true; save(); applyPanels(); syncPanelToggles(); dlg.close();
        if(location.hash==='#'+id) revealTarget(true); else location.hash=id; }; });
      // Same setting as Alert settings > Tab title (S.title); a visitor asked for it here too. tick() puts the plain title back when it is off.
      $('#hsSound').onchange=e=>{ S.sound=e.target.checked; save(); const ss=$('#setSound'); if(ss) ss.checked=S.sound; };
      { const hf=$('#hsFmt'); if(hf){ hf.value=S.fmt; hf.onchange=()=>{ const sf=$('#setFmt'); if(sf){ sf.value=hf.value; sf.dispatchEvent(new Event('change',{bubbles:true})); } else { S.fmt=hf.value; S.fmtSet=true; save(); } }; } }   // Clock (owner 2026-09-29): same path as Alert settings > Time format
      // the same lead-times widget as the Alert Settings panel, writing the same state; the panel re-renders on save
      { const host=$('#stLeads'); host._w=leadsWidget(host,{allowDefault:false,get:()=>defLeads(),set:a=>{ S.leads=normLeads(a)||[]; if(S.leads.length) S.lead=S.leads[0]; save(); dcDirty(); Object.keys(evEls).forEach(id=>fillEvCfg(id,evEls[id])); const ph=$('#setLeads'); if(ph&&ph._w) ph._w(); }}); }
      $('#hsTitle').onchange=e=>{ S.title=e.target.checked; save(); const al=$('#setTitle'); if(al) al.checked=S.title; if(!S.title) document.title=BASE_TITLE; };
      open.classList.add('hidden'); dlg.querySelector('.tp-head .eyebrow').textContent=t('Settings');
      dlg.showModal(); body.scrollTop=0; });
    const close=()=>dlg.close(); $('#tpClose').onclick=close; $('#tpDone').onclick=close; dlg.addEventListener('click',e=>{ if(e.target===dlg) close(); }); })();
  renderInfo(); renderPanelToggles(); applyPanels(); revealTarget(false); window.addEventListener('hashchange',()=>{ applyPanels(); revealTarget(true); }); initCustomTimers(); fbInit(); initStreamerEvents(); initSpeedrun(); initClasses(); renderClasses(); initPatches(); renderPatches(); rebuild(); initDiscord(); initLiveNow(); initAllStreams(); initGlobalFeed(); if(!window.OVERLAY) lazyBuilder(); else initCdOverlay(); setInterval(()=>tick(false),1000); setInterval(()=>{ const k=resetKeys(new Date()); if(k.dailyKey+'|'+k.weeklyKey!==chkKeysSeen) renderChecklist(); },60000);
  // Dictionary landed after the first paint: re-walk the page (now including the rendered cards) and redo the renderers that
  // build strings with t(); the init-only wiring above (custom timers, discord, checklist tools, builder) is not run twice.
  langP.then(()=>{ if(LANG==='en'||!Object.keys(DICT).length) return; i18nNodes.length=0; i18nApply(); renderPanelToggles(); renderInfo(); renderClasses(); renderPatches(); fbBuildSelects(); rebuild(); renderNotifyState(); dcSyncNotes(); asRender(); if(lnRender.last) lnRender(lnRender.last); if(GF.doc) gfRender(true); },()=>{});
}
init();
</script>
