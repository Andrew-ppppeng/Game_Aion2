  EVENTS.forEach(e=>{ if(!S.ev[e.id]||typeof S.ev[e.id]!=='object') S.ev[e.id]={on:e.def,lead:null,tone:null}; });
  // A language that came from the URL (/ja/ or ?lang=ja) is remembered, so the next page (planner, guide...) opens in it too
  { const q=(new URL(location.href).searchParams.get('lang')||'').toLowerCase().slice(0,2); const src=pathLang()||(LANGS[q]?q:''); if(src&&S.lang!==src&&!window.OVERLAY){ S.lang=src; save(); } }
  if(!S.fmtSet && LANG!=='en' && !(window.OVERLAY)) S.fmt='24'; i18nApply(); const ls=$('#langSelect'); if(ls){ for(const c in LANGS) ls.appendChild(new Option(LANGS[c][0],c)); ls.value=LANG; ls.onchange=()=>{ S.lang=ls.value; save(); location.href=langHref(ls.value); }; }
  // footer language links: remember the choice, so '/' does not bounce an English pick back to the saved language
  $$('nav.lang-foot a[hreflang]').forEach(a=>a.addEventListener('click',()=>{ const c=(a.getAttribute('href').match(/^\/([a-z]{2})\//)||[])[1]||'en'; if(LANGS[c]&&!window.OVERLAY){ S.lang=c; save(); } }));
  if(window.OVERLAY){ const O=window.OVERLAY; O.want=new Set((O.ev||'').split(',').map(x=>x.trim()).filter(Boolean)); if(O.ev){ const want=O.want; EVENTS.forEach(e=>{ S.ev[e.id]={on:want.has(e.id)||want.has('all'),lead:O.lead,tone:null}; }); } S.master=O.sound; S.sound=O.sound; S.title=false; S.lead=O.lead; S.leads=[O.lead]; S.cd10=false; S.atStart=true; S.atClose=true;
    if(O.brand){ const bl=document.createElement('div'); bl.className='brandline'; bl.textContent='www.aion2timers.com'; document.querySelector('.wrap').appendChild(bl); } }
