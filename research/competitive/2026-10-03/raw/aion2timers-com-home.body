<!-- Schedule table -->
<section class="section only-full" id="schedule">
  <div class="section-head">
    <div><div class="eyebrow">Schedule</div><h2>Upcoming, in your local time</h2></div>
    <div class="seg" id="rangeSeg" role="group" aria-label="Range"><button data-h="6">6 h</button><button data-h="12" class="active">12 h</button><button data-h="24">24 h</button><button data-h="168">7 days</button></div>
  </div>
  <div class="card tbl-wrap">
    <table>
      <thead><tr><th>Starts</th><th>In</th><th>Event</th><th>Type</th><th>Lasts</th></tr></thead>
      <tbody id="schedBody"></tbody>
    </table>
    <p class="subtle" style="margin:12px 0 0">Hourly minigames are grouped as one row. Toggle events off in the cards above to hide them here.</p>
  </div>
</section>

<!-- Checklist -->
<section class="section only-full" id="checklist">
  <div class="section-head">
    <div><div class="eyebrow">Progression</div><h2>Daily and weekly checklist for mains and alts</h2></div>
    <div class="row"><span class="subtle">Auto-clears at the 05:00 daily reset and Wednesday weekly reset</span><button class="btn small" data-popout="checklist" title="Compact window that stays in sync with this page">Pop out</button><button class="btn small" id="chkReset">Clear all</button></div>
  </div>
