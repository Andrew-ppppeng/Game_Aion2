<script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://www.aion2timers.com/#org", "name": "HomelessGuyNABox", "url": "https://homelessguynabox.org/", "logo": "https://www.aion2timers.com/logo.png", "sameAs": ["https://www.youtube.com/@homelessguynabox", "https://homelessguynabox.org/"]}, {"@type": "WebSite", "@id": "https://www.aion2timers.com/#website", "url": "https://www.aion2timers.com/", "name": "Aion 2 Timers", "publisher": {"@id": "https://www.aion2timers.com/#org"}, "inLanguage": "en"}, {"@type": "WebApplication", "@id": "https://www.aion2timers.com/#app", "name": "Aion 2 Timers", "alternateName": ["Aion 2 Rift Timer", "Aion 2 Spacetime Rift Timer", "Aion 2 Field Boss Timer", "Aion 2 World Boss Timer", "Aion 2 Event Timer"], "url": "https://www.aion2timers.com/", "description": "Live Aion 2 timers in your local time: Spacetime Rift, world bosses, Artifact Conquest, Shugo Festival and resets. Free Discord and OBS alerts.", "image": "https://www.aion2timers.com/og/banner-20261002.png", "applicationCategory": "GameApplication", "operatingSystem": "Web Browser", "browserRequirements": "Requires JavaScript", "isAccessibleForFree": true, "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}, "featureList": ["Spacetime Rift countdown", "World boss spawn timers", "Event timers", "Daily and weekly reset countdown", "Global launch countdown", "Sound and browser alerts", "Discord webhook alerts", "OBS stream overlay"], "about": {"@type": "VideoGame", "name": "AION 2", "publisher": {"@type": "Organization", "name": "NCSOFT"}}, "publisher": {"@id": "https://www.aion2timers.com/#org"}, "inLanguage": "en"}, {"@type": "FAQPage", "@id": "https://www.aion2timers.com/#faq", "mainEntity": [{"@type": "Question", "name": "When does the next Spacetime Rift open in Aion 2?", "acceptedAnswer": {"@type": "Answer", "text": "Spacetime Rifts open every 3 hours, 8 times a day, at 02:00, 05:00, 08:00, 11:00, 14:00, 17:00, 20:00 and 23:00 server time. The entry portal stays open about 10 minutes and the rift window lasts up to 1 hour. The countdown at the top of this page converts the next opening to your local time."}}, {"@type": "Question", "name": "What time zone does Aion 2 use?", "acceptedAnswer": {"@type": "Answer", "text": "The Taiwan service runs on UTC+8 (Asia/Taipei) and the Korea service on UTC+9 (Asia/Seoul). Both use the same clock schedule, so every event happens one hour apart between them. Global NA, SA, EU and Japan servers open October 5, 2026 and their server clock has not been published yet."}}, {"@type": "Question", "name": "Why is my Aion 2 rift timer an hour off?", "acceptedAnswer": {"@type": "Answer", "text": "Most often you have the wrong server selected, since Korea and Taiwan run one hour apart. Some trackers also hard-code US Eastern hours, which drift by an hour whenever daylight saving changes. This page anchors every event to the server's IANA time zone, so it stays correct through DST."}}, {"@type": "Question", "name": "What time is the daily and weekly reset in Aion 2?", "acceptedAnswer": {"@type": "Answer", "text": "Daily reset is at 05:00 server time. Weekly reset is Wednesday at 05:00 server time. Daily dungeon entries (7 per week) do not require daily logins and can all be cleared before Wednesday."}}, {"@type": "Question", "name": "When do Aion 2 world bosses spawn?", "acceptedAnswer": {"@type": "Answer", "text": "Post-Conquest Reshanta bosses (Watcher Kaira, Executor Argo, Executor Kaira, Executor Tamasa, Executioner Dramos, Ravager Marakha, Turncoat Ducal) spawn Wednesday and Saturday at 22:30 server time and despawn 30 minutes later. Enraged Guardian Lord Nahma spawns Friday and Sunday at 22:00. Watcher Kaira also has a regular 4-hour cycle from 01:00."}}, {"@type": "Question", "name": "When is Spacetime Rift Domination and the Abyss Rift Zone?", "acceptedAnswer": {"@type": "Answer", "text": "Rift Domination runs Monday, Thursday and Saturday at 20:00 and 23:00 server time with a 5-minute prep and a 15-minute match. The Abyss Rift Zone battlefield queues Tuesday and Thursday at 22:00 server time. Artifact Conquest is Wednesday and Saturday at 22:00."}}, {"@type": "Question", "name": "When is the Aion 2 global release?", "acceptedAnswer": {"@type": "Answer", "text": "Aion 2 launches globally on Monday, October 5, 2026 at 6:00 AM PDT (13:00 UTC) on Steam and the PURPLE launcher, with servers for North America, South America, Europe and Japan. Founder's Pack Advance Access runs from September 30 to October 4 and opened September 30 at 7:00 AM PDT (14:00 UTC), one hour later than first planned. This page counts down to both in your local time."}}, {"@type": "Question", "name": "Can I get Aion 2 rift alerts in Discord or on stream?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Paste a Discord webhook URL into the Discord alerts section and our server posts a message before each event you enable, even when this page is closed. The streamer section builds an OBS browser-source overlay URL with a live rift countdown, ticker bar, next-up cards or checklist."}}, {"@type": "Question", "name": "How many classes are in Aion 2?", "acceptedAnswer": {"@type": "Answer", "text": "Aion 2 has 9 playable classes: Gladiator, Templar, Assassin, Ranger, Sorcerer, Spiritmaster, Cleric, Chanter and Brawler. Every class is available to both factions and can be played male or female, so your class choice never locks you out of a side."}}, {"@type": "Question", "name": "What is on the Aion 2 schedule today?", "acceptedAnswer": {"@type": "Answer", "text": "Spacetime Rifts run every 3 hours at 02:00, 05:00, 08:00, 11:00, 14:00, 17:00, 20:00 and 23:00 server time, the daily reset lands at 05:00 server time and the weekly reset on Wednesday at 05:00. World bosses, Shugo Festival, Dimensional Invasion and Beritra Air Raid sit on their own rotations, and the schedule on this page converts all of them into your own time zone."}}]}]}</script>
