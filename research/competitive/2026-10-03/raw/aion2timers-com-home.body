  $('#exportBtn').onclick=()=>{ const o={region:S.region,tz:S.tz,globalTz:S.globalTz,master:S.master,sound:S.sound,tone:S.tone,vol:S.vol,repeat:S.repeat,lead:S.lead,leads:S.leads,cd10:S.cd10,cdVoice:S.cdVoice,fav:S.fav,hide:S.hide,atStart:S.atStart,atClose:S.atClose,fmt:S.fmt,ev:S.ev}; const url=location.origin+'/?cfg='+btoa(JSON.stringify(o)); (navigator.clipboard?navigator.clipboard.writeText(url):Promise.reject()).then(()=>toast(t('Link copied'),t('Open it on another device to import these settings.'))).catch(()=>prompt(t('Copy this link:'),url)); };
  $('#chkReset').onclick=()=>{ if(confirm(t('Clear every checkbox?'))){ const c=loadChk(); chkClear(c,'d'); chkClear(c,'w'); saveChk(c); renderChecklist(); } };
  chkInitTools(); chkLoadPresets();
  $$('#chkViews [data-chk]').forEach(b=>b.onclick=()=>{ S.chkShow=b.dataset.chk; if(!window.OVERLAY) save(); renderChecklist(); });
  { const db=$('#chkDoneBottom'); if(db) db.onchange=()=>{ S.chkDoneBottom=db.checked; if(!window.OVERLAY) save(); renderChecklist(); };
    const sh=$('#chkShowHidden'); if(sh) sh.onchange=()=>{ S.chkShowHidden=sh.checked; if(!window.OVERLAY) save(); renderChecklist(); };
    const pf=$('#chkPrioF'); if(pf) pf.onchange=()=>{ S.chkPrioF=pf.value; if(!window.OVERLAY) save(); renderChecklist(); };
