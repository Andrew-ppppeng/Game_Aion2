<style>
:root{
  --bg:#0a0814;--bg-2:#100c1f;--text:#f5f3ff;--text-muted:#b4aecb;--text-subtle:#8b86a3;
  --accent:#a78bfa;--accent-2:#818cf8;--accent-soft:rgba(167,139,250,.14);--accent-line:rgba(167,139,250,.34);
  --border:rgba(255,255,255,.1);--surface:rgba(255,255,255,.05);--surface-2:rgba(255,255,255,.08);
  --glow:rgba(167,139,250,.22);--card:rgba(10,8,20,.9);
  --ok:#34d399;--warn:#fbbf24;--danger:#f87171;--info:#60a5fa;
  --rift:#a78bfa;--pvp:#f472b6;--boss:#fb923c;--event:#34d399;--reset:#60a5fa;--launch:#fbbf24;--misc:#94a3b8;
  --radius:16px;
}
*{box-sizing:border-box}
html{color-scheme:dark}
body{margin:0;background:var(--bg);color:var(--text);font-family:"DM Sans",ui-sans-serif,system-ui,sans-serif;line-height:1.5;
  background-image:radial-gradient(1200px 600px at 50% -10%,rgba(167,139,250,.16),transparent 60%),radial-gradient(800px 400px at 100% 20%,rgba(129,140,248,.08),transparent 60%);
  background-attachment:fixed;min-height:100vh}
a{color:var(--accent);text-decoration:none}a:hover{color:var(--text)}
.wrap{max-width:1180px;margin:0 auto;padding:24px 20px 80px}
.mono{font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
.hero-banner{display:block;width:min(280px,70vw);height:auto;margin:2px auto 0}.hero-welcome{font-family:"Marcellus",Cinzel,Georgia,serif;font-weight:400;font-size:clamp(22px,3vw,30px);letter-spacing:.09em;text-transform:uppercase;text-align:center;margin:6px 0 4px;line-height:1.2;background:linear-gradient(180deg,#ffffff 0%,#dfe7f3 45%,#9fb2cc 70%,#eef3fa 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;filter:drop-shadow(0 1px 0 rgba(0,0,0,.6)) drop-shadow(0 0 14px rgba(70,150,255,.35))}.hero.only-full{padding-top:4px;padding-bottom:8px}details.a2more{margin:8px 0}details.a2more>summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;gap:8px}details.a2more>summary::-webkit-details-marker{display:none}details.a2more>summary::after{content:"";width:6px;height:6px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg) translate(-1px,-1px);opacity:.8}details.a2more[open]>summary::after{transform:rotate(-135deg) translate(-1px,-1px)}details.a2more>.a2more-body{margin-top:10px}details.a2more>.a2more-body>.card.sec{margin-bottom:0}
.pill{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:9999px;background:var(--accent-soft);border:1px solid var(--accent-line);font-size:13px;color:var(--text-muted)}
.pill svg{width:14px;height:14px}
header.top{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:28px}
.brand{display:flex;align-items:center;gap:12px;color:var(--text);font-weight:700;font-size:18px;text-decoration:none;cursor:pointer;border-radius:12px}
.brand:hover img,.brand:focus-visible img{border-color:var(--accent)}
.brand img{width:44px;height:44px;border-radius:12px;background:var(--surface);border:1px solid var(--border);object-fit:contain}
.brand small{display:block;font-weight:500;font-size:12px;color:var(--text-subtle)}
.brandrow{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap;min-width:0}
.about-btn{border-color:var(--accent-line);background:var(--accent-soft);color:#ddd6fe}
nav.links{display:flex;gap:8px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:var(--text);font:inherit;font-weight:600;font-size:14px;cursor:pointer;transition:all .2s}
.btn:hover{background:var(--surface-2);border-color:var(--accent-line)}
.btn.primary{background:linear-gradient(135deg,#6d28d9,#7c3aed 60%,#7c3aed);border:0;color:#fff;box-shadow:0 8px 24px var(--glow)}
.btn.primary:hover{transform:translateY(-1px);box-shadow:0 12px 30px var(--glow)}
.btn.small{min-height:32px;padding:4px 12px;font-size:13px;border-radius:10px}
.btn.active{background:linear-gradient(135deg,#6d28d9,#7c3aed 60%,#7c3aed);border-color:transparent;color:#fff;box-shadow:0 6px 18px var(--glow)}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.hero{text-align:center;margin:8px 0 28px}
.hero h1{font-size:clamp(30px,5vw,48px);letter-spacing:-.02em;margin:14px 0 8px;font-weight:800}
.hero p{max-width:760px;margin:0 auto;color:var(--text-muted);font-size:16px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;backdrop-filter:blur(6px)}
.card.glow{box-shadow:0 0 0 1px var(--accent-line),0 20px 60px var(--glow)}
.grid{display:grid;gap:16px}
.grid.cols-2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.grid.cols-3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.row.between{justify-content:space-between}
.seg{display:inline-flex;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:4px;gap:4px;flex-wrap:wrap}
.seg button{border:0;background:transparent;color:var(--text-muted);font:inherit;font-weight:600;font-size:13px;padding:8px 14px;border-radius:10px;cursor:pointer;min-height:36px}
.seg button.active{background:linear-gradient(135deg,#6d28d9,#7c3aed 60%,#7c3aed);color:#fff;box-shadow:0 6px 16px var(--glow)}
.lang-foot a{display:inline-block;padding:6px 4px}main#main:focus{outline:none}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
label.lbl,.lbl.g{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-subtle);font-weight:700}
select,input[type=number],input[type=text]{background:var(--surface);border:1px solid var(--border);color:var(--text);font:inherit;font-size:14px;border-radius:10px;padding:8px 10px;min-height:38px}
select option{background:#15112a;color:var(--text)}
input[type=range]{accent-color:var(--accent)}
input[type=checkbox]{accent-color:var(--accent);width:18px;height:18px}
h2{font-size:22px;letter-spacing:-.01em;margin:0 0 4px;font-weight:700}
h3{font-size:16px;margin:0 0 6px;font-weight:700}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:6px}
.muted{color:var(--text-muted)}.subtle{color:var(--text-subtle);font-size:13px}
.section{margin-top:28px}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}

/* hero timer */
.hero-timer{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;align-items:stretch}
@media(max-width:820px){.hero-timer{grid-template-columns:1fr}}
.big{font-size:clamp(44px,8vw,84px);font-weight:700;letter-spacing:-.02em;line-height:1;margin:6px 0}
.status{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;padding:6px 12px;border-radius:9999px;border:1px solid var(--border);background:var(--surface)}
.status .dot{width:9px;height:9px;border-radius:50%;background:var(--text-subtle)}
.status.open{border-color:rgba(52,211,153,.5);background:rgba(52,211,153,.12);color:#a7f3d0}.status.open .dot{background:var(--ok);box-shadow:0 0 12px var(--ok);animation:pulse 1.2s infinite}
.status.active{border-color:rgba(251,191,36,.5);background:rgba(251,191,36,.1);color:#fde68a}.status.active .dot{background:var(--warn)}
.status.soon{border-color:rgba(167,139,250,.5);background:var(--accent-soft);color:#ddd6fe}.status.soon .dot{background:var(--accent);animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.sched-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-top:8px}
.sched-list .t{padding:10px;border-radius:12px;border:1px solid var(--border);background:var(--surface);text-align:center;font-weight:600;font-size:14px}
.sched-list .t.past{color:var(--text-subtle);background:transparent;border-style:dashed;font-weight:500}.sched-list .t.next{border-color:var(--accent);background:var(--accent-soft);box-shadow:0 0 0 1px var(--accent-line)}
.sched-list .t small{display:block;font-weight:500;font-size:11px;color:var(--text-subtle)}
[data-lid],[data-sk]{cursor:pointer}[data-lid]:hover,[data-sk]:hover{border-color:var(--accent-line)}[data-lid]:focus-visible,[data-sk]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
body.overlay [data-lid],body.overlay [data-sk]{cursor:default}
.evd-big{font-size:clamp(30px,8vw,44px);font-weight:800;letter-spacing:.02em;margin:12px 0 2px}

/* clocks */
.clocks{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.clock{padding:12px 14px;border-radius:12px;background:var(--surface);border:1px solid var(--border)}
.clock .v{font-size:22px;font-weight:700}
.clock .k{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-subtle);font-weight:700}

.pkind{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:1px 6px;border-radius:5px;margin-right:6px;vertical-align:1px}
.pkind.hotfix{background:rgba(251,146,60,.16);color:#fdba74;border:1px solid rgba(251,146,60,.45)}
.pkind.update{background:var(--accent-soft);color:#ddd6fe;border:1px solid var(--accent-line)}
/* live now (approved streamers, gamedata/streamers_live.json) */
#allstreams.quiet{margin-top:10px}
.as-next{font-size:11.5px;color:var(--text-subtle);font-variant-numeric:tabular-nums;white-space:nowrap;align-self:center}
.as-chip{font-size:12px;padding:4px 10px;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text-muted);cursor:pointer;font-weight:600}
.as-chip.on{border-color:var(--accent);background:var(--accent-soft);color:var(--text)}
.lvc .pfb.youtube{background:rgba(239,68,68,.16);color:#fca5a5}
#livenow.quiet{margin-top:10px}
.live-cta{text-align:right;font-size:12px}.live-cta a{color:var(--text-subtle)}.live-cta a:hover{color:var(--accent)}
.live-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:10px}
.live-grid>*{min-width:0}
.sev-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:12px}.sev-grid>*{min-width:0}
.sev{display:flex;flex-direction:column;gap:10px;border:1px solid var(--border);border-radius:16px;background:var(--surface);padding:14px;color:var(--text)}
.sev-art{display:flex;align-items:center;justify-content:center;padding:10px 8px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(96,165,250,.18),rgba(15,12,30,0) 70%)}
.sev-art img{width:min(100%,360px);height:auto;display:block;filter:drop-shadow(0 6px 16px rgba(0,0,0,.55))}
.sev h3{margin:0;font-size:16px;line-height:1.25}
.sev .host{font-size:13px;color:var(--text-muted)}.sev .host a{color:var(--text)}
.sev .kind{font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:2px 7px;border-radius:6px;border:1px solid var(--accent-line);color:var(--accent);margin-right:6px;vertical-align:middle}
.sev p{margin:0;font-size:13.5px;color:var(--text-muted)}
.sev .row{margin-top:auto}
.sr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr));gap:12px}.sr-grid>*{min-width:0}
.sr{display:flex;flex-direction:column;gap:8px;border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:10px;color:var(--text);text-decoration:none;transition:border-color .15s,transform .15s}
.sr:hover{border-color:var(--accent-line);transform:translateY(-2px)}
.sr .thumb{position:relative;border-radius:10px;overflow:hidden;aspect-ratio:16/9;background:#0b0a16}.sr .thumb img{width:100%;height:100%;object-fit:cover;display:block}
.sr .len{position:absolute;right:6px;bottom:6px;font-size:11px;font-weight:700;padding:2px 6px;border-radius:6px;background:rgba(0,0,0,.75);color:#fff}
.sr h3{margin:0;font-size:14px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.sr .meta{font-size:12px;color:var(--text-muted);margin-top:auto}
.lvc{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:14px;background:var(--surface);overflow:hidden;min-width:0}
.lvc .th{position:relative;display:block;aspect-ratio:16/9;background:#15112a}
.lvc .th img{width:100%;height:100%;object-fit:cover;display:block}
.lvc .th .lvb{position:absolute;left:8px;top:8px;background:#dc2626;color:#fff;font-size:10px;font-weight:800;letter-spacing:.08em;padding:2px 6px;border-radius:5px}
.lvc .th .vw{position:absolute;left:8px;bottom:8px;background:rgba(0,0,0,.72);color:#fff;font-size:11.5px;padding:1px 6px;border-radius:5px}
.lvc .bd{padding:9px 11px 11px;display:flex;flex-direction:column;gap:5px;flex:1;min-width:0}
.lvc .nm{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-weight:700;font-size:14px;overflow-wrap:anywhere}
.lvc .tt{font-size:12.5px;color:var(--text-muted);overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.lvc .mt{font-size:11.5px;color:var(--text-subtle);overflow-wrap:anywhere}
.lvc .btn{margin-top:auto;align-self:flex-start}
@media(max-width:560px){.lvc{flex-direction:row}.lvc .th{flex:none;width:132px;align-self:flex-start;margin:9px 0 9px 9px;border-radius:9px;overflow:hidden}.lvc .th .lvb{left:4px;top:4px;font-size:9px}.lvc .th .vw{left:4px;bottom:4px;font-size:10px}.lvc .bd{padding:8px 10px 10px}.lvc .btn{align-self:flex-start}}
.pfb{font-size:10px;font-weight:800;letter-spacing:.04em;padding:1px 7px;border-radius:9999px;border:1px solid var(--border)}
.pfb.twitch{color:#c4a5ff;border-color:rgba(145,70,255,.6);background:rgba(145,70,255,.14)}
.pfb.kick{color:#53fc18;border-color:rgba(83,252,24,.45);background:rgba(83,252,24,.08)}
.pfb.youtube{color:#ff8a8a;border-color:rgba(255,48,48,.5);background:rgba(255,48,48,.1)}
.pfb.tiktok{color:#7ff6f0;border-color:rgba(37,244,238,.45);background:rgba(37,244,238,.08)}
a.pfb{text-decoration:none;display:inline-flex;align-items:center;min-height:24px}a.pfb:hover{filter:brightness(1.3)}.lvc .nm .pfb+.pfb{margin-left:4px}

/* next up strip */
.strip-wrap{display:flex;gap:10px;align-items:stretch}
#nowCard{flex:0 0 auto;display:flex}
@media (max-width:640px){body:not(.overlay) .strip-wrap{flex-direction:column}body:not(.overlay) .chip.now{max-width:none}}
.strip{display:flex;gap:10px;overflow-x:auto;padding:4px 2px 8px;scroll-snap-type:x proximity;flex:1;min-width:0}
.strip::-webkit-scrollbar{height:8px}.strip::-webkit-scrollbar-thumb{background:var(--surface-2);border-radius:8px}
.chip{min-width:190px;scroll-snap-align:start;padding:12px 14px;border-radius:14px;border:1px solid var(--border);background:var(--surface);border-left:3px solid var(--misc)}
.chip .n{font-weight:700;font-size:14px;line-height:1.25}
.chip .in{font-size:20px;font-weight:700;margin:4px 0 2px}
.chip .at{font-size:12px;color:var(--text-subtle)}
.chip.now{min-width:230px;max-width:300px;margin:4px 0 8px;border:1px solid rgba(52,211,153,.55);background:linear-gradient(180deg,#123328,#0a0814 70%);box-shadow:0 8px 24px rgba(0,0,0,.45);border-left-width:1px}
.chip.now .n{color:#a7f3d0;display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.08em;font-size:12px}
.chip.now .dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 10px var(--ok);animation:pulse 1.2s infinite}
.chip.now .lv{margin-top:8px;padding:6px 0 6px 10px;border-left:3px solid var(--misc)}
.chip.now .ln{font-weight:700;font-size:14px;line-height:1.2}
.chip.now .li{font-size:18px;font-weight:700;margin:2px 0}
body.overlay[data-view=next] .strip-wrap{flex-direction:column}
body.overlay .chip.now{flex-basis:100%;max-width:none;width:100%}
body.overlay.transparent .chip.now,body.overlay.noframe .chip.now{background:linear-gradient(180deg,#123328,#0a0814 70%)}

/* event cards */
.ev{display:flex;flex-direction:column;gap:10px;position:relative;border-left:3px solid var(--misc)}
.ev.cat-rift{border-left-color:var(--rift)}.ev.cat-pvp{border-left-color:var(--pvp)}.ev.cat-boss{border-left-color:var(--boss)}.ev.cat-event{border-left-color:var(--event)}.ev.cat-reset{border-left-color:var(--reset)}.ev.cat-launch{border-left-color:var(--launch)}
.ev .head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.ev .name{font-weight:700;font-size:16px}
.ev .badges{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0}
.obreq{margin-left:6px;font-size:10px;font-weight:800;letter-spacing:.06em;padding:1px 6px;border-radius:5px;background:rgba(251,191,36,.14);color:#fcd34d;border:1px solid rgba(251,191,36,.4);text-transform:uppercase;vertical-align:middle}#obCh.bad{border-color:rgba(248,113,113,.8)}input.oblocked,select.oblocked{opacity:.75;cursor:not-allowed}.oblock-note{margin-top:4px;font-size:12px}.urlbox .btn:disabled{opacity:.5;cursor:not-allowed}
.ev .req{font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;background:rgba(167,139,250,.14);color:var(--accent,#a78bfa);border:1px solid rgba(167,139,250,.35);white-space:nowrap}
.ev .tag{font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;padding:3px 8px;border-radius:6px;background:var(--surface-2);color:var(--text-muted)}
.ev .cd{font-size:30px;font-weight:700;letter-spacing:-.01em;line-height:1}
.ev .when{font-size:13px;color:var(--text-muted)}
.ev .desc{font-size:13px;color:var(--text-subtle)}
.ev .foot{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-top:auto;padding-top:8px;border-top:1px solid var(--border)}
.ev.live{box-shadow:inset 0 0 0 1px rgba(52,211,153,.35)}
.ev .livebadge{font-size:11px;font-weight:800;color:#a7f3d0;background:rgba(52,211,153,.14);border:1px solid rgba(52,211,153,.4);padding:3px 8px;border-radius:9999px}
.ev.off{border-color:rgba(255,255,255,.05);border-left-color:rgba(255,255,255,.14);background:rgba(10,8,20,.55)}
.ev.off .name,.ev.off .cd{color:var(--text-muted)}.ev.off .tag,.ev.off .req{filter:saturate(.35)}
.toggle{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--text-muted);cursor:pointer;user-select:none}
.alert-cfg{display:none;gap:8px;flex-wrap:wrap;align-items:center;font-size:13px}
.ev.cfg-open .alert-cfg{display:flex}
.alert-cfg select{min-height:32px;padding:4px 8px;font-size:13px}
.icon-btn{border:1px solid var(--border);background:var(--surface);color:var(--text-muted);border-radius:10px;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.icon-btn:hover{color:var(--text);border-color:var(--accent-line)}
.icon-btn svg{width:16px;height:16px}

/* filters */
.filters{display:flex;gap:8px;flex-wrap:wrap}
.fbtn{border:1px solid var(--border);background:var(--surface);color:var(--text-muted);border-radius:9999px;padding:6px 12px;font:inherit;font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.fsep{width:1px;align-self:stretch;background:var(--border);margin:0 4px}
.fbtn .sw{width:8px;height:8px;border-radius:50%}
.fbtn.active{color:var(--text);border-color:var(--accent-line);background:var(--accent-soft)}

/* patch notes */
.patch-list{list-style:none;margin:0;padding:0}
.patch-list li{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}
.patch-list li:last-child{border-bottom:0}
.patch-list .d{color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums;font-size:13px}
.patch-list .s{display:block;font-size:12px;color:var(--text-subtle);margin-top:2px}
.patch-list .sum{display:block;font-size:13px;color:var(--text-muted);margin-top:4px}
@media(max-width:560px){.patch-list li{grid-template-columns:1fr;gap:4px}}
/* Aion 2 Global Content: date-time | source (20ch or more) | credit (16 characters at most) | title | Read more...
   The list is one grid and every row borrows its columns (subgrid), so each column lines up down all 10 rows. */
.gf-card{padding:4px 14px}
.gf-list{list-style:none;margin:0;padding:0;height:370px;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;display:grid;
  grid-template-columns:max-content minmax(20ch,max-content) minmax(0,max-content) minmax(0,1fr) max-content;
  grid-auto-rows:max-content;align-content:start;column-gap:14px}
.gf-row{grid-column:1/-1;display:grid;grid-template-columns:subgrid;grid-template-areas:"ts src by title more";align-items:center;
  height:37px;box-sizing:border-box;border-bottom:1px solid var(--border);font-size:13.5px;overflow:hidden}
.gf-row:last-child{border-bottom:0}
.gf-ts{grid-area:ts;color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums;font-size:12.5px;white-space:nowrap}
.gf-src{grid-area:src;display:flex;align-items:center;gap:6px;min-width:0;max-width:30ch;white-space:nowrap;font-size:12.5px;color:var(--text-muted);font-weight:600}
.gf-src>span{overflow:hidden;text-overflow:ellipsis}
.gf-src.off>span{color:#67e8f9}
.gf-off{flex:none;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#67e8f9;border:1px solid rgba(103,232,249,.45);background:rgba(103,232,249,.08);border-radius:9999px;padding:1px 6px}
.gf-by{grid-area:by;min-width:0;max-width:17ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12.5px;color:var(--text-subtle)}
.gf-title{grid-area:title;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
.gf-more{grid-area:more;display:inline-flex;align-items:center;min-height:24px;white-space:nowrap;font-size:12.5px;font-weight:600;color:var(--accent);text-decoration:none}
.gf-more:hover,.gf-more:focus-visible{text-decoration:underline}
.gf-empty{height:auto;display:block;padding:14px 0;color:var(--text-subtle);border-bottom:0}
.gf-row.gf-in{animation:gfIn .7s ease-out}
@keyframes gfIn{from{height:0;opacity:0;background:var(--accent-soft)}to{height:37px;opacity:1;background:transparent}}
/* browsers without subgrid: fixed widths per row keep the same columns */
@supports not (grid-template-columns:subgrid){
  .gf-list{display:block}
  .gf-row{grid-template-columns:15ch 22ch 16ch minmax(0,1fr) max-content;column-gap:14px}
}
@media(max-width:560px){
  /* phones: no shared columns (the timestamp + "Read more" left source/author 44px each). Each row is its own two-line
     flex box: time / source / author, then title + link. Source and author start from 0 and grow 3:2 up to their own
     text, so a short one hands its space to the other; the ::after item forces the line break before the title. */
  .gf-list{height:540px;display:block}
  .gf-row{display:flex;flex-wrap:wrap;align-items:center;align-content:center;column-gap:10px;row-gap:2px;height:54px;padding:4px 0}
  .gf-row::after{content:"";flex-basis:100%;height:0;order:1}
  .gf-ts{flex:none}
  .gf-src{flex:3 1 0;max-width:max-content;overflow:hidden}
  .gf-by{flex:2 1 0;max-width:max-content}
  .gf-title{flex:1 1 0;order:2}
  .gf-more{flex:none;order:2}
  @keyframes gfIn{from{height:0;opacity:0}to{height:54px;opacity:1}}
}
@media (prefers-reduced-motion:reduce){.gf-row.gf-in{animation:none}.status .dot,.chip.now .dot{animation:none!important}html{scroll-behavior:auto}}
.gf-filters{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:flex-end;margin:0 0 10px}
.gf-f{display:flex;flex-direction:column;gap:3px;min-width:0}
.gf-f .lbl{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-subtle);font-weight:700}
.gf-f select{font:inherit;font-size:13px;padding:6px 9px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);max-width:260px;min-width:0}
.gf-f[hidden]{display:none}#gfClear[hidden]{display:none}
/* the hidden attribute always wins, whatever display the element's class sets (.btn, .cls-tiles...) */
[hidden]{display:none!important}
/* anchor jumps, scrollIntoView and focus land below the sticky header (nav.js measures --a2nav-h; the fallback covers the first paint) */
main section[id]{scroll-margin-top:calc(var(--a2nav-h,78px) + 12px)}
.gf-count{margin-left:auto;font-size:12.5px;align-self:center}
.gf-pages{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:center;margin-top:10px}
.gf-pages[hidden]{display:none}
.gf-pages .fbtn{min-width:36px;font-variant-numeric:tabular-nums}
.gf-pages .gf-gap{color:var(--text-subtle);padding:0 2px}
@media(max-width:560px){.gf-f{flex:1 1 140px}.gf-f select{max-width:none;width:100%}.gf-count{margin-left:0;flex-basis:100%}}
/* maintenance */
.banner.maint{border-color:rgba(251,191,36,.45);background:rgba(251,191,36,.08)}#globalBanner:not(.hidden)+#maintBanner{margin-top:14px}#clocks .banner:not(.hidden)~.clocks{margin-top:14px}
.banner.maint svg{color:#fcd34d}
.ev.maint-next .when{color:#fcd34d}
tr.maint td{color:#fcd34d;opacity:.9}
.chip.maint{border-left-color:#fcd34d}
/* classes */
.cls-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px}
.cls-tile{--c1:#ddd6fe;--c2:#7c3aed;position:relative;overflow:hidden;text-align:left;font:inherit;cursor:pointer;padding:12px 14px 12px 64px;min-height:64px;border-radius:14px;border:1px solid var(--border);background:var(--surface);color:var(--text);display:flex;flex-direction:column;justify-content:center;gap:3px;transition:transform .15s,border-color .15s}
.cls-tile:before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,var(--c2) 0%,transparent 60%);opacity:.14;pointer-events:none}
.cls-tile:hover{transform:translateY(-2px)}
.cls-crest{position:absolute;left:12px;top:50%;width:40px;height:40px;margin-top:-20px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,var(--c1),var(--c2));color:#140b26;box-shadow:inset 0 1px 0 rgba(255,255,255,.55),inset 0 -3px 0 rgba(0,0,0,.2),0 6px 16px rgba(0,0,0,.35)}
.cls-crest svg{width:24px;height:24px}.cls-crest img{width:36px;height:36px;display:block;object-fit:contain}.cls-crest img{filter:drop-shadow(0 1px 2px rgba(0,0,0,.55))}
.cls-cardhost{margin:0 0 16px}.cls-cardhost .a2w-card{box-shadow:0 12px 36px rgba(0,0,0,.35)}
.cls-guides{padding:14px 16px;border-radius:14px;border:1px solid var(--border);background:var(--surface)}
.cls-tile:hover{border-color:var(--accent-line);background:var(--accent-soft)}
.cls-tile.main{border-color:var(--accent-line);box-shadow:inset 0 0 0 1px var(--accent-line)}
.cls-tile b{font-size:15px}.cls-tile .r{font-size:12px;color:var(--text-subtle)}
.cls-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.cls{display:flex;flex-direction:column;gap:10px}
.cls .meta{font-size:12px;color:var(--text-subtle)}
.cls h4{margin:6px 0 2px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-subtle)}
.cls ul{margin:0;padding-left:18px;font-size:13px;color:var(--text-muted)}
.cls ul.g{list-style:none;padding:0}
.cls ul.g li{padding:6px 0;border-top:1px solid var(--border)}
.cls ul.g a{font-weight:600}
.cls .by{display:block;font-size:12px;color:var(--text-subtle)}
.kind{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:2px 6px;border-radius:6px;background:var(--surface-2);color:var(--text-muted);margin-right:6px}
.kind.video{background:rgba(248,113,113,.14);color:#fca5a5}
.kind.feat{background:rgba(251,191,36,.16);color:#fcd34d;border:1px solid rgba(251,191,36,.4)}
.cls ul.g li.featured{background:rgba(251,191,36,.06);border-radius:8px;padding-left:8px;padding-right:8px}
.cls .note{font-size:12px;color:#fcd34d}
.cls ul.gl li.pick{border-top-color:rgba(251,191,36,.35)}
.cls .grow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:4px}
.cls .gst{font-size:12px;color:var(--text-subtle);font-variant-numeric:tabular-nums}
.rx{display:inline-flex;gap:4px;margin-left:auto}
.rx-b{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:999px;border:1px solid var(--border);background:var(--surface-2);color:var(--text-muted);font:inherit;font-size:12px;cursor:pointer;line-height:1.4}
.rx-b svg{width:13px;height:13px;fill:currentColor}
.rx-b:hover,.rx-b:focus-visible{border-color:var(--accent);color:var(--text)}
.rx-b[aria-pressed=true].rx-like{color:#93c5fd;border-color:rgba(147,197,253,.5);background:rgba(147,197,253,.1)}
.rx-b[aria-pressed=true].rx-love{color:#fda4af;border-color:rgba(253,164,175,.5);background:rgba(253,164,175,.1)}
.rx-b[aria-pressed=true].rx-fav{color:#fcd34d;border-color:rgba(252,211,77,.5);background:rgba(252,211,77,.1)}
.cls .gnote{margin:8px 0 0;font-size:12px}
/* boss timers */
.beta[data-label]::after{content:attr(data-label)}.beta{font-size:10px;padding:2px 7px;border-radius:6px;background:rgba(251,191,36,.14);color:#fcd34d;border:1px solid rgba(251,191,36,.45);letter-spacing:.1em;font-weight:800}
.fb-ctl{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:0 0 12px}
.fb-in{font:inherit;font-size:13px;padding:6px 10px;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text);width:140px}
.fb-in.short{width:84px}
select.fb-in{appearance:auto;cursor:pointer}
#fieldBossTbl td .btn,#fieldBossTbl td .fbtn{padding:4px 9px;font-size:12px}
tr.fb-soon td{background:rgba(251,191,36,.08)}tr.fb-up td{background:rgba(52,211,153,.10)}
.fb-cd{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.fb-led{display:inline-block;width:11px;height:11px;border-radius:50%;vertical-align:middle;flex:none}.fb-led.g{background:#22c55e;box-shadow:0 0 6px #22c55e}.fb-led.y{background:#facc15;box-shadow:0 0 6px #facc15}.fb-led.r{background:#ef4444;box-shadow:0 0 6px #ef4444}td .fb-led{margin-left:8px}.fb-legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--text-subtle)}.fb-legend span{display:inline-flex;align-items:center;gap:6px}.fb-legend-t{font-weight:600}.fb-alive{color:#4ade80}.fb-dead{color:#f87171}.fb-src{font-size:12px;white-space:nowrap}
.fb-ko{display:block;font-size:11px;color:var(--text-subtle)}
/* table */
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--border);vertical-align:top}
th{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--text-subtle)}
tr.past td{opacity:.45}tr.now td{background:rgba(52,211,153,.08)}
.tbl-wrap{overflow-x:auto;position:relative}

/* checklist */
.chk{display:grid;grid-template-columns:1fr;gap:16px}
/* The OBS builder reuses .chk for its checkbox labels; the checklist grid above stacked the box over its text there (2026-09-26) */
.setting label.chk{display:inline-flex;align-items:center;gap:6px;margin:4px 12px 4px 0;font-size:14px}
#obWtpCls{display:flex;flex-wrap:wrap;gap:4px 12px}
.setting .lbl.g .btn.small{padding:2px 9px;font-size:12px;line-height:1.3}
.chk-views{margin-bottom:10px}.chk-note{margin:0 0 12px;font-size:13px}
.chk-preset{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 8px}.chk-preset .lbl{font-size:12px;color:var(--text-subtle)}
.chk-preset select{font:inherit;font-size:13px;padding:6px 9px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);max-width:100%}
.chk-credit{margin:0 0 8px;font-size:12.5px;line-height:1.5}.chk-credit a{color:var(--accent)}
.chk li .vts{flex:none;align-self:center;font-size:11.5px;color:var(--text-subtle);text-decoration:none;white-space:nowrap;border:1px solid var(--border);border-radius:6px;padding:1px 6px;font-variant-numeric:tabular-nums}
.chk li .vts:hover,.chk li .vts:focus-visible{color:var(--accent);border-color:var(--accent)}
.chk ul{list-style:none;margin:0;padding:0}
.chk li{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--border)}
.chk li:last-child{border-bottom:0}
.chk li label{cursor:pointer;flex:1}
.chk li .cnt{font-size:12px;color:var(--text-subtle)}
.chk li.done label{text-decoration:line-through;color:var(--text-subtle)}
.chk-chars{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}.chk-chars .lbl{font-size:12px;color:var(--text-subtle);margin-right:2px}
.chk-views .fbtn[hidden]{display:none}.chk-chars .fbtn small{font-weight:500;color:var(--text-subtle)}
.chk li .x{margin-left:auto;background:none;border:0;color:var(--text-subtle);cursor:pointer;font:inherit;font-size:12px;padding:2px 6px}.chk li .x:hover{color:var(--danger)}
.chk li .tag{font-size:10px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--border);border-radius:6px;padding:0 5px;margin-left:6px;color:var(--text-subtle)}
.chk-tools{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.chk-form{display:none;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}.chk-form.on{display:flex}
.chk-form input[type=text],.chk-form select{font:inherit;font-size:13px;padding:7px 9px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);min-width:0}.chk-form input[type=text]{flex:1 1 200px}
body.overlay .chk-chars,body.overlay .chk-tools,body.overlay .chk-form{display:none!important}
.progress{height:6px;border-radius:6px;background:var(--surface-2);overflow:hidden;margin:8px 0 12px}
.progress i{display:block;height:100%;background:linear-gradient(90deg,#8b5cf6,#c4b5fd);width:0;transition:width .3s}
/* checklist: one list for daily + weekly, grouped by the visitor's own priority (2026-09-25, viewer request) */
.chk-views{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.chk-views .lbl{font-size:12px;color:var(--text-subtle)}
.chk-views select,.chk li .pri{font:inherit;font-size:12.5px;padding:5px 8px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);max-width:100%}
.chk-opt{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--text-muted);cursor:pointer;user-select:none}.chk-opt input{margin:0}
.chk-stats{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--text-muted);margin:-4px 0 10px}.chk-stats b{color:var(--text);font-variant-numeric:tabular-nums}
.chk-hint{margin:0 0 6px;font-size:12px}
.chk li.chk-grp{display:block;padding:14px 0 4px;border-bottom:0;font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--text-subtle)}
.chk li.chk-grp[data-pr=h]{color:#fca5a5}.chk li.chk-grp:first-child{padding-top:2px}
.chk li .per{margin-left:6px}.chk li .per.d{border-color:rgba(52,211,153,.5);color:#6ee7b7}.chk li .per.w{border-color:rgba(96,165,250,.5);color:#93c5fd}
.chk li.pri-h{box-shadow:inset 3px 0 0 rgba(248,113,113,.65);padding-left:10px}.chk li.pri-l label,.chk li.pri-x label{opacity:.75}
.chk li .pri{flex:none;align-self:center;font-size:11.5px;padding:2px 6px;border-radius:6px;color:var(--text-subtle);cursor:pointer}
.chk li .pri[data-pr=h]{border-color:rgba(248,113,113,.6);color:#fca5a5}.chk li .pri[data-pr=x]{border-style:dashed}
body.overlay .chk li .pri,body.overlay .chk-views .chk-opt,body.overlay .chk-views select,body.overlay .chk-views .lbl,body.overlay .chk-hint{display:none!important}
body.overlay .chk li.pri-h{padding-left:8px}

/* settings panel */
.settings{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.setting{display:flex;flex-direction:column;gap:6px}
.setting[hidden]{display:none}
.banner{padding:12px 16px;border-radius:12px;border:1px solid rgba(251,191,36,.4);background:rgba(251,191,36,.08);color:#fde68a;font-size:14px;display:flex;gap:10px;align-items:flex-start}
.banner.info{border-color:rgba(96,165,250,.4);background:rgba(96,165,250,.08);color:#bfdbfe}
.banner.ok{border-color:rgba(52,211,153,.4);background:rgba(52,211,153,.08);color:#a7f3d0}
.banner svg{flex:none;width:18px;height:18px;margin-top:2px}
.toast{position:fixed;right:16px;bottom:16px;z-index:50;display:flex;flex-direction:column;gap:8px;max-width:360px}
.toast .t{background:#15112a;border:1px solid var(--accent-line);border-radius:14px;padding:12px 14px;box-shadow:0 20px 40px rgba(0,0,0,.5);font-size:14px;display:flex;gap:10px;align-items:flex-start;animation:slide .25s}
.toast .t b{display:block}.toast .t button{margin-left:auto;background:transparent;border:0;color:var(--text-subtle);cursor:pointer;font-size:18px;line-height:1}
.toast .t-link{border-color:rgba(251,191,36,.55)}.toast .t-link a{color:var(--text);text-decoration:underline;text-decoration-color:rgba(251,191,36,.6)}.toast .t-link a:hover{color:#fcd34d}
@keyframes slide{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}
details:not(.a2more){border:1px solid var(--border);border-radius:12px;background:var(--surface);padding:0 14px}
details summary{cursor:pointer;padding:12px 0;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center}
details summary::after{content:"+";color:var(--text-subtle);font-size:18px}
details[open] summary::after{content:"−"}
details .body{padding:0 0 14px;color:var(--text-muted);font-size:14px}
details .body ul{margin:6px 0;padding-left:18px}
footer{margin-top:48px;border-top:1px solid var(--border);padding-top:28px;text-align:center;color:var(--text-muted);font-size:14px}
footer .fb{display:flex;align-items:center;justify-content:center;gap:8px;font-weight:700;color:var(--text);font-size:16px}
footer .fb svg{width:16px;height:16px;color:var(--accent)}
.kbd{font-family:"JetBrains Mono",monospace;font-size:12px;background:var(--surface-2);border:1px solid var(--border);border-radius:6px;padding:1px 6px}
.hidden{display:none!important}
.howto{margin:14px auto 0;max-width:68ch}
/* A soft accent glow so the newest control is findable without shouting. */
#homeSettingsBtn{border-color:rgba(167,139,250,.55);box-shadow:0 0 0 1px rgba(167,139,250,.18),0 0 14px rgba(167,139,250,.35);transition:box-shadow .18s ease,border-color .18s ease}
#homeSettingsBtn:hover,#homeSettingsBtn:focus-visible{border-color:rgba(167,139,250,.9);box-shadow:0 0 0 1px rgba(167,139,250,.3),0 0 20px rgba(167,139,250,.55)}
@media (prefers-reduced-motion:reduce){#homeSettingsBtn{transition:none}}
.btn.small.gear-btn{width:32px;min-width:32px;padding:4px}.gear-btn svg{width:18px;height:18px;flex:0 0 auto;transition:transform .35s ease}.gear-btn:hover svg,.gear-btn:focus-visible svg{transform:rotate(45deg)}
.st-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--border)}.st-row:first-of-type{border-top:0}.st-row .lbl{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-subtle);font-weight:700}.st-row .note{margin-top:2px}.st-row select.btn{min-width:160px}
.tp-body #controls{border:0;background:none;padding:0 0 10px;margin:0;box-shadow:none}
.tp-body #controls .row{display:grid;grid-template-columns:120px minmax(0,1fr);align-items:center;gap:8px 12px;margin:0 0 10px}
.tp-body #controls .row:has(#tzSelect){grid-template-columns:120px minmax(0,1fr) auto}
.tp-body #controls .row>.subtle{grid-column:1/-1;font-size:13px;line-height:1.45;color:var(--text-subtle)}
.tp-body #controls .row>.hidden{display:none}
.tp-body #controls #fbServer{grid-column:2}
.tp-body #controls .lbl,.tp-body #controls .lbl.g{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--text-subtle);margin:0}
.tp-body #controls .fb-in,.tp-body #controls #tzSelect{width:auto;min-width:170px;max-width:100%}
.st-row .note{font-size:13px;color:var(--text-subtle);line-height:1.45;max-width:58ch}
.st-row>div:first-child{flex:1 1 auto;min-width:0}
.st-row .toggle{margin:0;white-space:nowrap}
.st-row.st-sub{border-top:0;padding-top:2px;padding-left:14px}
.st-row.st-sub>div:first-child .lbl{font-size:11px}
.st-leads #stLeads{flex:0 1 auto;max-width:60%}
@media (max-width:640px){.st-leads #stLeads{max-width:none}}
@media (max-width:640px){.st-row{flex-direction:column;align-items:stretch}.st-row .st-btns{justify-content:flex-start}.st-row .st-btns .btn{flex:1 1 auto;text-align:center}.st-row select.btn{width:100%}.st-row .toggle{white-space:normal}.tp-body #controls .row{grid-template-columns:1fr}.tp-body #controls .row:has(#tzSelect){grid-template-columns:1fr auto}.tp-body #controls .row:has(#tzSelect)>.lbl{grid-column:1/-1}.tp-body #controls .row>.lbl{margin-top:4px}.tp-body .panel-toggles{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.tp-body #controls .fb-in,.tp-body #controls #tzSelect{width:100%}}
.st-need{color:#fca5a5;margin:0 0 10px;font-size:13px;line-height:1.45}
.gear-btn.needs-setup{border-color:rgba(248,113,113,.7);color:#fca5a5;animation:gearPulse 1.6s ease-in-out infinite}
@keyframes gearPulse{0%,100%{box-shadow:0 0 0 0 rgba(248,113,113,.65)}50%{box-shadow:0 0 0 7px rgba(248,113,113,0)}}.st-btns{display:inline-flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
@media (max-width:760px){.st-menupos{display:none}}
@media (prefers-reduced-motion:reduce){.gear-btn svg{transition:none}.gear-btn:hover svg{transform:none}.gear-btn.needs-setup{animation:none;box-shadow:0 0 0 3px rgba(248,113,113,.45)}}
.howto p{margin:0 0 8px;font-size:14px;color:var(--text-muted);line-height:1.6}
.howto p b{color:var(--text)}
.panel-toggles{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:4px 14px;margin:4px 0 6px}
.srv-badge{font-size:12px;padding:3px 9px;border-radius:9999px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-muted)}

/* overlay mode */
body.overlay{background:transparent;background-image:none;padding:0}
body.overlay .wrap{padding:8px;max-width:none}
.wrap > main > section[data-off="1"]{display:none!important}
body.overlay .only-full{display:none!important}
body.overlay[data-view=next] #rift,body.overlay[data-view=checklist] #rift,body.overlay[data-view=launch] #rift{display:none!important}
body.overlay[data-view=launch] #launchHero:not([hidden]){display:block!important}
body.overlay #launchHero>.card{display:none!important}
.lh-bar{display:none}
body.overlay[data-view=launch] .lh-bar{display:flex!important;flex-wrap:nowrap;gap:8px;padding:0;overflow:hidden}
body.overlay[data-view=launch] .lh-bar .chip{flex:1 1 0;min-width:0;padding:6px 12px;border-radius:10px;border-left-color:var(--accent);display:flex;flex-direction:column;justify-content:center}
body.overlay[data-view=launch] .lh-bar .chip.live{border-color:rgba(52,211,153,.55);border-left-color:var(--ok)}
body.overlay[data-view=launch] .lh-bar .chip .n{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.overlay[data-view=launch] .lh-bar .chip .in{font-size:18px;margin:0}
body.overlay[data-view=launch] .lh-bar .chip .at{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.overlay[data-view=launch] .lh-bar .livebadge{font-size:9px;padding:1px 5px;margin-left:6px;vertical-align:1px}
body.overlay[data-view=next] #nextup,body.overlay[data-view=checklist] #checklist{display:block!important}
body.overlay .section{margin-top:0}
body.overlay [data-popout],body.overlay #popoutBtn{display:none!important}
body.overlay .section-head{margin-bottom:8px}
body.overlay .chk{grid-template-columns:1fr}
body.overlay .strip{flex-wrap:wrap}
body.overlay .chip{min-width:150px;flex:1}
body.overlay .card{background:rgba(10,8,20,.85)}
body.overlay.transparent{background:transparent}
body.overlay.transparent .card,body.overlay.transparent .chip{background:rgba(10,8,20,.55)}
body.overlay.solid .card,body.overlay.solid .chip{background:#0a0814}
body.overlay.noframe .card,body.overlay.noframe .chip{background:transparent;border-color:transparent;box-shadow:none;backdrop-filter:none}
body.overlay.noframe .chip.now{background:transparent}
body.overlay.compact #rift .subtle,body.overlay.compact #rift .row,body.overlay.compact #riftSched,body.overlay.compact #rift .eyebrow+.subtle,body.overlay.compact .chip .at,body.overlay.compact .chk .cnt,body.overlay.compact .section-head .subtle{display:none!important}
body.overlay.compact .hero-timer{grid-template-columns:1fr}
body.overlay.compact .hero-timer>div:nth-child(2){display:none!important}
body.overlay.nohead .section-head{display:none!important}
body.overlay.shadow .big,body.overlay.shadow .chip .in,body.overlay.shadow .chip .n,body.overlay.shadow .chip .li,body.overlay.shadow .chip .ln,body.overlay.shadow h2,body.overlay.shadow h3,body.overlay.shadow .status{text-shadow:0 2px 6px rgba(0,0,0,.9),0 0 2px rgba(0,0,0,.9)}
body.overlay[data-view=bar] #rift{display:none!important}
body.overlay[data-view=bar] #nextup{display:block!important}
body.overlay[data-view=bar] .section-head{display:none!important}
body.overlay[data-view=bar] .strip{flex-wrap:nowrap;overflow:hidden;gap:8px;padding:0;align-items:stretch}
body.overlay[data-view=bar] .chip{min-width:0;flex:0 0 auto;padding:6px 12px;display:flex;flex-direction:column;justify-content:center;border-radius:10px}
body.overlay[data-view=bar] .chip .n{font-size:12px;white-space:nowrap}
body.overlay[data-view=bar] .chip .in{font-size:18px;margin:0}
body.overlay[data-view=bar] .chip .at{font-size:11px;white-space:nowrap}
body.overlay[data-view=bar] .strip-wrap{gap:8px}
body.overlay[data-view=bar] .chip.now{flex:0 0 auto;max-width:none;width:auto;margin:0;flex-direction:row;gap:14px;align-items:center;padding:6px 12px}
body.overlay[data-view=bar] .chip.now .n{margin:0}
body.overlay[data-view=bar] .chip.now .lv{margin:0;padding:0 0 0 10px;display:flex;gap:8px;align-items:baseline}
body.overlay[data-view=bar] .chip.now .li{font-size:16px;margin:0}
body.overlay[data-view=bar] .chip.now .at{display:none}
body.overlay .brandline{font-size:11px;color:var(--text-subtle);text-align:right;padding:4px 6px 0}
#cdOv{display:none}
body.overlay[data-view=countdown] #rift{display:none!important}
body.overlay[data-view=countdown] #cdOv{display:block!important}
#cdOv .cdo-card{text-align:center;padding:14px 18px}
#cdOv .cdo-label{font-size:20px;font-weight:700;color:var(--accent);letter-spacing:.01em;overflow-wrap:anywhere}
#cdOv .cdo-label:empty,#cdOv .cdo-sub:empty{display:none}
#cdOv .cdo-time{color:var(--cdo-digits,var(--text));font-variant-numeric:tabular-nums;white-space:nowrap;margin:6px 0 2px}
#cdOv .cdo-time.cdo-endtxt{white-space:normal;font-size:clamp(30px,6vw,60px);overflow-wrap:anywhere}
#cdOv .cdo-sub{font-size:13px;color:var(--text-muted);margin-top:4px}
body.overlay.compact #cdOv .cdo-sub,body.overlay.nohead #cdOv .cdo-label{display:none!important}
body.cdo-gone #cdOv .cdo-card,body.cdo-gone .brandline{visibility:hidden}
body.overlay.shadow #cdOv .cdo-label,body.overlay.shadow #cdOv .cdo-sub{text-shadow:0 2px 6px rgba(0,0,0,.9),0 0 2px rgba(0,0,0,.9)}
body.focus .wrap > main > section:not([data-keep]),body.focus .wrap > main > #controls:not([data-keep]){display:none!important}
.seo{max-width:860px;margin:0 auto}.seo p{color:var(--text-muted);font-size:16px}.seo h2{margin-top:18px}.seo ul{color:var(--text-muted)}
.faq details{margin-bottom:8px}
.fullsched td:first-child{font-weight:600}
.topics{margin:22px 0 26px}
.builder>*,.opts,.opts .setting{min-width:0}.opts select,.opts input{max-width:100%;min-width:0}
:lang(en) :is(.btn,.fbtn,.cmpbtn,.rbtn,.linkbtn,.pin,.tabs button,.dv-tabs button,.tc-nav button,.about-btn,.as-chip,#ctKind button){text-transform:capitalize}
/* Domains must survive Title Case: capitalize treats "." as a word break,
   so homelessguynabox.org would render as Homelessguynabox.Org. */
.no-caps,:lang(en) .no-caps{text-transform:none!important}
:lang(en) :is(.btn,.fbtn) :is(input,select,textarea,.mono,.cnt,small.raw){text-transform:none}
.btn-discord{background:#5865f2;border-color:#5865f2;color:#fff}.btn-discord:hover{background:#4752c4;border-color:#4752c4;color:#fff}
.discord-card{display:flex;align-items:center;gap:14px;flex-wrap:wrap;border:1px solid rgba(88,101,242,.55);background:linear-gradient(135deg,rgba(88,101,242,.22),rgba(88,101,242,.06));border-radius:16px;padding:14px 16px;margin:6px 0 4px;color:var(--text)}.discord-card:hover{border-color:#8891f2;color:var(--text)}.discord-card svg{width:34px;height:34px;flex:0 0 auto;color:#aab1ff}.discord-card>div{min-width:0;flex:1 1 220px}.discord-card b{display:block;font-size:16px}.discord-card span{font-size:13.5px;color:var(--text-muted)}.discord-card .go{margin-left:auto;font-weight:700;color:#c7ccff;font-size:14px}
.dc-step{display:flex;gap:12px;margin:0 0 16px}.dc-n{flex:0 0 28px;height:28px;border-radius:50%;background:#5865f2;color:#fff;font-weight:800;display:grid;place-items:center;font-size:14px}.dc-b{flex:1 1 auto;min-width:0}.dc-ol{margin:6px 0 8px;padding-left:18px;font-size:14px;color:var(--text-muted)}.dc-in{display:flex;gap:8px}.dc-in input{flex:1 1 auto;min-width:0}#discord .note{font-size:12.5px;line-height:1.4;color:var(--text-subtle)}#dcEvHint{margin-top:6px}.dc-check.ok{color:var(--ok)}.dc-check.err{color:var(--danger)}.dc-check.warn{color:var(--warn)}
.dc-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}.dc-bar select{min-height:32px;padding:4px 8px;font-size:13px}.dc-quick{display:inline-flex;gap:6px;flex-wrap:wrap;margin-left:auto}.dc-evs{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:6px}.dc-ev{display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid var(--border);border-left:3px solid var(--misc);border-radius:10px;background:var(--surface);font-size:13px;min-width:0}.dc-ev label{display:flex;align-items:center;gap:6px;flex:1 1 auto;min-width:0;cursor:pointer}.dc-ev label span{overflow:hidden;text-overflow:ellipsis}.dc-ev small{color:var(--text-subtle);white-space:nowrap}.dc-ev select{min-height:28px;padding:2px 6px;font-size:12px}.dc-ev.off{opacity:.6}.dc-ev.c-rift{border-left-color:var(--rift)}.dc-ev.c-pvp{border-left-color:var(--pvp)}.dc-ev.c-boss{border-left-color:var(--boss)}.dc-ev.c-event{border-left-color:var(--event)}.dc-ev.c-reset{border-left-color:var(--reset)}@media(max-width:560px){.dc-step{gap:8px}.dc-n{flex-basis:22px;height:22px;font-size:12px}.dc-ev small{display:none}.dc-quick{margin-left:0}}
.dc-prevhead{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}.dc-prevhead select{min-height:30px;padding:3px 8px;font-size:13px}.dc-msg{background:#313338;color:#dbdee1;border-radius:10px;padding:12px 14px;font-size:14px;line-height:1.4;display:flex;gap:12px;margin-bottom:14px}.dc-msg img{width:40px;height:40px;border-radius:50%;flex:0 0 40px}.dc-msg .who{font-weight:600;color:#f2f3f5}.dc-msg .app{background:#5865f2;color:#fff;font-size:10px;font-weight:700;border-radius:3px;padding:0 4px;margin-left:4px;vertical-align:1px}.dc-msg .when{color:#949ba4;font-size:12px;margin-left:6px}.dc-msg .ts{background:rgba(255,255,255,.08);border-radius:3px;padding:0 2px}.dc-msg .men{background:rgba(88,101,242,.3);color:#c9cdfb;border-radius:3px;padding:0 2px}.dc-emb{margin-top:6px;background:#2b2d31;border-left:4px solid #a78bfa;border-radius:4px;padding:8px 12px 10px;max-width:440px;overflow-wrap:anywhere}.dc-emb .t{font-weight:700;color:#f2f3f5;margin-bottom:4px}.dc-emb .d{font-size:13.5px;white-space:pre-line}.dc-emb .f{font-size:11.5px;color:#949ba4;margin-top:8px}.dc-msg>div{min-width:0;flex:1 1 auto}
.dc-bot{display:flex;flex-wrap:wrap;gap:8px;align-items:center;border:1px solid rgba(88,101,242,.55);background:rgba(88,101,242,.1);border-radius:12px;padding:10px 12px;margin-bottom:12px;font-size:13.5px}.dc-bot>div{flex:1 1 240px;min-width:0}.dc-bot details{flex-basis:100%}.dc-bot code,.dc-msg code{font-size:12.5px}
.tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}.tools-grid>*{min-width:0}
.tool-card{display:block;border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:12px 14px;color:var(--text);transition:border-color .2s,background .2s}
.tool-card:hover{border-color:var(--accent-line);background:var(--surface-2);color:var(--text)}.tool-card b{display:block;font-size:15px;margin-bottom:2px}.tool-card span{font-size:13px;color:var(--text-muted)}
.tools-group h3{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-subtle);margin:14px 0 8px}
.dcard{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;text-align:left;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);font:inherit;font-weight:600;font-size:15px;padding:12px 14px;cursor:pointer;transition:all .2s}
.dcard:hover{border-color:var(--accent-line);background:var(--surface-2)}
.dcard-c{color:var(--text-subtle);font-size:18px;line-height:1}
.tp-body p{white-space:pre-line}
.topic-dialog{border:1px solid var(--accent-line);border-radius:18px;background:#120e22;color:var(--text);padding:0;width:min(760px,calc(100vw - 32px));max-height:min(80vh,820px);box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 1px var(--accent-line)}
.topic-dialog::backdrop{background:rgba(5,4,12,.72);backdrop-filter:blur(3px)}.rift-stat-row{gap:10px;align-items:center}.rift-stat-row .status{margin:0}.rift-info ul{margin:0;padding-left:20px;line-height:1.55}.rift-info li{margin:0 0 8px}@keyframes stflash{0%,100%{box-shadow:none}50%{box-shadow:0 0 0 2px var(--accent-line),0 0 18px var(--accent-soft)}}.st-flash{border-radius:10px;animation:stflash 1.2s ease-in-out 3}@media (prefers-reduced-motion:reduce){.st-flash{animation:none;outline:2px solid var(--accent-line)}}
.tp-head{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--border);position:sticky;top:0;background:#120e22;z-index:1}
.tp-body{padding:6px 22px 10px;overflow:auto;max-height:calc(min(80vh,820px) - 130px)}
.cl-day{border-bottom:1px solid var(--border)}.cl-day summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;font-weight:700;list-style:none}.cl-day summary::-webkit-details-marker{display:none}.cl-day summary::after{display:none;content:none}.cl-day summary::before{content:'';display:inline-block;width:7px;height:7px;border-right:2px solid var(--accent);border-bottom:2px solid var(--accent);transform:rotate(-45deg);margin-right:10px;flex:0 0 auto;transition:transform .15s}.cl-day[open] summary::before{transform:rotate(45deg)}.cl-dl{flex:1 1 auto}.cl-n{color:var(--text-muted);font-weight:400;font-size:13px;white-space:nowrap}.cl-none{margin:0 0 8px}.cl-day .cl-list{margin:0 0 8px 17px}.cl-day .cl-row:last-child{border-bottom:0}.cl-list{list-style:none;padding:0;margin:8px 0 12px}.cl-row{display:flex;gap:14px;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}.cl-ts{flex:0 0 auto;min-width:150px;color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums;font-size:13px}.cl-txt{color:var(--text-muted);white-space:normal}
@media(max-width:560px){.cl-row{flex-direction:column;gap:4px}}
.tp-body .tp-title{font-size:24px;margin:12px 0 6px}
.tp-body h2:not(.tp-title){font-size:17px}
.tp-body p,.tp-body li{font-size:15px}
.tp-foot{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border)}
body.obs{cursor:none}body.obs ::-webkit-scrollbar{display:none}
/* builder */
.builder{display:grid;grid-template-columns:1fr 1.1fr;gap:18px}
@media(max-width:900px){.builder{grid-template-columns:1fr}}
.builder .opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.preview{border:1px dashed var(--accent-line);border-radius:14px;overflow:hidden;background:repeating-conic-gradient(rgba(255,255,255,.06) 0 25%,transparent 0 50%) 0 0/20px 20px;position:relative;min-height:220px}
.preview iframe{position:absolute;top:0;left:0;border:0;display:block;max-width:none}
.preview .sz{position:absolute;right:8px;bottom:6px;font-size:11px;color:var(--text-subtle);background:rgba(10,8,20,.7);padding:2px 6px;border-radius:6px}
.urlbox{display:flex;gap:8px;align-items:stretch;margin-top:12px;flex-wrap:wrap}.urlbox input{min-width:0;flex:1 1 180px}
.urlbox input{flex:1;font-family:"JetBrains Mono",monospace;font-size:12px}
.evpick{display:flex;flex-wrap:wrap;gap:6px}
.evpick label{font-size:12px;border:1px solid var(--border);background:var(--surface);border-radius:9999px;padding:4px 10px;display:inline-flex;gap:6px;align-items:center;cursor:pointer}
.evpick input{width:14px;height:14px}
.steps{margin:6px 0;padding-left:18px}.steps li{margin:4px 0}
/* favorites, hidden, details, custom timers, multi-lead alerts */
.ev[data-details]{cursor:pointer}
.ev .foot .row{flex-wrap:wrap;justify-content:flex-end}
.icon-btn.fav{color:var(--warn);border-color:rgba(251,191,36,.5);background:rgba(251,191,36,.1)}.icon-btn.fav svg{fill:currentColor}
.ev .tag.ctag,.chip .ctag{background:rgba(96,165,250,.14);color:#bfdbfe}
.chip .ctag{font-size:9px;letter-spacing:.1em;text-transform:uppercase;font-weight:800;padding:1px 5px;border-radius:5px;margin-left:6px;vertical-align:1px}
.chip .pin{width:12px;height:12px;color:var(--warn);fill:currentColor;vertical-align:-1px;margin-right:4px}
.ev.cat-custom{border-left-color:var(--info)}
.ev-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 12px}
.hid-list{margin:0 0 14px;padding:12px 14px}.hid-list ul{list-style:none;margin:0;padding:0}.hid-list li{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:14px;flex-wrap:wrap}.hid-list li:last-child{border-bottom:0}
.alert-cfg .leads{flex-basis:100%}
.leads{display:flex;flex-direction:column;gap:6px;min-width:0}
.lchips{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.lchip{display:inline-flex;align-items:center;gap:4px;padding:2px 4px 2px 10px;border-radius:9999px;border:1px solid var(--accent-line);background:var(--accent-soft);font-size:13px;font-weight:600;white-space:nowrap}
.lchip button{border:0;background:transparent;color:var(--text-subtle);cursor:pointer;font-size:16px;line-height:1;width:24px;height:24px;border-radius:50%}.lchip button:hover{color:var(--danger)}
.ladd{display:inline-flex;gap:6px;align-items:center}.ladd input{width:76px;min-height:32px;padding:4px 8px}
input[type=time],input[type=datetime-local]{background:var(--surface);border:1px solid var(--border);color:var(--text);font:inherit;font-size:14px;border-radius:10px;padding:6px 10px;min-height:38px;max-width:100%;min-width:0}
.evd-meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 8px}
.evd-meta .tag{font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;padding:3px 8px;border-radius:6px;background:var(--surface-2);color:var(--text-muted)}.evd-meta .req{font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;background:rgba(167,139,250,.14);color:var(--accent);border:1px solid rgba(167,139,250,.35);white-space:nowrap}
.evd-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin:10px 0}
.evd-facts>div{padding:8px 12px;border-radius:12px;border:1px solid var(--border);background:var(--surface);min-width:0}
.evd-facts .k{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-subtle);font-weight:700}
.tp-body h3.evd-h{font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-subtle);margin:18px 0 6px}
.evd-tbl td,.evd-tbl th{padding:7px 6px;font-size:14px}
.evd-tbl tr.skip td{color:#fcd34d;text-decoration:line-through;text-decoration-color:rgba(252,211,77,.5)}.evd-tbl tr.skip td:last-child{text-decoration:none}
.sched-list .t.skip{border-color:rgba(251,191,36,.45);color:#fcd34d}.sched-list .t.skip small{color:#fcd34d}
.evd-alerts{display:grid;grid-template-columns:1fr;gap:12px}
.evd-alerts .row select{min-height:34px;padding:4px 8px;font-size:13px}
.ct-form{display:grid;gap:14px;padding:6px 0 4px}.ct-form>*{min-width:0}
.ct-form .row input[type=number]{width:90px}
.ct-part{display:grid;gap:10px}
.ev-dialog .tp-body{padding-bottom:18px}
.ev-dialog .lbl,#settings div.lbl{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-subtle);font-weight:700}

.obgrp{margin:6px 0}
.obgrp>b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-subtle);margin-bottom:3px}
.obgrp-in{display:flex;flex-wrap:wrap;gap:4px 12px}
</style>
