  <div class="filters chk-views" id="chkViews">
    <span class="lbl">Show</span>
    <button class="fbtn active" data-chk="all" type="button">Daily + Weekly</button>
    <button class="fbtn" data-chk="d" type="button">Daily</button>
    <button class="fbtn" data-chk="w" type="button">Weekly</button>
    <select id="chkPrioF" aria-label="Priority filter"><option value="all">All priorities</option><option value="h">High only</option><option value="hn">High and normal</option></select>
    <label class="chk-opt"><input type="checkbox" id="chkDoneBottom" checked> Done to bottom</label>
    <label class="chk-opt"><input type="checkbox" id="chkShowHidden"> Show hidden</label>
  </div>
  <div class="chk-preset"><label class="lbl" for="chkPreset">List by</label><select id="chkPreset" aria-label="Checklist by"><option value="">Aion 2 Timers</option></select></div>
  <p class="subtle chk-credit" id="chkCredit" hidden></p>
  <p class="subtle chk-note" id="chkNote"></p>
  <div class="chk">
    <div class="card">
      <h3><span id="chkTitle">Main: Daily and weekly</span> <span class="subtle" id="chkPct"></span></h3>
      <div class="progress"><i id="chkBar"></i></div>
      <div class="chk-stats" id="chkStats"></div>
      <p class="subtle chk-hint">Set each task's priority with the menu on its row. High tasks sit at the top, Hidden tasks leave the list until you tick Show hidden.</p>
      <ul id="chkList"></ul>
      <div class="chk-tools">
        <button class="btn small" id="chkAddTask" type="button">Add custom task</button>
        <button class="btn small" id="chkAddChar" type="button">Add character</button>
        <button class="btn small" id="chkResetPrio" type="button">Reset priorities</button>
        <button class="btn small" id="chkExport" type="button">Back up</button>
        <button class="btn small" id="chkImport" type="button">Restore</button>
        <input type="file" id="chkImportFile" accept="application/json,.json" hidden>
      </div>
      <form class="chk-form" id="chkTaskForm"><input type="text" id="chkTaskText" maxlength="80" placeholder="Task, e.g. Buy Odyle potions" aria-label="Task name"><select id="chkTaskPeriod" aria-label="Resets"><option value="d">Daily</option><option value="w">Weekly</option></select><select id="chkTaskFor" aria-label="Show on"><option value="all">Every character</option><option value="main">Mains</option><option value="alt">Alts</option><option value="this">This character only</option></select><select id="chkTaskPrio" aria-label="Priority"><option value="n">Normal priority</option><option value="h">High priority</option><option value="l">Low priority</option></select><button class="btn small primary" type="submit">Add</button><button class="btn small" type="button" data-close>Cancel</button></form>
      <form class="chk-form" id="chkCharForm"><input type="text" id="chkCharName" maxlength="24" placeholder="Character name" aria-label="Character name"><select id="chkCharKind" aria-label="Role"><option value="alt">Alt</option><option value="main">Main</option></select><button class="btn small primary" type="submit">Add</button><button class="btn small" type="button" data-close>Cancel</button></form>
      <p class="subtle" style="font-size:12px;margin:10px 0 0">Everything is saved in this browser only. Back up to move your checklist to another device.</p>
    </div>
  </div>
</section>

