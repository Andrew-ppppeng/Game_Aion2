  const v10=Math.floor(Date.now()/600000), get=(u)=>fetch(u,{cache:'no-cache'}).then(r=>r.json());
  const langP=loadLang(detectLang());
  const [rb,rs,rc,rm,rp,rj]=await Promise.allSettled([get('/bosses.json?v='+v10),get('/servers.json?v='+v10),get('/classes.json?v='+v10),get('/maintenance.json?v='+Math.floor(Date.now()/300000)),get('/patches.json?v='+v10),get('/schedule.json?v='+v10)]);
  if(rb.status==='fulfilled') BOSSES=rb.value; if(rs.status==='fulfilled') SERVERS=rs.value; if(rc.status==='fulfilled') CLASSES=rc.value; if(rm.status==='fulfilled') MAINT=rm.value; if(rp.status==='fulfilled') PATCHES=rp.value;
  try{ const rg=(await Promise.allSettled([get('/gamedata/guide_stats.json?v='+Math.floor(Date.now()/3600000))]))[0]; if(rg.status==='fulfilled'&&rg.value&&rg.value.videos) GSTATS=rg.value; }catch(e){}
  setInterval(async()=>{ try{ const rm=await fetch('/maintenance.json?v='+Math.floor(Date.now()/300000),{cache:'no-cache'}); MAINT=await rm.json(); stripSig=''; lastSchedBuild=0; }catch(e){} },600000);
  // The dictionary (300 KB on /de/) is NOT awaited here: the first tick renders with English fallbacks as soon as the data JSONs
