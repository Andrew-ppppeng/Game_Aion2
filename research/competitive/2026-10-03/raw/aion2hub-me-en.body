    <!--
      The tab icon, drawn by the API from the GAME's own name and accent
      (see `apps/api/src/app/og`). It was Nx's logo — the placeholder the
      Angular generator writes into `public/favicon.ico` — served on every
      page of a live site for as long as the site has been live.

      Not a file in `public/`, which is the reason it stayed wrong so long:
      a picture dropped in there is the FIRST game's picture, and the
      second site on this platform would wear it.
    -->
    <link rel="icon" type="image/svg+xml" href="/api/og/icon.svg">
    <link rel="apple-touch-icon" href="/api/og/icon.png">
    <!--
      The colour scheme, decided BEFORE the first paint.

      The server renders in the design's dark default, and `ThemeService`
      re-applies a stored choice on hydration — which is a whole page load
      later. A reader whose browser is set to light saw a dark page flash
      first, and a reader who had chosen light saw it every single time.
      There is no way to avoid that from inside the framework: this has to
      run before the browser paints, so it is a blocking inline script,
      and it is deliberately the only one on the page.

      The reader's own stored choice wins; failing that, what their system
      asks for; failing that, the design's dark. Wrapped in try/catch
      because reading `localStorage` throws outright in a browser set to
      block site data, and a colour scheme must never be the reason a page
      fails to start.
    -->
    <script>
      (function () {
        try {
          var stored = localStorage.getItem('gh_color_scheme');
          if (stored !== 'light' && stored !== 'dark') {
            stored = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', stored);
        } catch (error) {
          /* No storage, or no matchMedia: the served dark default stands. */
        }
      })();
    </script>
  <style>:root{--bg: #0a0a0c;--bg-deep: #0d0d0f;--surface: #121216;--surface-2: #1b1b20;--surface-3: #0d0d0f;--surface-card: rgba(0, 0, 0, .6);--line: #232228;--divider: var(--line);--neutral-100: #efece6;--neutral-200: #d6d2ca;--neutral-300: #aca79c;--neutral-400: #8a857a;--neutral-500: #57545f;--neutral-600: #423f48;--neutral-700: #33313a;--neutral-800: #232228;--neutral-900: #121216;--text-primary: #efece6;--text-secondary: #aca79c;--text-tertiary: #8a857a;--text-muted: #57545f;--text: var(--text-primary);--accent: #fbbf24;--accent-dark: #cc9a17;--accent-soft: rgba(251, 191, 36, .12);--accent-ink: #0f0c02;--accent-strong: #e0a91c;--ok: #10b981;--warn: #f59e0b;--bad: #f2605b;--info: #3b82f6;--purple: #8b5cf6;--cyan: #06b6d4;--ease: cubic-bezier(.2, .8, .2, 1);--dur-fast: .12s;--dur-base: .2s;--dur-slow: .32s;--radius-sm: 4px;--radius-md: 8px;--radius-lg: 12px;--radius-xl: 20px;--page-gutter: 20px;--page-top: 28px;--page-width: 1160px;--page-width-read: 780px;--page-width-wide: 1240px;--header-height: 69px;--space-1: 4px;--space-2: 8px;--space-3: 12px;--space-4: 16px;--space-5: 24px;--space-6: 32px;--space-7: 48px;--shadow-sm: 0 2px 10px rgba(0, 0, 0, .3);--shadow-md: 0 4px 20px rgba(0, 0, 0, .4);--shadow-lg: 0 12px 60px rgba(0, 0, 0, .5);--glow-accent: 0 0 20px rgba(251, 191, 36, .6);--glow-purple: 0 0 20px rgba(139, 92, 246, .6);--glow-bad: 0 0 20px rgba(242, 96, 91, .6);--font-body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;--font-display: "Exo 2", "Inter", system-ui, sans-serif;--font-logo: var(--font-display);--font-mono: "JetBrains Mono", "IBM Plex Mono", "Cascadia Code", monospace;--fs-xs: 11px;--fs-sm: 12px;--fs-badge: 12px;--fs-meta: 13px;--fs-body: 14px;--fs-table: 13px;--fs-lead: 16px;--fs-h3: 20px;--fs-h2: 24px;--fs-h1: 32px;--fs-display: 36px;--bp-sm: 360px;--bp-md: 768px;--bp-lg: 1280px;--grade-common: #8b9099;--grade-special: #6fbf8f;--grade-rare: #6f9fd8;--grade-epic: #a98cd4;--grade-unique: #d9b877;--grade-heroic: #d9705f;--