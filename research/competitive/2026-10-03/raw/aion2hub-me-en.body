,"event":30,"metal":546,"named":24,"citizen":1398,"jewelry":580,"monster":9361,"storage":4,"crafting":10,"instance":26,"merchant":46,"monolith":560,"teleport":1,"shellfish":208,"vegetable":196,"stronghold":15,"battlefield":22,"hidden_cube":132,"holiday_cube":16,"empyrean_trace":536,"sealed_dungeon":61},"defaultCategories":["battlefield","berry","citizen","crafting","empyrean_trace","event","herb","hidden_cube","holiday_cube","instance","jewelry","merchant","metal","monolith","monster","od","sealed_dungeon","shellfish","storage","stronghold","teleport","tree","vegetable"]},"regionAvailability":{"kr":null,"tw":null,"global":null},"gameVersion":"1.1","validFrom":"2026-09-14T13:31:00.664Z","validTo":null}],"page":{"total":8,"limit":50,"offset":0,"hasMore":false}},"h":{},"s":200,"st":"OK","u":"https:\u002F\u002Faion2hub.me\u002Fapi\u002Fentities\u002Fmap","rt":"json"},"3d9291e0ecb068180d2cf86418b77a43e7e5698818a048d728e7efd9c7ad5c9e":{"b":{"items":[{"id":"ea352a84-daa9-431c-84a3-61886f079ccf","type":"item","slug":"563700026","name":"+10 Conquest Accessory Selection Chest [★★] (Bound)","description":null,"icon":"\u002Fmedia\u002Ficons\u002F8a\u002F8aef43211ddae8135d85d8b766a3e50291a530684780e196e84c7bf0e332d4d1.webp","stats":{"slot":"other","grade":"unique","sources":[],"category":null,"gradeRaw":"Unique","internal":false,"mapZones":[],"tradable":false,"craftedBy":null,"itemLevel":null,"costumeSet":null,"equipLevel":null,"combatStats":[],"dropSources":null,"enchantable":false,"materialFor":null,"soulImprint":[],"subStatCount":0,"enchantBonuses":{},"maxEnchantLevel":0,"godStoneSlotCount":0,"magicStoneSlotCount":0,"maxExceedEnchantLevel":0,"soulImprintSelectable":null},"regionAvailability":{"kr":"1.1","tw":"1.1","global":null},"gameVersion":"1.1","validFrom":"2026-09-06T01:20:15.283Z","validTo":null}],"page":{"total":13018,"limit":1,"offset":0,"hasMore":true}},"h":{},"s":200,"st":"OK","u":"https:\u002F\u002Faion2hub.me\u002Fapi\u002Fentities\u002Fitem","rt":"json"},"analyticsId":"G-D73TPD3M1D","bf99c7cc77c8d094f58ea1a8a0c15407663da74e1b7ca29327d9056aa2c5f482":{"b":{"items":[{"id":"25f738b1-fee0-4959-89cb-5f0400e77ab9","slug":"new-servers-opening-r02aop","locale":"en","title":"New Servers Opening!","body":"## What changed\n\nHello Daevas,We are opening 2 new servers for EU.Elyos​Asmodian​​XXXXMore information on the Launch Scale Test below:Steam:&nbsp;https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F716789922107753638\n","summary":"Hello Daevas,We are opening 2 new servers for EU.Elyos​Asmodian​​XXXXMore information on the Launch Scale Test below:Steam:&nbsp;https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F716789922107753638","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T14:30:00.001Z","publishedAt":"2026-09-30T15:05:00.056Z","createdAt":"2026-09-30T15:02:57.904Z","updatedAt":"2026-09-30T15:02:57.904Z","category":"announcement","image":null},{"id":"f64a9db5-6224-4ef1-aba1-c5155e50c633","slug":"new-servers-opening-europe-g5nr7s","locale":"en","title":"New Servers Opening (Europe)","body":"## What changed\n\nHello Daevas,We’ve added the following servers:&nbsp;RegionElyos​AsmodianTimeEUXX:XX AM PDT \u002F XX:XX CESTWe encourage players to join new servers as they become available. Server transfers will be avai\n","summary":"Hello Daevas,We’ve added the following servers:&nbsp;RegionElyos​AsmodianTimeEUXX:XX AM PDT \u002F XX:XX CESTWe encourage players to join new servers as they become available. Server transfers will be avai","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T09:10:00.001Z","publishedAt":"2026-10-02T10:05:00.067Z","createdAt":"2026-10-02T09:33:07.576Z","updatedAt":"2026-10-02T09:33:07.576Z","category":"announcement","image":null},{"id":"9128af56-dfa2-485d-963e-304b95716d36","slug":"twitch-drops-account-linking-guide-1g3wee","locale":"en","title":"Twitch Drops Account Linking Guide","body":"## What changed\n\nTwitch Drops Account Linking GuideThe account you link to Twitch must be the account you're currently playing AION2 on.\n- If you're playing on Steam → Link your Steam accountLinking a different account may result in not receiving your Twitch Drops.Even if rewards are not granted, do not separately link your account on the NC website. Doing so may unlink your existing connection, and you may become unable to access your existing character.If you become unable to access your character, please check the FAQ (\"https:\u002F\u002Fhelp.plaync.com\u002Ffaq\u002Faion2global?faqNo=7240\") for how to resolve this.For more details on Twitch Drops, please refer to the FAQ (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Ftwitchdrops\u002Findex\").\n","summary":"Twitch Drops Account Linking GuideThe account you link to Twitch must be the account you're currently playing AION2 on.\n- If you're playing on Steam → Link your Steam accountLinking a different account may result in not receiving your Twitch Drops.Even if rewards are not granted, do not separately link your account on the NC website. Doing so may unlink your existing connection, and you may become unable to access your existing character.If you become unable to access your character, please check the FAQ (\"https:\u002F\u002Fhelp.plaync.com\u002Ffaq\u002Faion2global?faqNo=7240\") for how to resolve this.For more details on Twitch Drops, please refer to the FAQ (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Ftwitchdrops\u002Findex\").","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T06:57:29.000Z","publishedAt":"2026-10-02T07:05:00.107Z","createdAt":"2026-10-02T07:03:10.567Z","updatedAt":"2026-10-02T07:03:10.567Z","category":"announcement","image":null},{"id":"edbd4e15-f777-479d-9ddb-c62c412cb7ff","slug":"twitch-drops-account-linking-guide-dno6h2","locale":"en","title":"Twitch Drops Account Linking Guide","body":"## What changed\n\nTwitch Drops Account Linking GuideThe account you link to Twitch must be the account you're currently playing AION2 on.If you're playing on Steam → Link your Steam accountIf you're playing on NC (Purp\n","summary":"Twitch Drops Account Linking GuideThe account you link to Twitch must be the account you're currently playing AION2 on.If you're playing on Steam → Link your Steam accountIf you're playing on NC (Purp","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T05:27:52.915Z","publishedAt":"2026-10-02T06:05:00.099Z","createdAt":"2026-10-02T05:32:56.942Z","updatedAt":"2026-10-02T05:32:56.942Z","category":"announcement","image":null},{"id":"00cf61f8-255e-4194-ae8e-84f2ca3ec5b1","slug":"twitch-drops-account-linking-guide-q5mmnl","locale":"en","title":"Twitch Drops Account Linking Guide","body":"## What changed\n\nThe account you link to Twitch must be the account you're currently playing AION2 on.\n- If you're playing on Steam → Link your Steam account\n- If you're playing on NC (Purple) → Link your NC (Purple) accountLinking a different account may result in not receiving your Twitch Drops.Even if rewards are not granted, do not separately link your account on the NC website. Doing so may unlink your existing connection, and you may become unable to access your existing character.If you become unable to access your character, please check the FAQ (\"https:\u002F\u002Fhelp.plaync.com\u002Ffaq\u002Faion2global?faqNo=7240\") for how to resolve this.For more details on Twitch Drops, please refer to the FAQ (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Ftwitchdrops\u002Findex\").\n","summary":"The account you link to Twitch must be the account you're currently playing AION2 on.\n- If you're playing on Steam → Link your Steam account\n- If you're playing on NC (Purple) → Link your NC (Purple) accountLinking a different account may result in not receiving your Twitch Drops.Even if rewards are not granted, do not separately link your account on the NC website. Doing so may unlink your existing connection, and you may become unable to access your existing character.If you become unable to access your character, please check the FAQ (\"https:\u002F\u002Fhelp.plaync.com\u002Ffaq\u002Faion2global?faqNo=7240\") for how to resolve this.For more details on Twitch Drops, please refer to the FAQ (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Ftwitchdrops\u002Findex\").","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T05:26:07.000Z","publishedAt":"2026-10-02T07:05:00.095Z","createdAt":"2026-10-02T06:17:53.342Z","updatedAt":"2026-10-02T06:17:53.342Z","category":"announcement","image":null},{"id":"9f411685-1e73-4715-8c73-0045ef7b25c8","slug":"jump-into-advanced-access-now-uvs58k","locale":"en","title":"Jump Into Advanced Access Now!","body":"## What changed\n\nHello Daevas,The skies have opened and are welcoming all Founder’s Pack owners to Atreia. We are so excited to share this moment with you! Check out these notices and enjoy the flight!\n- Advanced Access Server Matchmaking (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F689769594581155928\")\n- War for Atreia (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839735193\")\n- Launch FAQ (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839734961\")\n- Community Launch Events Overview (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839734416\")\n- Introducing the Creator Program (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Fboard\u002Fnotice\u002Fview?articleId=50000203\")If you don’t have a Founder’s Pack yet, your last chance is October 5th 8:00 AM PDT \u002F October 5th at 17:00 CEST.Get your pack on Steam (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110?emclan=103582791475596239&emgid=677375815308020017\") or Purple (\"https:\u002F\u002Fpurple.plaync.com\u002Fdownload\").\n\n## What to do\n\nCheck the event window and the reward list before it ends, and plan around the classes and items named above.","summary":"Hello Daevas,The skies have opened and are welcoming all Founder’s Pack owners to Atreia. We are so excited to share this moment with you! Check out these notices and enjoy the flight!\n- Advanced Access Server Matchmaking (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F689769594581155928\")\n- War for Atreia (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839735193\")\n- Launch FAQ (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839734961\")\n- Community Launch Events Overview (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110\u002Fview\u002F680761758839734416\")\n- Introducing the Creator Program (\"https:\u002F\u002Faion2.plaync.com\u002Fen-us\u002Fboard\u002Fnotice\u002Fview?articleId=50000203\")If you don’t have a Founder’s Pack yet, your last chance is October 5th 8:00 AM PDT \u002F October 5th at 17:00 CEST.Get your pack on Steam (\"https:\u002F\u002Fstore.steampowered.com\u002Fnews\u002Fapp\u002F3393110?emclan=103582791475596239&emgid=677375815308020017\") or Purple (\"https:\u002F\u002Fpurple.plaync.com\u002Fdownload\").","status":"published","authorId":null,"sourcePublishedAt":"2026-10-02T00:16:17.000Z","publishedAt":"2026-10-02T01:05:00.108Z","createdAt":"2026-10-02T01:01:59.043Z","updatedAt":"2026-10-02T01:01:59.043Z","category":"event","image":null},{"id":"d030085d-42ae-43d3-883c-d5ce8adeef84","slug":"a-token-of-appreciation-to-all-daevas-fis61d","locale":"en","title":"A token of appreciation to all Daevas","body":"## What changed\n\nDaevas,We've all noticed your positivity across channels and regions, and we wanted to send you a humble gift. Check your inbox until the end of the Early Access to receive:\n- Battle Enhancement Scroll (Engraved) x5Thank you all! The AION 2 team appreciates you.See you in Atreia!\n\n## Who it affects\n\n- AION 2 Early Access (page)\n","summary":"Daevas,We've all noticed your positivity across channels and regions, and we wanted to send you a humble gift. Check your inbox until the end of the Early Access to receive:\n- Battle Enhancement Scroll (Engraved) x5Thank you all! The AION 2 team appreciates you.See you in Atreia!","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T16:03:00.000Z","publishedAt":"2026-10-01T17:05:00.090Z","createdAt":"2026-10-01T16:16:28.554Z","updatedAt":"2026-10-01T16:16:28.554Z","category":"announcement","image":null},{"id":"bd3bc0a3-710d-471b-b79d-fa2fb85a4fab","slug":"a-token-of-appreciation-to-all-daevas-cjmm77","locale":"en","title":"A token of appreciation to all Daevas","body":"## What changed\n\nDaevas,We've all noticed your positivity across channels and regions, and we wanted to send you a humble gift. Check your inbox until the end of the Early Access to receive:Battle Enhancement Scroll (\n\n## Who it affects\n\n- AION 2 Early Access (page)\n","summary":"Daevas,We've all noticed your positivity across channels and regions, and we wanted to send you a humble gift. Check your inbox until the end of the Early Access to receive:Battle Enhancement Scroll (","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T15:37:19.394Z","publishedAt":"2026-10-01T17:05:00.085Z","createdAt":"2026-10-01T16:31:27.255Z","updatedAt":"2026-10-01T16:31:27.255Z","category":"announcement","image":null},{"id":"2b4fd554-932c-4034-8762-18a19919c679","slug":"update-on-account-issues-and-in-game-fixes-uwshmc","locale":"en","title":"Update on account issues and in-game fixes","body":"## What changed\n\nDaevas!\n\nSome players reported that their Early Access status was not properly recognized when logging into the game; we just released a fix for this.\n\nThere were also reports of issues with in-game purchases; this should now be fixed as well.\nThere is no downtime and your client will update to apply the fix the next time you restart it.\n\nNote: our teams are also aware that some players are running into account linking issues. We're actively looking into this, along with the other issues you've been reporting, and will share an update as soon as we can.\n\nThank you for your patience and for your continued support!\n\n## Who it affects\n\n- AION 2 Early Access (page)\n","summary":"Daevas!\n\nSome players reported that their Early Access status was not properly recognized when logging into the game; we just released a fix for this.\n\nThere were also reports of issues with in-game purchases; this should now be fixed as well.\nThere is no downtime and your client will update to apply the fix the next time you restart it.\n\nNote: our teams are also aware that some players are running into account linking issues. We're actively looking into this, along with the other issues you've been reporting, and will share an update as soon as we can.\n\nThank you for your patience and for your continued support!","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T11:32:09.000Z","publishedAt":"2026-10-01T12:05:00.034Z","createdAt":"2026-10-01T12:03:16.705Z","updatedAt":"2026-10-01T12:03:16.705Z","category":"announcement","image":null},{"id":"6bbe6724-e645-4fa8-954d-ad9914b0af63","slug":"update-on-account-issues-and-in-game-fixes-gxh1pz","locale":"en","title":"Update on account issues and in-game fixes","body":"## What changed\n\nDaevas! Some players reported an issue with in-game purchases; we just released a fix to address it. There is no downtime and your client will update to apply the fix the next time you restart it. Tha\n","summary":"Daevas! Some players reported an issue with in-game purchases; we just released a fix to address it. There is no downtime and your client will update to apply the fix the next time you restart it. Tha","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T09:50:48.609Z","publishedAt":"2026-10-01T12:05:00.032Z","createdAt":"2026-10-01T12:01:47.790Z","updatedAt":"2026-10-01T12:01:47.790Z","category":"announcement","image":null},{"id":"10134d99-73eb-4d90-b09e-2d003c0a2f8d","slug":"maintenance-is-over-welcome-back-20cdie","locale":"en","title":"Maintenance is over, welcome back!","body":"## What changed\n\nAll our servers are now back online, thank you for your patience, Daevas!Your compensation will arrive through your mail later today.Welcome back in Atreia!\n","summary":"All our servers are now back online, thank you for your patience, Daevas!Your compensation will arrive through your mail later today.Welcome back in Atreia!","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T07:22:09.000Z","publishedAt":"2026-10-01T08:05:00.089Z","createdAt":"2026-10-01T08:01:34.994Z","updatedAt":"2026-10-01T08:01:34.994Z","category":"announcement","image":null},{"id":"77104b95-b769-459e-95d8-a3841a995c4d","slug":"maintenance-is-over-welcome-back-fjj194","locale":"en","title":"Maintenance is over, welcome back!","body":"## What changed\n\nAll our servers are now back online, thank you for your patience, Daevas!Your compensation will arrive through your mail later today.Welcome back in Atreia!\n","summary":"All our servers are now back online, thank you for your patience, Daevas!Your compensation will arrive through your mail later today.Welcome back in Atreia!","status":"published","authorId":null,"sourcePublishedAt":"2026-10-01T07:16:44.384Z","publishedAt":"2026-10-01T08:05:00.085Z","createdAt":"2026-10-01T07:31:23.209Z","updatedAt":"2026-10-01T07:31:23.209Z","category":"announcement","image":null}],"total":124,"limit":12,"offset":0},"h":{},"s":200,"st":"OK","u":"https:\u002F\u002Faion2hub.me\u002Fapi\u002Farticles","rt":"json"},"fdcc30487f31373227f874f8755f8d5f44f24d23a5086f655fedf595340b028a":{"b":{"items":[{"id":"95b32e34-9c23-4145-a217-94f853e7fe8a","slug":"notice-about-client-decryption-and-early-access-start-time-6bjmn4","locale":"en","title":"Notice about Client Decryption and Early Access Start Time","body":"## What changed\n\nHello Daevas,As we prepare the world of Atreia for your arrival today, we’ve decided to delay the opening of Early Access by 30 minutes. The game client decryption process will begin as previously scheduled, but servers will remain in maintenance mode until we reach the new times mentioned below. We know you are excited to join us and appreciate your patience while our team makes the final adjustments necessary to ensure you have the best experience possible.* Original Schedule:- September 30th, 6 AM PDT (September 30th, at 13:00 UTC)* New Schedule:- September 30th, 6:30 AM PDT (September 30th, at 13:30 UTC)Thanks for your understanding and please accept our apologies for the delay. We’ll see you soon!-The AION 2 Team\n\n## Who it affects\n\n- AION 2 Early Access (page)\n\n## What to do\n\nBefore you rebuild, check the values you rely on on their own pages: each one shows what the catalogue holds now, and its history shows when that last moved.","summary":"Hello Daevas,As we prepare the world of Atreia for your arrival today, we’ve decided to delay the opening of Early Access by 30 minutes. The game client decryption process will begin as previously scheduled, but servers will remain in maintenance mode until we reach the new times mentioned below. We know you are excited to join us and appreciate your patience while our team makes the final adjustments necessary to ensure you have the best experience possible.* Original Schedule:- September 30th, 6 AM PDT (September 30th, at 13:00 UTC)* New Schedule:- September 30th, 6:30 AM PDT (September 30th, at 13:30 UTC)Thanks for your understanding and please accept our apologies for the delay. We’ll see you soon!-The AION 2 Team","status":"published","authorId":null,"sourcePublishedAt":"2026-09-30T12:09:15.000Z","publishedAt":"2026-09-30T13:05:00.069Z","createdAt":"2026-09-30T12:34:28.104Z","updatedAt":"2026-09-30T12:34:28.104Z","category":"patch","image":null},{"id":"b0b16bad-e408-462b-b4bf-a81aeb8eb196","slug":"advanced-access-server-matchmaking-njv4g1","locale":"en","title":"Advanced Access Server Matchmaking ","body":"## What changed\n\nPrepare yourselves Daevas! The first Elyos and Asmodian server pairings have been revealed. Find your advanced access server below to see which server will become your first enemy in Atreia. What is Server Matchmaking?In Aion 2, the Elyos and Asmodians each live on their own servers. But the war between the factions doesn't stay behind borders for long. As you journey through Atreia, you'll get chances to face the opposing faction in modes such as Spacetime Rifts and the Abyss. To bring the two sides together, each Elyos server is paired with an Asmodian server for a limited time. Whenever you enter the Abyss or another cross-faction mode, the players you meet from the other faction will come from your matched server.  For example, if the Asmodian server Israphel is paired with the Elyos server Siel, every Israphel Asmodian who enters the Abyss will run into Siel's Elyos. Those are the players you'll be clashing with, competing against, and… holding grudges against.  Advanced Access Server Pairings EuropePair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikel3 VaizelTriniel4 KaisinelLumiel NA WestPair # Elyos Server Asmodian Server 1 SielIsraphelNA EastPair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikelLATAMPair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikelASIAPair # Elyos Server Asmodian Server 1 SielIsraphelWill My Server Pairing Always Be the Same? No. We will update server pairings periodically to keep the factions balanced. Today's pairing may be replaced by a new challenger down the road, so make your mark while you can. Represent your faction and show what your server is made of. Good luck Daevas!\n\n## What to do\n\nBefore you rebuild, check the values you rely on on their own pages: each one shows what the catalogue holds now, and its history shows when that last moved.","summary":"Prepare yourselves Daevas! The first Elyos and Asmodian server pairings have been revealed. Find your advanced access server below to see which server will become your first enemy in Atreia. What is Server Matchmaking?In Aion 2, the Elyos and Asmodians each live on their own servers. But the war between the factions doesn't stay behind borders for long. As you journey through Atreia, you'll get chances to face the opposing faction in modes such as Spacetime Rifts and the Abyss. To bring the two sides together, each Elyos server is paired with an Asmodian server for a limited time. Whenever you enter the Abyss or another cross-faction mode, the players you meet from the other faction will come from your matched server.  For example, if the Asmodian server Israphel is paired with the Elyos server Siel, every Israphel Asmodian who enters the Abyss will run into Siel's Elyos. Those are the players you'll be clashing with, competing against, and… holding grudges against.  Advanced Access Server Pairings EuropePair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikel3 VaizelTriniel4 KaisinelLumiel NA WestPair # Elyos Server Asmodian Server 1 SielIsraphelNA EastPair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikelLATAMPair # Elyos Server Asmodian Server 1 SielIsraphel2 NezekanZikelASIAPair # Elyos Server Asmodian Server 1 SielIsraphelWill My Server Pairing Always Be the Same? No. We will update server pairings periodically to keep the factions balanced. Today's pairing may be replaced by a new challenger down the road, so make your mark while you can. Represent your faction and show what your server is made of. Good luck Daevas!","status":"published","authorId":null,"sourcePublishedAt":"2026-09-29T01:00:14.000Z","publishedAt":"2026-09-29T02:06:22.994Z","createdAt":"2026-09-29T02:06:22.896Z","updatedAt":"2026-09-29T02:06:22.896Z","category":"patch","image":null},{"id":"e89427db-ea9c-4495-933c-e67f6a7cb7ff","slug":"aion-2-hot-fix-update-ru13rm","locale":"en","title":"AION 2 Hot Fix Update","body":"## What changed\n\nA hotfix will be applied to address the following issues:​Slightly increased interaction radius for quest interaction objectsCharacters below level 10 can no longer use appearance change ticketsResolv\n\n## What to do\n\nBefore you rebuild, check the values you rely on on their own pages: each one shows what the catalogue holds now, and its history shows when that last moved.","summary":"A hotfix will be applied to address the following issues:​Slightly increased interaction radius for quest interaction objectsCharacters below level 10 can no longer use appearance change ticketsResolv","status":"published","authorId":null,"sourcePublishedAt":"2026-09-18T04:00:00.001Z","publishedAt":"2026-09-18T05:05:00.073Z","createdAt":"2026-09-18T04:32:59.160Z","updatedAt":"2026-09-18T04:32:59.160Z","category":"patch","image":null},{"id":"c2ab89e0-0a08-447d-910c-6f74ddd58313","slug":"aion-2-hud-customization-combat-power-metrics-and-major-sanctuary-rebalancing-1269","locale":"en","title":"AION 2: HUD Customization, Combat Power Metrics, and Major Sanctuary Rebalancing","body":"## What changed\n\nThe latest developer broadcast and subsequent March 18 update have introduced pivotal changes to the AION 2 ecosystem. From a complete UI overhaul to a shift in how character progression is measured, here is the technical breakdown of the new patch. 1. Advanced HUD Editor & UI Flexibility For the PC enthusiast, the interface is […]\n\n## Who it affects\n\nNo entities in the database were confidently identified in this notice.\n\n## What to do\n\nReview the stat changes above against your current build; adjust gear, skill points or stigma choices that relied on the old values.","summary":"The latest developer broadcast and subsequent March 18 update have introduced pivotal changes to the AION 2 ecosystem. From a complete UI overhaul to a shift in how character progression is measured, here is the technical breakdown of the new patch. 1. Advanced HUD Editor & UI Flexibility For the PC enthusiast, the interface is […]","status":"published","authorId":null,"sourcePublishedAt":"2026-03-18T12:35:02.000Z","publishedAt":"2026-09-03T07:23:41.485Z","createdAt":"2026-09-03T00:02:28.334Z","updatedAt":"2026-09-05T04:37:45.501Z","category":"patch","image":null}],"total":15,"limit":4,"offset":0},"h":{},"s":200,"st":"OK","u":"https:\u002F\u002Faion2hub.me\u002Fapi\u002Farticles","rt":"json"},"__nghData__":[{"t":{"0":"t0"},"c":{"0":[]}},{"t":{"0":"t1"},"c":{"0":[{"i":"t1","r":1}]}},{"t":{"6":"t2","9":"t3","12":"t4","16":"t10","22":"t11","23":"t12"},"c":{"6":[{"i":"t2","r":1}],"9":[],"12":[{"i":"t4","r":3,"t":{"0":"t5","1":"t6"},"c":{"0":[],"1":[{"i":"t6","r":1}]},"x":2},{"i":"t4","r":3,"t":{"0":"t5","1":"t6"},"c":{"0":[{"i":"t5","r":1,"t":{"8":"t7"},"c":{"8":[{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]},"x":5}]}},{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]},"x":2}]}},{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]},"x":3}]}}]}}],"1":[]}},{"i":"t4","r":3,"t":{"0":"t5","1":"t6"},"c":{"0":[],"1":[{"i":"t6","r":1}]}},{"i":"t4","r":3,"t":{"0":"t5","1":"t6"},"c":{"0":[{"i":"t5","r":1,"t":{"8":"t7"},"c":{"8":[{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]},"x":3}]}},{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]}}]}}]}}],"1":[]}},{"i":"t4","r":3,"t":{"0":"t5","1":"t6"},"c":{"0":[{"i":"t5","r":1,"t":{"8":"t7"},"c":{"8":[{"i":"t7","r":1,"t":{"4":"t8"},"c":{"4":[{"i":"t8","r":1,"t":{"3":"t9"},"c":{"3":[{"i":"t9","r":1}]},"x":2}]},"x":2}]}}],"1":[]}}],"16":[{"i":"t10","r":1,"x":3}],"22":[],"23":[{"i":"t12","r":1}]}},{"t":{"4":"t13",