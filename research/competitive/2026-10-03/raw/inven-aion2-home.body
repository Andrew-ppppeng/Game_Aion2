<script>
(function() {
    var el = document.querySelector('.game-countdown__timer[data-end]:not([data-cnt-ready])');
    if (!el) return;
    el.dataset.cntReady = '1';
    var end = new Date(el.dataset.end).getTime();
    var nums = {
        days: el.querySelector('[data-unit="days"]'),
        hours: el.querySelector('[data-unit="hours"]'),
        min: el.querySelector('[data-unit="min"]'),
        sec: el.querySelector('[data-unit="sec"]')
    };
    var tid = null;
    function showAvailable() {
        el.innerHTML = '<strong class="game-countdown__timer-available">AVAILABLE TODAY</strong>';
    }
    if (!nums.days) {
        return;
    }
    function tick() {
        var diff = end - Date.now();
        if (diff <= 0) {
            clearInterval(tid);
            showAvailable();
            return;
        }
        nums.days.textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
        nums.hours.textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
        nums.min.textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
        nums.sec.textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
    }
    tick();
    tid = setInterval(tick, 1000);
})();
</script>
