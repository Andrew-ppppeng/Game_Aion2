<script>
    $(document).ready(function () {
        const $module = $('.inven-community-job');
        const $tabs = $module.find('.inven-community-job-tab');
        const $boards = $module.find('.inven-community-job-board');

        $tabs.children('li').on('click', function () {
            const $this = $(this);
            const index = $this.index();

            $this.siblings().removeClass('on');
            $this.addClass('on');

            $boards.removeClass('on');
            $boards.eq(index).addClass('on');
        });
    });
</script>		</article>
