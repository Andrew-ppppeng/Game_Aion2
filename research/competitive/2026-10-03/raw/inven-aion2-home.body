<script>
    $(document).ready(function () {
        const nexusView = $('.nexusViewiBuilderModule');
        const galleryListWrap = nexusView.find('.gallery-section .listWrap.auto');
        const textListWrap = nexusView.find('.text-section .listWrap');
        const refreshBtn = nexusView.find('.refresh');

        const types = ['bbs', 'report', 'youtube'];
        const countLimit = {
            'bbs': 9,
            'report': 0,
            'youtube': 0        };
        const gallerySectionLimit = 3;

        const shuffleArray = (array) => {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }

            return arr;
        }

        const youtubeList = nexusView.find('.listWrap[data-type="youtube"]');
        const youtubeModal = nexusView.find('.playMoveBack');
        const closeBtn = youtubeModal.find('.closeBtn');

        refreshBtn.on('click', function (e) {
            e.stopPropagation();

            galleryListWrap.removeClass('on');
            textListWrap.removeClass('on');

            let galleryOnCount = 0;
            const galleryUsedCount = { 'bbs': 0, 'report': 0, 'youtube': 0 };

            // 1. 갤러리 섹션 처리: 전체 아이템을 섞어서 가능한 만큼 채움
            const shuffledGalleryItems = shuffleArray(galleryListWrap.toArray());
            shuffledGalleryItems.forEach(function (el) {
                const type = $(el).data('type');

                // 갤러리 전체 개수 제한에 도달하지 않았고, 해당 타입의 노출 제한을 넘지 않은 경우
                if (galleryOnCount < gallerySectionLimit && galleryUsedCount[type] < countLimit[type]) {
                    $(el).addClass('on');
                    galleryOnCount++;
                    galleryUsedCount[type]++;
                }
            });

            // 2. 텍스트 섹션 처리: 갤러리에서 사용한 개수를 제외하고 타입별 남은 할당량만큼 채움
            types.forEach(function (type) {
                const typeList = textListWrap.filter('[data-type="' + type + '"]');
                const shuffledItems = shuffleArray(typeList.toArray());

                const remainingLimitForType = Math.max(0, countLimit[type] - galleryUsedCount[type]);
                shuffledItems.slice(0, remainingLimitForType).forEach(function (el) {
                    $(el).addClass('on');
                });
            });
        });

        youtubeList.on('click', function (e) {
            e.preventDefault();
            const videoId = $(this).data('video-id');
            youtubeModal.find('iframe').attr('src', 'https://www.youtube.com/embed/' + videoId);
            youtubeModal.css({'display': 'flex'});
        });

        closeBtn.on('click', function () {
            youtubeModal.css({'display': 'none'});
            youtubeModal.find('iframe').attr('src', '');
        });
    });

</script>		</article>
