            <div class="dropdown-wrapper">
                <div class="dropdown disabled" id="aion2-dropdown-server" onclick="toggleDropdown('server')">
                    <span id="aion2-server-label">서버</span>
                    <svg viewBox="0 0 12.209 7.522" fill="none">
                        <path d="M6.10677 4.69271L10.7936 0.000651042L12.209 1.41341L6.10807 7.52213L0 1.41406L1.41406 0L6.10677 4.69271Z" fill="#575757"/>
                    </svg>
                </div>
                <ul class="dropdown-menu" id="aion2-menu-server">
                </ul>
            </div>
        </div>

        <div class="search-box">
            <input type="text" id="aion2-char-name" placeholder="캐릭터 이름" onkeydown="handleKeyDown(event)">
            <svg viewBox="0 0 18.205 18.231" fill="none" onclick="doSearch()">
                <path d="M14.5557 8.39844C14.5557 6.76535 13.9077 5.19874 12.7529 4.04395C11.5982 2.88917 10.0315 2.24027 8.39844 2.24023C6.76529 2.24023 5.19875 2.88914 4.04395 4.04395C2.88914 5.19875 2.24023 6.76529 2.24023 8.39844C2.24027 10.0315 2.88917 11.5982 4.04395 12.7529C5.19874 13.9077 6.76535 14.5557 8.39844 14.5557C10.0315 14.5556 11.5982 13.9077 12.7529 12.7529C13.9077 11.5982 14.5556 10.0315 14.5557 8.39844ZM16.7969 8.39844C16.7968 10.2551 16.1793 12.0462 15.0625 13.5039L18.2051 16.6465L16.6211 18.2314L13.4746 15.085C12.0222 16.1876 10.2426 16.7968 8.39844 16.7969C6.17105 16.7969 4.03499 15.9119 2.45996 14.3369C0.884945 12.7619 3.34652e-05 10.6258 0 8.39844C0 6.17099 0.884915 4.03501 2.45996 2.45996C4.03501 0.884916 6.17099 0 8.39844 0C10.6258 3.33394e-05 12.7619 0.884945 14.3369 2.45996C15.9119 4.03499 16.7969 6.17105 16.7969 8.39844Z" fill="#575757"/>
            </svg>
        </div>
    </div>
</div>
<script>
    const SEARCH_URL = 'https://aion2.inven.co.kr/module/character_search.php';
    const SERVERS = {
        //시엘, 네자칸, 바이젤, 카이시넬, 유스티엘, 아리엘, 프레기온, 메스람타에다, 히타니에, 나니아, 타하바타, 루터스, 페르노스, 다미누, 카사카, 바카르마, 챈가룽, 코치룽, 이슈타르, 티아마트
        '천족': ['시엘', '네자칸', '바이젤', '카이시넬', '유스티엘', '아리엘', '프레기온', '메스람타에다', '히타니에', '나니아', '타하바타', '루터스', '페르노스', '다미누', '카사카', '바카르마', '챈가룽', '코치룽', '이슈타르', '티아마트','포에타'],
        //이스라펠, 지켈, 트리니엘, 루미엘, 마르쿠탄, 아스펠, 에레슈키갈, 브리트라, 네몬, 하달, 루드라, 울고른, 무닌, 오다르, 젠카카, 크로메데, 콰이링, 바바룽, 파프니르, 인드나흐
        '마족': ['이스라펠', '지켈', '트리니엘', '루미엘', '마르쿠탄', '아스펠', '에레슈키갈', '브리트라', '네몬', '하달', '루드라', '울고른', '무닌', '오다르', '젠카카', '크로메데', '콰이링', '바바룽', '파프니르', '인드나흐','이스할겐']
    };
    const state = { faction: null, server: null };

    function renderServerMenu(faction) {
        var menu = document.getElementById('aion2-menu-server');
        var servers = SERVERS[faction];
        menu.innerHTML = '';
        servers.forEach(function(name, i) {
            var li = document.createElement('li');
            li.textContent = name;
            if (i === 0) li.classList.add('selected');
            li.onclick = function() { selectOption('server', name, li); };
            menu.appendChild(li);
        });
        state.server = servers[0];
        document.getElementById('aion2-server-label').textContent = servers[0];
    }

    function toggleDropdown(id) {
        if (id === 'server' && document.getElementById('aion2-dropdown-server').classList.contains('disabled')) return;
        var btn = document.getElementById('aion2-dropdown-' + id);
        var menu = document.getElementById('aion2-menu-' + id);
        var isOpen = btn.classList.contains('open');

        document.querySelectorAll('.dropdown').forEach(function(d) { d.classList.remove('open'); });
        document.querySelectorAll('.dropdown-menu').forEach(function(m) { m.classList.remove('open'); });

        if (!isOpen) {
            btn.classList.add('open');
            menu.classList.add('open');
        }
    }

    function selectOption(id, value, el) {
        state[id] = value;
        document.getElementById('aion2-' + id + '-label').textContent = value;
        document.querySelectorAll('#aion2-menu-' + id + ' li').forEach(function(li) { li.classList.remove('selected'); });
        el.classList.add('selected');
        if (id === 'faction') {
            renderServerMenu(value);
            document.getElementById('aion2-dropdown-server').classList.remove('disabled');
        }
        toggleDropdown(id);
    }

    function doSearch() {
        var name = document.getElementById('aion2-char-name').value.trim();
        if (!state.faction) {
            alert('종족과 서버를 골라주세요.');
            return;
        }
        if (!name) {
            document.getElementById('aion2-char-name').focus();
            return;
        }
        var params = 'server=' + encodeURIComponent(state.server)
                    + '&race=' + encodeURIComponent(state.faction)
                    + '&name=' + encodeURIComponent(name);
        window.open(SEARCH_URL + '?' + params, '_blank');
    }

    function handleKeyDown(e) {
        if (e.key === 'Enter') doSearch();
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown-wrapper')) {
            document.querySelectorAll('.dropdown').forEach(function(d) { d.classList.remove('open'); });
            document.querySelectorAll('.dropdown-menu').forEach(function(m) { m.classList.remove('open'); });
        }
    });
</script>
