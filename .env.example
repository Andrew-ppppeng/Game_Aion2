NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel: connect the free Upstash Redis resource with auto-upgrade disabled.
# Keep both credentials server-only. Without them, Vercel dynamic queries fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Marketplace integration injects these aliases automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Anonymous daily aggregate statistics. Enabled in production by default;
# development requires true. Set false to disable collection completely.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# Server-only token for reading aggregate reports. Generate a long random value.
ANALYTICS_READ_TOKEN=
# Public feedback email is maintained in src/lib/site.ts.
